<!doctype html>
<html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="theme-color" content="#113d35"><meta name="description" content="Christmas Toy Drive giving options: gifts, toy planning and Cash App. Clear payment status and privacy safeguards.">
<title>Give | Christmas Toy Drive 24 / 7 / 365</title>
<style>
:root{color-scheme:light;--green:#113e32;--dark:#092b25;--gold:#f8d993;--bg:#faf8ef;--ink:#14352e;--line:#cadaD0;--muted:#4b6359}*{box-sizing:border-box}body{margin:0;background:var(--bg);color:var(--ink);font:16px/1.6 system-ui,-apple-system,sans-serif}a{color:inherit}button,input,textarea{font:inherit}button:focus-visible,a:focus-visible,input:focus-visible,textarea:focus-visible{outline:3px solid #ab4c40;outline-offset:3px}.wrap{max-width:1030px;margin:auto;padding:0 22px}header{background:var(--dark);color:#fff}header .wrap{padding-top:16px;padding-bottom:16px;display:flex;justify-content:space-between;align-items:center;gap:15px;flex-wrap:wrap}header a{font-weight:750;text-decoration:none}.hero{background:linear-gradient(125deg,#164b3c,#0b3029);color:white;padding:76px 0}.kicker{font-size:12px;letter-spacing:.15em;text-transform:uppercase;font-weight:800;color:var(--gold)}h1{font-size:clamp(42px,8vw,78px);line-height:1.06;letter-spacing:-.05em;max-width:780px;margin:15px 0 20px}.hero p{max-width:680px;color:#e0efe9;font-size:18px}.section{padding:55px 0}.section h2{font-size:clamp(27px,4vw,42px);line-height:1.15;margin:5px 0 15px}.grid{display:grid;grid-template-columns:repeat(3,1fr);gap:14px}.panel{padding:25px;border:1px solid var(--line);background:#fffef9;border-radius:17px}.panel h3{font-size:22px;margin:4px 0 9px}.panel p{color:var(--muted);margin:0 0 20px}.button{display:inline-block;min-height:45px;padding:11px 16px;border:1px solid #365e4f;border-radius:10px;background:var(--green);color:white;text-decoration:none;font-weight:800;cursor:pointer}.button.secondary{color:var(--green);background:#fff;border-color:#a5b9ab}.button.gold{background:var(--gold);color:var(--dark);border-color:var(--gold)}.donation{background:#eaf1e8;border-block:1px solid var(--line)}.layout{display:grid;grid-template-columns:1fr 330px;gap:20px}.amounts{display:flex;flex-wrap:wrap;gap:9px;margin:12px 0 20px}.amounts button{border:1px solid #98b3a2;border-radius:10px;background:white;padding:10px 16px;cursor:pointer}.amounts button[aria-pressed="true"]{background:var(--green);color:white}.form-label{display:block;font-size:14px;font-weight:800;margin:14px 0 5px}input,textarea{width:100%;padding:11px 12px;border:1px solid #a4b8a8;border-radius:9px;background:white;color:var(--ink)}textarea{min-height:75px;resize:vertical}.fine{font-size:13px;color:var(--muted)}.notice{border-left:4px solid #bb6d37;padding:16px 18px;background:#fff7e8;border-radius:5px;margin-top:18px;color:#684220}.pill{font-size:11px;font-weight:900;letter-spacing:.08em;text-transform:uppercase}.cash{font-size:clamp(25px,4vw,35px);font-weight:900;letter-spacing:-.02em;word-break:break-word;margin:10px 0}.actions{display:flex;flex-wrap:wrap;gap:10px;margin-top:18px}#preview{white-space:pre-wrap;overflow-wrap:anywhere;background:#f7f8f4;border:1px solid #d2dbd2;border-radius:10px;padding:16px;min-height:140px}.footer{background:var(--dark);color:#e2efe8;padding:26px 0;font-size:13px}@media(max-width:800px){.grid,.layout{grid-template-columns:1fr}}@media print{header,.hero,.actions,.grid,.notice,.fine,#amounts{display:none!important}.section{padding:15px 0}body{background:white}.panel{border:0}}@media(prefers-reduced-motion:reduce){*{scroll-behavior:auto!important}}
</style></head><body>
<header><div class="wrap"><a href="../">🎄 CHRISTMAS TOY DRIVE · 24 / 7 / 365</a><nav aria-label="Navigation"><a href="../">Drive home</a> · <a href="../catalog/">Giving catalog</a> · <a href="../../sites/">All sites</a> · <a href="../../nathan-ai/">Nathan AI</a></nav></div></header>
<main><section class="hero"><div class="wrap"><div class="kicker">One mission · Many ways to give</div><h1>Give toys, clothing, or food. Help all year.</h1><p>Christmas Toy Drive by Nathan Tabor. Choose a giving path and keep the details clear. Payments, toy deliveries and automatic email receipts are separate verified events.</p><a class="button gold" href="../catalog/">Browse 30 giving levels</a> <a class="button" href="#give">Cash App gateway</a></div></section>
<section class="section"><div class="wrap"><h2>Three ways to participate</h2><div class="grid">
<article class="panel"><div class="kicker" style="color:#245946">01 · Money</div><h3>Give through Cash App</h3><p>Select your own contribution amount and confirm the recipient inside Cash App.</p><a class="button" href="#give">Open Cash App giving details</a></article>
<article class="panel"><div class="kicker" style="color:#245946">02 · Purchase</div><h3>Choose gifts and essentials</h3><p>Explore toy, clothing and food giving ideas. Product checkout and fulfillment partnerships are not connected yet.</p><a class="button secondary" href="../catalog/">Browse the catalog</a></article>
<article class="panel"><div class="kicker" style="color:#245946">03 · Physical gift</div><h3>Donate physical goods</h3><p>Offer new toys, suitable clothing or safely handled food. Pickup and drop-off arrangements require verified partner locations.</p><a class="button secondary" href="../catalog/">Explore giving categories</a></article>
</div></div></section>
<section class="section donation" id="give"><div class="wrap"><h2>Cash App giving</h2><p>This site links to the Cash App profile provided by the project owner. Your payment amount and recipient must be confirmed in Cash App itself. An external Cash App transfer is not an automatic monthly subscription.</p>
<div class="layout"><div class="panel">
<p id="selected-program" class="fine" role="status" aria-live="polite">Donations toward toys, clothing, food or family essentials are planned separately from completed payments.</p><label class="form-label" for="amount">Plan a contribution amount (US dollars)</label><div class="amounts" id="amounts" aria-label="Suggested amounts"><button type="button" data-amount="10" aria-pressed="false">$10</button><button type="button" data-amount="25" aria-pressed="true">$25</button><button type="button" data-amount="50" aria-pressed="false">$50</button><button type="button" data-amount="100" aria-pressed="false">$100</button></div><input id="amount" type="number" inputmode="decimal" min="1" step="0.01" value="25" aria-label="Custom donation amount">
<label class="form-label" for="honoree">In honor of (optional)</label><input id="honoree" maxlength="80" placeholder="Honoree's first name or chosen name">
<label class="form-label" for="message">Holiday greeting (optional)</label><textarea id="message" maxlength="220" placeholder="A message for your card, not a payment note"></textarea>
<div class="actions"><button class="button secondary" id="card" type="button">Create printable tribute card</button><button class="button secondary" id="copy" type="button">Copy giving note</button></div>
<p class="fine" id="status" role="status" aria-live="polite">No information is sent to a server or saved by this tool.</p>
<div id="preview" role="region" aria-label="Card preview">Your holiday greeting will appear here. A card is not proof that a donation was paid.</div>
</div>
<aside class="panel"><div class="pill">Confirm recipient before paying</div><div class="cash">DOG GOD<br>$DOGGODjnt</div><p>Cash App account shown by the project owner. Select your amount again within Cash App and add “Christmas Toy Drive” as a payment note if desired.</p><a class="button gold" href="https://cash.app/$DOGGODjnt" rel="noopener noreferrer" target="_blank">Continue to Cash App ↗</a><p class="fine" style="margin-top:16px">This is an external payment link, not an embedded or automatic checkout. Do not treat this page or a donor's self-report as payment verification.</p></aside>
</div>
<div class="notice"><strong>Important charity and receipt disclosure:</strong> The Christmas Toy Drive's tax-exempt status has not been established in this website build. Do not assume a Cash App transfer is tax-deductible. An email receipt requires an approved private backend, verified donation records, and organizational tax-status review; none is active on this static page.</div>
</div></section>
<section class="section"><div class="wrap"><h2>How receipt emails will work</h2><div class="grid"><div class="panel"><h3>1. Donor email</h3><p>A secure, consent-based checkout collects an email address only when the real email service is connected.</p></div><div class="panel"><h3>2. Payment verification</h3><p>A trusted backend confirms the transaction from the payment provider, then creates an idempotent donor record.</p></div><div class="panel"><h3>3. Acknowledgment</h3><p>The donor receives the correct payment acknowledgment, personal tribute card and optional project updates.</p></div></div><p class="fine">At present these three steps are an implementation specification, not live automated actions. No child names, addresses or recipient records should be entered on this public page.</p></div></section>
</main><footer class="footer"><div class="wrap">CHRISTMAS TOY DRIVE · 24 / 7 / 365 · An independently managed Nathan Tabor project. <a href="../">Back to mission</a></div></footer>
<script>
(function(){'use strict';const amount=document.getElementById('amount'),status=document.getElementById('status'),preview=document.getElementById('preview');
const qs=new URLSearchParams(window.location.search),n=Number(qs.get('amount')),focus=String(qs.get('category')||''),title=String(qs.get('gift')||'').slice(0,120),cadence=String(qs.get('frequency')||'');
if(qs.has('amount')&&Number.isFinite(n)&&n>=1&&n<=1000000)amount.value=String(n);
if(['toys','clothing','food','essentials','logistics','mostneeded'].includes(focus))document.getElementById('selected-program').textContent='Selected proposed program: '+(title||focus)+(cadence==='monthly'?' · Monthly giving intention only; Cash App does not activate recurring billing.':cadence==='yearly'?' · Annual giving intention only; no automatic renewal.':'')+' · Not a paid receipt or inventory guarantee.';
document.querySelectorAll('[data-amount]').forEach(x=>x.setAttribute('aria-pressed',String(Number(x.dataset.amount)===Number(amount.value))));
document.getElementById('amounts').addEventListener('click',function(e){const b=e.target.closest('[data-amount]');if(!b)return;amount.value=b.dataset.amount;document.querySelectorAll('[data-amount]').forEach(x=>x.setAttribute('aria-pressed',String(x===b)));});
amount.addEventListener('input',()=>document.querySelectorAll('[data-amount]').forEach(x=>x.setAttribute('aria-pressed',String(Number(x.dataset.amount)===Number(amount.value)))));
function details(){const value=Number(amount.value);if(!Number.isFinite(value)||value<1||value>1000000){status.textContent='Enter a valid amount from $1 to $1,000,000.';return null;}const honoree=document.getElementById('honoree').value.trim(),message=document.getElementById('message').value.trim();return {value:value.toFixed(2),honoree,message};}
function note(d){return 'CHRISTMAS TOY DRIVE — TRIBUTE CARD\nGiving plan: $'+d.value+' USD\nCash App recipient: $DOGGODjnt\n'+(d.honoree?'In honor of: '+d.honoree+'\n':'')+(d.message?'Message: '+d.message+'\n':'')+'\nThis is a giving plan only, NOT a transaction receipt. Confirm any payment directly in Cash App.';}
document.getElementById('card').addEventListener('click',()=>{const d=details();if(!d)return;preview.textContent=note(d);status.textContent='Tribute card drafted locally. It is not proof of a contribution. Print this page to save it.';});
document.getElementById('copy').addEventListener('click',()=>{const d=details();if(!d)return;const value=note(d);if(navigator.clipboard?.writeText){navigator.clipboard.writeText(value).then(()=>status.textContent='Giving note copied; no payment has been recorded.').catch(()=>{preview.textContent=value;status.textContent='Copy the text in the card preview.';});}else {preview.textContent=value;status.textContent='Copy the text in the card preview.';}});
})();
</script></body></html>