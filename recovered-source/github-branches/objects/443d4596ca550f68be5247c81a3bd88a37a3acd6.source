:root{color-scheme:dark;--sky:#101b37;--panel:#25283a;--gold:#d8b96a;--text:#fff1ce;--earth:#a88161}*{box-sizing:border-box}body{margin:0;background:radial-gradient(ellipse at top,#29324b,var(--sky) 65%);color:var(--text);font:16px/1.5 system-ui,sans-serif}button,input,select,textarea{font:inherit}button,select,input[type=file]{min-height:44px}button,select{border:1px solid var(--gold);border-radius:8px;color:var(--text);background:linear-gradient(#4c4050,#242233);padding:8px 14px;cursor:pointer}button:hover{filter:brightness(1.2)}button:focus-visible,input:focus-visible,select:focus-visible,a:focus-visible{outline:3px solid #8fdfff;outline-offset:3px}button:disabled{opacity:.5;cursor:default}header{max-width:1320px;margin:auto;padding:34px 24px 16px}h1{font:clamp(30px,5vw,56px)/1.15 Georgia,serif;margin:8px 0}h2{font:25px Georgia,serif;color:var(--gold)}small,.muted{color:#d3c7b6}.eyebrow{letter-spacing:.16em;text-transform:uppercase;color:var(--gold);font-size:12px}.layout{max-width:1320px;display:grid;grid-template-columns:minmax(0,1.6fr) minmax(300px,1fr);gap:20px;margin:auto;padding:20px 24px}.panel{background:linear-gradient(140deg,#ffffff09,transparent),var(--panel);border:1px solid #ac8b58;border-radius:16px;padding:20px;box-shadow:0 12px 36px #0004,inset 0 0 0 4px #0002}.wide{grid-column:1/-1}.toolbar{display:flex;flex-wrap:wrap;gap:10px;align-items:center}.controls{display:grid;gap:14px}.controls label{display:flex;gap:10px;align-items:center;flex-wrap:wrap}input[type=range]{width:140px}canvas{width:100%;display:block;border-radius:10px;background:var(--sky)}.stage{position:relative;overflow:hidden;min-height:300px}.cutin{position:absolute;left:15%;top:12%;width:70%;pointer-events:none;display:grid;place-items:center;background:linear-gradient(110deg,#152444ec,#736035e8,#152444ec);border-block:2px solid var(--gold);padding:20px;opacity:0;font:24px Georgia,serif}.cutin svg{height:100px}.grid{display:grid;grid-template-columns:repeat(7,minmax(0,1fr));gap:4px;max-width:460px;margin:18px auto}.grid button{border:0;min-width:0;padding:0;background:none}.grid button svg{width:100%;height:auto;display:block}.asset-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(98px,1fr));gap:10px}.asset-grid button{display:grid;place-items:center;gap:6px;font-size:12px}.asset-grid svg{width:44px;height:44px}.notice{padding:12px;border-left:3px solid var(--gold);background:#0002}textarea{width:100%;min-height:160px;border:1px solid #a48e67;background:#101a2a;color:#f8eedb;padding:12px;border-radius:8px;font:13px/1.5 monospace}a{color:#91d8ff}output{font-variant-numeric:tabular-nums}#atlasPreview{max-height:420px;object-fit:contain;background:repeating-conic-gradient(#333 0 25%,#222 0 50%) 0/20px 20px}footer{padding:24px;text-align:center}.log{min-height:28px}details{margin:16px 0}summary{cursor:pointer;min-height:44px}#timelineControls{display:flex;gap:12px;flex-wrap:wrap}#atlasList{max-height:140px;overflow:auto}#atlasList li{overflow-wrap:anywhere}@media(max-width:850px){.layout{grid-template-columns:1fr;padding:12px}.panel{padding:14px}.wide{grid-column:auto}}@media(prefers-reduced-motion:reduce){*,*::before,*::after{scroll-behavior:auto!important;animation:none!important;transition:none!important}}
