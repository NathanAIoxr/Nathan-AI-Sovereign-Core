<!doctype html>
<html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<meta name="theme-color" content="#0b1724"><title>NATHAN AI 🚀 · Φ_mine</title>
<style>
:root{font:16px/1.55 system-ui,Arial,sans-serif;color:#e6f6ff;background:#071521}
*{box-sizing:border-box}body{margin:0;background:radial-gradient(circle at 15% 0%,#153b4b,#071521 60%);min-height:100vh}
header,main,footer{max-width:1150px;margin:auto;padding:24px}header{border-bottom:1px solid #355469}
nav{display:flex;gap:16px;flex-wrap:wrap;font-size:.91rem}a{color:#81d9f8}
h1{font-size:clamp(2.3rem,6vw,4.8rem);letter-spacing:-.06em;line-height:1;margin:14px 0}
h2{font-size:1.35rem}h3{font-size:1.05rem}
p{color:#bcd4e2}.eyebrow{color:#9ef5e2;font-size:.8rem;letter-spacing:.15em;font-weight:750}
main>section{margin:24px 0}.panel{border:1px solid #36566d;border-radius:15px;padding:19px;background:#102637}
.stats{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:14px}
.stat{background:#0e2a36;border:1px solid #42667b;border-radius:12px;padding:18px}
.stat strong{display:block;font-size:clamp(1.35rem,3vw,2.1rem);font-variant-numeric:tabular-nums}
label{display:block;color:#e9f8ff;font-weight:680}input{font:inherit;padding:11px;border:1px solid #7ba0b0;border-radius:9px;background:#061320;color:#fff;margin:6px 0 12px;width:100%}
.form-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(160px,1fr));gap:14px}
button{font:inherit;padding:12px 17px;background:#9df4e6;color:#092128;font-weight:800;border:0;border-radius:10px;cursor:pointer;margin:5px}
button:disabled{opacity:.45;cursor:not-allowed}.secondary{background:#284c60;color:#eaf8ff}
button:focus-visible,a:focus-visible,input:focus-visible{outline:3px solid #f5d581;outline-offset:2px}
.stages{display:grid;grid-template-columns:repeat(auto-fit,minmax(215px,1fr));gap:13px}
.stage{background:#103345;border:1px solid #48798b;border-radius:13px;padding:16px}
.stage.done{border-color:#8debdc}.stage strong{font-size:1.5rem;color:#9df4e6}
pre{background:#05111b;color:#d9eff7;border-radius:10px;padding:17px;overflow:auto;white-space:pre-wrap;overflow-wrap:anywhere;max-height:400px}
table{width:100%;border-collapse:collapse;font-size:.88rem}th,td{border-bottom:1px solid #426075;text-align:left;padding:7px}
.note{border-left:4px solid #9df4e6;padding-left:15px}
@media(max-width:650px){.stats{grid-template-columns:1fr}header,main,footer{padding:17px}}
</style><script type="module" src="./app.mjs"></script></head><body>
<header><nav aria-label="Nathan AI navigation">
