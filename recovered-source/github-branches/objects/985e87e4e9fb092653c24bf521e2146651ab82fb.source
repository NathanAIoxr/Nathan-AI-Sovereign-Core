<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Brainstormer Communication Academy</title><style>body{font:16px/1.5 system-ui;margin:0;background:#102736;color:#f5fafc;padding:20px}main{max-width:950px;margin:auto}a{color:#b3f5d5}.panel{padding:18px;border:1px solid #51768a;border-radius:14px;background:#203848;margin:15px 0}label{display:block;margin:12px 0}textarea,select,input{display:block;width:100%;box-sizing:border-box;background:#0f2b3c;color:white;border:1px solid #83a4ba;border-radius:8px;font:inherit;padding:10px}textarea{min-height:100px}button{margin:5px;padding:10px 13px;border:1px solid #b1edcd;background:#28566b;color:white;cursor:pointer;border-radius:8px}pre{white-space:pre-wrap;overflow-wrap:anywhere}li{margin:.5em 0}</style></head><body><main><nav><a href="../index.html">Brainstormer Home</a> · <a href="../game/index.html">Game</a> · <a href="../books/index.html">Books</a></nav><h1>Independent Communication Academy</h1><p>Eight local learning exercises that preserve the original wording separately from derived practice. Not a certified translation, pronunciation system or live model.</p><section class="panel"><label>Original words<textarea id="original" maxlength="12000" placeholder="Enter your unaltered thought"></textarea></label><label>Lesson<select id="mode"><option value="spoken">Explain aloud</option><option value="short">Short explanation</option><option value="outline">Organize an outline</option><option value="questions">Evidence and clarifying questions</option><option value="acrostic">Acrostic construction</option><option value="phonetic">Sounds / ear / mouth / tongue</option><option value="reverse">Reverse words</option><option value="lines">Reverse lines</option></select></label><button id="practice">Practice</button><button id="keep">Save in journal</button><button id="hop">Continue in Nathan AI Chatbox</button><pre id="result" aria-live="polite">Your learning result appears here.</pre><p id="status" role="status"></p></section><section class="panel"><h2>My learning journal</h2><p id="progress"></p><ol id="history"></ol><button id="md">Export teaching workbook</button><button id="json">Export JSON</button><label>Import journal<input id="import" type="file" accept=".json,application/json"></label><p>Local browser storage is unencrypted. Export backups frequently.</p></section></main><script>
(function(){'use strict';const $=x=>document.getElementById(x),KEY='nathan.brainstormer.academy.v1';let journal={schema:KEY,entries:[]},pending=null;try{const x=JSON.parse(localStorage.getItem(KEY)||'null');if(x?.schema===KEY&&Array.isArray(x.entries))journal=x}catch(e){}
function transform(s,m){const words=s.split(/\s+/).filter(Boolean);switch(m){case'spoken':return 'What I mean is: '+s+'\nPractice speaking in your own words.';case'short':return 'Short form: '+words.slice(0,16).join(' ')+(words.length>16?'…':'');case'outline':return '1. Main idea: '+s+'\n2. Example: [write] \n3. Outcome: [write]';case'questions':return 'What is the key message?\nWho is listening?\nWhat evidence supports it?\nWhich parts are interpretive?\nWhat must remain original?';case'acrostic':return 'First-letter sequence: '+words.slice(0,26).map(x=>x[0].toUpperCase()).join('')+'\nWrite a sentence for each letter.';case'phonetic':return 'ORIGINAL: '+s+'\nHEARD SOUND: [write what you hear]\nMOUTH / TONGUE: [describe the motion]\nNo automated phonetic accuracy claim.';case'reverse':return words.reverse().join(' ');case'lines':return s.split(/\r?\n/).reverse().join('\n')}}function save(){try{localStorage.setItem(KEY,JSON.stringify(journal));$('status').textContent='Saved in this browser.'}catch(e){$('status').textContent='Local storage full. Export a copy.'}}function render(){$('progress').textContent=journal.entries.length+' exercises · '+new Set(journal.entries.map(x=>x.mode)).size+'/8 lesson types';$('history').replaceChildren();for(const x of journal.entries.slice().reverse().slice(0,100)){const li=document.createElement('li');li.textContent=x.mode+': '+x.original.slice(0,150);$('history').append(li)}}function dl(name,s,type){const url=URL.createObjectURL(new Blob([s],{type:type||'text/plain'})),a=document.createElement('a');a.href=url;a.download=name;a.click();setTimeout(()=>URL.revokeObjectURL(url),1000)}$('practice').onclick=()=>{const original=$('original').value,mode=$('mode').value;if(!original.trim())return alert('Enter original wording');pending={mode,original,derived:transform(original,mode),date:new Date().toISOString()};$('result').textContent=pending.derived;$('status').textContent='Practice ready to save.'};$('keep').onclick=()=>{if(!pending)return alert('Practice first');journal.entries.push(pending);pending=null;save();render()};$('md').onclick=()=>dl('brainstormer-academy.md','# Communication Academy\n\n'+journal.entries.map((x,i)=>'## Lesson '+(i+1)+' — '+x.mode+'\n\nORIGINAL:\n'+x.original+'\n\nDERIVED PRACTICE:\n'+x.derived).join('\n\n'),'text/markdown');$('json').onclick=()=>dl('brainstormer-academy.json',JSON.stringify(journal,null,2),'application/json');$('import').onchange=async e=>{const f=e.target.files[0];e.target.value='';if(!f)return;try{if(f.size>1024*1024)throw Error('1 MB maximum');const j=JSON.parse(await f.text());if(j.schema!==KEY||!Array.isArray(j.entries)||j.entries.length>10000||j.entries.some(x=>typeof x.original!=='string'||typeof x.derived!=='string'||x.original.length>12000||x.derived.length>15000))throw Error('Invalid journal');if(!confirm('Replace learning journal?'))return;journal=j;save();render()}catch(e){alert(e.message)}};$('hop').onclick=()=>{try{sessionStorage.setItem('nathan.brainstormer.handoff.v1',JSON.stringify({schema:'nathan.brainstormer.handoff.v1',title:'The Brainstormer',form:'academy',version:1}))}catch(e){}location.href='../../hop-in/chatbox/index.html'};render();
})();</script></body></html>