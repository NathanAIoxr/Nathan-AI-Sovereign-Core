-- Additive catalogue only. Does not activate any option or mutate existing app data.
-- Prepared but not executed. Inspect and back up the target database first.
BEGIN IMMEDIATE;
CREATE TABLE IF NOT EXISTS tabor_archetypes_63_v1 (
 archetype_number INTEGER PRIMARY KEY CHECK(archetype_number BETWEEN 1 AND 3),
 name TEXT NOT NULL, subtitle TEXT NOT NULL
);
CREATE TABLE IF NOT EXISTS tabor_operational_options_63_v1 (
 option_id TEXT PRIMARY KEY,
 ordinal INTEGER NOT NULL UNIQUE CHECK(ordinal BETWEEN 1 AND 63),
 archetype_number INTEGER NOT NULL REFERENCES tabor_archetypes_63_v1(archetype_number),
 title TEXT NOT NULL,
 source_description TEXT NOT NULL,
 source_status TEXT NOT NULL,
 implementation_note TEXT NOT NULL,
 enabled_by_default INTEGER NOT NULL DEFAULT 0 CHECK(enabled_by_default=0)
);
INSERT INTO tabor_archetypes_63_v1 VALUES (1,'The Sortilegium','The Array Field Field Casting') ON CONFLICT(archetype_number) DO UPDATE SET name=excluded.name,subtitle=excluded.subtitle;
INSERT INTO tabor_archetypes_63_v1 VALUES (2,'The Taxis-Kosmos','The Ordered Continuum Grid') ON CONFLICT(archetype_number) DO UPDATE SET name=excluded.name,subtitle=excluded.subtitle;
INSERT INTO tabor_archetypes_63_v1 VALUES (3,'The Tessellated Psychomachia','The Conceptual Battle Matrix') ON CONFLICT(archetype_number) DO UPDATE SET name=excluded.name,subtitle=excluded.subtitle;
INSERT INTO tabor_operational_options_63_v1
(option_id,ordinal,archetype_number,title,source_description,source_status,implementation_note,enabled_by_default)
VALUES
('tabor.option.001',1,1,'Hardware Silicon Layer','The physical transistor array where random electrical micro-surges are initialized, captured, and converted into discrete binary states.','user-supplied proposal; not independently verified','Concept retained; no new hardware or production feature implementation established by this entry.',0),
('tabor.option.002',2,1,'The Peano Successor Sequence','The step-by-step mathematical clock cycle that takes an empty field (0) and calculates its exact subsequent data state (S(0)).','user-supplied proposal; not independently verified','Peano successor is a mathematical operation; it does not specify CPU clock timing.',0),
('tabor.option.003',3,1,'Low-Level Firmware Driver','The underlying code layer that translates physical coordinate touches on a screen directly into unformatted array values.','user-supplied proposal; not independently verified','Concept retained; no new hardware or production feature implementation established by this entry.',0),
('tabor.option.004',4,1,'The 2D Matrix Array','A strict, two-dimensional memory layout (7 × 5) where every cell acts as an isolated data register.','user-supplied proposal; not independently verified','7 × 5 is this proposed configuration; existing boards retain their own dimensions.',0),
('tabor.option.005',5,1,'Unary State Tracker','The baseline tracking loop where an asset’s presence is evaluated as a simple 1-to-1 binary option (1 or 0).','user-supplied proposal; not independently verified','Concept retained; no new hardware or production feature implementation established by this entry.',0),
('tabor.option.006',6,1,'Micro-Kernel Scheduler','The OS traffic manager that prevents multi-threaded processing requests from colliding and overlapping inside the same cache block.','user-supplied proposal; not independently verified','Concept retained; no new hardware or production feature implementation established by this entry.',0),
('tabor.option.007',7,1,'The Maternal Bootloader','The initial structural sweep that sets up the absolute direction of data flow before any data cells are populated.','user-supplied proposal; not independently verified','Concept retained; no new hardware or production feature implementation established by this entry.',0),
('tabor.option.008',8,1,'Random Seed Generator','A cryptographically secure random number generator (PRNG) that feeds un-biased initial variations into the grid layout.','user-supplied proposal; not independently verified','A seeded gameplay PRNG is not automatically cryptographically secure or unbiased. Security entropy and replay seeds must be separate.',0),
('tabor.option.009',9,1,'The Oldowan Fracture Gate','A pure logic checkpoint evaluating whether a stone flake or data node is blunt (0) or sharp (1).','user-supplied proposal; not independently verified','Concept retained; no new hardware or production feature implementation established by this entry.',0),
('tabor.option.010',10,1,'The Positional Memory Registry','A database table where an asset’s identity is bound directly to its raw geographic slot on the hardware board.','user-supplied proposal; not independently verified','Stable asset IDs should remain independent of movable board coordinates.',0),
('tabor.option.011',11,1,'Dynamic Vector Array','A memory structure that expands and contracts its tracking variables dynamically based on signal density.','user-supplied proposal; not independently verified','Concept retained; no new hardware or production feature implementation established by this entry.',0),
('tabor.option.012',12,1,'Cache Line Coherency','The hardware validation layer that keeps parallel memory rows perfectly synchronized across multiple chip structures.','user-supplied proposal; not independently verified','Concept retained; no new hardware or production feature implementation established by this entry.',0),
('tabor.option.013',13,1,'High-Frequency I/O Channel','The data pipe responsible for processing millions of tiny coordinate swaps per second without memory leaks.','user-supplied proposal; not independently verified','Throughput and leak freedom are unverified performance claims.',0),
('tabor.option.014',14,1,'Linear Memory Addressing','Eliminating relational pointer lookups by binding files directly to permanent hardware coordinate locations.','user-supplied proposal; not independently verified','Virtual addresses and persistent file identities are not permanent physical hardware coordinates.',0),
('tabor.option.015',15,1,'The Primitive Tally Stick','A 1-to-1 physical storage loop modeled after the ancient baboon fibula notch system to track cyclical data.','user-supplied proposal; not independently verified','Concept retained; no new hardware or production feature implementation established by this entry.',0),
('tabor.option.016',16,1,'Structural Boundary Control','The safety protocol preventing active data elements from bleeding sideways into adjacent columns without an explicit trigger.','user-supplied proposal; not independently verified','Concept retained; no new hardware or production feature implementation established by this entry.',0),
('tabor.option.017',17,1,'The Bitmask Array','A compression layer that reads a sequence of tiles as a single binary number to reduce computing overhead.','user-supplied proposal; not independently verified','Concept retained; no new hardware or production feature implementation established by this entry.',0),
('tabor.option.018',18,1,'Localized State Machine','An independent code module running its own rule sets within a single grid column.','user-supplied proposal; not independently verified','Concept retained; no new hardware or production feature implementation established by this entry.',0),
('tabor.option.019',19,1,'Hardware Interrupt Vector','The physical CPU circuit that pauses standard operations the exact millisecond a user initiates an array swap.','user-supplied proposal; not independently verified','Touch input is handled through platform event APIs; no exact-millisecond hardware interrupt guarantee.',0),
('tabor.option.020',20,1,'The Molecular Vault Envelope','A secure data packet wrapping unformatted inputs before they pass through to the central validation engine.','user-supplied proposal; not independently verified','A wrapper alone does not establish encryption, authentication, or integrity.',0),
('tabor.option.021',21,1,'The Absolute Zero Reset','The automatic memory cleanup routine that wipes a cell back to a complete void state once its contents are cleared.','user-supplied proposal; not independently verified','Clearing a game cell is not secure erasure of physical memory.',0),
('tabor.option.022',22,2,'The Collinear Hox Pipeline','The master sequence law where genes or code instructions are physically arranged on a strand matching their execution space.','user-supplied proposal; not independently verified','Hox collinearity is an analogy, not proof of a universal execution law.',0),
('tabor.option.023',23,2,'The Morphogen Gradient Timer','An exponential decay formula that uses physical distance from a signaling source to calculate automated timing events.','user-supplied proposal; not independently verified','Spatial exponential falloff alone is not a timer.',0),
('tabor.option.024',24,2,'The V(D)J Recombination Compiler','A low-level splicing engine that makes clean geometric cuts across a fixed data line to assemble custom trait variations.','user-supplied proposal; not independently verified','V(D)J joins selected segments; contiguous slicing is not a biological model.',0),
('tabor.option.025',25,2,'The TABOR Rate-Limiter','The primary kernel ceiling that strictly forbids memory expansion beyond a defined population-inflation index.','user-supplied proposal; not independently verified','Preserved proposal only. Population/inflation ceilings are not adopted as a memory rule; preserve the distinct Nathan Tabor framework attribution.',0),
('tabor.option.026',26,2,'Balanced Phase Polarity','An electronic balance protocol where every incoming data surge is matched with an equal and opposite counterweight.','user-supplied proposal; not independently verified','Concept retained; no new hardware or production feature implementation established by this entry.',0),
('tabor.option.027',27,2,'The Chrono-Locked War Server','A live synchronous human-vs-human event platform running on parallel multi-axial communication channels.','user-supplied proposal; not independently verified','Earlier scheduled shared-device rehearsal exists; authenticated remote human-vs-human service remains unconnected.',0),
('tabor.option.028',28,2,'The Parliamentary Quorum Gate','A constitutional system rule requiring a formal voting check before allocating shared team capital.','user-supplied proposal; not independently verified','Earlier local quorum model exists; server authorization and durable voting are separate requirements.',0),
('tabor.option.029',29,2,'The TALE Co-Factor Lock','A secondary verification key that binds to a primary instruction to guarantee precision execution.','user-supplied proposal; not independently verified','TALE label is retained separately from the foundation called The Tale. A cofactor does not guarantee execution precision.',0),
('tabor.option.030',30,2,'The Time-Space Frame GPU Matrix','The rendering script that translates raw microsecond timeline registers into static coordinate pixels on a display screen.','user-supplied proposal; not independently verified','Concept retained; no new hardware or production feature implementation established by this entry.',0),
('tabor.option.031',31,2,'Paralogous Redundancy Arrays','Duplicated vertical tracks (Tracks A, B, C, D) providing instant failover backups for missing data cells.','user-supplied proposal; not independently verified','Duplication alone does not provide independent durable failover.',0),
('tabor.option.032',32,2,'Posterior Dominance Suppressor','An execution priority law where the final, highest-address index completely overrides preceding operations.','user-supplied proposal; not independently verified','Index priority is a proposed game rule and must not silently override unrelated operations.',0),
('tabor.option.033',33,2,'The Gap Partition Core','A macro-drive formatting tool that blocks out un-zoned memory into distinct operational territories.','user-supplied proposal; not independently verified','Concept retained; no new hardware or production feature implementation established by this entry.',0),
('tabor.option.034',34,2,'The Pair-Rule Stripe Ticker','The structural engine that slices continuous data blocks into alternating, periodic grid columns.','user-supplied proposal; not independently verified','Concept retained; no new hardware or production feature implementation established by this entry.',0),
('tabor.option.035',35,2,'The Urbilateria Base Kernel','The pristine, non-fragmented base code architecture from which all subsequent thread forks are derived.','user-supplied proposal; not independently verified','Concept retained; no new hardware or production feature implementation established by this entry.',0),
('tabor.option.036',36,2,'Whole-System Replication Wave','A macro-server command that mirrors entire system structures concurrently to deploy large-scale environments.','user-supplied proposal; not independently verified','Whole-system replication requires explicit versioning, consistency and deployment design.',0),
('tabor.option.037',37,2,'The Xlox Algorithmic Bifurcation Point','The chip junction where numeric math logic and spatial indexing part ways into independent sub-processors.','user-supplied proposal; not independently verified','Concept retained; no new hardware or production feature implementation established by this entry.',0),
('tabor.option.038',38,2,'The Yield-Frequency Clock Interrupt','The microsecond tuning speed where local transistor refreshes and global ticks align perfectly.','user-supplied proposal; not independently verified','Perfect timing alignment is not established.',0),
('tabor.option.039',39,2,'The Zerknüllt Protective Envelope','A secure data wrapper insulating active execution spaces from external network latency interference.','user-supplied proposal; not independently verified','A data envelope does not remove network latency.',0),
('tabor.option.040',40,2,'The Fushi Tarazu Array Splitter','An algorithmic modifier that slices continuous resource pools into individual, repeating data segments.','user-supplied proposal; not independently verified','Concept retained; no new hardware or production feature implementation established by this entry.',0),
('tabor.option.041',41,2,'Ectopic Expression Intercept','A hardware security sentinel blocking back-line instructions from loading into a primary head register slot.','user-supplied proposal; not independently verified','Concept retained; no new hardware or production feature implementation established by this entry.',0),
('tabor.option.042',42,2,'Global Control Enhancer Bus','A long-range motherboard lane that broadcasts master configuration states across all sub-channels instantly.','user-supplied proposal; not independently verified','Broadcast delivery is not instantaneous.',0),
('tabor.option.043',43,3,'The Relational Trophic Lattice','An ecological database setup mapping how raw resource energy climbs up to top-tier active power assets.','user-supplied proposal; not independently verified','Concept retained; no new hardware or production feature implementation established by this entry.',0),
('tabor.option.044',44,3,'The Microfluidic Pheromone Index','An externalized memory network that drops physical hydrocarbon signals on geography to route system traffic.','user-supplied proposal; not independently verified','Concept retained; no new hardware or production feature implementation established by this entry.',0),
('tabor.option.045',45,3,'The Hox Segment Index','The developmental code that turns physical coordinate addresses into functional, structural biological identities.','user-supplied proposal; not independently verified','Concept retained; no new hardware or production feature implementation established by this entry.',0),
('tabor.option.046',46,3,'The Baryonic Acoustic Oscillation Array','A cosmological spacing script that places map nodes across fixed geographic intervals derived from wave peaks.','user-supplied proposal; not independently verified','Configurable game spacing is a design choice; BAO does not prescribe exact individual galaxy positions.',0),
('tabor.option.047',47,3,'The Immutable Covenant Ledger','A distributed transaction tracker enforcing structural resource penalties when community laws are broken.','user-supplied proposal; not independently verified','Earlier ledger is local and mutable; distributed durability and immutability are not implemented. Penalties require explicit opt-in rules.',0),
('tabor.option.048',48,3,'The Taxpayer Rebate Dividend Pool','An automated out-flow loop distributing excess resources back to lower-tier system accounts.','user-supplied proposal; not independently verified','Preserve this label as a proposed game distribution pool, not an automatic tax-law feature or forced redistribution.',0),
('tabor.option.049',49,3,'The De-Brucing Voter Ballot UI','The user interface canvas requiring an alliance to pass a formal vote before expanding base capacity.','user-supplied proposal; not independently verified','Local voting is a prototype; no legal tax procedure is being implemented.',0),
('tabor.option.050',50,3,'The Associative Attractor State Matrix','A neural memory storage method where data inputs look up files by pattern similarity instead of index folder paths.','user-supplied proposal; not independently verified','Earlier cosine retrieval is not a trained attractor network.',0),
('tabor.option.051',51,3,'The Stochastic Cellular Automaton','A self-generating field engine where combat and growth events are decided purely by local cell neighbor counts.','user-supplied proposal; not independently verified','Conway B3/S23 evolution is deterministic; seeded initialization alone does not make transition rules stochastic.',0),
('tabor.option.052',52,3,'Intrinsically Disordered Thread Buffers','Flexible code variables that let distinct values condense under heavy combat workloads without breaking type bounds.','user-supplied proposal; not independently verified','Protein disorder is an analogy; no automatic type safety or workload behavior follows.',0),
('tabor.option.053',53,3,'Kinetic Shockwave Multiplier','A code rule where cell explosions crack adjacent tiles, spawning recursive cascading events.','user-supplied proposal; not independently verified','Earlier workshop uses bounded cracking; unrestricted recursive expansion is not implemented.',0),
('tabor.option.054',54,3,'Direct Environment Deconstruction','An integrated background engine where elemental cell plays alter the physical attributes of the map backdrop.','user-supplied proposal; not independently verified','Earlier workshop has simplified local terrain effects.',0),
('tabor.option.055',55,3,'Asynchronous Chronos Echoes','A PVP pipeline that records a player''s exact move times and sequences to replay them as a live ghost opponent.','user-supplied proposal; not independently verified','Recorded opponent moves are replay, not a live adaptive human opponent; service remains unconnected.',0),
('tabor.option.056',56,3,'The Spatial Infrastructure Pipeline','A village grid layout rule where placing buildings adjacent to raw mines shortens crafting times.','user-supplied proposal; not independently verified','Earlier local adjacency prototype exists.',0),
('tabor.option.057',57,3,'The Generative Weapon Synthesis Forge','A modular alchemy calculator shaping item stats based on the molecular weight of raw material inputs.','user-supplied proposal; not independently verified','Earlier fictional forge uses game statistics, not molecular physics.',0),
('tabor.option.058',58,3,'The Biometric Resonance Weather Sync','An API integration layer that adjusts app lighting and base production based on the user''s real-world local climate.','user-supplied proposal; not independently verified','No biometric/location/weather collection enabled. Manual ambience is available; any external data source requires consumer controls.',0),
('tabor.option.059',59,3,'The Deep-Learning Strategic Mentor','An on-device neural network familiar studying user play habits to calculate live combat survival odds.','user-supplied proposal; not independently verified','Earlier hints are heuristic; no trained on-device neural mentor or calibrated survival probabilities.',0),
('tabor.option.060',60,3,'Macro-Economic Trade Syndicates','A shared alliance market ledger letting high-level accounts drop surplus supplies into low-level player bins.','user-supplied proposal; not independently verified','Remote alliance market, secure transfers and server ledger remain unconnected.',0),
('tabor.option.061',61,3,'Living Card Degeneration Mechanics','A character tracking matrix monitoring usage frequency to apply mechanical exhaustion adjustments.','user-supplied proposal; not independently verified','Earlier local mastery/rest prototype exists; no paid recovery or forced refill waits.',0),
('tabor.option.062',62,3,'Galactic Synchronous Mega-Raids','A distributed server network pooling millions of player actions to battle a shared macro boss in real time.','user-supplied proposal; not independently verified','Production shared-world raid services remain unconnected.',0),
('tabor.option.063',63,3,'The High-Fidelity Hologram Frame','A top-down schematic dashboard detailing post-match vector metrics and alternative combination options.','user-supplied proposal; not independently verified','Earlier local replay prototype exists; a full alternative-path tactical analysis is not established.',0)
ON CONFLICT(option_id) DO UPDATE SET ordinal=excluded.ordinal,
 archetype_number=excluded.archetype_number,title=excluded.title,
 source_description=excluded.source_description,source_status=excluded.source_status,
 implementation_note=excluded.implementation_note;
COMMIT;
