export const REVIEW_STATES=['OPEN','IN_REVIEW','REVIEWED','DEFERRED'];
export function parseCatalog(text){
 const data=JSON.parse(text);
 if(!data||!Array.isArray(data.catalog)||!Array.isArray(data.b8)||!Array.isArray(data.tasks)||!data.summary)throw new Error('Choose owner-catalog.json from the organized archive.');
 if(data.catalog.length>100000||data.b8.length>100000)throw new Error('Catalog exceeds the supported 100,000-row limit.');
 for(const list of [data.catalog,data.b8])for(const r of list)if(!r||!/^JNT-LOC-\d+$/.test(r.local_shelf_id)||typeof r.title!=='string'||typeof r.class!=='string')throw new Error('Catalog row is missing its source identity, title or subject.');
 return data;
}
export function filterRecords(rows,{query='',subject='',status='',review=''},notes={}){
 const q=query.trim().toLocaleLowerCase();return rows.filter(r=>(!subject||r.class===subject)&&(!status||r.completion_status===status)&&(!review||(notes[r.local_shelf_id]?.state||'OPEN')===review)&&(!q||JSON.stringify(r).toLocaleLowerCase().includes(q)));
}
export function pageRows(rows,page,size=50){const pages=Math.max(1,Math.ceil(rows.length/size));const active=Math.max(0,Math.min(page,pages-1));return{items:rows.slice(active*size,(active+1)*size),page:active,pages,total:rows.length};}
export function validatedNotes(value){if(!value||typeof value!=='object')return{};const result=Object.create(null);for(const [key,n]of Object.entries(value))if(key.startsWith('JNT-LOC-')&&n&&REVIEW_STATES.includes(n.state)&&typeof n.note==='string')result[key]={state:n.state,note:n.note};return result;}
if(typeof document!=='undefined'){
 const $=id=>document.getElementById(id),create=(tag,text)=>{const n=document.createElement(tag);if(text!==undefined)n.textContent=text;return n;};let data=null,page=0,notes={};const storageKey='nathan-loc-b8-review-v1';try{notes=validatedNotes(JSON.parse(localStorage.getItem(storageKey)||'{}'));}catch{}
 const persist=()=>{try{localStorage.setItem(storageKey,JSON.stringify(notes));}catch{$('message').textContent='Review notes could not be saved in this browser. Export them before closing.';}};
 function overview(s){$('overview').replaceChildren();for(const [label,value]of [['Preserved source items',s.physical_source_items],['B / 8 crosslinks',s.b8_records_crosslinked],['Subject shelves',s.shelves.length]]){const box=create('div');box.className='metric';box.append(create('strong',Number(value).toLocaleString()),create('span',label));$('overview').append(box);} $('shelves').replaceChildren();$('class').replaceChildren(new Option('All subjects',''));for(const r of s.shelves){$('class').append(new Option(`${r.class} · ${r.class_name}`,r.class));const b=create('button');b.className='shelf';b.append(create('strong',r.class),create('span',r.class_name),create('small',`${r.physical_items.toLocaleString()} items · ${r.b8_crosslinked_records.toLocaleString()} B / 8 links`));b.onclick=()=>{$('class').value=r.class;page=0;render();};$('shelves').append(b);}}
 function taskList(tasks){$('tasks').replaceChildren();for(const t of tasks){const d=create('details');d.append(create('summary',`${t.priority} · ${t.issue}`),create('p',`State: ${t.status}`),create('p',`Done when: ${t.done_when}`));$('tasks').append(d);}}
 function rows(){return data?($('scope').value==='all'?data.catalog:data.b8):[];}
 function render(){const result=filterRecords(rows(),{query:$('q').value,subject:$('class').value,status:$('status').value,review:$('review').value},notes),p=pageRows(result,page);page=p.page;$('count').textContent=data?`${p.total.toLocaleString()} matching source records`:'Import your owner catalog to see individual records.';$('page').textContent=`${page+1} / ${p.pages}`;$('prev').disabled=page===0;$('next').disabled=page+1>=p.pages;$('rows').replaceChildren();for(const r of p.items){const tr=create('tr'),title=create('td'),subject=create('td'),status=create('td'),review=create('td');title.append(create('strong',r.title),create('small',r.local_shelf_id),create('small',r.original_relative_path));subject.append(create('strong',r.subclass||r.class),create('small',r.match_routes||r.b8_match_routes||''));status.append(create('strong',r.completion_status),create('small',`${r.work_priority}: ${r.next_action}`));const select=create('select');select.setAttribute('aria-label',`Review state for ${r.local_shelf_id}`);for(const s of REVIEW_STATES)select.append(new Option(s,s));select.value=notes[r.local_shelf_id]?.state||'OPEN';const note=create('textarea');note.setAttribute('aria-label',`Review note for ${r.local_shelf_id}`);note.value=notes[r.local_shelf_id]?.note||'';const save=()=>{notes[r.local_shelf_id]={state:select.value,note:note.value};persist();};select.onchange=()=>{save();if($('review').value)render();};note.onchange=save;review.append(select,note);tr.append(title,subject,status,review);$('rows').append(tr);}}
 for(const id of ['q','scope','class','status','review'])$(id).addEventListener(id==='q'?'input':'change',()=>{page=0;render();});$('prev').onclick=()=>{page--;render();};$('next').onclick=()=>{page++;render();};
 $('import').onchange=async event=>{const file=event.target.files[0];if(!file)return;try{if(file.size>100*1024*1024)throw new Error('Choose a catalog smaller than 100 MB.');const incoming=parseCatalog(await file.text());data=incoming;overview(data.summary);taskList(data.tasks);$('status').replaceChildren(new Option('All statuses',''));for(const s of [...new Set(data.catalog.map(r=>r.completion_status))].sort())$('status').append(new Option(s,s));$('message').textContent=`Loaded ${data.catalog.length.toLocaleString()} source entries. No catalog data was uploaded.`;$('export').disabled=false;page=0;render();}catch(e){$('message').textContent=e.message;}};
 $('export').onclick=()=>{const blob=new Blob([JSON.stringify({schema:'nathan-loc-b8-review-v1',exported_at:new Date().toISOString(),notes},null,2)],{type:'application/json'}),url=URL.createObjectURL(blob),a=create('a');a.href=url;a.download='Nathan_LOC_Review_Notes.json';a.click();setTimeout(()=>URL.revokeObjectURL(url),1000);};
 fetch('summary.json').then(r=>{if(!r.ok)throw new Error('Summary unavailable');return r.json();}).then(s=>{if(!data){overview(s);taskList([{priority:'P2',issue:'Review visual and cross-script candidate connections',status:'OPEN',done_when:'Retain or reject each connection with source evidence.'},{priority:'P2',issue:'Inspect image-only stacked circles and mirrored glyphs',status:'OPEN',done_when:'Record source image, region coordinates and reviewer disposition.'},{priority:'P2',issue:'Separate incidental numeric eights',status:'OPEN',done_when:'Distinguish date/version/ID matches from authored or visual connections.'},{priority:'P2',issue:'Reconcile newly discovered source pointers',status:'OPEN',done_when:'Resolve source identity, bytes and subject placement.'}]);}}).catch(()=>{});render();
}
