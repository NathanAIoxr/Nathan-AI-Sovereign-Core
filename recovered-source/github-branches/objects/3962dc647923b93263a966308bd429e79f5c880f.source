<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="description" content="Child protection resources and accountability · Nathan AI"><meta name="theme-color" content="#0b1220"><title>Protect Innocence | Nathan AI</title><style>
:root{font-family:system-ui,sans-serif;color-scheme:dark;--bg:#0b1220;--p:#17283b;--b:#e2ad76;--w:#f6f7fb;--m:#c6d4e4}*{box-sizing:border-box}body{background:radial-gradient(circle at 90% -15%,#1c4052,transparent 42%),var(--bg);color:var(--w);margin:0;line-height:1.5}main,header,footer{width:min(1100px,calc(100% - 36px));margin:auto}header{display:flex;align-items:center;justify-content:space-between;gap:12px;padding:22px 0;flex-wrap:wrap}nav{display:flex;gap:15px;flex-wrap:wrap}a{color:#b4e5ff}nav a{color:var(--m);text-decoration:none}a:focus-visible,button:focus-visible,input:focus-visible{outline:3px solid #81dee0;outline-offset:3px}h1{font-size:clamp(3rem,10vw,7rem);line-height:.92;letter-spacing:-.075em;margin:30px 0}h1 em{color:var(--b);font-style:normal}h2{font-size:clamp(1.7rem,4vw,2.8rem)}.hero{padding:60px 0 50px}.hero p{max-width:750px;font-size:1.2rem;color:var(--m)}.button{display:inline-block;background:var(--b);padding:13px 20px;border-radius:8px;color:#0b1220;font-weight:bold;text-decoration:none}.statement{border:1px solid #74583c;background:#1f2230;border-radius:17px;padding:clamp(16px,4vw,35px);margin-bottom:65px}.statement blockquote{margin:20px 0;font-size:clamp(1.4rem,4vw,2.7rem);font-weight:700;overflow-wrap:anywhere}.muted{color:var(--m)}section{margin-bottom:65px}.cards{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,290px),1fr));gap:15px}.card{background:var(--p);border:1px solid #435569;border-radius:13px;padding:23px;display:flex;flex-direction:column;min-height:218px}.card p{color:var(--m);margin:0 0 18px}.card a{margin-top:auto;font-weight:bold}.filters{display:flex;flex-wrap:wrap;gap:7px;margin:17px 0}button{border:1px solid #7d90a2;border-radius:30px;padding:9px 15px;background:transparent;color:white;cursor:pointer}button[aria-pressed=true]{background:#614831;border-color:var(--b)}input{background:#0d1d30;border:1px solid #8595a6;color:white;padding:12px;border-radius:8px;width:100%;max-width:420px;margin-bottom:18px}.warning{border:1px solid var(--b);padding:18px;border-radius:12px}.skip{position:absolute;left:-10000px}.skip:focus{left:8px;top:8px;background:#fff;color:#000}footer{border-top:1px solid #405468;padding:30px 0 55px;color:var(--m)}@media(prefers-reduced-motion:reduce){*{scroll-behavior:auto!important}}
</style></head><body><a class="skip" href="#main">Skip to content</a><header><strong>✳ NATHAN AI 🚀 · PROTECT INNOCENCE</strong><nav aria-label="Primary"><a href="#help">Official help</a><a href="#statement">Statement</a><a href="#accountability">Accountability</a><a href="../index.html">ONE</a></nav></header><main id="main">
<section class="hero"><small style="color:#84dddd;letter-spacing:.18em">PROTECT CHILDREN · SUPPORT SURVIVORS</small><h1>CHILDREN<br>DESERVE <em>SAFETY.</em></h1><p>Help people reach verified reporting channels, survivor services and official resources. Accountability depends on evidence, not rumors or group-wide accusations.</p><a class="button" href="#help">Find official help</a></section>
<section class="statement" id="statement"><small style="color:var(--b)">USER-AUTHORED EXPRESSION — EXACT WORDING PRESERVED</small><blockquote>AMEN = pedophiles = 💀☠️⚰️⚱️🪦🏜️</blockquote><p class="muted">This authored artistic statement is not evidence that saying “amen” makes a person an abuser. Allegations about abuse must be based on evidence and handled through appropriate channels.</p></section>
<section id="help"><h2>Get help from the source</h2><p class="muted">This website does not accept incident reports, case files, photographs or accusations. Contact the appropriate organization directly.</p><div class="filters" role="group" aria-label="Filter resources"><button aria-pressed="true" data-kind="all">All</button><button aria-pressed="false" data-kind="emergency">Immediate danger</button><button aria-pressed="false" data-kind="report">Report online abuse</button><button aria-pressed="false" data-kind="support">Support</button></div><label for="search">Search resources</label><br><input id="search" type="search" placeholder="Search support, reporting, exploitation"><div id="cards" class="cards" aria-live="polite"></div></section>
<section id="accountability"><h2>Every layer of accountability</h2><div class="cards"><article class="card"><h3>Evidence first</h3><p>No invented findings, unverified lists, or public accusations.</p></article><article class="card"><h3>Privacy first</h3><p>No uploads, tracking, cookies, case intake or sensitive-data databases.</p></article><article class="card"><h3>Human protection</h3><p>Children and survivors receive pathways to trained professionals and relevant official services.</p></article></div><p class="warning"><strong>Important:</strong> If someone is in immediate danger in the U.S., call 911. Do not upload or share child sexual abuse images. This project is not a law enforcement, government, hotline or charity service.</p></section></main>
<footer>PROTECT INNOCENCE × NATHAN AI · Static public information module · <a href="https://report.cybertip.org/">NCMEC CyberTipline</a> · <a href="https://rainn.org/help-and-healing/hotline/">RAINN</a></footer>
<script>
const records=[
{name:"Immediate danger",category:"emergency",description:"Call emergency services when someone is in immediate danger in the United States.",url:"tel:911",action:"Call 911"},
{name:"NCMEC CyberTipline",category:"report",description:"Report suspected online child sexual exploitation through the official reporting service.",url:"https://report.cybertip.org/",action:"Open official report portal"},
{name:"Childhelp Hotline",category:"support",description:"Child abuse and neglect support. Call or text 800-422-4453.",url:"https://www.childhelphotline.org/",action:"Open Childhelp"},
{name:"RAINN National Sexual Assault Hotline",category:"support",description:"Confidential sexual assault support. Phone 800-656-4673.",url:"https://rainn.org/help-and-healing/hotline/",action:"Open RAINN"},
{name:"NCMEC Take It Down",category:"support",description:"Help stop online sharing of intimate images taken before age 18.",url:"https://takeitdown.ncmec.org/",action:"Open Take It Down"}];
let kind='all';const list=document.querySelector('#cards'),search=document.querySelector('#search');
function render(){list.replaceChildren();const q=search.value.toLowerCase().trim();let matched=0;for(const r of records){if(kind!=='all'&&kind!==r.category)continue;if(q&&![r.name,r.description].join(' ').toLowerCase().includes(q))continue;matched++;const card=document.createElement('article');card.className='card';const h=document.createElement('h3');h.textContent=r.name;const p=document.createElement('p');p.textContent=r.description;const a=document.createElement('a');a.href=r.url;a.textContent=r.action;if(r.url.startsWith('https://')){a.target='_blank';a.rel='noopener noreferrer'}card.append(h,p,a);list.append(card);}if(!matched){const p=document.createElement('p');p.textContent='No matching resource. Choose All or clear the search.';list.append(p);}}
for(const b of document.querySelectorAll('[data-kind]'))b.addEventListener('click',()=>{kind=b.dataset.kind;for(const x of document.querySelectorAll('[data-kind]'))x.setAttribute('aria-pressed',String(x===b));render()});search.addEventListener('input',render);render();
</script></body></html>