/* Optional creative studio. No host game state or save writes. */
(function(){'use strict';if(window.TaborCreativeTools)return;
const studio="\u003c!doctype html>\n\u003chtml lang=\"en\">\u003chead>\u003cmeta charset=\"utf-8\">\u003cmeta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\u003ctitle>Tabor Graphics & Animation Workshop\u003c/title>\u003cstyle>:root{color-scheme:dark;--sky:#101b37;--panel:#25283a;--gold:#d8b96a;--text:#fff1ce;--earth:#a88161}*{box-sizing:border-box}body{margin:0;background:radial-gradient(ellipse at top,#29324b,var(--sky) 65%);color:var(--text);font:16px/1.5 system-ui,sans-serif}button,input,select,textarea{font:inherit}button,select,input[type=file]{min-height:44px}button,select{border:1px solid var(--gold);border-radius:8px;color:var(--text);background:linear-gradient(#4c4050,#242233);padding:8px 14px;cursor:pointer}button:hover{filter:brightness(1.2)}button:focus-visible,input:focus-visible,select:focus-visible,a:focus-visible{outline:3px solid #8fdfff;outline-offset:3px}button:disabled{opacity:.5;cursor:default}header{max-width:1320px;margin:auto;padding:34px 24px 16px}h1{font:clamp(30px,5vw,56px)/1.15 Georgia,serif;margin:8px 0}h2{font:25px Georgia,serif;color:var(--gold)}small,.muted{color:#d3c7b6}.eyebrow{letter-spacing:.16em;text-transform:uppercase;color:var(--gold);font-size:12px}.layout{max-width:1320px;display:grid;grid-template-columns:minmax(0,1.6fr) minmax(300px,1fr);gap:20px;margin:auto;padding:20px 24px}.panel{background:linear-gradient(140deg,#ffffff09,transparent),var(--panel);border:1px solid #ac8b58;border-radius:16px;padding:20px;box-shadow:0 12px 36px #0004,inset 0 0 0 4px #0002}.wide{grid-column:1/-1}.toolbar{display:flex;flex-wrap:wrap;gap:10px;align-items:center}.controls{display:grid;gap:14px}.controls label{display:flex;gap:10px;align-items:center;flex-wrap:wrap}input[type=range]{width:140px}canvas{width:100%;display:block;border-radius:10px;background:var(--sky)}.stage{position:relative;overflow:hidden;min-height:300px}.cutin{position:absolute;left:15%;top:12%;width:70%;pointer-events:none;display:grid;place-items:center;background:linear-gradient(110deg,#152444ec,#736035e8,#152444ec);border-block:2px solid var(--gold);padding:20px;opacity:0;font:24px Georgia,serif}.cutin svg{height:100px}.grid{display:grid;grid-template-columns:repeat(7,minmax(0,1fr));gap:4px;max-width:460px;margin:18px auto}.grid button{border:0;min-width:0;padding:0;background:none}.grid button svg{width:100%;height:auto;display:block}.asset-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(98px,1fr));gap:10px}.asset-grid button{display:grid;place-items:center;gap:6px;font-size:12px}.asset-grid svg{width:44px;height:44px}.notice{padding:12px;border-left:3px solid var(--gold);background:#0002}textarea{width:100%;min-height:160px;border:1px solid #a48e67;background:#101a2a;color:#f8eedb;padding:12px;border-radius:8px;font:13px/1.5 monospace}a{color:#91d8ff}output{font-variant-numeric:tabular-nums}#atlasPreview{max-height:420px;object-fit:contain;background:repeating-conic-gradient(#333 0 25%,#222 0 50%) 0/20px 20px}footer{padding:24px;text-align:center}.log{min-height:28px}details{margin:16px 0}summary{cursor:pointer;min-height:44px}#timelineControls{display:flex;gap:12px;flex-wrap:wrap}#atlasList{max-height:140px;overflow:auto}#atlasList li{overflow-wrap:anywhere}@media(max-width:850px){.layout{grid-template-columns:1fr;padding:12px}.panel{padding:14px}.wide{grid-column:auto}}@media(prefers-reduced-motion:reduce){*,*::before,*::after{scroll-behavior:auto!important;animation:none!important;transition:none!important}}\n\n\u003c/style>\u003c/head>\n\u003cbody>\u003cheader>\u003cdiv class=\"eyebrow\">Shared creative tools \u00b7 Nathan Tabor\u003c/div>\u003ch1>Light the journey.\u003c/h1>\u003cp>Build a visual language for every world. Preview Christmas scenes, elemental gems, animation cues, sound, and sprite atlases.\u003c/p>\u003cp class=\"notice\">Standalone tool preview. These controls do not change another app\u2019s settings, saves, or gameplay. The sky is decorative, with no claim of precise astronomical positioning.\u003c/p>\u003c/header>\n\u003cmain class=\"layout\">\n\u003csection class=\"panel\">\u003ch2>Scene & effects\u003c/h2>\u003cdiv class=\"stage\">\u003ccanvas id=\"scene\" width=\"900\" height=\"480\" aria-label=\"Decorative Bethlehem night village with lanterns and a star\">\u003c/canvas>\u003cdiv id=\"cutin\" class=\"cutin\" aria-hidden=\"true\">\u003cspan id=\"cutinIcon\">\u003c/span>\u003cspan id=\"cutinText\">Let your light shine\u003c/span>\u003c/div>\u003c/div>\n\u003cdiv class=\"toolbar\">\u003cbutton data-fx=\"star\">Star reveal\u003c/button>\u003cbutton data-fx=\"lantern\">Lantern glow\u003c/button>\u003cbutton data-fx=\"snow\">Snowfall\u003c/button>\u003cbutton data-fx=\"cutin\">Hero cut-in\u003c/button>\u003cbutton id=\"pause\">Pause scene\u003c/button>\u003c/div>\n\u003cdiv id=\"board\" class=\"grid\" role=\"group\" aria-label=\"Elemental visual effect audition board\">\u003c/div>\u003cp class=\"muted\">Tap a gem to audition its effect. This board is an animation surface, not a scored match.\u003c/p>\u003c/section>\n\u003csection class=\"panel\">\u003ch2>Consumer controls\u003c/h2>\u003cdiv class=\"controls\">\n\u003clabel>World palette \u003cselect id=\"theme\">\u003coption value=\"bethlehem\">Bethlehem \u00b7 midnight & gold\u003c/option>\u003coption value=\"woodland\">Woodland \u00b7 moss & timber\u003c/option>\u003coption value=\"forge\">Forge \u00b7 plum & copper\u003c/option>\u003c/select>\u003c/label>\n\u003clabel>\u003cinput type=\"checkbox\" id=\"motion\"> Allow motion\u003c/label>\u003clabel>\u003cinput type=\"checkbox\" id=\"particles\"> Particle effects\u003c/label>\u003clabel>\u003cinput type=\"checkbox\" id=\"shake\"> Small impact movement\u003c/label>\u003clabel>\u003cinput type=\"checkbox\" id=\"sound\"> Sound \u00b7 starts after a tap\u003c/label>\u003clabel>Volume \u003cinput type=\"range\" id=\"volume\" min=\"0\" max=\"1\" step=\".05\" value=\".25\">\u003c/label>\u003clabel>Particle budget \u003cinput type=\"range\" id=\"budget\" min=\"0\" max=\"240\" step=\"12\" value=\"96\">\u003coutput id=\"budgetValue\">96\u003c/output>\u003c/label>\n\u003cbutton id=\"exportSettings\">Export settings JSON\u003c/button>\u003clabel>Import settings \u003cinput id=\"importSettings\" type=\"file\" accept=\".json,application/json\">\u003c/label>\u003cbutton id=\"reset\">Reset workshop controls\u003c/button>\u003c/div>\u003cp class=\"notice\">Motion and sound begin off. System reduced-motion preference always takes priority. Settings belong only to this workshop.\u003c/p>\u003cp id=\"status\" class=\"log\" role=\"status\" aria-live=\"polite\">Ready.\u003c/p>\u003c/section>\n\u003csection class=\"panel wide\">\u003ch2>Icon & gem library\u003c/h2>\u003cp>26 scalable symbols and five labeled elemental shields. Choose an asset to download its SVG.\u003c/p>\u003cdiv id=\"assets\" class=\"asset-grid\">\u003c/div>\u003cbutton id=\"exportSVG\">Export SVG contact sheet\u003c/button>\u003c/section>\n\u003csection class=\"panel\">\u003ch2>Animation director\u003c/h2>\u003cdiv id=\"timelineControls\">\u003clabel>Cue \u003cselect id=\"preset\">\u003coption>idle\u003c/option>\u003coption>cutin\u003c/option>\u003coption>impact\u003c/option>\u003coption>reveal\u003c/option>\u003c/select>\u003c/label>\u003clabel>Duration \u003cinput type=\"number\" id=\"duration\" min=\"200\" max=\"10000\" value=\"1200\" step=\"100\"> ms\u003c/label>\u003cbutton id=\"playCue\">Play cue\u003c/button>\u003cbutton id=\"applyCue\">Apply edited keyframes\u003c/button>\u003cbutton id=\"exportCue\">Export cue\u003c/button>\u003c/div>\u003clabel>Timeline position \u003cinput type=\"range\" id=\"scrub\" min=\"0\" max=\"1\" step=\".01\" value=\"0\">\u003c/label>\u003cp>Preview the same keyframes interactively, then export them for an app adapter.\u003c/p>\u003ctextarea id=\"cueJSON\" aria-label=\"Animation keyframes JSON\">\u003c/textarea>\u003c/section>\n\u003csection class=\"panel\">\u003ch2>Sprite atlas packer\u003c/h2>\u003cp>Pack local PNG artwork into a single image with a companion frame map. Up to 32 files, 1 MiB each, 32 MiB total, 2048 \u00d7 2048 per image. Combined artwork is capped at 16 million pixels. Output is capped at 4096 \u00d7 4096.\u003c/p>\u003clabel>PNG artwork \u003cinput id=\"sprites\" type=\"file\" accept=\"image/png\" multiple>\u003c/label>\u003clabel>Atlas width \u003cselect id=\"atlasWidth\">\u003coption>1024\u003c/option>\u003coption selected>2048\u003c/option>\u003coption>4096\u003c/option>\u003c/select>\u003c/label>\u003cdiv class=\"toolbar\">\u003cbutton id=\"pack\">Pack images\u003c/button>\u003cbutton id=\"downloadPNG\" disabled>Export PNG\u003c/button>\u003cbutton id=\"downloadMap\" disabled>Export frame map\u003c/button>\u003c/div>\u003cul id=\"atlasList\">\u003c/ul>\u003ccanvas id=\"atlasPreview\" width=\"1\" height=\"1\" aria-label=\"Packed sprite atlas preview\">\u003c/canvas>\u003cp id=\"atlasStatus\" role=\"status\">\u003c/p>\u003c/section>\n\u003csection class=\"panel wide\">\u003ch2>World artwork\u003c/h2>\u003cp>Vector scene and building tiers. Download SVG artwork to adapt it to each app\u2019s palette.\u003c/p>\u003cdiv class=\"asset-grid\">\u003ca href=\"data:image/svg+xml;base64,\" download>\u003cimg loading=\"lazy\" src=\"data:image/svg+xml;base64,\" alt=\"bethlehem night\" width=\"128\" height=\"128\" style=\"max-width:100%;height:auto\">\u003cspan>bethlehem-night\u003c/span>\u003c/a>\u003ca href=\"data:image/svg+xml;base64,\" download>\u003cimg loading=\"lazy\" src=\"data:image/svg+xml;base64,\" alt=\"camp tier 1\" width=\"128\" height=\"128\" style=\"max-width:100%;height:auto\">\u003cspan>camp-tier-1\u003c/span>\u003c/a>\u003ca href=\"data:image/svg+xml;base64,\" download>\u003cimg loading=\"lazy\" src=\"data:image/svg+xml;base64,\" alt=\"camp tier 2\" width=\"128\" height=\"128\" style=\"max-width:100%;height:auto\">\u003cspan>camp-tier-2\u003c/span>\u003c/a>\u003ca href=\"data:image/svg+xml;base64,\" download>\u003cimg loading=\"lazy\" src=\"data:image/svg+xml;base64,\" alt=\"camp tier 3\" width=\"128\" height=\"128\" style=\"max-width:100%;height:auto\">\u003cspan>camp-tier-3\u003c/span>\u003c/a>\u003ca href=\"data:image/svg+xml;base64,\" download>\u003cimg loading=\"lazy\" src=\"data:image/svg+xml;base64,\" alt=\"forge tier 1\" width=\"128\" height=\"128\" style=\"max-width:100%;height:auto\">\u003cspan>forge-tier-1\u003c/span>\u003c/a>\u003ca href=\"data:image/svg+xml;base64,\" download>\u003cimg loading=\"lazy\" src=\"data:image/svg+xml;base64,\" alt=\"forge tier 2\" width=\"128\" height=\"128\" style=\"max-width:100%;height:auto\">\u003cspan>forge-tier-2\u003c/span>\u003c/a>\u003ca href=\"data:image/svg+xml;base64,\" download>\u003cimg loading=\"lazy\" src=\"data:image/svg+xml;base64,\" alt=\"forge tier 3\" width=\"128\" height=\"128\" style=\"max-width:100%;height:auto\">\u003cspan>forge-tier-3\u003c/span>\u003c/a>\u003ca href=\"data:image/svg+xml;base64,\" download>\u003cimg loading=\"lazy\" src=\"data:image/svg+xml;base64,\" alt=\"observatory tier 1\" width=\"128\" height=\"128\" style=\"max-width:100%;height:auto\">\u003cspan>observatory-tier-1\u003c/span>\u003c/a>\u003ca href=\"data:image/svg+xml;base64,\" download>\u003cimg loading=\"lazy\" src=\"data:image/svg+xml;base64,\" alt=\"observatory tier 2\" width=\"128\" height=\"128\" style=\"max-width:100%;height:auto\">\u003cspan>observatory-tier-2\u003c/span>\u003c/a>\u003ca href=\"data:image/svg+xml;base64,\" download>\u003cimg loading=\"lazy\" src=\"data:image/svg+xml;base64,\" alt=\"observatory tier 3\" width=\"128\" height=\"128\" style=\"max-width:100%;height:auto\">\u003cspan>observatory-tier-3\u003c/span>\u003c/a>\u003ca href=\"data:image/svg+xml;base64,\" download>\u003cimg loading=\"lazy\" src=\"data:image/svg+xml;base64,\" alt=\"hall tier 1\" width=\"128\" height=\"128\" style=\"max-width:100%;height:auto\">\u003cspan>hall-tier-1\u003c/span>\u003c/a>\u003ca href=\"data:image/svg+xml;base64,\" download>\u003cimg loading=\"lazy\" src=\"data:image/svg+xml;base64,\" alt=\"hall tier 2\" width=\"128\" height=\"128\" style=\"max-width:100%;height:auto\">\u003cspan>hall-tier-2\u003c/span>\u003c/a>\u003ca href=\"data:image/svg+xml;base64,\" download>\u003cimg loading=\"lazy\" src=\"data:image/svg+xml;base64,\" alt=\"hall tier 3\" width=\"128\" height=\"128\" style=\"max-width:100%;height:auto\">\u003cspan>hall-tier-3\u003c/span>\u003c/a>\u003c/div>\u003c/section>\u003csection class=\"panel wide\">\u003ch2>The nine foundations\u003c/h2>\u003cdiv class=\"asset-grid\">\u003carticle>\u003cimg src=\"data:image/svg+xml;base64,\" width=\"50\" height=\"50\" alt=\"\">\u003ch3>The Egg\u003c/h3>\u003cp>Origin and a protected starting state\u003c/p>\u003c/article>\u003carticle>\u003cimg src=\"data:image/svg+xml;base64,\" width=\"50\" height=\"50\" alt=\"\">\u003ch3>The Gene\u003c/h3>\u003cp>Instructions, inheritance, and variation\u003c/p>\u003c/article>\u003carticle>\u003cimg src=\"data:image/svg+xml;base64,\" width=\"50\" height=\"50\" alt=\"\">\u003ch3>The Hox\u003c/h3>\u003cp>Position, sequence, and organization\u003c/p>\u003c/article>\u003carticle>\u003cimg src=\"data:image/svg+xml;base64,\" width=\"50\" height=\"50\" alt=\"\">\u003ch3>The Rule\u003c/h3>\u003cp>Constraints, permissions, and consequences\u003c/p>\u003c/article>\u003carticle>\u003cimg src=\"data:image/svg+xml;base64,\" width=\"50\" height=\"50\" alt=\"\">\u003ch3>The Duality\u003c/h3>\u003cp>Partnership and complementary roles\u003c/p>\u003c/article>\u003carticle>\u003cimg src=\"data:image/svg+xml;base64,\" width=\"50\" height=\"50\" alt=\"\">\u003ch3>The Polarity\u003c/h3>\u003cp>Direction and orientation\u003c/p>\u003c/article>\u003carticle>\u003cimg src=\"data:image/svg+xml;base64,\" width=\"50\" height=\"50\" alt=\"\">\u003ch3>The Tale\u003c/h3>\u003cp>An individual account of experience\u003c/p>\u003c/article>\u003carticle>\u003cimg src=\"data:image/svg+xml;base64,\" width=\"50\" height=\"50\" alt=\"\">\u003ch3>The Story\u003c/h3>\u003cp>Connected accounts and shared context\u003c/p>\u003c/article>\u003carticle>\u003cimg src=\"data:image/svg+xml;base64,\" width=\"50\" height=\"50\" alt=\"\">\u003ch3>The Truth\u003c/h3>\u003cp>Evidence, uncertainty, and correction\u003c/p>\u003c/article>\u003c/div>\u003c/section>\u003csection class=\"panel wide\">\u003ch2>The 63-option catalogue\u003c/h2>\u003cp>Search the three archetypes and review original proposals alongside separate implementation notes. Selecting a record does not enable a runtime feature.\u003c/p>\u003clabel>Search \u003cinput type=\"search\" id=\"catalogSearch\" placeholder=\"Name, archetype, or description\">\u003c/label>\u003clabel>Archetype \u003cselect id=\"catalogGroup\">\u003coption value=\"\">All three\u003c/option>\u003coption value=\"1\">The Sortilegium\u003c/option>\u003coption value=\"2\">The Taxis-Kosmos\u003c/option>\u003coption value=\"3\">The Tessellated Psychomachia\u003c/option>\u003c/select>\u003c/label>\u003cp id=\"catalogCount\" role=\"status\">\u003c/p>\u003cdiv id=\"catalogResults\">\u003c/div>\u003c/section>\u003c/main>\u003cfooter>Free creative tools \u00b7 no paid tokens \u00b7 all file processing stays in this page \u00b7 no external fonts, trackers, or asset requests\u003c/footer>\n\u003cscript>/* Shared graphics primitives for Nathan Tabor's app framework. */\n(function(root,factory){if(typeof module==='object'&&module.exports)module.exports=factory();else root.TaborGraphics=factory();})(typeof globalThis!=='undefined'?globalThis:this,function(){\n'use strict';\nconst themes={bethlehem:{sky:'#101b37',panel:'#25283a',gold:'#d8b96a',text:'#fff1ce',earth:'#a88161'},woodland:{sky:'#102820',panel:'#283d31',gold:'#c6b777',text:'#f5f0d2',earth:'#987351'},forge:{sky:'#21182b',panel:'#342637',gold:'#cfaa75',text:'#fff0d8',earth:'#9c7974'}};\nconst elements=[{id:'fire',label:'Fire',color:'#e75947',mark:'M25 9Q43 28 36 39Q27 50 17 39Q10 29 21 19L21 30Q31 24 25 9Z'},{id:'nature',label:'Nature',color:'#65ba75',mark:'M14 39Q8 13 39 12Q43 40 14 39ZM14 39L33 20'},{id:'ice',label:'Ice',color:'#78c9f2',mark:'M25 10V40M12 17L38 33M12 33L38 17M20 14L25 19L30 14M20 36L25 31L30 36'},{id:'holy',label:'Holy',color:'#f1d65b',mark:'M25 9L29 21L41 25L29 29L25 42L21 29L9 25L21 21Z'},{id:'dark',label:'Dark',color:'#b18ae5',mark:'M31 11A16 16 0 1 0 39 35A18 18 0 0 1 31 11Z'}];\nconst glyphs={\negg:'M25 7C17 7 10 25 10 32A15 15 0 0 0 40 32C40 25 33 7 25 7Z',\ngene:'M15 7C40 17 10 33 35 43M35 7C10 17 40 33 15 43M19 12H31M19 21H31M19 29H31M19 38H31',\nhox:'M10 10H40V40H10ZM10 20H40M10 30H40M20 10V40M30 10V40',\nrule:'M13 8H37V43H13ZM19 17H31M19 25H31M19 33H27',\nduality:'M24 10A16 16 0 1 0 24 40M26 10A16 16 0 1 1 26 40M20 25H30',\npolarity:'M25 6V44M6 25H44M20 12L25 6L30 12M20 38L25 44L30 38',\ntale:'M11 10H35V35H11ZM16 17H30M16 23H30M16 29H25M18 40H41V17',\nstory:'M25 13Q13 5 6 13V40Q16 34 25 41Q34 34 44 40V13Q36 5 25 13V41',\ntruth:'M9 25L20 36L42 12M10 9H23M9 9V19',\nstar:'M25 5L30 20L45 25L30 30L25 45L20 30L5 25L20 20Z',\nlantern:'M18 15V10Q25 2 32 10V15M14 15H36L33 41H17ZM18 21H32M25 21V35',\ncompass:'M25 4A21 21 0 1 0 25 46A21 21 0 1 0 25 4M31 18L28 29L17 33L21 21Z',\ngift:'M7 21H43V30H7ZM12 30V44H38V30M25 21V44M25 21C4 17 14 3 25 21C46 17 36 3 25 21Z',\nscroll:'M12 9H39Q46 9 41 17H17V37Q17 45 8 41Q4 36 11 34M17 41H38V17',\nshield:'M25 5L42 13V28Q39 41 25 46Q11 41 8 28V13ZM16 25L23 32L35 18',\nforge:'M6 21H44L35 29H27V37H37V43H13V37H23V29H14ZM15 12L29 6L35 13L21 19Z',\nhouse:'M5 25L25 7L45 25M11 22V44H39V22M21 44V30H30V44',\nvote:'M7 25H43V44H7ZM17 25L13 12L31 6L36 23M20 15L25 19L30 11M18 32H32',\nreplay:'M11 16A19 19 0 1 1 8 31M11 6V18H23M22 17L34 25L22 33Z',\nsound:'M6 19H15L26 9V41L15 31H6ZM33 17Q42 25 33 33M39 10Q53 25 39 40',\npause:'M14 9H21V41H14ZM29 9H36V41H29Z',\nplay:'M14 7L42 25L14 43Z',\nsnow:'M25 4V46M7 14L43 36M7 36L43 14M17 10L25 17L33 10M17 40L25 33L33 40',\nmoon:'M32 6A21 21 0 1 0 44 35A23 23 0 0 1 32 6Z',\nsettings:'M25 15A10 10 0 1 0 25 35A10 10 0 1 0 25 15M25 5V12M25 38V45M5 25H12M38 25H45M11 11L16 16M34 34L39 39M11 39L16 34M34 16L39 11',\npeople:'M17 9A7 7 0 1 0 17 23A7 7 0 1 0 17 9M33 12A6 6 0 1 0 33 24A6 6 0 1 0 33 12M4 43V35Q17 20 29 35V43M30 30Q44 29 46 39V43'\n};\nfunction finite(n,name,min,max){if(typeof n!=='number'||!Number.isFinite(n)||n\u003cmin||n>max)throw new RangeError(name);return n;}\nfunction escape(s){return String(s).replace(/[&\u003c>\"']/g,c=>({'&':'&amp;','\u003c':'&lt;','>':'&gt;','\"':'&quot;',\"'\":'&apos;'}[c]));}\nfunction icon(id,size=50,color='#d8b96a'){if(!glyphs[id])throw new RangeError('Unknown icon');finite(size,'size',8,2048);if(!/^#[0-9a-f]{6}$/i.test(color))throw new RangeError('color');return '\u003csvg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 50 50\" width=\"'+size+'\" height=\"'+size+'\" role=\"img\" aria-label=\"'+escape(id)+'\">\u003cpath d=\"'+glyphs[id]+'\" fill=\"none\" stroke=\"'+color+'\" stroke-width=\"2.5\" stroke-linejoin=\"round\" stroke-linecap=\"round\"/>\u003c/svg>';}\nfunction gem(id,size=64){const e=elements.find(x=>x.id===id);if(!e)throw new RangeError('Unknown element');finite(size,'size',8,2048);return '\u003csvg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 50 56\" width=\"'+size+'\" height=\"'+size+'\" role=\"img\" aria-label=\"'+e.label+'\">\u003cpath d=\"M25 2L46 13L42 39L25 54L8 39L4 13Z\" fill=\"'+e.color+'\" stroke=\"#e7c681\" stroke-width=\"2\"/>\u003cpath d=\"M25 2L25 49L8 39L4 13Z\" fill=\"#000\" opacity=\".18\"/>\u003cpath d=\"M4 13L25 19L46 13L25 2Z\" fill=\"#fff\" opacity=\".3\"/>\u003cpath d=\"'+e.mark+'\" fill=\"none\" stroke=\"#14202c\" stroke-width=\"2.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/>\u003c/svg>';}\nfunction pack(rects,maxWidth=2048,padding=2){finite(maxWidth,'width',16,4096);finite(padding,'padding',0,32);if(!Number.isInteger(maxWidth)||!Number.isInteger(padding)||!Array.isArray(rects)||rects.length>128)throw new RangeError('packer input');const ids=new Set();let x=padding,y=padding,row=0;const frames=[];for(const r of rects){if(typeof r.id!=='string'||!r.id||ids.has(r.id))throw new RangeError('unique id');ids.add(r.id);finite(r.width,'frame width',1,4096);finite(r.height,'frame height',1,4096);if(!Number.isInteger(r.width)||!Number.isInteger(r.height)||r.width+2*padding>maxWidth)throw new RangeError('frame size');if(x+r.width+padding>maxWidth){x=padding;y+=row+padding;row=0;}if(y+r.height+padding>4096)throw new RangeError('atlas exceeds 4096');frames.push({id:r.id,x,y,width:r.width,height:r.height});x+=r.width+padding;row=Math.max(row,r.height);}return {width:maxWidth,height:rects.length?y+row+padding:1,padding,frames};}\nconst presets={\nidle:[{t:0,x:0,y:0,scale:1,opacity:1},{t:.5,x:0,y:-3,scale:1.01,opacity:1},{t:1,x:0,y:0,scale:1,opacity:1}],\ncutin:[{t:0,x:-200,y:0,scale:.9,opacity:0},{t:.2,x:0,y:0,scale:1.03,opacity:1},{t:.7,x:0,y:0,scale:1,opacity:1},{t:1,x:160,y:0,scale:1,opacity:0}],\nimpact:[{t:0,x:0,y:0,scale:1,opacity:1},{t:.18,x:-5,y:0,scale:1.08,opacity:1},{t:.4,x:4,y:0,scale:.96,opacity:1},{t:1,x:0,y:0,scale:1,opacity:1}],\nreveal:[{t:0,x:0,y:12,scale:.85,opacity:0},{t:.6,x:0,y:0,scale:1.03,opacity:1},{t:1,x:0,y:0,scale:1,opacity:1}]\n};\nfunction sample(frames,t,reduced=false){finite(t,'time',0,1);if(!Array.isArray(frames)||frames.length\u003c2||frames.length>256)throw new RangeError('frames');for(let i=0;i\u003cframes.length;i++){const f=frames[i];finite(f.t,'keyframe time',0,1);if(i&&f.t\u003c=frames[i-1].t)throw new RangeError('keyframe order');finite(f.x,'x',-4096,4096);finite(f.y,'y',-4096,4096);finite(f.scale,'scale',.01,10);finite(f.opacity,'opacity',0,1);}if(frames[0].t!==0||frames[frames.length-1].t!==1)throw new RangeError('endpoint times');if(reduced)return {x:0,y:0,scale:1,opacity:1};const i=Math.max(0,frames.findIndex(f=>f.t>=t)-1),a=frames[i],b=frames[i+1],u=(t-a.t)/(b.t-a.t),s=u*u*(3-2*u);return Object.fromEntries(['x','y','scale','opacity'].map(k=>[k,a[k]+(b[k]-a[k])*s]));}\nfunction rng(seed){let s=seed>>>0||1;return()=>{s^=s\u003c\u003c13;s^=s>>>17;s^=s\u003c\u003c5;return(s>>>0)/4294967296;};}\nclass Particles{\nconstructor(cap=120,seed=7){finite(cap,'capacity',0,512);if(!Number.isInteger(cap))throw new RangeError('capacity');this.cap=cap;this.random=rng(seed);this.items=[];}\nburst(x,y,count=24,color='#f1d65b'){finite(x,'x',-4096,8192);finite(y,'y',-4096,8192);finite(count,'count',0,512);if(!Number.isInteger(count)||!/^#[0-9a-f]{6}$/i.test(color))throw new RangeError('burst');for(let i=0;i\u003ccount&&this.items.length\u003cthis.cap;i++){const a=this.random()*Math.PI*2,v=30+this.random()*130;this.items.push({x,y,vx:Math.cos(a)*v,vy:Math.sin(a)*v,life:.3+this.random()*.7,color});}return this.items.length;}\nstep(dt){finite(dt,'delta',0,.1);for(const p of this.items){p.life-=dt;p.x+=p.vx*dt;p.y+=p.vy*dt;p.vy+=70*dt;}this.items=this.items.filter(p=>p.life>0);return this.items;}\nclear(){this.items=[];}\n}\nreturn {themes,elements,glyphs,icon,gem,pack,presets,sample,rng,Particles};\n});\n\n\u003c/script>\u003cscript>/* Standalone graphics workshop; no host app save keys are touched. */\n(function(){\n'use strict';\nconst G=TaborGraphics,$=id=>document.getElementById(id),signal=matchMedia('(prefers-reduced-motion: reduce)');\nlet settings={theme:'bethlehem',motion:false,particles:true,shake:false,sound:false,volume:.25,budget:96};\nlet dirty=true;\nlet pool=new G.Particles(settings.budget,7),paused=false,last=0,clock=0,cue=null,audio=null,atlasMap=null,packBusy=false;\nconst canvas=$('scene'),ctx=canvas.getContext('2d'),stars=G.rng(171),starPoints=Array.from({length:80},()=>[stars()*900,stars()*290,stars()]);\nconst reduced=()=>signal.matches||!settings.motion;\nfunction status(s){$('status').textContent=s;}\nfunction save(){try{localStorage.setItem('tabor.graphics-workshop.v1',JSON.stringify(settings));}catch{status('Storage unavailable; controls still work for this visit.');}}\nfunction sanitize(o){if(!o||typeof o!=='object'||Array.isArray(o))throw Error('Expected settings object');const next={...settings};if(o.theme!==undefined){if(!Object.prototype.hasOwnProperty.call(G.themes,o.theme))throw Error('Unknown theme');next.theme=o.theme;}for(const k of ['motion','particles','shake','sound'])if(o[k]!==undefined){if(typeof o[k]!=='boolean')throw Error('Invalid '+k);next[k]=o[k];}for(const [k,min,max]of [['volume',0,1],['budget',0,240]])if(o[k]!==undefined){if(typeof o[k]!=='number'||!Number.isFinite(o[k])||o[k]\u003cmin||o[k]>max||(k==='budget'&&!Number.isInteger(o[k])))throw Error('Invalid '+k);next[k]=o[k];}return next;}\nfunction sync(){dirty=true;for(const[k,v]of Object.entries(settings)){if(!$(k))continue;if(typeof v==='boolean')$(k).checked=v;else $(k).value=v;}for(const[k,v]of Object.entries(G.themes[settings.theme]))document.documentElement.style.setProperty('--'+k,v);$('budgetValue').textContent=settings.budget;pool=new G.Particles(settings.budget,7);if(reduced()){cue=null;$('cutin').style.opacity=0;}if(!settings.sound&&audio)audio.suspend().catch(()=>{});save();}\ntry{const raw=localStorage.getItem('tabor.graphics-workshop.v1');if(raw){settings=sanitize(JSON.parse(raw));settings.sound=false;}}catch{}\nfunction download(name,data,type){const blob=data instanceof Blob?data:new Blob([data],{type}),url=URL.createObjectURL(blob),a=document.createElement('a');a.href=url;a.download=name;document.body.append(a);a.click();a.remove();setTimeout(()=>URL.revokeObjectURL(url),2000);}\nasync function tone(high=false){if(!settings.sound||settings.volume===0)return;try{if(!audio)audio=new(window.AudioContext||window.webkitAudioContext)();await audio.resume();const t=audio.currentTime;[high?784:523,high?1175:659].forEach((f,i)=>{const o=audio.createOscillator(),v=audio.createGain();o.type='sine';o.frequency.value=f;v.gain.setValueAtTime(0,t);v.gain.linearRampToValueAtTime(settings.volume*.1,t+.015+i*.03);v.gain.exponentialRampToValueAtTime(.0001,t+.5);o.connect(v).connect(audio.destination);o.start(t);o.stop(t+.52);});}catch{settings.sound=false;sync();status('Sound unavailable on this device.');}}\nfunction emit(x,y,color,count=24){if(!reduced()&&settings.particles)pool.burst(x,y,count,color);}\nfunction cueJSON(){const name=$('preset').value;$('cueJSON').value=JSON.stringify({version:1,preset:name,durationMs:Number($('duration').value),keyframes:G.presets[name]},null,2);}\nfunction showCue(t){const s=G.sample(G.presets[$('preset').value],t,reduced()),el=$('cutin');el.style.transform='translate('+s.x+'px,'+s.y+'px) scale('+s.scale+')';el.style.opacity=s.opacity;}\nfunction trigger(type){if(type==='cutin'){const d=Number($('duration').value);if(!Number.isFinite(d)||d\u003c200||d>10000){status('Duration must be between 200 and 10000 ms.');return;}$('preset').value='cutin';cueJSON();if(reduced()){showCue(1);setTimeout(()=>$('cutin').style.opacity=0,1200);}else cue={start:performance.now(),duration:d};}else if(type==='star')emit(670,95,'#f1d65b',60);else if(type==='snow'){for(let i=0;i\u003c5;i++)emit(i*180+90,80,'#d4ebff',12);}else emit(255,330,'#f4bd63',36);tone(type==='star');status(type+' cue auditioned.');}\nfunction draw(){\nconst t=G.themes[settings.theme],gradient=ctx.createLinearGradient(0,0,0,480);gradient.addColorStop(0,t.sky);gradient.addColorStop(1,'#695449');ctx.fillStyle=gradient;ctx.fillRect(0,0,900,480);\nfor(const[x,y,r]of starPoints){ctx.globalAlpha=.55+r*.45;ctx.fillStyle='#fff1ce';ctx.beginPath();ctx.arc(x,y,1+r,0,7);ctx.fill();}ctx.globalAlpha=1;\nctx.fillStyle='#26333e';ctx.beginPath();ctx.moveTo(0,320);ctx.lineTo(160,220);ctx.lineTo(330,330);ctx.lineTo(560,210);ctx.lineTo(760,300);ctx.lineTo(900,240);ctx.lineTo(900,480);ctx.lineTo(0,480);ctx.fill();\nctx.fillStyle=t.earth;for(let i=0;i\u003c11;i++){let x=i*87-20,h=45+(i*23)%70;ctx.fillRect(x,375-h,80,h+80);ctx.fillStyle='#554746';ctx.fillRect(x-3,371-h,86,8);ctx.fillStyle='#e8c983';ctx.fillRect(x+32,390-h,14,18);ctx.fillStyle=t.earth;}\nctx.fillStyle='#bd9d71';ctx.beginPath();ctx.moveTo(325,480);ctx.quadraticCurveTo(480,350,580,375);ctx.lineTo(605,380);ctx.quadraticCurveTo(490,390,460,480);ctx.fill();\nconst glow=ctx.createRadialGradient(670,95,0,670,95,70);glow.addColorStop(0,'#ffe9a4aa');glow.addColorStop(1,'#ffe9a400');ctx.fillStyle=glow;ctx.fillRect(590,15,160,160);ctx.fillStyle='#fff4c4';ctx.beginPath();ctx.moveTo(670,62);ctx.lineTo(677,88);ctx.lineTo(700,95);ctx.lineTo(677,102);ctx.lineTo(670,128);ctx.lineTo(663,102);ctx.lineTo(640,95);ctx.lineTo(663,88);ctx.closePath();ctx.fill();\nfor(let i=0;i\u003c3;i++){const x=180+i*130+(!reduced()?Math.sin(clock*.5+i)*9:0),y=405+i*8;ctx.fillStyle=['#554348','#354c56','#716246'][i];ctx.beginPath();ctx.moveTo(x-12,y);ctx.lineTo(x-18,y+38);ctx.lineTo(x+18,y+38);ctx.lineTo(x+10,y);ctx.fill();ctx.fillStyle='#c9a781';ctx.beginPath();ctx.arc(x,y-7,9,0,7);ctx.fill();ctx.fillStyle='#f3d17c';ctx.fillRect(x+17,y+10,6,10);}\nfor(const p of pool.items){ctx.globalAlpha=Math.min(1,p.life*2);ctx.fillStyle=p.color;ctx.beginPath();ctx.arc(p.x,p.y,2.3,0,7);ctx.fill();}ctx.globalAlpha=1;\n}\nfunction frame(now){const dt=Math.min(.05,Math.max(0,(now-last)/1000));last=now;if(!paused&&!document.hidden){if(!reduced()){clock+=dt;pool.step(dt);}else pool.clear();if(cue){const u=Math.min(1,(now-cue.start)/cue.duration);$('scrub').value=u;showCue(u);if(u===1)cue=null;}}if(!document.hidden&&((!paused&&!reduced())||dirty)){draw();dirty=false;}requestAnimationFrame(frame);}\nfor(const e of G.elements){const b=document.createElement('button');b.innerHTML=G.gem(e.id);b.title='Download '+e.label+' SVG';b.addEventListener('click',()=>download('gem-'+e.id+'.svg',G.gem(e.id,256),'image/svg+xml'));$('assets').append(b);}\nfor(const id of Object.keys(G.glyphs)){const b=document.createElement('button');b.innerHTML=G.icon(id)+'\u003cspan>'+id+'\u003c/span>';b.addEventListener('click',()=>download('icon-'+id+'.svg',G.icon(id,256),'image/svg+xml'));$('assets').append(b);}\nfor(let i=0;i\u003c35;i++){const e=G.elements[(i*3+Math.floor(i/7))%5],b=document.createElement('button');b.innerHTML=G.gem(e.id);b.setAttribute('aria-label',e.label+' effect, row '+(1+Math.floor(i/7))+', column '+(1+i%7));b.addEventListener('click',()=>{emit(120+(i%7)*100,220,e.color,24);if(settings.shake&&!reduced()&&b.animate)b.animate([{transform:'translateX(0)'},{transform:'translateX(-3px)'},{transform:'translateX(3px)'},{transform:'translateX(0)'}],{duration:180});tone();status(e.label+' effect auditioned.');});$('board').append(b);}\n$('board').addEventListener('keydown',e=>{const buttons=[...$('board').children],i=buttons.indexOf(document.activeElement),offset={ArrowLeft:-1,ArrowRight:1,ArrowUp:-7,ArrowDown:7}[e.key];if(i>=0&&offset){e.preventDefault();buttons[Math.max(0,Math.min(34,i+offset))].focus();}});\ndocument.querySelectorAll('[data-fx]').forEach(b=>b.addEventListener('click',()=>trigger(b.dataset.fx)));\nfor(const k of Object.keys(settings))$(k).addEventListener('change',()=>{const input=$(k),v=input.type==='checkbox'?input.checked:(input.type==='range'?Number(input.value):input.value);settings=sanitize({[k]:v});sync();if(k==='sound'&&v)tone();});\n$('pause').onclick=()=>{paused=!paused;$('cutin').style.opacity=0;dirty=true;$('pause').textContent=paused?'Resume scene':'Pause scene';cue=null;};\n$('exportSettings').onclick=()=>download('tabor-workshop-settings.json',JSON.stringify({schemaVersion:1,...settings},null,2),'application/json');\n$('importSettings').onchange=async e=>{try{const file=e.target.files[0];if(!file)return;if(file.size>16384)throw Error('Settings file is too large');settings=sanitize(JSON.parse(await file.text()));settings.sound=false;sync();status('Settings imported. Sound stays off until enabled.');}catch(err){status('Import failed: '+err.message);}e.target.value='';};\n$('reset').onclick=()=>{settings={theme:'bethlehem',motion:false,particles:true,shake:false,sound:false,volume:.25,budget:96};sync();status('Workshop controls reset.');};\n$('preset').onchange=()=>{cue=null;cueJSON();showCue(Number($('scrub').value));};$('duration').onchange=cueJSON;\n$('scrub').oninput=()=>{cue=null;showCue(Number($('scrub').value));};\n$('playCue').onclick=()=>{const duration=Number($('duration').value);if(!Number.isFinite(duration)||duration\u003c200||duration>10000){status('Choose 200\u201310000 ms.');return;}if(paused){status('Resume scene before playing a cue.');return;}cueJSON();if(reduced()){showCue(1);status('Static cue shown; motion is disabled.');}else cue={start:performance.now(),duration};};\n$('exportCue').onclick=()=>{cueJSON();const data=JSON.parse($('cueJSON').value);if(!Number.isFinite(data.durationMs)||data.durationMs\u003c200||data.durationMs>10000){status('Choose 200\u201310000 ms.');return;}download('tabor-'+data.preset+'.json',$('cueJSON').value,'application/json');};\n$('cutinIcon').innerHTML=G.icon('lantern',100);$('exportSVG').onclick=()=>{const cells=[...G.elements.map(e=>({id:e.id,svg:G.gem(e.id,70)})),...Object.keys(G.glyphs).map(id=>({id,svg:G.icon(id,70)}))];const body=cells.map((c,i)=>'\u003cg transform=\"translate('+((i%6)*130+20)+','+(Math.floor(i/6)*110+20)+')\">'+c.svg+'\u003ctext x=\"0\" y=\"90\" fill=\"#fff1ce\" font-size=\"12\">'+c.id+'\u003c/text>\u003c/g>').join('');download('tabor-asset-contact-sheet.svg','\u003csvg xmlns=\"http://www.w3.org/2000/svg\" width=\"800\" height=\"690\" viewBox=\"0 0 800 690\">\u003crect width=\"800\" height=\"690\" fill=\"#101b37\"/>'+body+'\u003c/svg>','image/svg+xml');};\nfunction pngSize(bytes){const v=new DataView(bytes);if(v.byteLength\u003c24||v.getUint32(0)!==0x89504e47||v.getUint32(4)!==0x0d0a1a0a||v.getUint32(12)!==0x49484452)throw Error('Invalid PNG header');return {width:v.getUint32(16),height:v.getUint32(20)};}\nasync function decode(file){const bytes=await file.arrayBuffer(),size=pngSize(bytes);if(!size.width||!size.height||size.width>2048||size.height>2048)throw Error('PNG dimensions exceed 2048');const url=URL.createObjectURL(new Blob([bytes],{type:'image/png'}));try{const img=new Image();await new Promise((resolve,reject)=>{img.onload=resolve;img.onerror=()=>reject(Error('PNG decode failed'));img.src=url;});if(img.naturalWidth!==size.width||img.naturalHeight!==size.height)throw Error('PNG dimensions mismatch');return img;}finally{URL.revokeObjectURL(url);}}\n$('pack').onclick=async()=>{if(packBusy)return;packBusy=true;$('pack').disabled=true;$('downloadPNG').disabled=true;$('downloadMap').disabled=true;atlasMap=null;const images=[];try{const files=[...$('sprites').files];if(!files.length||files.length>32)throw Error('Choose 1\u201332 PNG files');if(files.some(f=>f.size>1024*1024)||files.reduce((s,f)=>s+f.size,0)>32*1024*1024)throw Error('Input size limit exceeded');$('atlasList').replaceChildren();let pixels=0;for(const [i,file]of files.entries()){const header=pngSize(await file.slice(0,24).arrayBuffer());pixels+=header.width*header.height;if(pixels>16777216)throw Error('Combined artwork exceeds 16 million pixels');const img=await decode(file);images.push({id:String(i).padStart(3,'0')+'-'+file.name,img,width:img.width,height:img.height});}const map=G.pack(images,Number($('atlasWidth').value),2),out=$('atlasPreview');out.width=map.width;out.height=map.height;const c=out.getContext('2d');c.clearRect(0,0,out.width,out.height);for(const f of map.frames){const image=images.find(i=>i.id===f.id);c.drawImage(image.img,f.x,f.y);const li=document.createElement('li');li.textContent=f.id+' \u00b7 '+f.width+' \u00d7 '+f.height;$('atlasList').append(li);}atlasMap={version:1,image:'tabor-atlas.png',...map};$('downloadPNG').disabled=false;$('downloadMap').disabled=false;$('atlasStatus').textContent='Packed '+map.frames.length+' images \u00b7 '+map.width+' \u00d7 '+map.height+' \u00b7 transparent 2px gutters. Use clamp sampling; edge extrusion is not supplied.';}catch(err){$('atlasStatus').textContent=err.message;}finally{images.length=0;packBusy=false;$('pack').disabled=false;}};\n$('downloadPNG').onclick=()=>{if(!atlasMap)return;$('atlasPreview').toBlob(blob=>{if(blob)download('tabor-atlas.png',blob);else $('atlasStatus').textContent='PNG export failed.';},'image/png');};\n$('downloadMap').onclick=()=>{if(atlasMap)download('tabor-atlas.json',JSON.stringify(atlasMap,null,2),'application/json');};\nsignal.addEventListener('change',()=>{pool.clear();cue=null;$('cutin').style.opacity=0;status(signal.matches?'System reduced motion is active.':'System reduced motion is off; your motion setting still applies.');});\ndocument.addEventListener('visibilitychange',()=>{last=performance.now();if(document.hidden){cue=null;pool.clear();$('cutin').style.opacity=0;if(audio)audio.suspend().catch(()=>{});}});\n\n$('applyCue').onclick=()=>{try{const data=JSON.parse($('cueJSON').value);if(data.preset!==$('preset').value)throw Error('Preset must match selection');if(typeof data.durationMs!=='number'||!Number.isFinite(data.durationMs)||data.durationMs\u003c200||data.durationMs>10000)throw Error('Duration must be 200\u201310000 ms');G.sample(data.keyframes,.5);G.presets[data.preset]=data.keyframes.map(f=>({t:f.t,x:f.x,y:f.y,scale:f.scale,opacity:f.opacity}));$('duration').value=data.durationMs;cue=null;showCue(Number($('scrub').value));status('Edited keyframes applied to this workshop.');}catch(err){status('Keyframes rejected: '+err.message);}};\nconst catalogue={\"schema_version\":1,\"id\":\"tabor-three-archetypes-63\",\"framework\":\"Tabor Decimal System\",\"framework_attribution\":\"Nathan Tabor\",\"source\":\"User supplied these names and descriptions in the current chat; wording preserved as proposals. Implementation notes are assistant annotations.\",\"archetypes\":[{\"number\":1,\"name\":\"The Sortilegium\",\"subtitle\":\"The Array Field Field Casting\"},{\"number\":2,\"name\":\"The Taxis-Kosmos\",\"subtitle\":\"The Ordered Continuum Grid\"},{\"number\":3,\"name\":\"The Tessellated Psychomachia\",\"subtitle\":\"The Conceptual Battle Matrix\"}],\"options\":[{\"id\":\"tabor.option.001\",\"number\":1,\"archetype_number\":1,\"within_archetype\":1,\"name\":\"Hardware Silicon Layer\",\"source_description\":\"The physical transistor array where random electrical micro-surges are initialized, captured, and converted into discrete binary states.\",\"source_status\":\"user-supplied proposal; not independently verified\",\"implementation_status\":\"catalogued; runtime enablement not implied\",\"implementation_note\":\"Concept retained; no new hardware or production feature implementation established by this entry.\",\"enabled_by_default\":false},{\"id\":\"tabor.option.002\",\"number\":2,\"archetype_number\":1,\"within_archetype\":2,\"name\":\"The Peano Successor Sequence\",\"source_description\":\"The step-by-step mathematical clock cycle that takes an empty field (0) and calculates its exact subsequent data state (S(0)).\",\"source_status\":\"user-supplied proposal; not independently verified\",\"implementation_status\":\"catalogued; runtime enablement not implied\",\"implementation_note\":\"Peano successor is a mathematical operation; it does not specify CPU clock timing.\",\"enabled_by_default\":false},{\"id\":\"tabor.option.003\",\"number\":3,\"archetype_number\":1,\"within_archetype\":3,\"name\":\"Low-Level Firmware Driver\",\"source_description\":\"The underlying code layer that translates physical coordinate touches on a screen directly into unformatted array values.\",\"source_status\":\"user-supplied proposal; not independently verified\",\"implementation_status\":\"catalogued; runtime enablement not implied\",\"implementation_note\":\"Concept retained; no new hardware or production feature implementation established by this entry.\",\"enabled_by_default\":false},{\"id\":\"tabor.option.004\",\"number\":4,\"archetype_number\":1,\"within_archetype\":4,\"name\":\"The 2D Matrix Array\",\"source_description\":\"A strict, two-dimensional memory layout (7 \u00d7 5) where every cell acts as an isolated data register.\",\"source_status\":\"user-supplied proposal; not independently verified\",\"implementation_status\":\"catalogued; runtime enablement not implied\",\"implementation_note\":\"7 \u00d7 5 is this proposed configuration; existing boards retain their own dimensions.\",\"enabled_by_default\":false},{\"id\":\"tabor.option.005\",\"number\":5,\"archetype_number\":1,\"within_archetype\":5,\"name\":\"Unary State Tracker\",\"source_description\":\"The baseline tracking loop where an asset\u2019s presence is evaluated as a simple 1-to-1 binary option (1 or 0).\",\"source_status\":\"user-supplied proposal; not independently verified\",\"implementation_status\":\"catalogued; runtime enablement not implied\",\"implementation_note\":\"Concept retained; no new hardware or production feature implementation established by this entry.\",\"enabled_by_default\":false},{\"id\":\"tabor.option.006\",\"number\":6,\"archetype_number\":1,\"within_archetype\":6,\"name\":\"Micro-Kernel Scheduler\",\"source_description\":\"The OS traffic manager that prevents multi-threaded processing requests from colliding and overlapping inside the same cache block.\",\"source_status\":\"user-supplied proposal; not independently verified\",\"implementation_status\":\"catalogued; runtime enablement not implied\",\"implementation_note\":\"Concept retained; no new hardware or production feature implementation established by this entry.\",\"enabled_by_default\":false},{\"id\":\"tabor.option.007\",\"number\":7,\"archetype_number\":1,\"within_archetype\":7,\"name\":\"The Maternal Bootloader\",\"source_description\":\"The initial structural sweep that sets up the absolute direction of data flow before any data cells are populated.\",\"source_status\":\"user-supplied proposal; not independently verified\",\"implementation_status\":\"catalogued; runtime enablement not implied\",\"implementation_note\":\"Concept retained; no new hardware or production feature implementation established by this entry.\",\"enabled_by_default\":false},{\"id\":\"tabor.option.008\",\"number\":8,\"archetype_number\":1,\"within_archetype\":8,\"name\":\"Random Seed Generator\",\"source_description\":\"A cryptographically secure random number generator (PRNG) that feeds un-biased initial variations into the grid layout.\",\"source_status\":\"user-supplied proposal; not independently verified\",\"implementation_status\":\"catalogued; runtime enablement not implied\",\"implementation_note\":\"A seeded gameplay PRNG is not automatically cryptographically secure or unbiased. Security entropy and replay seeds must be separate.\",\"enabled_by_default\":false},{\"id\":\"tabor.option.009\",\"number\":9,\"archetype_number\":1,\"within_archetype\":9,\"name\":\"The Oldowan Fracture Gate\",\"source_description\":\"A pure logic checkpoint evaluating whether a stone flake or data node is blunt (0) or sharp (1).\",\"source_status\":\"user-supplied proposal; not independently verified\",\"implementation_status\":\"catalogued; runtime enablement not implied\",\"implementation_note\":\"Concept retained; no new hardware or production feature implementation established by this entry.\",\"enabled_by_default\":false},{\"id\":\"tabor.option.010\",\"number\":10,\"archetype_number\":1,\"within_archetype\":10,\"name\":\"The Positional Memory Registry\",\"source_description\":\"A database table where an asset\u2019s identity is bound directly to its raw geographic slot on the hardware board.\",\"source_status\":\"user-supplied proposal; not independently verified\",\"implementation_status\":\"catalogued; runtime enablement not implied\",\"implementation_note\":\"Stable asset IDs should remain independent of movable board coordinates.\",\"enabled_by_default\":false},{\"id\":\"tabor.option.011\",\"number\":11,\"archetype_number\":1,\"within_archetype\":11,\"name\":\"Dynamic Vector Array\",\"source_description\":\"A memory structure that expands and contracts its tracking variables dynamically based on signal density.\",\"source_status\":\"user-supplied proposal; not independently verified\",\"implementation_status\":\"catalogued; runtime enablement not implied\",\"implementation_note\":\"Concept retained; no new hardware or production feature implementation established by this entry.\",\"enabled_by_default\":false},{\"id\":\"tabor.option.012\",\"number\":12,\"archetype_number\":1,\"within_archetype\":12,\"name\":\"Cache Line Coherency\",\"source_description\":\"The hardware validation layer that keeps parallel memory rows perfectly synchronized across multiple chip structures.\",\"source_status\":\"user-supplied proposal; not independently verified\",\"implementation_status\":\"catalogued; runtime enablement not implied\",\"implementation_note\":\"Concept retained; no new hardware or production feature implementation established by this entry.\",\"enabled_by_default\":false},{\"id\":\"tabor.option.013\",\"number\":13,\"archetype_number\":1,\"within_archetype\":13,\"name\":\"High-Frequency I/O Channel\",\"source_description\":\"The data pipe responsible for processing millions of tiny coordinate swaps per second without memory leaks.\",\"source_status\":\"user-supplied proposal; not independently verified\",\"implementation_status\":\"catalogued; runtime enablement not implied\",\"implementation_note\":\"Throughput and leak freedom are unverified performance claims.\",\"enabled_by_default\":false},{\"id\":\"tabor.option.014\",\"number\":14,\"archetype_number\":1,\"within_archetype\":14,\"name\":\"Linear Memory Addressing\",\"source_description\":\"Eliminating relational pointer lookups by binding files directly to permanent hardware coordinate locations.\",\"source_status\":\"user-supplied proposal; not independently verified\",\"implementation_status\":\"catalogued; runtime enablement not implied\",\"implementation_note\":\"Virtual addresses and persistent file identities are not permanent physical hardware coordinates.\",\"enabled_by_default\":false},{\"id\":\"tabor.option.015\",\"number\":15,\"archetype_number\":1,\"within_archetype\":15,\"name\":\"The Primitive Tally Stick\",\"source_description\":\"A 1-to-1 physical storage loop modeled after the ancient baboon fibula notch system to track cyclical data.\",\"source_status\":\"user-supplied proposal; not independently verified\",\"implementation_status\":\"catalogued; runtime enablement not implied\",\"implementation_note\":\"Concept retained; no new hardware or production feature implementation established by this entry.\",\"enabled_by_default\":false},{\"id\":\"tabor.option.016\",\"number\":16,\"archetype_number\":1,\"within_archetype\":16,\"name\":\"Structural Boundary Control\",\"source_description\":\"The safety protocol preventing active data elements from bleeding sideways into adjacent columns without an explicit trigger.\",\"source_status\":\"user-supplied proposal; not independently verified\",\"implementation_status\":\"catalogued; runtime enablement not implied\",\"implementation_note\":\"Concept retained; no new hardware or production feature implementation established by this entry.\",\"enabled_by_default\":false},{\"id\":\"tabor.option.017\",\"number\":17,\"archetype_number\":1,\"within_archetype\":17,\"name\":\"The Bitmask Array\",\"source_description\":\"A compression layer that reads a sequence of tiles as a single binary number to reduce computing overhead.\",\"source_status\":\"user-supplied proposal; not independently verified\",\"implementation_status\":\"catalogued; runtime enablement not implied\",\"implementation_note\":\"Concept retained; no new hardware or production feature implementation established by this entry.\",\"enabled_by_default\":false},{\"id\":\"tabor.option.018\",\"number\":18,\"archetype_number\":1,\"within_archetype\":18,\"name\":\"Localized State Machine\",\"source_description\":\"An independent code module running its own rule sets within a single grid column.\",\"source_status\":\"user-supplied proposal; not independently verified\",\"implementation_status\":\"catalogued; runtime enablement not implied\",\"implementation_note\":\"Concept retained; no new hardware or production feature implementation established by this entry.\",\"enabled_by_default\":false},{\"id\":\"tabor.option.019\",\"number\":19,\"archetype_number\":1,\"within_archetype\":19,\"name\":\"Hardware Interrupt Vector\",\"source_description\":\"The physical CPU circuit that pauses standard operations the exact millisecond a user initiates an array swap.\",\"source_status\":\"user-supplied proposal; not independently verified\",\"implementation_status\":\"catalogued; runtime enablement not implied\",\"implementation_note\":\"Touch input is handled through platform event APIs; no exact-millisecond hardware interrupt guarantee.\",\"enabled_by_default\":false},{\"id\":\"tabor.option.020\",\"number\":20,\"archetype_number\":1,\"within_archetype\":20,\"name\":\"The Molecular Vault Envelope\",\"source_description\":\"A secure data packet wrapping unformatted inputs before they pass through to the central validation engine.\",\"source_status\":\"user-supplied proposal; not independently verified\",\"implementation_status\":\"catalogued; runtime enablement not implied\",\"implementation_note\":\"A wrapper alone does not establish encryption, authentication, or integrity.\",\"enabled_by_default\":false},{\"id\":\"tabor.option.021\",\"number\":21,\"archetype_number\":1,\"within_archetype\":21,\"name\":\"The Absolute Zero Reset\",\"source_description\":\"The automatic memory cleanup routine that wipes a cell back to a complete void state once its contents are cleared.\",\"source_status\":\"user-supplied proposal; not independently verified\",\"implementation_status\":\"catalogued; runtime enablement not implied\",\"implementation_note\":\"Clearing a game cell is not secure erasure of physical memory.\",\"enabled_by_default\":false},{\"id\":\"tabor.option.022\",\"number\":22,\"archetype_number\":2,\"within_archetype\":1,\"name\":\"The Collinear Hox Pipeline\",\"source_description\":\"The master sequence law where genes or code instructions are physically arranged on a strand matching their execution space.\",\"source_status\":\"user-supplied proposal; not independently verified\",\"implementation_status\":\"catalogued; runtime enablement not implied\",\"implementation_note\":\"Hox collinearity is an analogy, not proof of a universal execution law.\",\"enabled_by_default\":false},{\"id\":\"tabor.option.023\",\"number\":23,\"archetype_number\":2,\"within_archetype\":2,\"name\":\"The Morphogen Gradient Timer\",\"source_description\":\"An exponential decay formula that uses physical distance from a signaling source to calculate automated timing events.\",\"source_status\":\"user-supplied proposal; not independently verified\",\"implementation_status\":\"catalogued; runtime enablement not implied\",\"implementation_note\":\"Spatial exponential falloff alone is not a timer.\",\"enabled_by_default\":false},{\"id\":\"tabor.option.024\",\"number\":24,\"archetype_number\":2,\"within_archetype\":3,\"name\":\"The V(D)J Recombination Compiler\",\"source_description\":\"A low-level splicing engine that makes clean geometric cuts across a fixed data line to assemble custom trait variations.\",\"source_status\":\"user-supplied proposal; not independently verified\",\"implementation_status\":\"catalogued; runtime enablement not implied\",\"implementation_note\":\"V(D)J joins selected segments; contiguous slicing is not a biological model.\",\"enabled_by_default\":false},{\"id\":\"tabor.option.025\",\"number\":25,\"archetype_number\":2,\"within_archetype\":4,\"name\":\"The TABOR Rate-Limiter\",\"source_description\":\"The primary kernel ceiling that strictly forbids memory expansion beyond a defined population-inflation index.\",\"source_status\":\"user-supplied proposal; not independently verified\",\"implementation_status\":\"catalogued; runtime enablement not implied\",\"implementation_note\":\"Preserved proposal only. Population/inflation ceilings are not adopted as a memory rule; preserve the distinct Nathan Tabor framework attribution.\",\"enabled_by_default\":false},{\"id\":\"tabor.option.026\",\"number\":26,\"archetype_number\":2,\"within_archetype\":5,\"name\":\"Balanced Phase Polarity\",\"source_description\":\"An electronic balance protocol where every incoming data surge is matched with an equal and opposite counterweight.\",\"source_status\":\"user-supplied proposal; not independently verified\",\"implementation_status\":\"catalogued; runtime enablement not implied\",\"implementation_note\":\"Concept retained; no new hardware or production feature implementation established by this entry.\",\"enabled_by_default\":false},{\"id\":\"tabor.option.027\",\"number\":27,\"archetype_number\":2,\"within_archetype\":6,\"name\":\"The Chrono-Locked War Server\",\"source_description\":\"A live synchronous human-vs-human event platform running on parallel multi-axial communication channels.\",\"source_status\":\"user-supplied proposal; not independently verified\",\"implementation_status\":\"catalogued; runtime enablement not implied\",\"implementation_note\":\"Earlier scheduled shared-device rehearsal exists; authenticated remote human-vs-human service remains unconnected.\",\"enabled_by_default\":false},{\"id\":\"tabor.option.028\",\"number\":28,\"archetype_number\":2,\"within_archetype\":7,\"name\":\"The Parliamentary Quorum Gate\",\"source_description\":\"A constitutional system rule requiring a formal voting check before allocating shared team capital.\",\"source_status\":\"user-supplied proposal; not independently verified\",\"implementation_status\":\"catalogued; runtime enablement not implied\",\"implementation_note\":\"Earlier local quorum model exists; server authorization and durable voting are separate requirements.\",\"enabled_by_default\":false},{\"id\":\"tabor.option.029\",\"number\":29,\"archetype_number\":2,\"within_archetype\":8,\"name\":\"The TALE Co-Factor Lock\",\"source_description\":\"A secondary verification key that binds to a primary instruction to guarantee precision execution.\",\"source_status\":\"user-supplied proposal; not independently verified\",\"implementation_status\":\"catalogued; runtime enablement not implied\",\"implementation_note\":\"TALE label is retained separately from the foundation called The Tale. A cofactor does not guarantee execution precision.\",\"enabled_by_default\":false},{\"id\":\"tabor.option.030\",\"number\":30,\"archetype_number\":2,\"within_archetype\":9,\"name\":\"The Time-Space Frame GPU Matrix\",\"source_description\":\"The rendering script that translates raw microsecond timeline registers into static coordinate pixels on a display screen.\",\"source_status\":\"user-supplied proposal; not independently verified\",\"implementation_status\":\"catalogued; runtime enablement not implied\",\"implementation_note\":\"Concept retained; no new hardware or production feature implementation established by this entry.\",\"enabled_by_default\":false},{\"id\":\"tabor.option.031\",\"number\":31,\"archetype_number\":2,\"within_archetype\":10,\"name\":\"Paralogous Redundancy Arrays\",\"source_description\":\"Duplicated vertical tracks (Tracks A, B, C, D) providing instant failover backups for missing data cells.\",\"source_status\":\"user-supplied proposal; not independently verified\",\"implementation_status\":\"catalogued; runtime enablement not implied\",\"implementation_note\":\"Duplication alone does not provide independent durable failover.\",\"enabled_by_default\":false},{\"id\":\"tabor.option.032\",\"number\":32,\"archetype_number\":2,\"within_archetype\":11,\"name\":\"Posterior Dominance Suppressor\",\"source_description\":\"An execution priority law where the final, highest-address index completely overrides preceding operations.\",\"source_status\":\"user-supplied proposal; not independently verified\",\"implementation_status\":\"catalogued; runtime enablement not implied\",\"implementation_note\":\"Index priority is a proposed game rule and must not silently override unrelated operations.\",\"enabled_by_default\":false},{\"id\":\"tabor.option.033\",\"number\":33,\"archetype_number\":2,\"within_archetype\":12,\"name\":\"The Gap Partition Core\",\"source_description\":\"A macro-drive formatting tool that blocks out un-zoned memory into distinct operational territories.\",\"source_status\":\"user-supplied proposal; not independently verified\",\"implementation_status\":\"catalogued; runtime enablement not implied\",\"implementation_note\":\"Concept retained; no new hardware or production feature implementation established by this entry.\",\"enabled_by_default\":false},{\"id\":\"tabor.option.034\",\"number\":34,\"archetype_number\":2,\"within_archetype\":13,\"name\":\"The Pair-Rule Stripe Ticker\",\"source_description\":\"The structural engine that slices continuous data blocks into alternating, periodic grid columns.\",\"source_status\":\"user-supplied proposal; not independently verified\",\"implementation_status\":\"catalogued; runtime enablement not implied\",\"implementation_note\":\"Concept retained; no new hardware or production feature implementation established by this entry.\",\"enabled_by_default\":false},{\"id\":\"tabor.option.035\",\"number\":35,\"archetype_number\":2,\"within_archetype\":14,\"name\":\"The Urbilateria Base Kernel\",\"source_description\":\"The pristine, non-fragmented base code architecture from which all subsequent thread forks are derived.\",\"source_status\":\"user-supplied proposal; not independently verified\",\"implementation_status\":\"catalogued; runtime enablement not implied\",\"implementation_note\":\"Concept retained; no new hardware or production feature implementation established by this entry.\",\"enabled_by_default\":false},{\"id\":\"tabor.option.036\",\"number\":36,\"archetype_number\":2,\"within_archetype\":15,\"name\":\"Whole-System Replication Wave\",\"source_description\":\"A macro-server command that mirrors entire system structures concurrently to deploy large-scale environments.\",\"source_status\":\"user-supplied proposal; not independently verified\",\"implementation_status\":\"catalogued; runtime enablement not implied\",\"implementation_note\":\"Whole-system replication requires explicit versioning, consistency and deployment design.\",\"enabled_by_default\":false},{\"id\":\"tabor.option.037\",\"number\":37,\"archetype_number\":2,\"within_archetype\":16,\"name\":\"The Xlox Algorithmic Bifurcation Point\",\"source_description\":\"The chip junction where numeric math logic and spatial indexing part ways into independent sub-processors.\",\"source_status\":\"user-supplied proposal; not independently verified\",\"implementation_status\":\"catalogued; runtime enablement not implied\",\"implementation_note\":\"Concept retained; no new hardware or production feature implementation established by this entry.\",\"enabled_by_default\":false},{\"id\":\"tabor.option.038\",\"number\":38,\"archetype_number\":2,\"within_archetype\":17,\"name\":\"The Yield-Frequency Clock Interrupt\",\"source_description\":\"The microsecond tuning speed where local transistor refreshes and global ticks align perfectly.\",\"source_status\":\"user-supplied proposal; not independently verified\",\"implementation_status\":\"catalogued; runtime enablement not implied\",\"implementation_note\":\"Perfect timing alignment is not established.\",\"enabled_by_default\":false},{\"id\":\"tabor.option.039\",\"number\":39,\"archetype_number\":2,\"within_archetype\":18,\"name\":\"The Zerkn\u00fcllt Protective Envelope\",\"source_description\":\"A secure data wrapper insulating active execution spaces from external network latency interference.\",\"source_status\":\"user-supplied proposal; not independently verified\",\"implementation_status\":\"catalogued; runtime enablement not implied\",\"implementation_note\":\"A data envelope does not remove network latency.\",\"enabled_by_default\":false},{\"id\":\"tabor.option.040\",\"number\":40,\"archetype_number\":2,\"within_archetype\":19,\"name\":\"The Fushi Tarazu Array Splitter\",\"source_description\":\"An algorithmic modifier that slices continuous resource pools into individual, repeating data segments.\",\"source_status\":\"user-supplied proposal; not independently verified\",\"implementation_status\":\"catalogued; runtime enablement not implied\",\"implementation_note\":\"Concept retained; no new hardware or production feature implementation established by this entry.\",\"enabled_by_default\":false},{\"id\":\"tabor.option.041\",\"number\":41,\"archetype_number\":2,\"within_archetype\":20,\"name\":\"Ectopic Expression Intercept\",\"source_description\":\"A hardware security sentinel blocking back-line instructions from loading into a primary head register slot.\",\"source_status\":\"user-supplied proposal; not independently verified\",\"implementation_status\":\"catalogued; runtime enablement not implied\",\"implementation_note\":\"Concept retained; no new hardware or production feature implementation established by this entry.\",\"enabled_by_default\":false},{\"id\":\"tabor.option.042\",\"number\":42,\"archetype_number\":2,\"within_archetype\":21,\"name\":\"Global Control Enhancer Bus\",\"source_description\":\"A long-range motherboard lane that broadcasts master configuration states across all sub-channels instantly.\",\"source_status\":\"user-supplied proposal; not independently verified\",\"implementation_status\":\"catalogued; runtime enablement not implied\",\"implementation_note\":\"Broadcast delivery is not instantaneous.\",\"enabled_by_default\":false},{\"id\":\"tabor.option.043\",\"number\":43,\"archetype_number\":3,\"within_archetype\":1,\"name\":\"The Relational Trophic Lattice\",\"source_description\":\"An ecological database setup mapping how raw resource energy climbs up to top-tier active power assets.\",\"source_status\":\"user-supplied proposal; not independently verified\",\"implementation_status\":\"catalogued; runtime enablement not implied\",\"implementation_note\":\"Concept retained; no new hardware or production feature implementation established by this entry.\",\"enabled_by_default\":false},{\"id\":\"tabor.option.044\",\"number\":44,\"archetype_number\":3,\"within_archetype\":2,\"name\":\"The Microfluidic Pheromone Index\",\"source_description\":\"An externalized memory network that drops physical hydrocarbon signals on geography to route system traffic.\",\"source_status\":\"user-supplied proposal; not independently verified\",\"implementation_status\":\"catalogued; runtime enablement not implied\",\"implementation_note\":\"Concept retained; no new hardware or production feature implementation established by this entry.\",\"enabled_by_default\":false},{\"id\":\"tabor.option.045\",\"number\":45,\"archetype_number\":3,\"within_archetype\":3,\"name\":\"The Hox Segment Index\",\"source_description\":\"The developmental code that turns physical coordinate addresses into functional, structural biological identities.\",\"source_status\":\"user-supplied proposal; not independently verified\",\"implementation_status\":\"catalogued; runtime enablement not implied\",\"implementation_note\":\"Concept retained; no new hardware or production feature implementation established by this entry.\",\"enabled_by_default\":false},{\"id\":\"tabor.option.046\",\"number\":46,\"archetype_number\":3,\"within_archetype\":4,\"name\":\"The Baryonic Acoustic Oscillation Array\",\"source_description\":\"A cosmological spacing script that places map nodes across fixed geographic intervals derived from wave peaks.\",\"source_status\":\"user-supplied proposal; not independently verified\",\"implementation_status\":\"catalogued; runtime enablement not implied\",\"implementation_note\":\"Configurable game spacing is a design choice; BAO does not prescribe exact individual galaxy positions.\",\"enabled_by_default\":false},{\"id\":\"tabor.option.047\",\"number\":47,\"archetype_number\":3,\"within_archetype\":5,\"name\":\"The Immutable Covenant Ledger\",\"source_description\":\"A distributed transaction tracker enforcing structural resource penalties when community laws are broken.\",\"source_status\":\"user-supplied proposal; not independently verified\",\"implementation_status\":\"catalogued; runtime enablement not implied\",\"implementation_note\":\"Earlier ledger is local and mutable; distributed durability and immutability are not implemented. Penalties require explicit opt-in rules.\",\"enabled_by_default\":false},{\"id\":\"tabor.option.048\",\"number\":48,\"archetype_number\":3,\"within_archetype\":6,\"name\":\"The Taxpayer Rebate Dividend Pool\",\"source_description\":\"An automated out-flow loop distributing excess resources back to lower-tier system accounts.\",\"source_status\":\"user-supplied proposal; not independently verified\",\"implementation_status\":\"catalogued; runtime enablement not implied\",\"implementation_note\":\"Preserve this label as a proposed game distribution pool, not an automatic tax-law feature or forced redistribution.\",\"enabled_by_default\":false},{\"id\":\"tabor.option.049\",\"number\":49,\"archetype_number\":3,\"within_archetype\":7,\"name\":\"The De-Brucing Voter Ballot UI\",\"source_description\":\"The user interface canvas requiring an alliance to pass a formal vote before expanding base capacity.\",\"source_status\":\"user-supplied proposal; not independently verified\",\"implementation_status\":\"catalogued; runtime enablement not implied\",\"implementation_note\":\"Local voting is a prototype; no legal tax procedure is being implemented.\",\"enabled_by_default\":false},{\"id\":\"tabor.option.050\",\"number\":50,\"archetype_number\":3,\"within_archetype\":8,\"name\":\"The Associative Attractor State Matrix\",\"source_description\":\"A neural memory storage method where data inputs look up files by pattern similarity instead of index folder paths.\",\"source_status\":\"user-supplied proposal; not independently verified\",\"implementation_status\":\"catalogued; runtime enablement not implied\",\"implementation_note\":\"Earlier cosine retrieval is not a trained attractor network.\",\"enabled_by_default\":false},{\"id\":\"tabor.option.051\",\"number\":51,\"archetype_number\":3,\"within_archetype\":9,\"name\":\"The Stochastic Cellular Automaton\",\"source_description\":\"A self-generating field engine where combat and growth events are decided purely by local cell neighbor counts.\",\"source_status\":\"user-supplied proposal; not independently verified\",\"implementation_status\":\"catalogued; runtime enablement not implied\",\"implementation_note\":\"Conway B3/S23 evolution is deterministic; seeded initialization alone does not make transition rules stochastic.\",\"enabled_by_default\":false},{\"id\":\"tabor.option.052\",\"number\":52,\"archetype_number\":3,\"within_archetype\":10,\"name\":\"Intrinsically Disordered Thread Buffers\",\"source_description\":\"Flexible code variables that let distinct values condense under heavy combat workloads without breaking type bounds.\",\"source_status\":\"user-supplied proposal; not independently verified\",\"implementation_status\":\"catalogued; runtime enablement not implied\",\"implementation_note\":\"Protein disorder is an analogy; no automatic type safety or workload behavior follows.\",\"enabled_by_default\":false},{\"id\":\"tabor.option.053\",\"number\":53,\"archetype_number\":3,\"within_archetype\":11,\"name\":\"Kinetic Shockwave Multiplier\",\"source_description\":\"A code rule where cell explosions crack adjacent tiles, spawning recursive cascading events.\",\"source_status\":\"user-supplied proposal; not independently verified\",\"implementation_status\":\"catalogued; runtime enablement not implied\",\"implementation_note\":\"Earlier workshop uses bounded cracking; unrestricted recursive expansion is not implemented.\",\"enabled_by_default\":false},{\"id\":\"tabor.option.054\",\"number\":54,\"archetype_number\":3,\"within_archetype\":12,\"name\":\"Direct Environment Deconstruction\",\"source_description\":\"An integrated background engine where elemental cell plays alter the physical attributes of the map backdrop.\",\"source_status\":\"user-supplied proposal; not independently verified\",\"implementation_status\":\"catalogued; runtime enablement not implied\",\"implementation_note\":\"Earlier workshop has simplified local terrain effects.\",\"enabled_by_default\":false},{\"id\":\"tabor.option.055\",\"number\":55,\"archetype_number\":3,\"within_archetype\":13,\"name\":\"Asynchronous Chronos Echoes\",\"source_description\":\"A PVP pipeline that records a player's exact move times and sequences to replay them as a live ghost opponent.\",\"source_status\":\"user-supplied proposal; not independently verified\",\"implementation_status\":\"catalogued; runtime enablement not implied\",\"implementation_note\":\"Recorded opponent moves are replay, not a live adaptive human opponent; service remains unconnected.\",\"enabled_by_default\":false},{\"id\":\"tabor.option.056\",\"number\":56,\"archetype_number\":3,\"within_archetype\":14,\"name\":\"The Spatial Infrastructure Pipeline\",\"source_description\":\"A village grid layout rule where placing buildings adjacent to raw mines shortens crafting times.\",\"source_status\":\"user-supplied proposal; not independently verified\",\"implementation_status\":\"catalogued; runtime enablement not implied\",\"implementation_note\":\"Earlier local adjacency prototype exists.\",\"enabled_by_default\":false},{\"id\":\"tabor.option.057\",\"number\":57,\"archetype_number\":3,\"within_archetype\":15,\"name\":\"The Generative Weapon Synthesis Forge\",\"source_description\":\"A modular alchemy calculator shaping item stats based on the molecular weight of raw material inputs.\",\"source_status\":\"user-supplied proposal; not independently verified\",\"implementation_status\":\"catalogued; runtime enablement not implied\",\"implementation_note\":\"Earlier fictional forge uses game statistics, not molecular physics.\",\"enabled_by_default\":false},{\"id\":\"tabor.option.058\",\"number\":58,\"archetype_number\":3,\"within_archetype\":16,\"name\":\"The Biometric Resonance Weather Sync\",\"source_description\":\"An API integration layer that adjusts app lighting and base production based on the user's real-world local climate.\",\"source_status\":\"user-supplied proposal; not independently verified\",\"implementation_status\":\"catalogued; runtime enablement not implied\",\"implementation_note\":\"No biometric/location/weather collection enabled. Manual ambience is available; any external data source requires consumer controls.\",\"enabled_by_default\":false},{\"id\":\"tabor.option.059\",\"number\":59,\"archetype_number\":3,\"within_archetype\":17,\"name\":\"The Deep-Learning Strategic Mentor\",\"source_description\":\"An on-device neural network familiar studying user play habits to calculate live combat survival odds.\",\"source_status\":\"user-supplied proposal; not independently verified\",\"implementation_status\":\"catalogued; runtime enablement not implied\",\"implementation_note\":\"Earlier hints are heuristic; no trained on-device neural mentor or calibrated survival probabilities.\",\"enabled_by_default\":false},{\"id\":\"tabor.option.060\",\"number\":60,\"archetype_number\":3,\"within_archetype\":18,\"name\":\"Macro-Economic Trade Syndicates\",\"source_description\":\"A shared alliance market ledger letting high-level accounts drop surplus supplies into low-level player bins.\",\"source_status\":\"user-supplied proposal; not independently verified\",\"implementation_status\":\"catalogued; runtime enablement not implied\",\"implementation_note\":\"Remote alliance market, secure transfers and server ledger remain unconnected.\",\"enabled_by_default\":false},{\"id\":\"tabor.option.061\",\"number\":61,\"archetype_number\":3,\"within_archetype\":19,\"name\":\"Living Card Degeneration Mechanics\",\"source_description\":\"A character tracking matrix monitoring usage frequency to apply mechanical exhaustion adjustments.\",\"source_status\":\"user-supplied proposal; not independently verified\",\"implementation_status\":\"catalogued; runtime enablement not implied\",\"implementation_note\":\"Earlier local mastery/rest prototype exists; no paid recovery or forced refill waits.\",\"enabled_by_default\":false},{\"id\":\"tabor.option.062\",\"number\":62,\"archetype_number\":3,\"within_archetype\":20,\"name\":\"Galactic Synchronous Mega-Raids\",\"source_description\":\"A distributed server network pooling millions of player actions to battle a shared macro boss in real time.\",\"source_status\":\"user-supplied proposal; not independently verified\",\"implementation_status\":\"catalogued; runtime enablement not implied\",\"implementation_note\":\"Production shared-world raid services remain unconnected.\",\"enabled_by_default\":false},{\"id\":\"tabor.option.063\",\"number\":63,\"archetype_number\":3,\"within_archetype\":21,\"name\":\"The High-Fidelity Hologram Frame\",\"source_description\":\"A top-down schematic dashboard detailing post-match vector metrics and alternative combination options.\",\"source_status\":\"user-supplied proposal; not independently verified\",\"implementation_status\":\"catalogued; runtime enablement not implied\",\"implementation_note\":\"Earlier local replay prototype exists; a full alternative-path tactical analysis is not established.\",\"enabled_by_default\":false}],\"app_policy\":{\"consumer_opt_in\":true,\"distinct_themes\":true,\"preserve_originals\":true,\"preserve_saves\":true,\"paid_tokens\":false,\"collection_default\":false},\"rollout\":{\"database_import_executed\":false,\"library_package_replaced\":false,\"app_runtime_changed\":false,\"reason\":\"Execution environment unavailable; draft catalogue and SQL only\"}};\nfunction showCatalogue(){const query=$('catalogSearch').value.trim().toLowerCase(),group=$('catalogGroup').value;const rows=catalogue.options.filter(r=>(!group||String(r.archetype_number)===group)&&(!query||(r.name+' '+r.source_description+' '+r.implementation_note).toLowerCase().includes(query)));$('catalogResults').replaceChildren();for(const r of rows){const d=document.createElement('details'),s=document.createElement('summary'),source=document.createElement('p'),note=document.createElement('p');s.textContent=r.number+'. '+r.name+' \u00b7 proposed';source.textContent=r.source_description;note.textContent='Implementation note: '+r.implementation_note;note.className='notice';d.append(s,source,note);$('catalogResults').append(d);}$('catalogCount').textContent=rows.length+' of 63 records';}\n$('catalogSearch').oninput=showCatalogue;$('catalogGroup').onchange=showCatalogue;showCatalogue();\nsync();cueJSON();requestAnimationFrame(frame);\n})();\n\n\u003c/script>\u003c/body>\u003c/html>\n\n";
let dialog,frame;
function open(){if(!dialog){dialog=document.createElement('dialog');dialog.setAttribute('aria-label','Graphics, animation and framework tools');dialog.style.cssText='width:96vw;max-width:1500px;height:94vh;padding:12px;background:#101b37;color:#fff1ce;border:1px solid #d8b96a;border-radius:14px';let close=document.createElement('button');close.type='button';close.textContent='Close creative tools';close.style.cssText='min-height:44px;padding:8px 16px;margin-bottom:8px';close.onclick=()=>dialog.close();frame=document.createElement('iframe');frame.title='Tabor graphics and animation workshop';frame.style.cssText='display:block;width:100%;height:calc(100% - 60px);border:0';frame.setAttribute('sandbox','allow-scripts allow-same-origin allow-downloads');dialog.append(close,frame);document.body.append(dialog);dialog.addEventListener('close',()=>{frame.srcdoc='';});}frame.srcdoc=studio;dialog.showModal();}
function ready(){const button=document.createElement('button');button.type='button';button.textContent='Art, animation & framework tools';button.style.cssText='display:block;margin:14px 0;min-height:44px';button.onclick=()=>{const prefs=document.querySelector('.mw-preferences');if(prefs&&prefs.open)prefs.close();open();};const prefs=document.querySelector('.mw-preferences');if(prefs)prefs.insertBefore(button,prefs.lastElementChild);else{button.style.position='fixed';button.style.bottom='16px';button.style.left='16px';button.style.zIndex='9000';document.body.append(button);}}
window.TaborCreativeTools={open};if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',ready,{once:true});else ready();
})();
