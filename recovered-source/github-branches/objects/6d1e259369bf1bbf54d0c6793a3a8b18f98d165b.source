/* Nathan AI — Joy Studio v0.1 · Local-first, additive, no external API calls. */
(function(root){
'use strict';
const STORAGE_KEY='nathan-ai-joy-studio-v1';
const THEMES={
 christmas:{name:'Christmas',icon:'🎄',bg:'#dfeee2',accent:'#28533b',ink:'#263c32',title:'Merry & bright',message:'May your days be filled with wonder.',sticker:'✦'},
 birthday:{name:'Birthday',icon:'🎂',bg:'#fae9e3',accent:'#bd6173',ink:'#6d3553',title:'Happy birthday!',message:'A whole new year of wonderful you.',sticker:'★'},
 newyear:{name:'New Year',icon:'✨',bg:'#e8e8f4',accent:'#655c9f',ink:'#352f60',title:'A beautiful new beginning',message:'Here’s to the memories still to come.',sticker:'✧'},
 halloween:{name:'Halloween',icon:'🎃',bg:'#f8e7d5',accent:'#b85b2c',ink:'#3a2725',title:'A little magic',message:'Tricks, treats and happy memories.',sticker:'☾'},
 thanksgiving:{name:'Thanksgiving',icon:'🍂',bg:'#f4e8d6',accent:'#a7763d',ink:'#563d2c',title:'Grateful together',message:'For the moments that make us family.',sticker:'❦'},
 hanukkah:{name:'Hanukkah',icon:'🕎',bg:'#e7eff8',accent:'#5479ae',ink:'#2b4c77',title:'Light & warmth',message:'Wishing you a season full of light.',sticker:'✡'},
 diwali:{name:'Diwali',icon:'🪔',bg:'#fbebcf',accent:'#bd7843',ink:'#7e3b32',title:'Festival of lights',message:'May every little light bring joy.',sticker:'✺'},
 eid:{name:'Eid',icon:'🌙',bg:'#dfece7',accent:'#498979',ink:'#285d54',title:'Eid Mubarak',message:'Peace, blessings and beautiful moments.',sticker:'☪'},
 easter:{name:'Easter',icon:'🌷',bg:'#f2ecf4',accent:'#9776aa',ink:'#4d4b62',title:'Spring is here',message:'May your season bloom with joy.',sticker:'❀'},
 anniversary:{name:'Anniversary',icon:'💝',bg:'#f7e5e4',accent:'#aa6675',ink:'#5b3546',title:'Always & forever',message:'Another chapter of our story.',sticker:'♡'},
 graduation:{name:'Graduation',icon:'🎓',bg:'#e9edf1',accent:'#54728e',ink:'#30495b',title:'You did it!',message:'A world of wonder is waiting.',sticker:'✦'},
 lunar:{name:'Lunar New Year',icon:'🏮',bg:'#f9e5da',accent:'#bd473b',ink:'#6a312c',title:'A year of possibility',message:'Wishing joy and fortune in every season.',sticker:'✿'}
};
const MODULES=[
 ['📅','Fridge Calendar','Birthdays, holidays, memories and iCalendar export.','working'],
 ['🎨','Zero-Scrap Studio','Editable design layers, image import and shareable exports.','working'],
 ['✍','WORDS & Writing','Original phrasing, phonetic hints, reverse text and acrostics.','working'],
 ['▤','Memory Library','Saved pages and portable local backups.','working'],
 ['🔒','Sovereign Privacy','SHA-256 comparison and incident evidence notebook.','working'],
 ['📖','KJV / Strong’s Reader','Separate scripture and concordance adapter; not bundled.','planned'],
 ['᚛','Ogham / Mosaic Reader','Separate language, historical script and game adapters.','planned'],
 ['A–Z','A–Z Matrix','Independent alphabet, inversions and phonetic archive.','planned'],
 ['∞','Epoch & Mythology Lab','Source-aware timelines and labeled hypothesis notebooks.','planned'],
 ['◈','Verified Media Watch','Opt-in public-source discovery and lawful report workflows.','planned'],
 ['☁','Connected Sync','Optional encrypted backups, calendars and approved mail adapters.','planned'],
 ['☆','Holiday Game World','Playable Memory Match, Joy Bingo, 25 doors and creative quests.','working']
];
const HOMOPHONES=[['write','right','rite','wright'],['see','sea'],['one','won'],['two','too','to'],['there','their',"they're"],['hear','here'],['flower','flour'],['peace','piece'],['sun','son'],['night','knight'],['blue','blew']];
const $=id=>document.getElementById(id);
const el=(tag,classes,text)=>{let node=document.createElement(tag);if(classes)node.className=classes;if(text!==undefined)node.textContent=String(text);return node;};
const uid=()=>('j'+(typeof crypto!=='undefined'&&crypto.randomUUID?crypto.randomUUID():Date.now().toString(36)+Math.random().toString(36).slice(2)));
const clamp=(v,lo,hi)=>Math.min(hi,Math.max(lo,Number.isFinite(+v)?+v:lo));
const copy=o=>JSON.parse(JSON.stringify(o));
const isoDate=(year,month,day)=>`${year}-${String(month+1).padStart(2,'0')}-${String(day).padStart(2,'0')}`;
const dateParts=s=>{const m=/^(\d{4})-(\d{2})-(\d{2})$/.exec(s||'');return m?{year:+m[1],month:+m[2]-1,day:+m[3]}:null};
const escapeHtml=s=>String(s??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
const fmtMonth=(y,m)=>new Intl.DateTimeFormat('en',{month:'long',year:'numeric'}).format(new Date(y,m,1));
const pad=(n)=>String(n).padStart(2,'0');
function defaultLayers(theme){const t=THEMES[theme]||THEMES.christmas;return[
 {id:uid(),kind:'sticker',text:t.sticker,x:6,y:8,w:14,h:19,size:86,color:t.accent,rotate:-10},
 {id:uid(),kind:'text',text:t.title,x:18,y:34,w:68,h:22,size:59,color:t.ink,rotate:0},
 {id:uid(),kind:'text',text:t.message,x:21,y:61,w:60,h:12,size:26,color:t.ink,rotate:0},
 {id:uid(),kind:'text',text:'WITH LOVE ✦',x:33,y:84,w:35,h:7,size:19,color:t.accent,rotate:0}];}
function newProject(theme='christmas'){return{id:null,title:(THEMES[theme]||THEMES.christmas).name+' memory',theme,layers:defaultLayers(theme),updatedAt:new Date().toISOString()};}
function cleanLayer(l){if(!l||typeof l!=='object'||!['text','sticker','photo'].includes(l.kind))return null;return{
 id:String(l.id||uid()).slice(0,110),kind:l.kind,text:String(l.text??'').slice(0,5000),
 x:clamp(l.x,0,99),y:clamp(l.y,0,99),w:clamp(l.w,2,100),h:clamp(l.h,2,100),
 size:clamp(l.size,8,180),color:/^#[0-9a-fA-F]{6}$/.test(l.color||'')?l.color:'#284235',rotate:clamp(l.rotate,-180,180),
 img:l.kind==='photo'&&/^data:image\/(png|jpeg|webp);base64,[A-Za-z0-9+/=]+$/.test(l.img||'')?l.img:''};}
function cleanProject(p){if(!p||typeof p!=='object')throw Error('Invalid project');return{
 id:p.id?String(p.id).slice(0,110):null,title:String(p.title||'Untitled memory').slice(0,100),theme:THEMES[p.theme]?p.theme:'christmas',
 layers:(Array.isArray(p.layers)?p.layers:[]).slice(0,80).map(cleanLayer).filter(Boolean),updatedAt:String(p.updatedAt||new Date().toISOString())};}
function icsEscape(s){return String(s??'').replace(/\\/g,'\\\\').replace(/\r?\n/g,'\\n').replace(/;/g,'\\;').replace(/,/g,'\\,');}
function foldIcs(line){const limit=73;let chunks=[];for(let i=0;i<line.length;i+=limit)chunks.push((i?' ':'')+line.slice(i,i+limit));return chunks.join('\r\n');}
function createIcs(events){let lines=['BEGIN:VCALENDAR','VERSION:2.0','PRODID:-//Nathan AI//Joy Studio//EN','CALSCALE:GREGORIAN'];for(const e of events){if(!dateParts(e.date))continue;lines.push('BEGIN:VEVENT','UID:'+String(e.id||uid()).replace(/[^a-zA-Z0-9-]/g,'')+'@joy-studio','DTSTART;VALUE=DATE:'+e.date.replace(/-/g,''),'SUMMARY:'+icsEscape(e.title),'DESCRIPTION:'+icsEscape(e.notes||''),...(e.repeat?['RRULE:FREQ=YEARLY']:[]),'END:VEVENT');}lines.push('END:VCALENDAR');return lines.map(foldIcs).join('\r\n')+'\r\n';}
function nthWeekday(y,m,weekday,n){const first=new Date(y,m,1).getDay();return 1+((weekday-first+7)%7)+(n-1)*7;}
function builtInDates(y,m){const rows=[{date:isoDate(y,0,1),title:'New Year’s Day',kind:'Holiday'},{date:isoDate(y,1,14),title:'Valentine’s Day',kind:'Holiday'},{date:isoDate(y,6,4),title:'Independence Day (US)',kind:'Holiday'},{date:isoDate(y,9,31),title:'Halloween',kind:'Holiday'},{date:isoDate(y,10,nthWeekday(y,10,4,4)),title:'Thanksgiving (US)',kind:'Holiday'},{date:isoDate(y,11,25),title:'Christmas',kind:'Holiday'}];return rows.filter(x=>dateParts(x.date).month===m).map(x=>({...x,id:'builtin-'+x.date,notes:'Built-in date · not an editable personal event',builtin:true}));}
function wordPlay(input,mode){const raw=String(input??'');const words=raw.trim().split(/\s+/).filter(Boolean);switch(mode){
 case'reverse':return words.slice().reverse().join(' ');
 case'letters':return [...raw].reverse().join('');
 case'acrostic':return raw.split(/\n/).map(s=>{const m=s.trim().match(/\p{L}/u);return m?m[0]:''}).join(' · ');
 case'vertical':return words.join('\n');
 default:{let hits=[];for(const group of HOMOPHONES){const found=group.filter(w=>new RegExp('(^|[^a-z])'+w.replace(/[.*+?^${}()|[\]\\]/g,'\\$&')+'(?=$|[^a-z])','i').test(raw));if(found.length)hits.push(found.join(', ')+' → '+group.join(' / '));}return hits.length?hits.join('\n'):'No sample homophone groups found. Your exact original text is untouched.';}
 }}
function safeExternalUrl(value){try{const u=new URL(String(value));return ['http:','https:'].includes(u.protocol)?u.href:null}catch{return null}}
/* Joy Game World v0.2: original creative data stays local. No server or hidden scanners. */
const BINGO_TASKS=[
 'Draw a star','Send a thank-you','Make a birthday card','Share a favorite story','Decorate a photo',
 'Remember a grandparent','Write a poem','Pick a new holiday','Write a kind note','Pin a fridge reminder',
 'Create a silly rhyme','Make a keepsake','FREE JOY ✷','Make someone laugh','Celebrate a small win',
 'Design an invitation','Tell a family story','Try a new greeting','Make a holiday card','Say thank you',
 'Write a memory','Take a nature photo','Plan a celebration','Sing a joyful song','Decorate a scrapbook'
];
const ADVENT_PROMPTS=[
 'What made you smile today?','Share a favorite family tradition.','Describe a moment of kindness.','What is your favorite holiday smell?','Who deserves a thank-you?',
 'What story lives in an old photograph?','Design a greeting from your heart.','Remember a song that feels like home.','What would you place on the refrigerator door?','Tell a childhood celebration story.',
 'Write a note to your future self.','What is something wonderful about winter?','Name someone who inspired you.','What makes a perfect birthday?','Describe your favorite shared meal.',
 'Invent a new holiday tradition.','What made you laugh the hardest?','Write a wish for a friend.','Pick a color that feels joyful.','Recall a surprise you loved.',
 'What good thing did you learn?','Tell a story about a pet or plant.','What are you grateful for?','Create a little poem about light.','Write a message you want to keep forever.'
];
const PROMPTS=[
 ['christmas','Design an old-fashioned Christmas postcard for someone you love.','🎄'],
 ['birthday','Make a birthday card that remembers one wonderful year.','🎂'],
 ['thanksgiving','Build a gratitude page out of five small moments.','🍂'],
 ['halloween','Invent a friendly Halloween character and write their story.','🎃'],
 ['lunar','Make a lantern celebration card with three joyful wishes.','🏮'],
 ['easter','Tell a springtime memory through four colors.','🌷'],
 ['hanukkah','Write a message about a light that keeps shining.','🕎'],
 ['diwali','Design a page of little lights and kind wishes.','🪔'],
 ['eid','Write a beautiful message of peace and togetherness.','🌙'],
 ['anniversary','Make a two-page timeline of your favorite shared moments.','💝'],
 ['graduation','Make a card for a new adventure with a heartfelt message.','🎓'],
 ['newyear','Create a family time capsule to open next year.','✨'],
 ['christmas','Write the funniest note Santa could leave on a fridge.','🎅'],
 ['birthday','Create a party invitation with your own silly rhyme.','🎉'],
 ['thanksgiving','Thank someone who helped turn a hard day around.','💌'],
 ['christmas','Illustrate a winter story with an alliterative acrostic.','❄️'],
 ['anniversary','Turn a favorite photograph into a postcard with a caption.','📸'],
 ['newyear','Plan twelve little celebrations for the next twelve months.','📆'],
 ['halloween','Write a cozy ghost story without a scary ending.','👻'],
 ['graduation','Build a certificate celebrating a tiny victory.','🏅']
];
const STICKERS=['🎄','🎁','🎂','✨','❄️','🎈','💌','❤️','⭐','🌻','🎃','🍂','🎉','🕎','🪔','🌙','🐻','🎀','🏮','📸','☃️','🌷','🎓','🧸'];
const WRITING_TEMPLATES={
 birthday:'Happy birthday!\n\nOne thing I always remember about you is ...\n\nWishing you a year full of wonderful moments.\n',
 christmas:'Wishing you a joyful Christmas, filled with warm memories and good company.\n\nA favorite moment from this year ...\n',
 thanks:'Dear ...\n\nThank you for ...\n\nThat meant a great deal to me because ...\n\nWith appreciation,\n',
 memory:'THE DAY I WANT TO REMEMBER\n\nDate and place: ...\nPeople and moments: ...\nWhat I never want to forget: ...\n',
 invitation:'YOU ARE INVITED!\n\nCelebrating: ...\nDate and time: ...\nPlace: ...\nBring: ...\nRSVP: ...\n',
 poem:'A POEM MADE OF FIRST LETTERS\n\nJ ...\nO ...\nY ...\n'
};
const BADGES=[['first-page','🎨','First Keepsake'],['first-event','📅','Fridge Keeper'],['wordsmith','✍','Wordsmith'],['magnet','📌','Magnificent Magnet'],['match','🃏','Memory Master'],['bingo','🏆','Bingo Star'],['advent','🎁','Door Explorer'],['share','💌','Joy Messenger']];
function defaultGame(){return{xp:0,rewarded:[],history:[],matchWins:0,bingo:{checked:[12],lines:[],round:1},advent:{entries:{},opened:[]}}}
function cleanGame(g){let d=defaultGame(),v=g&&typeof g==='object'?g:{};return{
 xp:clamp(v.xp,0,1000000), rewarded:Array.isArray(v.rewarded)?v.rewarded.filter(x=>typeof x==='string').slice(-3000):[],
 history:Array.isArray(v.history)?v.history.slice(-60):[],matchWins:clamp(v.matchWins,0,100000),
 bingo:{checked:Array.isArray(v.bingo?.checked)?[...new Set([12,...v.bingo.checked.filter(i=>Number.isInteger(i)&&i>=0&&i<=24)])]:[12],lines:Array.isArray(v.bingo?.lines)?v.bingo.lines.filter(Number.isInteger):[],round:clamp(v.bingo?.round,1,100000)},
 advent:{entries:v.advent?.entries&&typeof v.advent.entries==='object'&&!Array.isArray(v.advent.entries)?Object.fromEntries(Object.entries(v.advent.entries).filter(([k,val])=>/^(?:[1-9]|1\d|2[0-5])$/.test(k)).map(([k,val])=>[k,String(val).slice(0,1800)])):{} ,opened:Array.isArray(v.advent?.opened)?[...new Set(v.advent.opened.filter(i=>Number.isInteger(i)&&i>=1&&i<=25))]:[]}
}}
function bingoLines(indices){const checked=new Set(indices),lines=[];for(let r=0;r<5;r++)if(Array.from({length:5},(_,c)=>r*5+c).every(x=>checked.has(x)))lines.push(r);for(let c=0;c<5;c++)if(Array.from({length:5},(_,r)=>r*5+c).every(x=>checked.has(x)))lines.push(5+c);if([0,6,12,18,24].every(x=>checked.has(x)))lines.push(10);if([4,8,12,16,20].every(x=>checked.has(x)))lines.push(11);return lines}
function makeMatchDeck(randomFn=Math.random){const symbols=['🎄','🎁','🧸','🎂','⭐','❄️','🎈','💌'];const deck=symbols.flatMap(s=>[s,s]).map((symbol,i)=>({id:i,symbol,matched:false}));for(let i=deck.length-1;i>0;i--){let j=Math.floor(randomFn()*(i+1));[deck[i],deck[j]]=[deck[j],deck[i]]}return deck}

const API={THEMES,cleanGame,bingoLines,makeMatchDeck,ADVENT_PROMPTS,BINGO_TASKS,WRITING_TEMPLATES,cleanProject,cleanLayer,createIcs,builtInDates,wordPlay,escapeHtml,safeExternalUrl,nthWeekday,defaultLayers};
if(typeof module!=='undefined'&&module.exports)module.exports=API;
if(typeof document==='undefined')return;
const now=new Date();
function load(){try{let v=JSON.parse(localStorage.getItem(STORAGE_KEY)||'null');if(!v||typeof v!=='object')return empty();return{
 projects:Array.isArray(v.projects)?v.projects.slice(0,500).map(p=>{try{return cleanProject(p)}catch{return null}}).filter(Boolean):[],
 events:Array.isArray(v.events)?v.events.filter(x=>x&&dateParts(x.date)).map(x=>({id:String(x.id||uid()),title:String(x.title||''),date:x.date,kind:String(x.kind||'Other'),notes:String(x.notes||''),repeat:!!x.repeat})):[],
 incidents:Array.isArray(v.incidents)?v.incidents.slice(0,500):[],writing:String(v.writing||''),modules:Array.isArray(v.modules)?v.modules.slice(0,100):[],
 magnets:Array.isArray(v.magnets)?v.magnets.filter(x=>x&&typeof x.text==='string').slice(0,120):[],consents:Array.isArray(v.consents)?v.consents.filter(x=>x&&typeof x.asset==='string').slice(0,300):[],game:cleanGame(v.game),
 draft:v.draft?cleanProject(v.draft):newProject()};}catch{return empty()}}
function empty(){return{projects:[],events:[],incidents:[],writing:'',modules:[],magnets:[],consents:[],game:defaultGame(),draft:newProject()}}
let data=load(),project=copy(data.draft),selected=null,month=now.getMonth(),year=now.getFullYear(),editingEvent=null,currentHash='';
function archiveCurrentDraft(){if(!project||!project.layers?.length)return;const old=copy(project);old.id=old.id||uid();old.title=old.title||'Untitled memory';old.updatedAt=new Date().toISOString();const i=data.projects.findIndex(x=>x.id===old.id);if(i<0)data.projects.unshift(old);else data.projects[i]=old;data.projects=data.projects.slice(0,500)}
function persist(){data.draft=copy(project);try{localStorage.setItem(STORAGE_KEY,JSON.stringify(data));return true}catch{notify('Browser storage is full or unavailable. Export a backup or remove large images.');return false}}
function notify(s){const t=$('toast');t.textContent=s;t.classList.add('show');clearTimeout(notify.timer);notify.timer=setTimeout(()=>t.classList.remove('show'),3500)}
function navigate(view){document.querySelectorAll('.view').forEach(n=>n.classList.toggle('active',n.id===view+'View'));document.querySelectorAll('.nav-link').forEach(n=>n.classList.toggle('active',n.dataset.view===view));const labels={home:'Welcome home',calendar:'Fridge calendar',studio:'Scrapbook studio',writing:'Words & writing',library:'Memory library',shield:'Privacy shield',modules:'ONE app universe',game:'Joy Game World'};$('pageName').textContent=labels[view]||view;window.scrollTo(0,0);if(view==='calendar'){renderCalendar();renderMagnets();}if(view==='studio')renderStudio();if(view==='writing')renderWriting();if(view==='library')renderLibrary();if(view==='modules')renderModules();if(view==='shield'){renderIncidents();renderConsent();}if(view==='game')renderGame();if(view==='home')renderHome()}
function download(text,name,mime){let blob=text instanceof Blob?text:new Blob([text],{type:mime||'text/plain;charset=utf-8'});const url=URL.createObjectURL(blob);const a=document.createElement('a');a.href=url;a.download=name;document.body.append(a);a.click();a.remove();setTimeout(()=>URL.revokeObjectURL(url),30000)}
function renderHome(){$('homePageCount').textContent=data.projects.length;$('homeEventCount').textContent=data.events.length}
function renderCalendar(){const start=new Date(year,month,1).getDay();const count=new Date(year,month+1,0).getDate();$('monthHeading').textContent=fmtMonth(year,month);$('eventPanelHeading').textContent=fmtMonth(year,month);const grid=$('calendarGrid');grid.replaceChildren();const items=[...builtInDates(year,month),...data.events.filter(e=>{let p=dateParts(e.date);return p&&p.month===month&&(p.year===year||e.repeat&&p.year<=year)}).map(e=>e.repeat?{...e,date:isoDate(year,month,dateParts(e.date).day)}:e)].sort((a,b)=>a.date.localeCompare(b.date));for(let i=0;i<42;i++){const day=i-start+1;const valid=day>=1&&day<=count;const cell=el('button','calendar-cell'+(valid?'':' inactive'));cell.type='button';cell.disabled=!valid;const key=isoDate(year,month,day);if(valid&&key===isoDate(now.getFullYear(),now.getMonth(),now.getDate()))cell.classList.add('today');cell.append(el('span','calendar-day',valid?day:''));if(valid){for(const e of items.filter(e=>e.date===key).slice(0,3)){const tag=el('span','cal-event '+e.kind.toLowerCase(),e.title);cell.append(tag)}cell.onclick=()=>showEventDialog(null,key)}grid.append(cell)}
 const list=$('eventList');list.replaceChildren();if(!items.length)list.append(el('p','tiny-note','No memories pinned this month. Add a birthday, holiday or reminder!'));for(const e of items){let day=dateParts(e.date).day;let row=el('div','event-item'),chip=el('div','event-date-chip'),details=el('div','event-details');chip.append(el('span',null,new Date(year,month,day).toLocaleDateString('en',{month:'short'})),el('strong',null,day));details.append(el('strong',null,e.title),el('p',null,e.kind+(e.builtin?' · built-in':'')+(e.notes?' · '+e.notes:'')));row.append(chip,details);let createCard=el('button','event-edit','CARD ↗');createCard.title='Design a scrapbook for this event';createCard.onclick=()=>{archiveCurrentDraft();const theme=e.kind==='Birthday'?'birthday':e.kind==='Anniversary'?'anniversary':e.title.toLowerCase().includes('christmas')?'christmas':e.title.toLowerCase().includes('halloween')?'halloween':e.title.toLowerCase().includes('thanksgiving')?'thanksgiving':'birthday';project=newProject(theme);project.title=e.title+' · '+e.date;const headings=project.layers.filter(l=>l.kind==='text');if(headings[0])headings[0].text=e.title;if(headings[1])headings[1].text=(e.notes||'A special day worth remembering')+'\n'+e.date;selected=null;persist();navigate('studio')};row.append(createCard);if(!e.builtin){let edit=el('button','event-edit','EDIT');edit.onclick=()=>showEventDialog(e);row.append(edit)}list.append(row)}}
function showEventDialog(e,date){editingEvent=e?.id||null;$('eventDialogTitle').textContent=e?'Edit this memory':'Pin something to the calendar';$('eventTitle').value=e?.title||'';$('eventDate').value=e?.date||date||isoDate(year,month,now.getDate());$('eventKind').value=e?.kind||'Birthday';$('eventNotes').value=e?.notes||'';$('eventRepeat').checked=!!e?.repeat;$('deleteEventBtn').style.visibility=e?'visible':'hidden';$('eventDialog').showModal()}
function saveEvent(){const title=$('eventTitle').value.trim(),date=$('eventDate').value;if(!title||!dateParts(date)){notify('A title and valid date are required.');return}const e={id:editingEvent||uid(),title,date,kind:$('eventKind').value,notes:$('eventNotes').value,repeat:$('eventRepeat').checked};if(editingEvent){data.events=data.events.map(x=>x.id===editingEvent?e:x)}else data.events.push(e);let parts=dateParts(date);year=parts.year;month=parts.month;persist();renderCalendar();renderHome();awardStars(10,'Pinned a family event','event:'+e.id);notify('Pinned to your family calendar.')}
function deleteEvent(){data.events=data.events.filter(e=>e.id!==editingEvent);editingEvent=null;persist();renderCalendar();renderHome();$('eventDialog').close();notify('Calendar note removed.')}
function renderThemes(){const wrap=$('themeChoices');wrap.replaceChildren();for(const [id,t] of Object.entries(THEMES)){let b=el('button','theme-choice'+(id===project.theme?' active':''));b.type='button';b.append(el('b',null,t.icon),el('span',null,t.name));b.onclick=()=>{snapshot();project.theme=id;selected=null;persist();renderStudio();notify(t.name+' theme applied. Your layers were preserved.')};wrap.append(b)}}
function layerCss(layer){const l=cleanLayer(layer),textSize=l.size/960*100;return`left:${l.x}%;top:${l.y}%;width:${l.w}%;height:${l.h}%;color:${l.color};font-size:${textSize}cqw;transform:rotate(${l.rotate}deg);`}
function renderStudio(){renderThemes();$('designTitle').value=project.title;const t=THEMES[project.theme]||THEMES.christmas;$('canvasThemeLabel').textContent=t.name.toUpperCase();const art=$('artboard');art.style.setProperty('--board-bg',t.bg);art.style.setProperty('--board-accent',t.accent);art.replaceChildren();const bg=el('div','artboard-inner');art.append(bg);art.style.containerType='inline-size';for(const layer of project.layers){const l=cleanLayer(layer);let div=el('div','art-layer'+(selected===l.id?' selected':''));div.dataset.id=l.id;div.dataset.kind=l.kind;div.style.cssText=layerCss(l);if(l.kind==='photo'){if(l.img){const img=el('img');img.src=l.img;img.alt='Uploaded scrapbook photograph';img.draggable=false;div.append(img)}}else{div.textContent=l.text}div.addEventListener('pointerdown',startDrag);div.addEventListener('click',()=>selectLayer(l.id));art.append(div)}$('layerCount').textContent=project.layers.length+' layer'+(project.layers.length!==1?'s':'');renderInspector();renderLayerList()}
function selectLayer(id){selected=id;renderStudio()}
function renderLayerList(){let wrap=$('layersList');wrap.replaceChildren();[...project.layers].reverse().forEach((l,i)=>{let b=el('button','layer-chip'+(selected===l.id?' active':''));b.append(el('span',null,l.kind==='photo'?'▣':l.kind==='sticker'?'✳':'T'),el('span',null,l.kind==='photo'?'Photograph':l.text.slice(0,25)||'Empty layer'));b.onclick=()=>selectLayer(l.id);wrap.append(b)})}
function labeled(parent,label,node){const lab=el('label','field-label',label);parent.append(lab,node);return node}
function inputNumber(l,property,label,min,max){let i=el('input','field');i.type='number';i.min=min;i.max=max;i.value=l[property];i.onchange=()=>{snapshot();l[property]=clamp(i.value,min,max);persist();renderStudio()};return labeled($('inspectorBody'),label,i)}
function renderInspector(){let b=$('inspectorBody');b.replaceChildren();const l=project.layers.find(x=>x.id===selected);if(!l){b.append(el('p',null,'Select a layer to edit it, or add text, a sticker, a heart or a photo.'));return}b.append(el('strong',null,l.kind.toUpperCase()+' LAYER'));if(l.kind!=='photo'){let a=el('textarea','field');a.rows=3;a.value=l.text;a.onfocus=()=>snapshot();a.oninput=()=>{l.text=a.value.slice(0,5000);persist();updateArtText(l)};labeled(b,'Words or symbol',a)}let color=el('input','field');color.type='color';color.value=l.color;color.onfocus=()=>snapshot();color.oninput=()=>{l.color=color.value;persist();updateArtText(l)};labeled(b,'Color',color);const coords=el('div','inspector-row');for(const [prop,label,min,max] of [['x','Left %',0,99],['y','Top %',0,99],['w','Width %',2,100],['h','Height %',2,100],['size','Type size',8,180],['rotate','Rotate °',-180,180]]){let hold=el('div');let i=el('input','field');i.type='number';i.value=l[prop];i.min=min;i.max=max;i.onchange=()=>{snapshot();l[prop]=clamp(i.value,min,max);persist();renderStudio()};hold.append(el('label','field-label',label),i);coords.append(hold)}b.append(coords);let actions=el('div','small-flex');for(const [label,fn] of [['↑ Front',()=>moveLayer(l.id,1)],['↓ Back',()=>moveLayer(l.id,-1)],['× Delete',()=>deleteLayer(l.id)]]){let btn=el('button','btn btn-outline btn-small',label);btn.onclick=fn;actions.append(btn)}b.append(actions)}
function updateArtText(l){let div=[...$('artboard').querySelectorAll('.art-layer')].find(n=>n.dataset.id===l.id);if(!div)return;if(l.kind!=='photo')div.textContent=l.text;div.style.cssText=layerCss(l)}
function addLayer(kind,text){snapshot();let t=THEMES[project.theme],l={id:uid(),kind,text:text||'',x:30,y:30,w:48,h:20,size:kind==='sticker'?80:38,color:t.ink,rotate:0};project.layers.push(l);selected=l.id;persist();renderStudio()}
function moveLayer(id,delta){snapshot();const i=project.layers.findIndex(l=>l.id===id),j=i+delta;if(j<0||j>=project.layers.length)return;const [a]=project.layers.splice(i,1);project.layers.splice(j,0,a);persist();renderStudio()}
function deleteLayer(id){snapshot();project.layers=project.layers.filter(x=>x.id!==id);selected=null;persist();renderStudio()}
let drag=null;function startDrag(ev){if(ev.button!==undefined&&ev.button!==0)return;let div=ev.currentTarget,l=project.layers.find(x=>x.id===div.dataset.id);if(!l)return;selected=l.id;document.querySelectorAll('.art-layer').forEach(n=>n.classList.toggle('selected',n.dataset.id===selected));const rect=$('artboard').getBoundingClientRect();snapshot();drag={id:l.id,startX:ev.clientX,startY:ev.clientY,x:l.x,y:l.y,w:rect.width,h:rect.height};div.setPointerCapture?.(ev.pointerId);div.addEventListener('pointermove',doDrag);div.addEventListener('pointerup',endDrag,{once:true});div.addEventListener('pointercancel',endDrag,{once:true})}
function doDrag(ev){if(!drag)return;let l=project.layers.find(x=>x.id===drag.id);if(!l)return;l.x=clamp(drag.x+(ev.clientX-drag.startX)/drag.w*100,0,100-l.w);l.y=clamp(drag.y+(ev.clientY-drag.startY)/drag.h*100,0,100-l.h);if(snapToGrid){l.x=Math.round(l.x/5)*5;l.y=Math.round(l.y/5)*5};updateArtText(l)}
function endDrag(ev){ev.currentTarget.removeEventListener('pointermove',doDrag);drag=null;persist();renderStudio()}
async function resizeImage(file){if(!file.type.match(/^image\/(png|jpeg|webp)$/))throw Error('Please use PNG, JPG or WebP, not SVG or other active formats.');if(file.size>15*1024*1024)throw Error('Choose an image under 15 MB.');return new Promise((resolve,reject)=>{const img=new Image(),url=URL.createObjectURL(file);img.onload=()=>{URL.revokeObjectURL(url);let scale=Math.min(1,1400/Math.max(img.width,img.height)),canvas=document.createElement('canvas');canvas.width=Math.max(1,Math.round(img.width*scale));canvas.height=Math.max(1,Math.round(img.height*scale));let ctx=canvas.getContext('2d');ctx.drawImage(img,0,0,canvas.width,canvas.height);resolve(canvas.toDataURL('image/jpeg',.84))};img.onerror=()=>{URL.revokeObjectURL(url);reject(Error('Could not read this image.'))};img.src=url})}
async function loadPhoto(e){const f=e.target.files?.[0];e.target.value='';if(!f)return;try{let src=await resizeImage(f);let layer={id:uid(),kind:'photo',text:'',x:22,y:23,w:55,h:53,size:20,color:'#ffffff',rotate:0,img:src};snapshot();project.layers.push(layer);selected=layer.id;persist();renderStudio();notify('Photo added. Saved only in this browser.') }catch(err){notify(err.message)}}
function saveProject(){project.title=$('designTitle').value.trim().slice(0,100)||'Untitled memory';project.updatedAt=new Date().toISOString();project.id=project.id||uid();let found=data.projects.findIndex(p=>p.id===project.id);if(found>=0)data.projects[found]=copy(project);else data.projects.unshift(copy(project));persist();renderHome();awardStars(20,'Saved a memory','save:'+project.id);notify('Design saved in your memory library.');}
function renderLibrary(){if(!$('libraryTheme').dataset.ready){for(const [id,t] of Object.entries(THEMES)){const option=el('option',null,t.name);option.value=id;$('libraryTheme').append(option)}$('libraryTheme').dataset.ready='1'}let grid=$('libraryGrid');grid.replaceChildren();if(!data.projects.length){const e=el('div','empty-state');e.append(el('strong',null,'Your next favorite memory starts here.'),el('p',null,'Create a page in the studio, then save it to this shelf.'));grid.append(e);return}for(const p of data.projects.filter(p=>(p.title+' '+(THEMES[p.theme]?.name||'')).toLowerCase().includes(($('librarySearch')?.value||'').toLowerCase())&&(!$('libraryTheme')?.value||p.theme===$('libraryTheme').value))){let c=el('div','library-card'),pr=el('div','library-preview',p.layers?.find(x=>x.kind==='text')?.text?.slice(0,50)||p.title),t=THEMES[p.theme]||THEMES.christmas;pr.style.background=t.bg;pr.style.color=t.ink;c.append(pr,el('h3',null,p.title),el('p',null,t.name+' · '+new Date(p.updatedAt).toLocaleDateString()));let btns=el('div','library-buttons');let open=el('button','btn btn-dark btn-small','Open');open.onclick=()=>{project=copy(p);selected=null;persist();navigate('studio')};let del=el('button','btn btn-outline btn-small','Delete');del.onclick=()=>{if(confirm('Remove this saved design from this browser?')){data.projects=data.projects.filter(x=>x.id!==p.id);persist();renderLibrary();renderHome()}};let clone=el('button','btn btn-outline btn-small','Duplicate');clone.onclick=()=>{const cloned=copy(p);cloned.id=uid();cloned.title=p.title+' (copy)';cloned.updatedAt=new Date().toISOString();data.projects.unshift(cloned);persist();renderLibrary();notify('Keepsake duplicated without changing the original.')};btns.append(open,clone,del);c.append(btns);grid.append(c)}}
function renderWriting(){$('writingInput').value=data.writing;refreshWord()}
function refreshWord(){const text=$('writingInput').value;const count=text.trim()?text.trim().split(/\s+/).length:0;$('wordCount').textContent=count+' word'+(count===1?'':'s');$('wordResult').textContent=wordPlay(text,$('wordMode').value)}
function fileName(){return (project.title||'joy-memory').toLowerCase().replace(/[^a-z0-9]+/g,'-').replace(/^-|-$/g,'').slice(0,60)||'joy-memory'}
function exportHtml(){const t=THEMES[project.theme];const layers=project.layers.map(l=>{let safe=cleanLayer(l);let inner=l.kind==='photo'&&safe.img?`<img alt="Scrapbook image" src="${safe.img}" style="width:100%;height:100%;object-fit:cover">`:escapeHtml(safe.text).replace(/\n/g,'<br>');return `<div style="position:absolute;left:${safe.x}%;top:${safe.y}%;width:${safe.w}%;height:${safe.h}%;font-size:${safe.size/960*100}cqw;font-family:Georgia,serif;color:${safe.color};transform:rotate(${safe.rotate}deg);white-space:pre-wrap;overflow-wrap:anywhere;overflow:hidden;line-height:1.2">${inner}</div>`}).join('');const html=`<!doctype html><html lang="en"><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>${escapeHtml(project.title)}</title><style>body{background:#f8f8f5;display:grid;place-items:center;min-height:95vh;margin:0}.art{width:min(96vw,960px);aspect-ratio:3/2;background:${t.bg};position:relative;overflow:hidden;container-type:inline-size;border:10px solid #fff;box-shadow:0 5px 40px #0002}@media print{body{background:white}.art{width:100%;border:0;box-shadow:none}}</style><div class="art">${layers}</div></html>`;download(html,fileName()+'.html','text/html;charset=utf-8');awardStars(10,'Exported a standalone page','export:html')}
async function drawPng(){const c=document.createElement('canvas');c.width=960;c.height=640;const ctx=c.getContext('2d'),t=THEMES[project.theme];ctx.fillStyle=t.bg;ctx.fillRect(0,0,960,640);for(const raw of project.layers){const l=cleanLayer(raw);let x=960*l.x/100,y=640*l.y/100,w=960*l.w/100,h=640*l.h/100;ctx.save();ctx.translate(x+w/2,y+h/2);ctx.rotate(l.rotate*Math.PI/180);ctx.beginPath();ctx.rect(-w/2,-h/2,w,h);ctx.clip();if(l.kind==='photo'&&l.img){const image=new Image();await new Promise((resolve,reject)=>{image.onload=resolve;image.onerror=reject;image.src=l.img});const scale=Math.max(w/image.width,h/image.height),iw=image.width*scale,ih=image.height*scale;ctx.drawImage(image,-iw/2,-ih/2,iw,ih)}else{ctx.fillStyle=l.color;ctx.font=`${l.size}px Georgia,serif`;ctx.textBaseline='top';const max=w,lines=[];for(const para of l.text.split('\n')){let current='';for(const word of para.split(/\s+/)){if(ctx.measureText((current?current+' ':'')+word).width>max&&current){lines.push(current);current=word}else current+=(current?' ':'')+word}lines.push(current)}let lineh=l.size*1.2;for(let i=0;i<lines.length&&i*lineh<h;i++)ctx.fillText(lines[i],-w/2,-h/2+i*lineh)}ctx.restore()}return new Promise((res,rej)=>c.toBlob(b=>b?res(b):rej(Error('Canvas export failed')),'image/png'))}
async function exportPng(){try{const blob=await drawPng();download(blob,fileName()+'.png','image/png');awardStars(10,'Exported your image','export:png');notify('PNG downloaded. You can attach it to an email.')}catch(e){notify('Could not export image: '+e.message)}}
function backup(){download(JSON.stringify({format:'nathan-ai-joy-studio',version:1,createdAt:new Date().toISOString(),...data},null,2),'nathan-ai-joy-studio-backup.json','application/json');notify('Local archive downloaded. Keep it somewhere safe.')}
function validateImport(o){if(!o||typeof o!=='object')throw Error('Invalid JSON project');if(o.format==='nathan-ai-joy-studio'){if(!Array.isArray(o.projects)||!Array.isArray(o.events))throw Error('Invalid backup structure');return{kind:'backup',value:o}}if(o.format==='nathan-ai-joy-project'&&o.project)return{kind:'project',value:cleanProject(o.project)};if(Array.isArray(o.layers))return{kind:'project',value:cleanProject(o)};throw Error('Unknown project format')}
async function importFile(e){const f=e.target.files?.[0];e.target.value='';if(!f)return;try{if(f.size>8*1024*1024)throw Error('Import must be under 8 MB');const obj=validateImport(JSON.parse(await f.text()));if(obj.kind==='backup'){if(!confirm('Replace this browser’s projects, events and notes with the imported backup?'))return;data={...empty(),...obj.value,projects:obj.value.projects.map(cleanProject),game:cleanGame(obj.value.game),magnets:Array.isArray(obj.value.magnets)?obj.value.magnets.slice(0,120):[],consents:Array.isArray(obj.value.consents)?obj.value.consents.slice(0,300):[]};project=cleanProject(data.draft||newProject());selected=null;persist();notify('Backup restored.')}else{let p=obj.value;p.id=uid();data.projects.unshift(p);project=copy(p);selected=null;persist();notify('Editable project imported.')}navigate('library')}catch(err){notify('Import failed: '+err.message)}}
function exportProject(){download(JSON.stringify({format:'nathan-ai-joy-project',version:1,project:cleanProject(project)},null,2),fileName()+'.joy-project.json','application/json');awardStars(10,'Exported an editable design','export:json')}
async function shareDevice(){try{const blob=await drawPng();const file=new File([blob],fileName()+'.png',{type:'image/png'});if(navigator.share&&navigator.canShare?.({files:[file]})){await navigator.share({files:[file],title:project.title,text:'A memory made with Nathan AI Joy Studio'});awardStars(10,'Shared your creation','export:device')}else{download(blob,fileName()+'.png','image/png');notify('Device sharing is unavailable here. PNG downloaded; attach it from your files.')}}catch(err){if(err.name!=='AbortError')notify('Sharing could not start: '+err.message)}}
function shareEmail(){const subject=encodeURIComponent('A memory for you — '+project.title),body=encodeURIComponent('I made a memory I wanted to share with you.\n\nI have attached the exported card to this email.\n\nWith love');location.href='mailto:?subject='+subject+'&body='+body;awardStars(10,'Prepared a memory to share','export:email');notify('Email draft opened. Attach your downloaded card manually.')}
function printPage(){window.print()}
function renderModules(){const grid=$('modulesGrid');grid.replaceChildren();for(const [icon,name,desc,status] of MODULES){const c=el('div','module-card');c.append(el('span','module-icon',icon),el('h3',null,name),el('p',null,desc),el('span','module-status '+(status==='planned'?'planned':''),status==='working'?'● WORKING IN THIS APP':'◇ SEPARATE / PLANNED ADAPTER'));grid.append(c)}const wrap=$('customModules');wrap.replaceChildren();for(const m of data.modules){const b=el('div','incident-row'),left=el('span',null,m.name+' · '+m.url),open=el('button','btn btn-outline btn-small','Open ↗'),del=el('button','btn btn-outline btn-small','×');open.onclick=()=>window.open(m.url,'_blank','noopener,noreferrer');del.onclick=()=>{data.modules=data.modules.filter(x=>x.id!==m.id);persist();renderModules()};b.append(left,open,del);wrap.append(b)}}
function addModule(){let name=$('moduleName').value.trim().slice(0,80),url=safeExternalUrl($('moduleUrl').value);if(!name||!url){notify('Enter a name and a valid http(s) address.');return}data.modules.push({id:uid(),name,url});persist();$('moduleName').value='';$('moduleUrl').value='';renderModules();notify('External launcher saved. No project data is shared.')}
function renderIncidents(){let list=$('incidentList');list.replaceChildren();if(!data.incidents.length)list.append(el('p','tiny-note','No incidents recorded.'));for(const item of data.incidents){let row=el('div','incident-row'),content=el('div'),b=el('button','btn btn-outline btn-small','Delete');content.append(el('strong',null,item.desc),el('span',null,new Date(item.date).toLocaleString()+(item.url?' · '+item.url:'')));b.onclick=()=>{data.incidents=data.incidents.filter(x=>x.id!==item.id);persist();renderIncidents()};row.append(content,b);list.append(row)}}
function addIncident(){const desc=$('incidentDesc').value.trim(),url=$('incidentUrl').value.trim();if(!desc){notify('Describe what you observed first.');return}if(url&&!safeExternalUrl(url)){notify('Use an http(s) URL or leave it blank.');return}data.incidents.unshift({id:uid(),date:new Date().toISOString(),desc:desc.slice(0,300),url:safeExternalUrl(url)||''});persist();$('incidentDesc').value='';$('incidentUrl').value='';renderIncidents();notify('Incident recorded locally.')}
function reportTemplate(){const incident=data.incidents[0];const text='Subject: Request for review of potentially unauthorized image or video use\n\nHello,\n\nI would like to report potentially unauthorized use of an image or video featuring me or an asset I own.\n\nPage URL: '+(incident?.url||'[insert public URL]')+'\nDetails: '+(incident?.desc||'[describe the content and your rights/consent status]')+'\n\nPlease review this report under your platform policies and applicable law, and tell me what documentation is needed for a removal request.\n\nThank you.';navigator.clipboard?.writeText(text).then(()=>notify('Review request copied.')).catch(()=>notify('Clipboard unavailable in this browser.'))}
async function hashFile(file){if(!file)throw Error('Select a file');if(!crypto?.subtle)throw Error('Secure browser context required for SHA-256');const bytes=await file.arrayBuffer(),digest=await crypto.subtle.digest('SHA-256',bytes);return[...new Uint8Array(digest)].map(b=>b.toString(16).padStart(2,'0')).join('')}
async function makeHash(){const f=$('hashFileInput').files?.[0];if(!f)return;try{currentHash=await hashFile(f);$('hashOutput').textContent=`${f.name}\nSHA-256: ${currentHash}`;$('copyHashBtn').disabled=false;notify('Exact-file fingerprint calculated locally.')}catch(e){notify(e.message)}}
async function compareHash(){const a=$('compareA').files?.[0],b=$('compareB').files?.[0];if(!a||!b){notify('Choose both files.');return}try{let [ha,hb]=await Promise.all([hashFile(a),hashFile(b)]);$('compareResult').textContent=ha===hb?'Exact match: these files have the same SHA-256 fingerprint. This does not establish rights or consent.':'Different bytes: the hashes do not match. This does NOT rule out re-encoding, cropping or an altered copy.'}catch(e){notify(e.message)}}
function safeClipboard(text){if(!text)return; if(navigator.clipboard?.writeText)navigator.clipboard.writeText(text).then(()=>notify('Copied.')).catch(()=>notify('Clipboard access unavailable.'));else notify('Clipboard unavailable.')}
const undoHistory=[],redoHistory=[];
function snapshot(){undoHistory.push(copy(project));if(undoHistory.length>50)undoHistory.shift();redoHistory.length=0;updateUndoButtons()}
function updateUndoButtons(){if($('undoBtn'))$('undoBtn').disabled=!undoHistory.length;if($('redoBtn'))$('redoBtn').disabled=!redoHistory.length}
function undoDesign(){if(!undoHistory.length)return;redoHistory.push(copy(project));project=undoHistory.pop();selected=null;persist();renderStudio();updateUndoButtons();notify('Last design change undone.')}
function redoDesign(){if(!redoHistory.length)return;undoHistory.push(copy(project));project=redoHistory.pop();selected=null;persist();renderStudio();updateUndoButtons();notify('Design change restored.')}
function duplicateSelected(){const l=project.layers.find(x=>x.id===selected);if(!l)return notify('Select a layer first.');snapshot();const duplicate=copy(l);duplicate.id=uid();duplicate.x=clamp(duplicate.x+4,0,99);duplicate.y=clamp(duplicate.y+4,0,99);project.layers.push(duplicate);selected=duplicate.id;persist();renderStudio();notify('Layer duplicated. Original preserved.')}
let snapToGrid=false;
function renderStickerShelf(){const wrap=$('stickerShelf');wrap.replaceChildren();for(const sticker of STICKERS){let b=el('button','sticker-pick',sticker);b.type='button';b.title='Add sticker '+sticker;b.setAttribute('aria-label','Add '+sticker+' sticker');b.onclick=()=>addLayer('sticker',sticker);wrap.append(b)}}
function applyPreset(type){if(!confirm('Start a new '+type+' layout? Your current draft will be preserved in the Memory Library.'))return;archiveCurrentDraft();const theme=project.theme,p=newProject(theme),t=THEMES[theme];p.title={postcard:'Postcard',invitation:'Party invitation',photo:'Photo keepsake',gratitude:'Thank-you note'}[type]+' · '+t.name;
 if(type==='postcard')p.layers=defaultLayers(theme);
 if(type==='invitation')p.layers=[{id:uid(),kind:'text',text:'YOU ARE INVITED!',x:17,y:17,w:67,h:22,size:65,color:t.accent,rotate:0},{id:uid(),kind:'text',text:'Celebration: ...\nDate & time: ...\nPlace: ...\nRSVP: ...',x:23,y:48,w:60,h:34,size:29,color:t.ink,rotate:0}];
 if(type==='photo')p.layers=[{id:uid(),kind:'text',text:'A MOMENT TO TREASURE',x:20,y:6,w:65,h:12,size:38,color:t.ink,rotate:0},{id:uid(),kind:'text',text:'Tap Photo to add your favorite picture.\nWrite a caption here ...',x:17,y:78,w:73,h:16,size:24,color:t.accent,rotate:0}];
 if(type==='gratitude')p.layers=[{id:uid(),kind:'sticker',text:'💌',x:38,y:9,w:24,h:25,size:110,color:t.accent,rotate:0},{id:uid(),kind:'text',text:'Thank you for everything.',x:16,y:40,w:70,h:15,size:49,color:t.ink,rotate:0},{id:uid(),kind:'text',text:'I am grateful for ...',x:17,y:65,w:70,h:12,size:27,color:t.accent,rotate:0}];
 snapshot();project=p;selected=null;persist();renderStudio();notify('New layout ready. Make it yours.')}
function getBadgeIds(){const r=[];if(data.projects.length)r.push('first-page');if(data.events.length)r.push('first-event');if(data.writing.trim().length>=60)r.push('wordsmith');if(data.magnets.length)r.push('magnet');if(data.game.matchWins)r.push('match');if(data.game.bingo.lines.length)r.push('bingo');if(data.game.advent.opened.length)r.push('advent');if(data.game.rewarded.some(x=>x.startsWith('export:')))r.push('share');return r}
function awardStars(points,label,key){if(key&&data.game.rewarded.includes(key))return false;if(key)data.game.rewarded.push(key);data.game.xp=clamp(data.game.xp+points,0,1000000);data.game.history.unshift({at:new Date().toISOString(),points,label});data.game.history=data.game.history.slice(0,60);persist();if(document.querySelector('#gameView.active'))renderGameStats();notify('✷ +'+points+' joy stars · '+label);return true}
function renderGameStats(){const game=data.game,lv=1+Math.floor(game.xp/100),filled=game.xp%100;$('gameLevel').textContent='Level '+lv+' · '+(['Little Spark','Bright Idea','Memory Maker','Celebration Star','Joy Keeper'][(lv-1)%5]);$('gameXp').textContent=game.xp;$('gameSummary').textContent=(100-filled)+' stars to the next level · '+game.matchWins+' Memory Match wins';$('gameLevelFill').style.width=filled+'%';const earned=getBadgeIds();$('gameBadgesCount').textContent=earned.length;let shelf=$('gameBadges');shelf.replaceChildren();for(const [id,icon,label] of BADGES){const isEarned=earned.includes(id);let b=el('div','earned-badge'+(isEarned?'':' locked'));b.append(el('span',null,isEarned?icon:'◇'),el('span',null,label));b.title=isEarned?'Earned!':'Complete an activity to unlock';shelf.append(b)}
 const quests=[['🎨','Save your first scrapbook','first-page'],['📅','Pin a family celebration','first-event'],['✍','Write at least sixty characters','wordsmith'],['📌','Leave a note on the fridge','magnet'],['🃏','Win Holiday Memory Match','match'],['🏆','Finish one bingo line','bingo'],['🎁','Record a 25 Doors memory','advent'],['💌','Export a keepsake','share']];let list=$('questList');list.replaceChildren();for(const [icon,title,id] of quests){const done=earned.includes(id),row=el('div','quest-item'+(done?' complete':'')),head=el('div');head.append(el('strong',null,title),el('p',null,done?'Achievement unlocked':'Make a little joy in the studio or game'));row.append(el('span','quest-icon',icon),head,el('span','quest-points',done?'✓ DONE':'☆ TO DO'));list.append(row)}}
let match={deck:makeMatchDeck(),selected:[],matched:0,moves:0,busy:false,completed:false};
function resetMatch(){match={deck:makeMatchDeck(),selected:[],matched:0,moves:0,busy:false,completed:false};renderMatch()}
function renderMatch(){let grid=$('matchGrid');grid.replaceChildren();$('matchMoves').textContent=match.moves+' move'+(match.moves!==1?'s':'');$('matchPairs').textContent=match.matched+' / 8 pairs';$('matchMessage').textContent=match.completed?'✷ You matched them all!':'Find each matching pair';match.deck.forEach((card,i)=>{let faceUp=match.selected.includes(i)||card.matched;let b=el('button','match-tile'+(faceUp?'':' face-down')+(card.matched?' matched':''));b.type='button';b.disabled=match.busy||card.matched||match.selected.includes(i)||match.completed;b.setAttribute('aria-label',card.matched?'Matched '+card.symbol:faceUp?'Revealed '+card.symbol:'Hidden card '+(i+1));let span=el('span',null,faceUp?card.symbol:'✦');b.append(span);b.onclick=()=>flipMatch(i);grid.append(b)})}
function flipMatch(index){if(match.busy||match.completed||match.selected.includes(index)||match.deck[index].matched)return;match.selected.push(index);if(match.selected.length===2){match.moves++;const [a,b]=match.selected;if(match.deck[a].symbol===match.deck[b].symbol){match.deck[a].matched=true;match.deck[b].matched=true;match.matched++;match.selected=[];if(match.matched===8){match.completed=true;data.game.matchWins++;awardStars(40,'Holiday Memory Match winner');}renderMatch()}else{match.busy=true;renderMatch();setTimeout(()=>{match.selected=[];match.busy=false;renderMatch()},750)}}else renderMatch()}
let selectedDoor=null;
function renderAdvent(){const grid=$('adventGrid');grid.replaceChildren();$('adventCount').textContent=data.game.advent.opened.length;for(let i=1;i<=25;i++){let opened=data.game.advent.opened.includes(i);let b=el('button','advent-door'+(opened?' opened':'')+(selectedDoor===i?' selected':''),opened?'✦ '+i:i);b.type='button';b.setAttribute('aria-label',(opened?'Opened':'Open')+' door '+i);b.onclick=()=>selectDoor(i);grid.append(b)}renderDoorDetail()}
function selectDoor(i){selectedDoor=i;const advent=data.game.advent;if(!advent.opened.includes(i)){advent.opened.push(i);persist();notify('Door '+i+' opened! Write a memory to earn joy stars.')}renderAdvent()}
function renderDoorDetail(){const wrap=$('adventEntry');wrap.replaceChildren();if(!selectedDoor){wrap.append(el('p',null,'Select any numbered door. All twenty-five doors are available all year.'));return}const i=selectedDoor;wrap.append(el('h4',null,'Door '+i+' · '+ADVENT_PROMPTS[i-1]),el('p',null,'Write something, or use the prompt in your scrapbook.'));const box=el('textarea','field');box.placeholder='A memory, a wish, a note...';box.maxLength=1800;box.value=data.game.advent.entries[i]||'';box.id='adventNote';wrap.append(box);const actions=el('div','small-flex'),save=el('button','btn btn-gold btn-small','Save memory + 15 ✷'),create=el('button','btn btn-outline btn-small','Make a card ↗');save.onclick=()=>{const val=box.value.trim();if(!val)return notify('Add a few words first.');data.game.advent.entries[i]=val;persist();awardStars(15,'Door '+i+' memory','advent:'+i);renderAdvent()};create.onclick=()=>{const v=box.value.trim()||ADVENT_PROMPTS[i-1];archiveCurrentDraft();project=newProject('christmas');project.title='Door '+i+' · A little memory';project.layers.find(l=>l.kind==='text').text=v;selected=null;persist();navigate('studio')};actions.append(save,create);wrap.append(actions)}
function renderBingo(){const grid=$('bingoGrid');grid.replaceChildren();const b=data.game.bingo;BINGO_TASKS.forEach((task,i)=>{let isChecked=b.checked.includes(i),tile=el('button','bingo-square'+(isChecked?' checked':'')+(i===12?' center':''),i===12?'FREE ✷':task);tile.type='button';tile.setAttribute('aria-pressed',String(isChecked));tile.disabled=i===12;tile.onclick=()=>toggleBingo(i);grid.append(tile)});$('bingoStatus').textContent=b.lines.length?b.lines.length+' bingo line'+(b.lines.length===1?'':'s')+'! Keep going for another.':'Fill any 5 in a row · horizontal, vertical or diagonal.'}
function toggleBingo(i){const b=data.game.bingo;if(b.checked.includes(i))b.checked=b.checked.filter(x=>x!==i);else{b.checked.push(i);awardStars(2,'Bingo square','bingo-cell:'+b.round+':'+i)}const lines=bingoLines(b.checked);for(const l of lines){if(!b.lines.includes(l)){b.lines.push(l);awardStars(35,'BINGO! Five in a row','bingo-line:'+b.round+':'+l)}}persist();renderBingo();renderGameStats()}
function resetBingo(){if(!confirm('Start a fresh bingo board? The previous marks will be cleared, but earned stars stay.'))return;data.game.bingo={checked:[12],lines:[],round:data.game.bingo.round+1};persist();renderBingo();renderGameStats()}
let currentPrompt=PROMPTS[0];
function spinPrompt(){const index=Math.floor(Math.random()*PROMPTS.length);currentPrompt=PROMPTS[index];$('promptSymbol').textContent=currentPrompt[2];$('promptText').textContent=currentPrompt[1];$('promptTheme').textContent=THEMES[currentPrompt[0]].name.toUpperCase()+' · YOUR OWN STORY'}
function createPromptCard(){const [theme,prompt]=currentPrompt;archiveCurrentDraft();snapshot();project=newProject(theme);project.title='Joy Quest · '+THEMES[theme].name;const textLayers=project.layers.filter(l=>l.kind==='text');if(textLayers.length>=2){textLayers[0].text='A LITTLE JOY QUEST';textLayers[1].text=prompt;textLayers[1].size=27;textLayers[1].h=25}selected=null;persist();navigate('studio');notify('Creative quest card ready to decorate.')}
function renderGame(){renderGameStats();renderMatch();renderAdvent();renderBingo();spinPrompt()}
function renderMagnets(){const wall=$('magnetWall');wall.replaceChildren();if(!data.magnets.length){wall.append(el('p','tiny-note','Your fridge is ready for a family note, a wish, a reminder, or a silly idea.'));return}for(const item of data.magnets){let card=el('article','magnet-note'),words=el('p',null,item.text),actions=el('div','magnet-actions'),make=el('button',null,'Make card ↗'),del=el('button',null,'× Remove');make.onclick=()=>{archiveCurrentDraft();snapshot();project=newProject('birthday');project.title='From the family fridge';const t=project.layers.find(x=>x.kind==='text');if(t)t.text=item.text;persist();navigate('studio')};del.onclick=()=>{data.magnets=data.magnets.filter(x=>x.id!==item.id);persist();renderMagnets()};actions.append(make,del);card.append(words,actions);wall.append(card)}}
function pinMagnet(){const text=$('magnetInput').value.trim();if(!text)return notify('Write something to pin.');data.magnets.unshift({id:uid(),text:text.slice(0,250),at:new Date().toISOString()});persist();$('magnetInput').value='';awardStars(10,'Pinned a fridge magnet','magnet:first');renderMagnets()}
function renderConsent(){const wrap=$('consentList');wrap.replaceChildren();if(!data.consents.length){wrap.append(el('p','tiny-note','Nothing recorded yet. This notebook tracks your own sharing decisions; it does not enforce removal elsewhere.'));return}for(const c of data.consents){const row=el('div','consent-item'),details=el('div'),stat=el('em',null,{private:'PRIVATE',allowed:'ALLOWED',revoked:'WITHDRAWN'}[c.status]||'UNKNOWN'),del=el('button','btn btn-outline btn-small','Delete');details.append(el('strong',null,c.asset),el('span',null,(c.party||'No recipient')+' · '+new Date(c.at).toLocaleDateString()));del.onclick=()=>{data.consents=data.consents.filter(x=>x.id!==c.id);persist();renderConsent()};row.append(details,stat,del);wrap.append(row)}}
function recordConsent(){const asset=$('consentAsset').value.trim().slice(0,90),party=$('consentParty').value.trim().slice(0,100),status=$('consentStatus').value;if(!asset)return notify('Name an asset to record.');data.consents.unshift({id:uid(),asset,party,status,at:new Date().toISOString()});persist();$('consentAsset').value='';$('consentParty').value='';renderConsent();notify('Permission decision recorded locally.')}
function insertWritingTemplate(){const kind=$('writingTemplate').value;if(!WRITING_TEMPLATES[kind])return notify('Choose a writing idea.');const area=$('writingInput');area.value+=(area.value.trim()?'\n\n':'')+WRITING_TEMPLATES[kind];data.writing=area.value;persist();refreshWord();notify('Idea inserted. Existing words preserved.')}
function readWriting(){if(!('speechSynthesis' in window))return notify('Read aloud is not available in this browser.');const synth=window.speechSynthesis;if(synth.speaking){synth.cancel();return notify('Reading stopped.')}const val=$('writingInput').value;if(!val.trim())return notify('Write a few words first.');let u=new SpeechSynthesisUtterance(val.slice(0,5000));u.lang='en-US';u.rate=.95;synth.speak(u);notify('Reading aloud; press again to stop.')}

function bind(){document.querySelectorAll('.nav-link').forEach(n=>n.addEventListener('click',()=>navigate(n.dataset.view)));document.querySelectorAll('[data-goto]').forEach(n=>n.addEventListener('click',()=>navigate(n.dataset.goto)));$('currentDate').textContent=now.toLocaleDateString('en',{month:'short',day:'numeric',year:'numeric'});$('backupBtn').onclick=backup;$('prevMonth').onclick=()=>{month--;if(month<0){year--;month=11}renderCalendar()};$('nextMonth').onclick=()=>{month++;if(month>11){year++;month=0}renderCalendar()};$('addEventBtn').onclick=()=>showEventDialog(null,isoDate(year,month,1));$('eventForm').addEventListener('submit',e=>{if(e.submitter?.value==='cancel')return;e.preventDefault();saveEvent();$('eventDialog').close()});$('deleteEventBtn').onclick=deleteEvent;$('icsBtn').onclick=()=>{download(createIcs(data.events),'joy-studio-family-calendar.ics','text/calendar');notify('Calendar exported in iCalendar format.')};$('newPageBtn').onclick=()=>{archiveCurrentDraft();snapshot();project=newProject();selected=null;persist();renderStudio();notify('Fresh board ready; previous draft preserved in the library.')};$('savePageBtn').onclick=saveProject;$('designTitle').oninput=e=>{project.title=e.target.value;persist()};$('addTextBtn').onclick=()=>addLayer('text','Your beautiful words here');$('addStickerBtn').onclick=()=>addLayer('sticker','✦');$('addHeartBtn').onclick=()=>addLayer('sticker','♡');$('addPhotoBtn').onclick=()=>$('imageInput').click();$('imageInput').addEventListener('change',loadPhoto);$('sharePageBtn').onclick=()=>{$('shareDialog').showModal()};$('closeShareBtn').onclick=()=>$('shareDialog').close();$('exportPngBtn').onclick=exportPng;$('exportHtmlBtn').onclick=exportHtml;$('exportProjectBtn').onclick=exportProject;$('emailBtn').onclick=shareEmail;$('shareDeviceBtn').onclick=shareDevice;$('printBtn').onclick=printPage;$('writingInput').addEventListener('input',()=>{data.writing=$('writingInput').value;persist();refreshWord();if(data.writing.trim().length>=60)awardStars(12,'Wrote your story','writing:first60')});$('wordMode').onchange=refreshWord;$('copyWordBtn').onclick=()=>safeClipboard($('wordResult').textContent);$('writeToCanvasBtn').onclick=()=>{let txt=$('writingInput').value.trim();if(!txt){notify('Write something first.');return}navigate('studio');addLayer('text',txt.slice(0,5000))};$('importBtn').onclick=()=>$('importInput').click();$('importInput').addEventListener('change',importFile);$('hashFileInput').onchange=makeHash;$('copyHashBtn').onclick=()=>safeClipboard(currentHash);$('compareBtn').onclick=compareHash;$('addIncidentBtn').onclick=addIncident;$('copyNoticeBtn').onclick=reportTemplate;$('addModuleBtn').onclick=addModule;$('matchRestartBtn').onclick=resetMatch;$('bingoResetBtn').onclick=resetBingo;$('promptSpinBtn').onclick=spinPrompt;$('promptCreateBtn').onclick=createPromptCard;$('pinMagnetBtn').onclick=pinMagnet;$('recordConsentBtn').onclick=recordConsent;$('undoBtn').onclick=undoDesign;$('redoBtn').onclick=redoDesign;$('duplicateBtn').onclick=duplicateSelected;$('snapBtn').onclick=()=>{snapToGrid=!snapToGrid;$('snapBtn').textContent='# Snap: '+(snapToGrid?'on':'off');$('snapBtn').setAttribute('aria-pressed',String(snapToGrid))};$('addWritingTemplate').onclick=insertWritingTemplate;$('readWritingBtn').onclick=readWriting;$('librarySearch').oninput=renderLibrary;$('libraryTheme').onchange=renderLibrary;document.querySelectorAll('[data-preset]').forEach(n=>n.onclick=()=>applyPreset(n.dataset.preset));renderStickerShelf();updateUndoButtons();document.addEventListener('keydown',e=>{if((e.ctrlKey||e.metaKey)&&e.key.toLowerCase()==='s'){e.preventDefault();if(document.querySelector('#studioView.active'))saveProject()}if((e.ctrlKey||e.metaKey)&&e.key.toLowerCase()==='z'&&document.querySelector('#studioView.active')&&!['INPUT','TEXTAREA'].includes(document.activeElement?.tagName)){e.preventDefault();if(e.shiftKey)redoDesign();else undoDesign()}if(['ArrowUp','ArrowDown','ArrowLeft','ArrowRight'].includes(e.key)&&selected&&document.querySelector('#studioView.active')&&!['INPUT','TEXTAREA','SELECT'].includes(document.activeElement?.tagName)){const l=project.layers.find(x=>x.id===selected);if(l){e.preventDefault();snapshot();const d=e.shiftKey?5:1;if(e.key==='ArrowUp')l.y=clamp(l.y-d,0,99);if(e.key==='ArrowDown')l.y=clamp(l.y+d,0,99);if(e.key==='ArrowLeft')l.x=clamp(l.x-d,0,99);if(e.key==='ArrowRight')l.x=clamp(l.x+d,0,99);persist();renderStudio()}}if(e.key==='Delete'&&selected&&document.activeElement?.tagName!=='INPUT'&&document.activeElement?.tagName!=='TEXTAREA'&&document.querySelector('#studioView.active'))deleteLayer(selected)})}
bind();navigate('home');
if(typeof navigator!=='undefined'&&'serviceWorker' in navigator&&(location.protocol==='https:'||location.hostname==='localhost')){navigator.serviceWorker.register('./sw.js').catch(()=>{});}
})(typeof globalThis!=='undefined'?globalThis:this);
