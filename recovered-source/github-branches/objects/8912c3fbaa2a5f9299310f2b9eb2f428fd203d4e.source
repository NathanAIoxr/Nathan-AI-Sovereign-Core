/* Elemental State Engine 1.0 — original local prototype; zero paid resources. */
(function(root,factory){const api=factory();if(typeof module==='object'&&module.exports)module.exports=api;else root.ElementalEngine=api})(typeof globalThis!=='undefined'?globalThis:this,function(){'use strict';
const ELEMENTS=['FIRE','NATURE','ICE','HOLY','DARK'];
const SPEED={VERY_FAST:6.5,FAST:8,AVERAGE:10,SLOW:12,VERY_SLOW:13.5};
const FEATURES={gravity:{label:'Gravity wells',available:true},quantum:{label:'Changing elements',available:true},shockwaves:{label:'Cracking cascades',available:true},environment:{label:'Reactive battlefield',available:true},echoRaids:{label:'Live echo raids',available:false,reason:'Requires recorded opponents and authenticated server replay.'},settlement:{label:'Connected settlement',available:true},forge:{label:'Custom equipment forge',available:true},atmosphere:{label:'Time and weather ambience',available:true},mentor:{label:'Local strategy hints',available:true,note:'Rules-based analysis; not a trained neural network.'},trade:{label:'Alliance exchange',available:false,reason:'Requires accounts, server inventory, and atomic transfers.'},mastery:{label:'Hero mastery and fatigue',available:true},titans:{label:'Shared World Titans',available:false,reason:'Requires live shared boss state and server reconciliation.'},replays:{label:'Tactical replays',available:true}};
function mult(a,b){return({FIRE:'NATURE',NATURE:'ICE',ICE:'FIRE',HOLY:'DARK',DARK:'HOLY'})[a]===b?2:({FIRE:'ICE',NATURE:'FIRE',ICE:'NATURE'})[a]===b?.5:1}
class RNG{constructor(seed=42){if(!Number.isInteger(seed))throw Error('Integer seed required');this.s=seed>>>0||0x6d2b79f5}next(){this.s^=this.s<<13;this.s^=this.s>>>17;this.s^=this.s<<5;return(this.s>>>0)/4294967296}tile(){return Math.floor(this.next()*5)}}
class Engine{
 constructor({rows=7,cols=5,seed=42,features={}}={}){if(!Number.isInteger(rows)||!Number.isInteger(cols)||rows<3||cols<3||rows>12||cols>12)throw Error('Board dimensions must be integers between 3 and 12');this.rows=rows;this.cols=cols;this.seed=seed;this.rng=new RNG(seed);this.features={};for(const k of Object.keys(FEATURES))this.features[k]=!!features[k]&&FEATURES[k].available;this.turn=0;this.log=[];this.heroes=[];this.enemies=Array.from({length:cols},(_,i)=>({hp:240,element:ELEMENTS[i%5]}));this.terrain=Array.from({length:cols},(_,i)=>i%2?'water':'forest');this.wells=[];this.cracks={};this.mastery=0;this.fatigue=0;this.generate()}
 generate(){for(let n=0;n<200;n++){this.board=Array.from({length:this.rows},()=>Array(this.cols).fill(0));for(let r=0;r<this.rows;r++)for(let c=0;c<this.cols;c++){let choices=[0,1,2,3,4].filter(v=>!(c>1&&this.board[r][c-1]===v&&this.board[r][c-2]===v)&&!(r>1&&this.board[r-1][c]===v&&this.board[r-2][c]===v));this.board[r][c]=choices[Math.floor(this.rng.next()*choices.length)]}if(this.moves().length)return}throw Error('Unable to generate playable board')}
 valid(r,c){return Number.isInteger(r)&&Number.isInteger(c)&&r>=0&&r<this.rows&&c>=0&&c<this.cols}
 scan(){let set=new Set(),groups=[];for(let r=0;r<this.rows;r++){let c=0;while(c<this.cols){let end=c+1;while(end<this.cols&&this.board[r][end]===this.board[r][c])end++;if(end-c>=3){let group=[];for(let j=c;j<end;j++){group.push([r,j]);set.add(r*this.cols+j)}groups.push(group)}c=end}}for(let c=0;c<this.cols;c++){let r=0;while(r<this.rows){let end=r+1;while(end<this.rows&&this.board[end][c]===this.board[r][c])end++;if(end-r>=3){let group=[];for(let j=r;j<end;j++){group.push([j,c]);set.add(j*this.cols+c)}groups.push(group)}r=end}}return{cells:[...set].sort((a,b)=>a-b).map(i=>[Math.floor(i/this.cols),i%this.cols]),groups}}
 exchange(a,b){[this.board[a[0]][a[1]],this.board[b[0]][b[1]]]=[this.board[b[0]][b[1]],this.board[a[0]][a[1]]]}
 moves(phase=0){let out=[];for(let r=0;r<this.rows;r++)for(let c=0;c<this.cols;c++)for(const b of [[r,c+1],[r+1,c]]){if(!this.valid(...b))continue;let a=[r,c],q=[(this.turn+1)%this.rows,this.turn%this.cols],previous;if(this.features.quantum&&this.turn%3===2&&[a,b].some(p=>p[0]===q[0]&&p[1]===q[1])){previous=this.board[q[0]][q[1]];this.board[q[0]][q[1]]=phase?2:0;}this.exchange(a,b);let scan=this.scan();this.exchange(a,b);if(previous!==undefined)this.board[q[0]][q[1]]=previous;if(scan.cells.length)out.push({a,b,count:scan.cells.length})}return out.sort((a,b)=>b.count-a.count)}
 configure(slot,hero){if(!Number.isInteger(slot)||slot<0||slot>=this.cols||!ELEMENTS.includes(hero.element)||!Object.hasOwn(SPEED,hero.speed)||!Number.isFinite(hero.attack)||hero.attack<0)throw Error('Invalid hero');this.heroes[slot]={id:String(hero.id),element:hero.element,speed:hero.speed,attack:hero.attack,charge:0}}
 snapshot(){return JSON.parse(JSON.stringify({board:this.board,rng:this.rng.s,enemies:this.enemies,terrain:this.terrain,heroes:this.heroes,wells:this.wells,cracks:this.cracks,turn:this.turn,log:this.log,mastery:this.mastery,fatigue:this.fatigue}))}
 restore(s){Object.assign(this,{board:s.board,enemies:s.enemies,terrain:s.terrain,heroes:s.heroes,wells:s.wells,cracks:s.cracks,turn:s.turn,log:s.log,mastery:s.mastery,fatigue:s.fatigue});this.rng.s=s.rng}
 swap(a,b,{phase=0}={}){if(!Array.isArray(a)||!Array.isArray(b)||a.length!==2||b.length!==2||!this.valid(...a)||!this.valid(...b)||Math.abs(a[0]-b[0])+Math.abs(a[1]-b[1])!==1)return{status:'INVALID_MOVE'};if(!Number.isInteger(phase)||phase<0||phase>1)return{status:'INVALID_PHASE'};let before=this.snapshot(),events=[];if(!this.log.length)this.initialState=JSON.parse(JSON.stringify(before));
 // Turn-resolved alternatives avoid mandatory flashing or millisecond timing.
 if(this.features.quantum&&this.turn%3===2){const q=[(this.turn+1)%this.rows,this.turn%this.cols];if([a,b].some(p=>p[0]===q[0]&&p[1]===q[1])){this.board[q[0]][q[1]]=phase?2:0;events.push({type:'quantum',cell:q,phase})}}
 this.exchange(a,b);let scan=this.scan();if(!scan.cells.length){this.restore(before);return{status:'INVALID_MOVE'}};
 let round=0;try{while(scan.cells.length){if(++round>40)throw Error('CASCADE_LIMIT');const cells=scan.cells.map(([r,c])=>({r,c,kind:this.board[r][c]}));if(this.features.gravity&&scan.groups.some(g=>g.length>=5)){let g=scan.groups.find(g=>g.length>=5),p=g[Math.floor(g.length/2)];this.wells=[p];events.push({type:'gravity-well',cell:p})}
 let damage=0,mini=0;for(const tile of cells){let {r,c,kind}=tile,element=ELEMENTS[kind],enemy=this.enemies[c],hero=this.heroes[c],open=enemy.hp===0;let gain=open?2:1;if(hero?.element===element)hero.charge=Math.min(SPEED[hero.speed],hero.charge+gain);if(!open){let cover=this.features.environment&&this.terrain[c]==='forest'?.85:1;let dmg=Math.ceil(((hero?.attack||100)/5)*mult(element,enemy.element)*cover*(this.features.mastery?(1+Math.min(this.mastery,100)*.003)*(1-this.fatigue*.02):1)*(events.some(e=>e.type==='quantum'&&e.phase===1)?2:1));enemy.hp=Math.max(0,enemy.hp-dmg);damage+=dmg}if(this.features.environment){if(element==='FIRE'&&this.terrain[c]==='forest')this.terrain[c]='cleared';if(element==='ICE'&&this.terrain[c]==='water')this.terrain[c]='frozen'}if(this.features.shockwaves){let key=r+','+c;if(this.cracks[key]){mini++;delete this.cracks[key]}}this.board[r][c]=-1}
 if(this.features.shockwaves&&cells.length>=5){for(const {r,c} of cells)for(const [dr,dc] of [[0,1],[0,-1],[1,0],[-1,0]]){let rr=r+dr,cc=c+dc;if(this.valid(rr,cc)&&this.board[rr][cc]>=0)this.cracks[rr+','+cc]=1}}if(mini){const e=this.enemies.find(e=>e.hp>0);if(e)e.hp=Math.max(0,e.hp-Math.min(mini,12)*5)}
 // One diagonal pull per row creates bounded gravity-well board fluidity.
 if(this.features.gravity&&this.wells.length){let [wr,wc]=this.wells[0];for(let r=this.rows-2;r>=0;r--)for(let c=0;c<this.cols;c++){let nc=c+Math.sign(wc-c);if(nc!==c&&this.valid(r+1,nc)&&this.board[r][c]>=0&&this.board[r+1][nc]===-1){this.board[r+1][nc]=this.board[r][c];this.board[r][c]=-1}}}
 for(let c=0;c<this.cols;c++){let values=[];for(let r=this.rows-1;r>=0;r--)if(this.board[r][c]>=0)values.push(this.board[r][c]);for(let r=this.rows-1;r>=0;r--)this.board[r][c]=values[this.rows-1-r]??this.rng.tile()}
 events.push({type:'match',round,cells,damage,miniTiles:Math.min(mini,12),board:this.board.map(r=>r.slice())});scan=this.scan()}
 if(!this.moves().length){this.generate();events.push({type:'reshuffle'})}this.turn++;if(this.features.mastery){this.mastery++;this.fatigue=Math.min(10,this.fatigue+1)}this.log.push({a:a.slice(),b:b.slice(),phase,events});return{status:'TURN_COMPLETE',events,board:this.board.map(r=>r.slice()),won:this.enemies.every(e=>!e.hp)}}catch(e){this.restore(before);return{status:e.message==='CASCADE_LIMIT'?'CASCADE_LIMIT':'ERROR',reason:e.message}}}
 rest(){this.fatigue=0;return{status:'RESTED',wait:0,cost:0}}
 replay(){return{schema:'elemental-replay/1',seed:this.seed,rows:this.rows,cols:this.cols,features:{...this.features},initialState:this.initialState||this.snapshot(),moves:this.log.map(({a,b,phase})=>({a,b,phase}))}}
 hint(phase=0){return this.moves(phase)[0]||null}
 static replay(record){if(record.schema!=='elemental-replay/1'||!Array.isArray(record.moves)||record.moves.length>10000)throw Error('Invalid replay');let e=new Engine(record);if(record.initialState){let s=record.initialState;if(!Array.isArray(s.board)||s.board.length!==e.rows||!s.board.every(r=>Array.isArray(r)&&r.length===e.cols&&r.every(v=>Number.isInteger(v)&&v>=0&&v<5))||!Array.isArray(s.enemies)||s.enemies.length!==e.cols||!Array.isArray(s.log))throw Error('Invalid initial state');e.restore(JSON.parse(JSON.stringify(s)));e.initialState=JSON.parse(JSON.stringify(s));}for(const m of record.moves){if(e.swap(m.a,m.b,{phase:m.phase}).status!=='TURN_COMPLETE')throw Error('Replay diverged')}return e}
}
function settlement(buildings){let forge=buildings.find(x=>x.type==='forge'),mine=buildings.find(x=>x.type==='mine');return{craftCostMultiplier:forge&&mine&&Math.abs(forge.x-mine.x)+Math.abs(forge.y-mine.y)===1?.85:1,recruitmentWait:0}}
function forge(parts){if(!Array.isArray(parts)||parts.length<1||parts.length>5)throw Error('Choose 1–5 ingredients');const materials={star:{weight:4,power:12,element:'HOLY'},ember:{weight:2,power:9,element:'FIRE'},frost:{weight:3,power:8,element:'ICE'},leaf:{weight:1,power:6,element:'NATURE'},shadow:{weight:2,power:10,element:'DARK'}};let totals={},power=0,weight=0;for(const p of parts){if(!materials[p.kind]||!Number.isInteger(p.amount)||p.amount<1||p.amount>10)throw Error('Invalid ingredient');const m=materials[p.kind];power+=m.power*p.amount;weight+=m.weight*p.amount;totals[m.element]=(totals[m.element]||0)+p.amount}return{power,weight,element:Object.keys(totals).sort((a,b)=>totals[b]-totals[a]||a.localeCompare(b))[0],note:'Fictional material units; not real chemistry.',cost:0}}
return{Engine,RNG,ELEMENTS,SPEED,FEATURES,mult,settlement,forge};});
