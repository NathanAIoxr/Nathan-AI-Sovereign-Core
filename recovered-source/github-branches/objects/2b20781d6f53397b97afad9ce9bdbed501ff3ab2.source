<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="theme-color" content="#0c1c2b"><meta name="description" content="Search and launch the public Nathan AI apps, games, books, research, tools and websites."><title>Nathan AI 🚀 · My Desktop · Complete App Launchpad</title>
<style>
:root{color-scheme:dark;font-family:Inter,system-ui,-apple-system,"Segoe UI",sans-serif;--bg:#091520;--panel:#122434;--line:#334d5f;--text:#f2f8fa;--muted:#bfd0d9;--mint:#a6f3d3;--gold:#f4d78d}*{box-sizing:border-box}body{margin:0;color:var(--text);background:radial-gradient(ellipse at 100% 0%,#21455d,transparent 60%),var(--bg)}a{color:var(--mint)}button,input{font:inherit}button:focus-visible,input:focus-visible,a:focus-visible{outline:3px solid var(--gold);outline-offset:3px}.wrap{max-width:1240px;padding:0 22px;margin:auto}.skip{position:absolute;left:10px;top:-100px;background:white;color:black;padding:10px}.skip:focus{top:10px}
header{border-bottom:1px solid #375263;background:#0a1a28e8}.nav{display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:14px;padding:18px 0}.brand{color:var(--text);text-decoration:none;font-weight:950;letter-spacing:.08em}.brand span{color:var(--mint)}nav{display:flex;align-items:center;gap:18px;flex-wrap:wrap}nav a{color:#d2e8ef;text-decoration:none;font-size:13px;font-weight:750}nav a:hover{text-decoration:underline}.hero{padding:65px 0 35px}.eyebrow{font-size:11px;letter-spacing:.2em;font-weight:850;text-transform:uppercase;color:var(--mint)}h1{font-size:clamp(46px,7vw,89px);letter-spacing:-.065em;line-height:1.0;margin:13px 0}h1 em{font-style:normal;color:var(--mint)}.lede{color:var(--muted);line-height:1.7;max-width:760px;font-size:18px}.principles{display:flex;flex-wrap:wrap;gap:18px;font-size:11px;color:var(--gold);font-weight:850;letter-spacing:.1em;margin:25px 0 0}
.search-box{border:1px solid #4e6979;border-radius:19px;padding:22px;background:#172b3e}.search-box label{display:block;font-size:14px;font-weight:850;margin-bottom:10px}.search-box input{width:100%;padding:16px 18px;background:#081827;border:1px solid #7894a5;border-radius:12px;color:#fff;font-size:17px}.search-hint{color:var(--muted);font-size:12px;margin:10px 0 0}.filters{display:flex;flex-wrap:wrap;gap:9px;margin:20px 0}.filters button{border:1px solid #4b6b7b;border-radius:999px;padding:10px 16px;background:#1a3041;color:#edf7f9;font-size:12px;font-weight:800;cursor:pointer}.filters button[aria-pressed="true"]{background:var(--mint);color:#09241e;border-color:var(--mint)}.filters button:hover{border-color:var(--mint)}#result-count{font-size:13px;color:var(--muted);margin:14px 0}
.grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:14px}.module{border:1px solid var(--line);border-radius:17px;background:linear-gradient(145deg,#193344,#101e2d);padding:22px;min-height:232px;display:flex;flex-direction:column;gap:11px}.module-top{display:flex;align-items:center;justify-content:space-between;gap:9px}.symbol{font-size:27px;color:var(--mint)}.meta{font-size:10px;letter-spacing:.03em;color:#c6d7e2;padding:5px 8px;border-radius:7px;border:1px solid #4e6b7d;white-space:nowrap}.module h2{font-size:18px;margin:1px 0 0;line-height:1.25;letter-spacing:-.02em}.module p{font-size:13px;line-height:1.55;color:var(--muted);margin:0}.actions{display:flex;gap:10px;align-items:center;flex-wrap:wrap;margin-top:auto}.visit{font-size:13px;font-weight:900;text-decoration:none}.visit:hover{text-decoration:underline}.save{border:1px solid #587b7c;background:#1e3945;border-radius:9px;color:var(--mint);padding:8px 11px;cursor:pointer;font-size:12px;font-weight:800}.save[aria-pressed="true"]{background:#245040;border-color:#92dcb5}
.tools{display:flex;gap:10px;flex-wrap:wrap;margin:22px 0 62px}.tools button,.file-label{border:1px solid #708b9d;border-radius:10px;background:#193747;color:white;padding:11px 16px;font-weight:850;cursor:pointer;font-size:13px}.tools button:hover,.file-label:hover{background:#265166}.file-label input{position:absolute;opacity:0;width:1px;height:1px}.file-label:focus-within{outline:3px solid var(--gold);outline-offset:3px}.empty{padding:20px;border:1px dashed #5d7b8c;border-radius:12px;color:#b6d1d9}
footer{border-top:1px solid var(--line);padding:30px 0 55px;color:var(--muted);font-size:13px;line-height:1.6}footer a{color:var(--mint)}@media(max-width:960px){.grid{grid-template-columns:repeat(2,minmax(0,1fr))}}@media(max-width:630px){.wrap{padding:0 15px}.hero{padding:43px 0 24px}.grid{grid-template-columns:1fr}.search-box{padding:15px}.module{min-height:195px}.nav{align-items:flex-start;flex-direction:column}}
@media(prefers-reduced-motion:reduce){*{scroll-behavior:auto!important;transition:none!important;animation:none!important}}
</style><script defer src="./registry.js"></script><script defer src="./dedupe.js"></script><script defer src="./launchpad.js"></script><link rel="stylesheet" href="../appearance/shared.css" data-nathan-shared-appearance><script src="../appearance/engine.js"></script><script src="../appearance/app.js"></script><link rel="stylesheet" href="../launcher/shared.css" data-nathan-command-center><script src="../workspace.js" defer></script><script src="../assistant/engine.js" defer></script><script src="../launcher/engine.js" defer></script><script src="../launcher/app.js" defer></script></head><body>
<a href="#main" class="skip">Skip to apps</a><header><div class="wrap nav"><a class="brand" href="./">NATHAN AI <span>🚀 MY DESKTOP</span></a><nav aria-label="Navigation"><a href="./">Websites Home</a><a href="../../sites/">Complete Website Network</a><a href="../">Nathan AI Hub</a><a href="../../christmas-toy-drive/">Christmas Toy Drive</a><a href="../../">TABOR FACTORY</a><a href="../../one/">ONE</a></nav></div></header>
<main class="wrap" id="main"><section class="hero"><div class="eyebrow">NATHAN AI 🚀 · TABOR ROOT · ONE APP · ALL PUBLIC MODULES</div><h1>Your worlds.<br><em>One desktop.</em></h1><p class="lede">Find and open the public websites, browser games, research tools, libraries, and original creations in the Nathan AI ecosystem. Save your favorite modules, track recently opened pages, and export your own launchpad shortcuts.</p><div class="principles"><span>1 + 1 = 2 · BUILD</span><span>1 − 1 = 0 · CLEAR</span><span>ALWAYS PROTECT THE ONE</span></div></section>
<section aria-label="App search and launcher"><div class="search-box"><label for="search-all">Find apps, games, books, archives, and websites</label><input type="search" id="search-all" placeholder="Search every public module…" autocomplete="off"><p class="search-hint">Press / or Ctrl+K to search. Use Tab, Enter and Space to navigate with a desktop keyboard.</p></div>
<div class="filters" id="categories" role="group" aria-label="Filter modules"><button type="button" data-group="all" aria-pressed="true">All modules</button><button type="button" data-group="games" aria-pressed="false">Games & Puzzles</button><button type="button" data-group="apps" aria-pressed="false">Apps & Tools</button><button type="button" data-group="creative" aria-pressed="false">Books & Creative</button><button type="button" data-group="research" aria-pressed="false">Research</button><button type="button" data-group="community" aria-pressed="false">Community</button><button type="button" data-group="saved" aria-pressed="false">★ My Desktop (<span id="saved-number">0</span>)</button><button type="button" data-group="recent" aria-pressed="false">Recently Opened</button></div>
<p id="result-count" role="status" aria-live="polite"></p><div class="grid" id="module-cards"></div><div class="tools"><button id="show-more" type="button">Show more</button><button id="export" type="button">Export My Desktop</button><label class="file-label" for="restore">Restore My Desktop<input id="restore" aria-label="Restore My Desktop from a JSON backup" type="file" accept=".json,application/json"></label></div></section>
</main><footer><div class="wrap">Public routes are shown as they exist in the repository; an index entry does not prove an independent complete application or production server. My Desktop favorites and recent links stay in this browser unless exported. No private source archives or payment tools are connected automatically.<p><a href="./">Back to Nathan AI Websites</a> · <a href="https://github.com/NathanAIoxr/Nathan-AI-Sovereign-Core">Open source repository</a></p></div></footer></body></html>