='../../'+x.path;a.textContent='Open source page';st.textContent=x.status;el.append(b,a,st);out.appendChild(el)});count.textContent=rows.length+' of '+PAGES.length+' public HTML pages';}q.addEventListener('input',paint);paint();</script></body></html>