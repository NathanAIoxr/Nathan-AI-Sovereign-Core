  "books": [
    {
      "id": "BOOK-1-01",
      "series": "Five-Matrix Field Guides",
      "universe": "Cross-universe",
      "volume": 1,
      "title": "The Body of the Story",
      "description": "Physical objects remain classified by their real material form; begin with rings, blades, doors and maps.",
      "outline": [
        "Classify original objects and named characters without substitution.",
        "Trace the exact source references and distinguish author-provided interpretation.",
        "Compare five matrix roles with source labels and open questions.",
        "Make one original educational exercise and glossary.",
