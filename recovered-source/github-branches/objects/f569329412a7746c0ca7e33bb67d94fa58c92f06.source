:root{color-scheme:dark;font-family:system-ui,-apple-system,"Segoe UI",sans-serif;background:#08131d;color:#ecf4fd;font-size:15px;line-height:1.5}*{box-sizing:border-box}body{margin:0}button,input,textarea,select{font:inherit}button{cursor:pointer;transition:background .12s,border-color .12s}button:disabled{opacity:.45;cursor:not-allowed}a{color:#a3d9ff}a:focus-visible,button:focus-visible,input:focus-visible,textarea:focus-visible,select:focus-visible{outline:3px solid #f2c878;outline-offset:3px}.sr-only{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0,0,0,0)}.skip{position:absolute;z-index:99;top:-100px}.skip:focus{top:3px;left:3px;padding:12px;background:#fff;color:#000}.shell{display:flex;flex-direction:column;min-height:100vh}.masthead{min-height:73px;display:flex;align-items:center;justify-content:space-between;gap:20px;padding:12px 22px;background:#0b1b29;border-bottom:1px solid #2d4357}.mark{display:flex;align-items:center;gap:12px;text-decoration:none;color:#f2f7ff;letter-spacing:.06em}.mark small{display:block;color:#adc6d9;font-size:.72rem;letter-spacing:.13em}.logomark{display:inline-grid;place-items:center;width:43px;height:43px;border:1px solid #a5d8ff;border-radius:11px;color:#a5d8ff;font-size:24px;font-weight:900}.header-links{display:flex;gap:18px;align-items:center;flex-wrap:wrap}.tag{padding:6px 10px;background:#1b3950;border:1px solid #517b99;border-radius:99px;color:#d9f3ff;font-size:.78rem}.workbench{display:grid;grid-template-columns:minmax(210px,242px) minmax(420px,1fr) minmax(250px,326px);flex:1;min-height:650px}.rail,.tools{background:#0d2030;padding:20px 15px;border-right:1px solid #294357}.tools{border-left:1px solid #294357;border-right:0;overflow:auto;max-height:calc(100vh - 74px)}h1,h2,h3,p{margin-top:0}h1{font-size:clamp(1.75rem,2.3vw,2.7rem);letter-spacing:-.04em;line-height:1.15;margin-bottom:10px}h2{font-size:1.08rem}h3{font-size:1rem;margin:10px 0 5px}.muted{color:#b8cadb;font-size:.88rem}.eyebrow{font-weight:750;text-transform:uppercase;letter-spacing:.14em;color:#98cce9;font-size:.7rem}.mode-list{display:grid;gap:6px}.mode-list button{text-align:left;display:flex;align-items:center;gap:12px;padding:11px;background:transparent;border:1px solid transparent;border-radius:10px;color:#e5f4ff;min-height:45px}.mode-list button span{width:23px;text-align:center;font-size:1.15rem;color:#97cfff}.mode-list button:hover,.mode-list button[aria-pressed=true]{background:#233e55;border-color:#4c718e}.rail-bottom{padding:18px 8px 5px;margin-top:28px;border-top:1px solid #325167}.motto{line-height:1.8;color:#e5f7ff}.motto span,.rail-bottom small{color:#b5cddd}.conversation{min-width:0;display:flex;flex-direction:column;max-height:calc(100vh - 74px);background:#091823}.chat-heading{padding:22px 25px 12px;display:flex;justify-content:space-between;gap:16px;align-items:start}.chat-heading p{max-width:780px;margin-bottom:0}.environment-bar{display:flex;gap:7px;flex-wrap:wrap;padding:8px 25px 14px;border-bottom:1px solid #294055}.environment-bar span{font-size:.75rem;border:1px solid #304b63;color:#b4d7ea;padding:5px 10px;border-radius:12px}.chat-history{padding:25px;flex:1;min-height:200px;overflow-y:auto;scroll-behavior:smooth;overscroll-behavior:contain}.chat-history>div:last-child{scroll-margin-bottom:20px}.welcome{margin:20px auto;max-width:640px;border:1px solid #395a71;padding:25px;border-radius:17px;background:linear-gradient(135deg,#112b3a,#0d1d30)}.welcome h2{font-size:2rem}.suggestions{display:flex;flex-wrap:wrap;gap:8px;margin-top:22px}.suggestions button{background:#17324a;border:1px solid #426984;border-radius:99px;padding:9px 12px;color:#e9f7ff}.turn{display:flex;gap:12px;margin:14px 0 24px;align-items:flex-start}.turn .avatar{flex:0 0 34px;height:34px;width:34px;border-radius:11px;border:1px solid #43627a;display:grid;place-items:center;font-weight:800;color:#d6ecff}.turn.user{flex-direction:row-reverse}.turn.user .avatar{background:#31536b}.bubble{max-width:min(100%,780px);min-width:0;border:1px solid #294e68;background:#142b3e;border-radius:14px;padding:16px}.turn.user .bubble{background:#1b364b}.turn-label{font-size:.73rem;font-weight:700;letter-spacing:.07em;text-transform:uppercase;color:#a3cde7;margin:0 0 8px}.bubble .answer{white-space:pre-wrap;overflow-wrap:anywhere;line-height:1.65;margin:0}.related{display:flex;gap:8px;flex-wrap:wrap;margin-top:14px}.related a{font-size:.83rem;padding:5px 9px;border:1px solid #3b6682;border-radius:10px}.composer{background:#102434;border-top:1px solid #34536a;padding:16px 22px 10px}.composer textarea{width:100%;min-height:75px;max-height:180px;resize:vertical}.composer-controls,.composer-foot{display:flex;align-items:center;justify-content:space-between;gap:10px;flex-wrap:wrap;margin-top:9px}.composer-foot{color:#b2cadb;font-size:.74rem}.control-group{display:flex;gap:7px;flex-wrap:wrap}button,input,select,textarea{background:#19354a;border:1px solid #52718a;border-radius:10px;color:#f2f6fc;padding:9px 11px;min-height:42px}button:hover{background:#27495f}button.primary{background:#b8e2ff;color:#061827;border:1px solid #b8e2ff;font-weight:800}button.primary:hover{background:#e0f4ff}.secondary{background:transparent;border-color:#4b6b81}.danger{background:#452d32;border-color:#9c686e}.review-panel{padding:15px 25px;background:#152b3b;border-top:1px solid #3c6077;max-height:250px;overflow-y:auto}.review-panel[hidden],.tool-panel[hidden]{display:none}.source-hit{padding:10px 0;border-bottom:1px solid #3c556c}.source-hit summary{cursor:pointer}.source-hit p{white-space:pre-wrap;font-size:.85rem}.tools-heading{margin-bottom:15px}.tools-heading p{font-size:.78rem;color:#bacfe0}.tool-tabs{display:grid;grid-template-columns:repeat(3,1fr);gap:5px;margin-bottom:18px}.tool-tabs button{font-size:.78rem;padding:8px 4px;min-height:42px}.tool-tabs button[aria-pressed=true]{background:#b8e2ff;color:#102b3b;font-weight:800}.tool-panel>label{display:block;font-size:.83rem;font-weight:700;margin-top:12px;margin-bottom:4px}.tool-panel input,.tool-panel select,.tool-panel textarea{width:100%;margin-bottom:8px}.tool-panel input[type=range]{padding:0;accent-color:#b8e2ff}.readout{color:#cae7fc;font-weight:700}.full{width:100%;margin:5px 0}.letters{display:grid;grid-template-columns:repeat(9,1fr);gap:4px;margin-top:13px}.letters button{padding:5px 0;min-width:0;font-size:.75rem;min-height:30px}.letters button[aria-pressed=true]{background:#b8e2ff;color:#0c1c2d}.catalog-results{margin:12px 0}.catalog-card{border:1px solid #33566e;border-radius:10px;padding:10px;margin:8px 0;background:#132c40}.catalog-card b{font-size:.85rem}.catalog-card p{font-size:.78rem;color:#b5cbdd;margin:4px 0;overflow-wrap:anywhere}.catalog-card button{font-size:.72rem;padding:5px 8px;min-height:31px}.catalog-count,.catalog-nav{font-size:.8rem;color:#b4ccdc}.catalog-nav{display:flex;align-items:center;justify-content:space-between;gap:5px}.people-select label{display:flex;gap:9px;align-items:center;padding:7px 0;border-bottom:1px solid #32546a;font-size:.88rem}.people-select input[type=checkbox],.check-row input[type=checkbox]{width:auto;margin:0;min-height:auto;accent-color:#b8e2ff}.check-row{display:flex!important;gap:9px;align-items:center;font-size:.84rem}.tool-panel hr{border:0;border-top:1px solid #39556b;margin:18px 0}.source-mode-guide{padding:13px;background:#182e41;border:1px solid #36566b;border-radius:12px;margin:12px 0;font-size:.78rem}.source-mode-guide p{margin:9px 0}footer{border-top:1px solid #2b4357;background:#091824;padding:12px 18px;display:flex;justify-content:space-between;flex-wrap:wrap;gap:10px;color:#aec4d7;font-size:.73rem}footer strong{color:#f2faff}@media(max-width:1150px){.workbench{grid-template-columns:minmax(180px,210px) minmax(360px,1fr)}.tools{grid-column:1 / -1;border-left:0;border-top:1px solid #284358;max-height:none}.tools-heading{display:flex;align-items:baseline;gap:15px}.tools-heading p{margin:0}.catalog-results{display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:6px}.tool-panel{max-width:900px;margin:auto}}@media(max-width:740px){.workbench{display:flex;flex-direction:column}.masthead{flex-wrap:wrap;padding:11px 14px}.header-links{gap:10px}.rail{padding:10px 14px}.rail h2,.rail>.muted{display:none}.mode-list{display:flex;overflow-x:auto;padding-bottom:3px}.mode-list button{white-space:nowrap;flex-shrink:0}.rail-bottom{display:none}.conversation{max-height:none;min-height:620px}.chat-history{min-height:320px;max-height:60vh}.chat-heading,.chat-history{padding:18px 14px}.environment-bar{padding:8px 14px}.composer{padding:13px}.composer-controls button{font-size:.83rem}.tools{padding:16px 14px}.letters{grid-template-columns:repeat(9,1fr)}}@media(prefers-reduced-motion:reduce){.chat-history{scroll-behavior:auto}button{transition:none}}

/* HOP IN Studio 0.3: conversation library and accessible spatial board. */
.thread-dock{margin:18px 0 0;border-top:1px solid #36546a;padding:17px 4px 0}
.thread-head{display:flex;align-items:center;justify-content:space-between;gap:8px}
.thread-head h2{margin:0}.thread-head button{padding:6px 10px;font-size:.78rem}
.thread-list{display:grid;gap:6px;margin:10px 0;max-height:225px;overflow-y:auto;overscroll-behavior:contain}
.thread-item{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:6px;border:1px solid #31536a;border-radius:11px;padding:5px;background:#122a3a}
.thread-item[aria-current=true]{border-color:#a9e3dc;background:#23465b}
.thread-main{display:flex;flex-direction:column;align-items:start;text-align:left;gap:3px;min-width:0;background:transparent;border:0;padding:6px 8px}
.thread-main b{font-size:.8rem;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;max-width:100%}
.thread-main small{font-size:.68rem;color:#bfd0dc}
.thread-options{display:grid;gap:3px;align-content:center}
.thread-options button{font-size:.75rem;min-height:27px;padding:2px 6px}
.thread-actions{display:flex;gap:5px;flex-wrap:wrap}
.thread-actions button,.thread-import-label{font-size:.76rem;min-height:38px;padding:6px 9px}
.thread-import-label{border:1px solid #52718a;border-radius:9px;background:#19354a;cursor:pointer;display:inline-flex;align-items:center;margin:0}
.thread-actions input[type=file]{width:1px;height:1px;overflow:hidden;position:absolute;left:-10000px}
.active-thread-title{font-size:.8rem;color:#a9ddc6;margin:8px 0 0;font-weight:700}
.canvas-actions{display:flex;gap:7px;flex-wrap:wrap;margin:9px 0}
.board-space{position:relative;width:100%;height:350px;max-width:100%;border:1px solid #466479;border-radius:14px;margin:12px 0;background:linear-gradient(0deg,transparent 23px,#ffffff09 24px),linear-gradient(90deg,transparent 23px,#ffffff09 24px),#0b1f2d;background-size:24px 24px;touch-action:none;overflow:hidden}
#board-lines,#board-nodes{position:absolute;inset:0;width:100%;height:100%;pointer-events:none}
#board-lines{overflow:visible}
.board-node{position:absolute;pointer-events:auto;display:block;text-align:left;min-height:40px;max-width:155px;max-height:98px;overflow:hidden;overflow-wrap:anywhere;white-space:normal;transform:translate(-50%,-50%);border-radius:10px;border:1px solid #91d4cb;background:#1d5762;color:white;padding:9px;font-weight:750;font-size:.78rem;touch-action:none;user-select:none;cursor:grab;box-shadow:0 5px 12px #0006}
.board-node:active{cursor:grabbing}
.board-node[data-kind=source]{background:#28516a;border-color:#9cbaf1}
.board-node[data-kind=question]{background:#514b74;border-color:#d1b9fa}
.board-node[data-kind=person]{background:#634b53;border-color:#edb3c7}
.board-node[data-kind=time]{background:#56523c;border-color:#e6d68c}
.board-node[aria-selected=true]{outline:3px solid #f3d68f;outline-offset:1px}
.board-legend{font-size:.74rem;color:#bacbda}
#board-from,#board-to{width:49%;display:inline-block}
#board-to{margin-left:2%}
#board-status{white-space:pre-wrap}
#message-count{font-variant-numeric:tabular-nums}
@media(max-width:1150px){.thread-list{max-height:230px}}
@media(max-width:740px){.thread-dock{padding:12px 0}.thread-list{display:flex;overflow-x:auto;max-height:120px}.thread-item{min-width:180px;max-width:205px}.thread-main b{max-width:145px}.board-space{height:280px}}


/* Optional generated geometry skins: calm default, hundreds of mathematical arrangements. */
.skin-picker{position:relative;color:#e6edf7;z-index:4;min-width:105px}
.skin-picker>summary{cursor:pointer;border:1px solid #476d83;border-radius:999px;padding:8px 13px;background:#123043;list-style:none;font-size:.8rem;font-weight:800}
.skin-picker>summary::-webkit-details-marker{display:none}
.skin-picker>summary:focus-visible{outline:3px solid #f2c878;outline-offset:3px}
.skin-picker-inner{position:absolute;right:0;top:calc(100% + 8px);min-width:280px;max-width:min(360px,90vw);padding:16px;border:1px solid #6d8393;background:#102939;border-radius:14px;box-shadow:0 12px 45px #000a}
.skin-picker-inner label{display:block;font-size:.78rem;font-weight:700;margin:4px 0 6px}
.skin-picker-inner select{width:100%;margin:0}
.skin-buttons{display:flex;gap:6px;margin:9px 0}
.skin-buttons button{flex:1;font-size:.75rem}
.skin-picker .check-row{display:flex;align-items:center;gap:8px;font-weight:500;margin:8px 0}
.skin-picker .check-row input{width:auto;min-height:auto}
.visual-banner{position:relative;margin:4px 24px 8px;height:122px;border-radius:18px;overflow:hidden;background:radial-gradient(ellipse at 50% 10%,#29435c88 0%,transparent 60%),linear-gradient(120deg,#0d2637,#101d32 48%,#152f36);border:1px solid #3f6375;isolation:isolate;flex-shrink:0}
.visual-banner:after{content:"";position:absolute;inset:0;pointer-events:none;background:linear-gradient(90deg,#0b1b2ae3 0%,#10243a45 48%,#0b1b2a35 100%)}
.visual-banner svg{position:absolute;inset:0;width:100%;height:100%;opacity:.84;pointer-events:none;filter:drop-shadow(0 0 4px #e7c17f44)}
.visual-banner-words{position:absolute;z-index:2;left:25px;top:23px;display:flex;flex-direction:column;font-family:Georgia,Times,serif;font-size:clamp(1.65rem,3.8vw,3rem);font-weight:700;letter-spacing:.08em;color:#f8e9d3;text-shadow:0 0 16px #edc58733;line-height:1.1}
.visual-banner-words small{font:700 .64rem system-ui,-apple-system,sans-serif;letter-spacing:.17em;color:#9dd5e4;margin-top:10px}
.visual-banner[data-quiet=true]{height:57px;background:#0d2636}
.visual-banner[data-quiet=true] svg{opacity:.12}
.visual-banner[data-quiet=true] .visual-banner-words{top:15px;font-size:1.2rem}
.visual-banner[data-quiet=true] .visual-banner-words small{display:none}
@media(max-width:1150px){.visual-banner{height:96px}}
@media(max-width:740px){.visual-banner{margin:4px 13px 7px;height:78px;border-radius:12px}.visual-banner-words{left:15px;top:16px;font-size:1.65rem}.visual-banner-words small{font-size:.51rem;letter-spacing:.07em;margin-top:6px}.skin-picker-inner{right:-8px}.visual-banner[data-quiet=true]{height:48px}}
@media(prefers-reduced-motion:reduce){.visual-banner svg{filter:none}}
