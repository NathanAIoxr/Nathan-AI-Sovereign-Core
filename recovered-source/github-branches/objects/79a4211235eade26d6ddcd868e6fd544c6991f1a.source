(function(root){
'use strict';
const SCHEMA='nathan-ai.hop-in.chat.v1';
const MAX_TURNS=100;
const MODE_LABELS={core:'Nathan AI Core',modern:'Modern version',institution:'Man-Made Lies Stripped · source audit',theology:'God Lies Removed · theology audit',jerome:'Saint Jerome · textual audit',custom:'Your Mind',assembly:'Group Assembly'};
const LINKS={assistant:{label:'Nathan AI source-grounded Assistant',url:'../../assistant/index.html'},library:{label:'ONE Library Mind',url:'../../../one/library-mind/index.html'},family:{label:'Family & Redstone Research',url:'../../family-research/index.html'},work:{label:'Universal Workspace',url:'../../universal-workspace/index.html'},calendar:{label:'HOP IN calendar and name tools',url:'../index.html'},matrix:{label:'Nathan AI ONE',url:'../../../one/index.html'},maps:{label:'OpenHistoricalMap · external',url:'https://www.openhistoricalmap.org/'},wikis:{label:'Wikidata · external',url:'https://www.wikidata.org/'},creator:{label:'Creator works and books',url:'../../original-works/index.html'},all:{label:'Consumer Editions',url:'../../consumer/index.html'},roots:{label:'Nathan AI main hub',url:'../../index.html'},studio:{label:'Words → Worlds · unboxed source studio',url:'../chatbox/index.html#studio-panel'},rootClear:{label:'ROOT → CLEAR → BUILD · game, academy and books',url:'../root-clear/index.html'},paradoxes:{label:'Paradoxes, Enigmas & Anomalies · 416-entry atlas',url:'../paradox-atlas/index.html'},dArchive:{label:'D · Original Words, Variants & Inversions (source archive)',url:'../../../../archive-index/alphabet/d/index.html'},dCanon:{label:'Five exact original D sequence titles',url:'../../../../archive-index/alphabet/d/canonical-d-sequences.json'}};
const FIGURES=[
{id:'buddha',name:'Buddha',angle:'Cause and effect, suffering and compassion; distinguish early textual traditions from later religious interpretation.',research:'Find translations of early discourses and their documented transmission history.'},
{id:'jesus',name:'Jesus',angle:'Protective love, care for vulnerable people, textual witnesses and historical setting.',research:'Compare Gospel passages with original-language manuscripts and named translations.'},
{id:'mlksr',name:'Martin Luther King Sr.',angle:'Ministry, civil rights organizing and family/community leadership.',research:'Use recorded sermons, biographies and historical civil-rights archives; avoid invented quotes.'},
{id:'mlkjr',name:'Martin Luther King Jr.',angle:'Civil rights, nonviolence, economic justice and historical context.',research:'Use archived speeches and properly attributed writings; no invented verbatim speech.'},
{id:'james',name:'King James',angle:'Translation sponsorship, royal authority, political motives and historical printing context.',research:'Compare translation records, historical letters and 1611 editions with scholarly work.'}
];
const TIPS={core:'Start with concrete facts, clear counts, user-owned goals and questions with sources.',modern:'Explain current systems in plain language; check contemporary claims against current documentation.',institution:'Separate observable facts, the institution’s wording, outside evidence and the open questions. Do not pre-judge the conclusion.',theology:'Compare spiritual teachings, human institutions and opposing interpretations without claiming to prove or disprove divine truth.',jerome:'Compare Jerome, the Vulgate, original-language witnesses, translation choices, dates and textual uncertainty.',custom:'Use the user-written worldview as a perspective, not as a verified fact or a command to override safeguards.',assembly:'Compare documented viewpoints and historical records. Simulated prompts are not authentic quotations or living historical participants.'};
const ROUTES=[
{terms:/\b(david|original words|verbatim|words to worlds|source preservation|unboxed source|book series)\b/i,title:'Words → Worlds · Unboxed',key:'studio',guide:'Open the full-source ledger, seven books and five lessons without collapsing source records; original words remain separate from derived material.'},
{terms:/\b(?:letter\s+d|d\s+(?:words?|titles?|archives?|variants?|variations?|inversions?|families|index|catalog)|d0g|dick(?:s|head)?|dungeons\s+and\s+dragons)\b/i,title:'D · Original Words & Variations',key:'dArchive',guide:'Search 152 original D / The D filename occurrences, 19 variant routes and five exact original A–Z titles. Reversal, visual mirroring, language variants and source titles remain separate.'},
{terms:/\b(paradox|paradoxes|enigma|enigmas|anomalies|anomaly|contradiction|contradictions|fallacy|dilemma|riddle|puzzle)\b/i,title:'Paradox, Enigma & Contradiction Atlas',key:'paradoxes',guide:'Browse 298 reference leads plus 118 exact 118 LINE original characters. Categories and sources are labeled separately; not every entry is a verified formal paradox.'},
{terms:/\b(name|reverse|backward|phonetic|birthday|born|birthdate|almanac|calendar|zodiac)\b/i,title:'Names & Calendars',key:'calendar',guide:'Try the name transformations and browser-supported calendars. The Tabor 12/13/17/21-month cycles remain illustrative until your original formulas are verified.'},
{terms:/\b(time|timeline|travel|history|historical|past|future|1611|judea|india|zoom|macro|micro|earth|globe|map)\b/i,title:'Time & Space',key:'maps',guide:'Open the existing time/scale controls for dated research and an explicitly imaginative scene. Live planet tracking, literal time travel and remote observation are not enabled.'},
{terms:/\b(jesus|buddha|king|assembly|group|mlk|luther)\b/i,title:'Group Assembly',key:'library',guide:'Compare evidence and contextual questions for selected figures. Neither authentic first-person speech nor verified historical memories are generated.'},
{terms:/\b(god|belief|mind|spiritual|worldview|faith|religion)\b/i,title:'Mind Builder',key:'calendar',guide:'Create a user-authored spiritual/philosophical mind profile in the original HOP IN Mind Builder. It is a creative tool, not a divine or autonomous entity.'},
{terms:/\b(family|ancestor|genealogy|kin|tree|tabor|redstone)\b/i,title:'Family & Genealogy',key:'family',guide:'Record evidence-backed people and relationships separately from Above/Middle/Below/Beyond symbolic worlds. Private family information is never published automatically.'},
{terms:/\b(scripture|text|source|jerome|vulgate|kjv|translation|truth|lie|fact|prove|evidence|compare)\b/i,title:'Texts & Evidence',key:'assistant',guide:'Search existing sources, compare wording and provenance, and label supported, contested, unverified or creative interpretations rather than deleting disagreeing records.'},
{terms:/\b(book|write|story|language|reader|library|dictionary|alphabet|ogham|rune)\b/i,title:'Library & Writing',key:'library',guide:'Read published original materials and build source-preserving drafts, translations and book plans in ONE Library Mind.'},
{terms:/\b(game|app|website|code|build|dashboard|system|software|project)\b/i,title:'App Factory',key:'work',guide:'Use the shared workspace to assemble existing applications. New work must be additive and tested before release.'}
];
function words(input){return String(input||'').normalize('NFKC').toLocaleLowerCase().match(/[\p{L}\p{N}]+/gu)||[]}
function catalogSearch(rows,query,letter='',limit=20){const q=words(query),selected=String(letter).toUpperCase();const ranked=(rows||[]).filter(x=>!selected||x.letter===selected).map(item=>{const t=words(item.title),d=words(item.sourceDescription);const score=q.reduce((n,w)=>n+(t.includes(w)?6:0)+(d.includes(w)?1:0),0);return {item,score};}).filter(x=>!q.length||x.score>0).sort((a,b)=>b.score-a.score||a.item.title.localeCompare(b.item.title));return ranked.slice(0,Math.max(1,Math.min(104,limit))).map(x=>x.item)}
function getMatches(question){return ROUTES.filter(x=>x.terms.test(question)).slice(0,3)}
function assembly(topic,ids){const chosen=FIGURES.filter(x=>ids.includes(x.id));if(!chosen.length)return {answer:'Select one or more figures to build a source-comparison conversation.',sources:[],links:[LINKS.library]};const lines=chosen.map(x=>x.name+': '+x.angle+' Research step: '+x.research);return {answer:'GROUP ASSEMBLY · comparison of research perspectives (not actual historical speech)\nTopic: '+topic+'\n\n'+lines.join('\n\n')+'\n\nFind the earliest relevant witnesses, establish the dates, and label disputed interpretations.',links:[LINKS.library,LINKS.assistant],kind:'research'};}
function noCredentials(value){if(/-----BEGIN[^\n]*PRIVATE KEY-----|\bsk-[A-Za-z0-9_-]{20,}|\b(?:password|passphrase|seed phrase|recovery phrase|private key|api[_ -]?key)\s*[:=]\s*\S+/i.test(String(value)))throw Error('Possible credentials found. Remove passwords, keys and recovery phrases before using this field.');}
function reply(input,opts={}){
 const q=String(input||'').trim(),mode=MODE_LABELS[opts.mode]?opts.mode:'core',mind=String(opts.mind||'').trim().slice(0,500);
 if(!q||q.length>4000)throw Error('Enter a question of 1–4000 characters.');noCredentials(q);noCredentials(mind);
 if(/^\/(?:d|letter-d)(?:\s|$)/i.test(q))return {kind:'route',answer:'LETTER D · ORIGINAL WORDS AND VARIATIONS\n\nBrowse 138 D/d-starting Library filename records and 14 The D titles, preserving repetitions. Compare 19 separate D discovery routes (D, DD, DDD, D0G, phonetics, mirrors, rotations, reversals and KJV Game of Life). The five exact authored D sequence titles are in the canonical cross-reference; private source bytes remain private. These are archive records, not 152 finished apps or books.',links:[LINKS.dArchive,LINKS.dCanon]};
  if(/^\/(root|clear|build)\b/i.test(q))return {kind:'route',answer:'ROOT → CLEAR → BUILD. Remove the complication → expose the root issue → fix the root issue. Open the linked interactive workshop, game, academy and book-series generator. Your original wording is preserved separately from any examples.',links:[LINKS.rootClear]};
 if(/^\/paradoxes?\b/i.test(q))return {kind:'route',answer:'Open the Paradox, Enigma, Anomaly & Contradiction Atlas: 298 named research leads and 118 creator-original characters, kept distinct.',links:[LINKS.paradoxes]};
 if(/^\/(help|commands)\b/i.test(q))return {kind:'commands',answer:'Commands: /help, /studio, /d [titles|variants], /paradoxes, /root, /features, /group [topic], /sources, /reset (clears this tab after confirmation). Ask in natural language to find a feature. “Save” is a separate action.',links:[LINKS.all]};
 if(/^\/studio\b/i.test(q))return {kind:'studio',answer:'Words → Worlds · Unboxed is integrated in the Create tab of this HOP IN chatbox: source-originals ledger, game rounds, all seven book outlines and five lessons. Original records never merge into editorial text.',links:[LINKS.studio]};
 if(/^\/reset\b/i.test(q))return {kind:'reset-request',answer:'To clear this workspace, use the visible CLEAR control and confirm. Messages are not erased by a command hidden in text.',links:[]};
 if(/^\/features\b/i.test(q))return {kind:'directory',answer:'There are 104 explicitly listed A–Z consumer concepts (four per letter), even though the source calls the list “101”. The excerpt also names 43 root settings. Browse and search them from the feature directory; concepts are not certified live functions.',links:[LINKS.all]};
 if(/^\/sources\b/i.test(q))return {kind:'sources',answer:'Use Load sources for citations from this repository’s public catalogs. Model drafting requires a separate configured local adapter and a deliberate second confirmation. No documents are silently fetched from other accounts.',links:[LINKS.assistant]};
 if(/^\/group\b/i.test(q))return assembly(q.replace(/^\/group\s*/i,'').trim()||'innocence',opts.figureIds||[]);
 if(mode==='assembly')return assembly(q,opts.figureIds||[]);
 const matches=getMatches(q),tag=MODE_LABELS[mode],intro=tag+' · '+TIPS[mode]+(mind?'\nYour chosen perspective: '+mind:'');
 if(matches.length){const lines=matches.map((x,i)=>(i+1)+'. '+x.title+': '+x.guide);const links=matches.map(x=>LINKS[x.key]);return {kind:'route',answer:intro+'\n\n'+lines.join('\n\n')+'\n\nFor factual answers, load the matching original sources and inspect citations.',links:[...new Map(links.map(x=>[x.url,x])).values()]};}
 return {kind:'guide',answer:intro+'\n\nI can help route a question through names, calendars, history, micro/macro, Group Assembly, scripture, family trees, writing, games, sources and the A–Z feature catalog. This local reply is a navigation guide—not a model-generated answer. Try “show the 1611 historical lens,” “reverse a name,” or “compare early source texts.”',links:[LINKS.assistant,LINKS.work]};
}
function validateSession(s){if(!s||s.schema!==SCHEMA||!Array.isArray(s.turns)||s.turns.length>MAX_TURNS)throw Error('Invalid chat backup schema or length.');const turns=s.turns.map(x=>{if(!x||!['user','assistant'].includes(x.role)||typeof x.text!=='string'||x.text.length>25000||typeof x.kind!=='string'||x.kind.length>50)throw Error('Invalid turn.');noCredentials(x.text);return {role:x.role,text:x.text,kind:x.kind,links:[]};});return {schema:SCHEMA,turns};}
function validateCatalog(data,kind){if(!data||!Array.isArray(data.items)||data.items.length>150||data.schema!==('nathan-ai.'+kind))throw Error('Invalid local source catalog');return data.items.map(x=>{if(typeof x.title!=='string'||typeof x.sourceDescription!=='string'||!x.id||x.title.length>200||x.sourceDescription.length>1500)throw Error('Malformed catalog record');return {id:String(x.id),title:x.title,sourceDescription:x.sourceDescription,letter:String(x.letter||''),group:String(x.group||''),stage:String(x.stage||'concept')};});}
function messageTitle(question){return String(question).replace(/^\/[a-z]+\s*/i,'').trim().slice(0,60)||'New conversation'}
const API={SCHEMA,MAX_TURNS,MODE_LABELS,LINKS,FIGURES,TIPS,ROUTES,words,catalogSearch,getMatches,assembly,noCredentials,reply,validateSession,validateCatalog,messageTitle};
if(typeof module==='object'&&module.exports)module.exports=API;else root.NathanChatbox=API;
})(typeof window==='object'?window:globalThis);