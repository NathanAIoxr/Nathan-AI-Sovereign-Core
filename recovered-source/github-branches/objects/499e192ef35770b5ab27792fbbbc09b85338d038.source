<script>
window.ATLAS_DATA = {"meta":{"name":"THE FIVE MATRICES","subtitle":"The Twelve Rings / Twelve Gates Atlas","version":"1.0.0","copyright":"Independent interpretive study tool. No affiliation with Tolkien or C. S. Lewis estates.","policy":"Canonical works, scriptural references, and interpretive transformations are kept distinct. Source objects are never converted in place.","arithmetic":["1 + 1 = 2 — BUILD","1 − 1 = 0 — CLEAR","8 fingers + 2 thumbs + 2 arm bracelets = 12 symbolic positions"]},"matrices":[{"id":"body","name":"BODY","index":"I","subtitle":"Form • materials • space","principle":"What physically exists, where it is placed, and what it can do.","questions":["What is it made of?","How large is it?","Is it jewelry, a weapon, furniture, a gate, or something else?"],"keywords":["matter","structure","material","size"]},{"id":"soul","name":"SOUL","index":"II","subtitle":"Identity • loyalty • belonging","principle":"Who bears an object and what relationships, memories, and loyalties attach to it.","questions":["Who bears or owns it?","What identity does it symbolize?","Whose loyalty is tested?"],"keywords":["identity","loyalty","memory","belonging"]},{"id":"shadow","name":"SHADOW","index":"III","subtitle":"Concealment • power • deception","principle":"What is concealed, coerced, corrupted, or strategically kept out of view.","questions":["What does it hide?","Who gains power from its secrecy?","Is its use coercive or protective?"],"keywords":["deception","hidden","risk","power"]},{"id":"mind","name":"MIND","index":"IV","subtitle":"Language • rules • strategy","principle":"How inscriptions, signals, logic, laws, reading, and decisions shape use.","questions":["What rules govern it?","How do we know what it does?","How is the mechanism communicated?"],"keywords":["language","knowledge","logic","strategy"]},{"id":"spirit","name":"SPIRIT","index":"V","subtitle":"Sacrifice • conscience • purpose","principle":"What the narrative presents as its moral purpose, sacrifice, hope, or ultimate consequence.","questions":["What moral tension does it represent?","Does it preserve or violate freedom?","What restoration is imagined?"],"keywords":["ethics","freedom","sacrifice","hope"]}],"universes":[{"id":"lotr","name":"The Lord of the Rings","short":"LOTR","type":"literary","subtitle":"Middle-earth: the War of the Ring"},{"id":"hobbit","name":"The Hobbit","short":"HOBBIT","type":"literary","subtitle":"Bilbo, Erebor, and the finding of the Ring"},{"id":"narnia","name":"The Chronicles of Narnia","short":"NARNIA","type":"literary","subtitle":"Worlds, gifts, and sovereign claims"},{"id":"kjv","name":"KJV Bible","short":"KJV","type":"scripture","subtitle":"Textual artifacts and passage references"},{"id":"design","name":"Interpretive Workshop","short":"MODEL","type":"interpretation","subtitle":"Proposed symbolic 12-ring model"}],"categories":[{"id":"ring","name":"Physical ring / jewelry"},{"id":"bracelet","name":"Bracelet / arm ring"},{"id":"gate_literal","name":"Literal gate"},{"id":"gate_vision","name":"Visionary gate"},{"id":"gate_fig","name":"Figurative gate"},{"id":"portal","name":"Portal / passage"},{"id":"furniture","name":"Furniture"},{"id":"monument","name":"Monument / architecture"},{"id":"weapon","name":"Weapon / blade"},{"id":"armor","name":"Armor / protection"},{"id":"tool","name":"Tool / device"},{"id":"treasure","name":"Treasure / vessel"},{"id":"person","name":"Character / person"},{"id":"place","name":"Place / realm"},{"id":"law","name":"Law / governing rule"},{"id":"concept","name":"Interpretive concept"}],"objects":[{"id":"lotr.one","title":"The One Ring","universe":"lotr","category":"ring","summary":"The ruling Ring made by Sauron in Mount Doom; tied to dominion over the other Rings of Power.","source":"The Lord of the Rings; The Silmarillion","matrices":["body","shadow","mind","spirit"],"function":"Conceals wearer from ordinary sight and draws on Sauron’s power.","material":"Gold","dimensions":"Not given as a fixed measurement","bearer":"Sauron → Isildur → Gollum → Bilbo → Frodo","status":"literary","attributes":["Black Speech inscription","Central control","Corruption"],"links":["hobbit.discovery"]},{"id":"lotr.narya","title":"Narya — Ring of Fire","universe":"lotr","category":"ring","summary":"One of the Three Elven Rings; worn by Gandalf in the later Third Age.","source":"The Lord of the Rings, Appendix B; The Silmarillion","matrices":["body","soul","spirit"],"function":"Associated with courage, kindling hearts, and resistance to despair.","material":"Gold with a red stone","dimensions":"Not specified","bearer":"Gandalf","status":"literary","attributes":[],"links":["lotr.one"]},{"id":"lotr.nenya","title":"Nenya — Ring of Water","universe":"lotr","category":"ring","summary":"One of the Three, entrusted to Galadriel.","source":"The Lord of the Rings","matrices":["body","soul","shadow","spirit"],"function":"Associated with preservation of Lórien.","material":"Mithril with a white stone","dimensions":"Not specified","bearer":"Galadriel","status":"literary","attributes":[],"links":["lotr.one"]},{"id":"lotr.vilya","title":"Vilya — Ring of Air","universe":"lotr","category":"ring","summary":"One of the Three, entrusted to Elrond.","source":"The Lord of the Rings","matrices":["body","soul","spirit"],"function":"The mightiest of the Three; preservation and protection.","material":"Gold with a blue stone","dimensions":"Not specified","bearer":"Elrond","status":"literary","attributes":[],"links":["lotr.one"]},{"id":"lotr.seven","title":"Seven Dwarf-rings","universe":"lotr","category":"ring","summary":"Seven Rings associated with the Dwarf-lords, wealth, and intensified greed.","source":"The Lord of the Rings, “Of the Rings of Power and the Third Age”","matrices":["body","shadow","soul"],"function":"Influence the accumulation of treasure; they did not turn Dwarves into wraiths.","material":"Various","dimensions":"Not specified","bearer":"Dwarf-lords","status":"literary","attributes":[],"links":["lotr.one"]},{"id":"lotr.nine","title":"Nine Rings for Mortal Men","universe":"lotr","category":"ring","summary":"Nine Rings that enslave their bearers as Ringwraiths, the Nazgûl.","source":"The Lord of the Rings","matrices":["body","shadow","soul","spirit"],"function":"Prolonged corruption and domination.","material":"Various","dimensions":"Not specified","bearer":"Nazgûl","status":"literary","attributes":[],"links":["lotr.one"]},{"id":"lotr.anduril","title":"Andúril — Flame of the West","universe":"lotr","category":"weapon","summary":"Sword reforged from Narsil, symbol of Aragorn’s lineage and restored kingship.","source":"The Lord of the Rings, “The Ring Goes South”","matrices":["body","soul","mind","spirit"],"function":"Sword; royal emblem and legitimacy.","material":"Reforged Elven-forged steel","dimensions":"Not specified","bearer":"Aragorn","status":"literary","attributes":[],"links":[]},{"id":"lotr.narsil","title":"Narsil","universe":"lotr","category":"weapon","summary":"Broken sword of Elendil, reforged into Andúril.","source":"The Lord of the Rings","matrices":["body","soul","spirit"],"function":"Heirloom embodying broken and restored kingship.","material":"Steel","dimensions":"Not specified","bearer":"Elendil → Isildur → Aragorn","status":"literary","attributes":[],"links":["lotr.anduril"]},{"id":"lotr.glamdring","title":"Glamdring — Foe-hammer","universe":"lotr","category":"weapon","summary":"Ancient sword of Gondolin carried by Gandalf; shines blue in the presence of Orcs.","source":"The Hobbit; The Lord of the Rings","matrices":["body","mind","shadow"],"function":"Melee defense and warning.","material":"Elven steel","dimensions":"Not specified","bearer":"Gandalf","status":"literary","attributes":[],"links":[]},{"id":"lotr.sting","title":"Sting","universe":"lotr","category":"weapon","summary":"Elven blade used by Bilbo and later Frodo; glows blue near Orcs.","source":"The Hobbit; The Lord of the Rings","matrices":["body","mind","shadow","soul"],"funct