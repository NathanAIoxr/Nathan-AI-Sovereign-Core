      <div class="brand-sigil" aria-hidden="true"><svg viewBox="0 0 64 64" width="48" height="48"><circle cx="32" cy="32" r="28" fill="none" stroke="currentColor" stroke-width="1.2" opacity=".6"/><circle cx="32" cy="32" r="19" fill="none" stroke="#54d5c5" stroke-width="1.6"/><circle cx="32" cy="32" r="9" fill="none" stroke="#dcaa7d" stroke-width="2"/><path d="M32 4v56M4 32h56" stroke="currentColor" opacity=".35" stroke-width=".7"/></svg></div>
      <div><div class="brand-overline">THE SOVEREIGN ARCHIVE</div><div class="brand-title">FIVE MATRICES</div><div class="brand-sub">RINGS / GATES / WORLDS</div></div>
