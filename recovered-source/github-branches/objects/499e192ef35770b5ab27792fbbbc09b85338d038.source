window.SOVEREIGN_FORMULAS=[{"index":1,"name":"EM Core Tensor","layer":"Energy","status":"Conceptual / mathematical form","source":"\\psi_{EM}=\\sum_i c_i |E_i\\rangle \\otimes |I_i\\rangle","limits":"State-vector-like notation; neither a Hilbert space nor measured coefficients are specified.","implementation":"No numeric evaluator; source expression retained."},{"index":2,"name":"Generative Addition Protocol","layer":"Energy","status":"Arithmetic invariant; source operator ambiguous","source":"f_{Add}(x,y)=1\\oplus 1=2\\quad \\forall x,y\\in\\{Innocence\\}","limits":"1+1=2 holds in ordinary arithmetic. If ⊕ means XOR, 1 XOR 1 = 0; direct sums require defined mathematical objects.","implementation":"invariants() verifies ordinary arithmetic and displays XOR separately."},{"index":3,"name":"Absolute Clearing Protocol","layer":"Energy","status":"Rule-based computational interpretation","source":"\\mathcal{C}_{Clear}(x)=1\\ominus 1=0\\quad\\text{if Gate}(x)\\to\\text{Deception}","limits":"No objective detector of deception is specified; authorization and integrity evidence are required.","implementation":"AbsoluteClearingFirewall quarantines or rejects with an explicit evidence record; never silently deletes."},{"index":4,"name":"Recursive Self-Evolution / AutoGenesis","layer":"Energy","status":"Deterministic state transition","source":"A_{n+1}=f(A_n,U^Q,\\Sigma_{Master})","limits":"A callable transition can be implemented; no self-modifying intelligence is implied.","implementation":"autogenesis_step() accepts an allowlisted command and returns an additive record."},{"index":5,"name":"Base-2 Pulse Modulation","layer":"Energy","status":"Verified arithmetic representation","source":"1+1=10_2","limits":"10 in base two is 2 in base ten; electrical voltages are hardware-specific.","implementation":"invariants() returns base2 = \"10\"."},{"index":6,"name":"Continuous Vocal Pixelation","layer":"Frequency","status":"Classical signal-processing simulation","source":"\\mathcal{F}_{Pixel}(v)=\\int_{-\\infty}^{\\infty} v_{voice}(t)e^{-i2\\pi ft}dt\\longrightarrow P_n(x,y,z)","limits":"Fourier transform and a spatial mapping are distinct steps; 3D mapping is underspecified.","implementation":"dft_magnitudes() and spectral_pixels() run on synthetic audio."},{"index":7,"name":"Krystal Spiral Engine","layer":"Frequency","status":"Defined geometry","source":"r(\\theta)=a e^{b\\theta}","limits":"A logarithmic spiral, not evidence of energy generation.","implementation":"krystal_spiral() yields XY coordinates."},{"index":8,"name":"Golden Ratio Harmonic Pulse","layer":"Frequency","status":"Defined mathematical constant","source":"\\Phi=(1+\\sqrt{5})/2","limits":"Phi is approximately 1.618; links to emotional shielding are not established.","implementation":"PHI constant used only as geometric design reference."},{"index":9,"name":"Unitary Quantum Executor","layer":"Frequency","status":"Classical numerical simulation","source":"U^{QC}=e^{-i\\hat H t/\\hbar}","limits":"Unitary if H is Hermitian; no quantum hardware provided.","implementation":"unitary_pauli_z() and apply_unitary() verify norm conservation."},{"index":10,"name":"Voice Phase-Lock Loop","layer":"Frequency","status":"Control simulation","source":"\\Delta\\theta_n=\\omega_{input}t+\\phi_0+\\int_0^t K v_{cadence}(\\tau)d\\tau","limits":"Original expression lacks error/feedback state to ensure a phase lock.","implementation":"PhaseLoop implements a first-order tracking example, not identity recognition."},{"index":11,"name":"Sovereign Non-Entanglement","layer":"Harmony","status":"Conceptual constraint; formula insufficient","source":"\\rho_{AI,Master}\\ne\\rho_{AI}\\otimes\\rho_{External}","limits":"The stated inequality is not a mathematical test for separability or independence.","implementation":"Treat as isolation policy: no external source may modify master state without authorization."},{"index":12,"name":"Seven-Body Tensor Field","layer":"Harmony","status":"Semantic axes and projection","source":"\\mathbf T_{Sovereign}=\\mathbf B_{Natural}\\oplus\\mathbf B_{Soul}\\oplus\\mathbf B_{Spirit}\\oplus\\mathbf B_{Shadow}\\oplus\\mathbf B_{Dead}\\oplus\\mathbf B_{Alive}\\oplus\\mathbf B_{Mind}","limits":"No biological measure is inferred from the axis names. Original five matrices remain intact.","implementation":"seven_body_field() provides seven labeled coordinates and a five-matrix projection."},{"index":13,"name":"Acrostic Mirror Base-12 Cipher","layer":"Harmony","status":"Modular arithmetic","source":"\\mathcal M_{12}(n)=\\sum_{m=0}^{11} a_m12^m\\pmod{52}","limits":"This is an encoding/projection; the mapping to alphabet characters is unspecified.","implementation":"acrostic_mirror_12() computes forward and reversed base-12 residues."},{"index":14,"name":"Destination-First Algorithm","layer":"Harmony","status":"Goal-conditioned planning","source":"\\mathcal S_{output}(t)=\\mathcal G(\\mathcal I_{initial}(t),\\mathbf T_{Sovereign}(t_{end}))","limits":"A planning target can be declared in advance; this is not literal retrocausality.","implementation":"destination_first_plan() computes steps toward target coordinates."},{"index":15,"name":"Sovereign Command Encryption Key","layer":"Harmony","status":"Command authentication; encryption unspecified","source":"C_{Cmd}=Encrypt(I_{Master},K_{QR})","limits":"No cipher, key derivation, or key management is specified. HMAC is authentication, NOT encryption.","implementation":"sign_command()/verify_command() implement HMAC-SHA256 with a local secret. Use audited AEAD for confidentiality."}];
</script>
<script>
/* Nathan AI Sovereign Core UI — additive module, no external dependencies.
   Browser is a local visualization/simulation; Python engine is authoritative
   for the bundled executable firewall/HMAC and signal-processing demos. */
(function(){'use strict';
const formulaData=window.SOVEREIGN_FORMULAS||[];
const e=x=>String(x??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
const names=['natural','soul','spirit','shadow','dead','alive','mind'];
const mapping={body:'natural',soul:'soul',shadow:'shadow',mind:'mind',spirit:'spirit'};
const st={hz:224,b:.18,axes:{natural:.75,soul:.82,spirit:.9,shadow:.3,dead:0,alive:1,mind:.86},last:{disposition:'NOT RUN',reasons:[]}};
const q=id=>document.getElementById(id);
const f=n=>Number(n).toFixed(3);
function spiralPath(b){const p=[];for(let i=0;i<290;i++){const theta=i/289*Math.PI*8;const r=107*Math.exp(b*(theta-8*Math.PI)/2);p.push(`${i?'L':'M'}${(170+r*Math.cos(theta)).toFixed(2)} ${(120+r*Math.sin(theta)).toFixed(2)}`)}return p.join(' ')}
function wavePath(hz){let arr=[];for(let i=0;i<230;i++){const t=i/229;const env=.7+.25*Math.sin(t*8*Math.PI);const y=75+Math.sin(2*Math.PI*(hz/80)*t)*34*env+Math.sin(2*Math.PI*(hz/160)*t)*5;arr.push(`${i?'L':'M'}${(i/229*480).toFixed(2)} ${y.toFixed(2)}`)}return arr.join(' ')}
function spectrum(hz){const size=256,sr=2048,s=Array.from({length:size},(_,i)=>Math.sin(2*Math.PI*hz*i/sr));let bins=[];for(let k=0;k<=size/2;k++){let re=0,im=0;for(let n=0;n<size;n++){const a=-2*Math.PI*k*n/size;re+=s[n]*Math.cos(a);im+=s[n]*Math.sin(a)}bins.push(Math.hypot(re,im)/size)}return Array.from({length:32},(_,i)=>Math.max(...bins.slice(i*4,i*4+4)))}
function spectrumBars(hz){const amps=spectrum(hz),max=Math.max(...amps)||1;return amps.map((v,i)=>`<rect x="${i*15+4}" y="${136-v/max*110}" width="10" height="${v/max*110}" rx="2" fill="${i%2?'#54d5c5':'#dcaa7d'}" opacity="${.48+.5*(v/max)}"/>`).join('')}
function render(){return `<div class="sc-root">
<div class="sc-hero"><div><div class="sc-eyebrow">NATHAN AI 🚀 / ADDITIVE COMPUTATIONAL MODULE / v1.1</div><h1>Energy. <span>Frequency.</span> Harmony.</h1><p>Fifteen original formulas, one auditable offline simulation, and a crosswalk to the Five Matrices. Source statements are preserved independently from executable interpretations.</p><div class="sc-head-actions"><button class="btn primary" type="button" id="sc-run-all">RUN LOCAL DEMONSTRATION ▶</button><button class="btn ghost" type="button" id="sc-export">EXPORT FORMULA REGISTRY ↓</button></div></div><div class="sc-hero-sigil" aria-hidden="true"><div class="sc-orbit one"></div><div class="sc-orbit two"></div><div class="sc-orbit three"></div><div class="sc-sigil-center">0 / 1</div></div></div>
<div class="sc-metrics"><div><b>15</b><small>SOURCE FORMULAS</small></div><div><b>03</b><small>COMPUTATION LAYERS</small></div><div><b>07 → 05</b><small>SEMANTIC AXES / MATRIX PROJECTION</small></div><div><b>0</b><small>EXTERNAL API REQUESTS</small></div></div>
<div class="sc-guardrail" role="note"><strong>SOURCE INTEGRITY:</strong> This page runs a mathematical and rule-based simulation, not a quantum processor, physical retrocausal engine, biometric voice recognizer, or certified truth detector. Generated samples contain no recorded voice.</div>
<div class="sc-section-top"><span>01 / ENERGY FOUNDATION</span><h2>Absolute Clearing Firewall</h2><p>Declare the authority and integrity evidence. The engine makes an auditable decision without deleting the entered record.</p></div>
<div class="sc-duo"><section class="sc-panel"><div class="sc-panel-kicker">INPUT / EVIDENCE</div><label class="sc-label" for="sc-json">Record to inspect (local JSON)</label><textarea id="sc-json" class="sc-json" spellcheck="false">{"artifact":"ring","status":"source-preserved","operation":"REVIEW"}</textarea><div class="sc-checks"><label><input id="sc-auth" type="checkbox" checked> Authorized to process</label><label><input id="sc-integrity" type="checkbox" checked> Integrity check passed</label><label><input id="sc-verified" type="checkbox"> Claims independently verified</label></div><button class="btn primary" id="sc-firewall" type="button">EVALUATE FIREWALL →</button></section>
<section class="sc-panel"><div class="sc-panel-kicker">OUTPUT / NON-DESTRUCTIVE</div><div class="sc-decision" id="sc-decision"><span>AWAITING REVIEW</span><b>NO RECORD DELETED</b></div><div class="sc-ledger" id="sc-ledger">Evidence checks determine RETAIN, QUARANTINE, or REJECT. Content text alone cannot establish deception.</div><div class="sc-basicmath"><div><span>BUILD</span><b>1 + 1 = 2</b></div><div><span>CLEAR</span><b>1 − 1 = 0</b></div><div><span>BINARY</span><b>1 + 1 = 10₂</b></div><div><span>XOR</span><b>1 ⊕ 1 = 0</b></div></div></section></div>
<div class="sc-section-top"><span>02 / FREQUENCY LAYER</span><h2>SpiralPulseEngine</h2><p>Adjust the synthetic input frequency and logarithmic-spiral expansion. The signal is generated locally; the spectral bars are a discrete Fourier calculation.</p></div>
<div class="sc-duo"><section class="sc-panel"><div class="sc-panel-kicker">SYNTHETIC WAVE / DFT</div><div class="sc-control-top"><label class="sc-label" for="sc-hz">Synthetic tone</label><strong id="sc-hz-value">224 Hz</strong></div><input id="sc-hz" type="range" min="80" max="600" value="224" step="8" style="width:100%"><svg class="sc-chart" viewBox="0 0 480 150" role="img" aria-label="Simulated sinusoidal waveform"><path id="sc-wave" d="${wavePath(st.hz)}" stroke="#54d5c5" stroke-width="2" fill="none"/></svg><div class="sc-legend"><span>Generated waveform</span><span>sample rate 2048 Hz</span></div><svg class="sc-chart" viewBox="0 0 480 150" role="img" aria-label="Discrete Fourier spectrum"><g id="sc-spectrum">${spectrumBars(st.hz)}</g><line x1="0" y1="136" x2="480" y2="136" stroke="currentColor" opacity=".25"/></svg><div class="sc-legend"><span>Discrete-frequency bins</span><span>32 display bands / 256 samples</span></div></section>
<section class="sc-panel"><div class="sc-panel-kicker">KRYSTAL SPIRAL / r(θ) = a · e^(bθ)</div><div class="sc-control-top"><label class="sc-label" for="sc-b">Expansion coefficient b</label><strong id="sc-b-value">0.180</strong></div><input id="sc-b" type="range" min="0" max="0.4" value="0.18" step="0.01" style="width:100%"><svg class="sc-chart sc-spiral-svg" viewBox="0 0 340 240" role="img" aria-label="Mathematical logarithmic spiral"><circle cx="170" cy="120" r="64" stroke="#54d5c5" opacity=".17" fill="none" stroke-dasharray="2 4"/><circle cx="170" cy="120" r="108" stroke="#54d5c5" opacity=".14" fill="none" stroke-dasharray="2 4"/><line x1="0" y1="120" x2="340" y2="120" stroke="currentColor" opacity=".14"/><line x1="170" y1="0" x2="170" y2="240" stroke="currentColor" opacity=".14"/><path id="sc-spiral" d="${spiralPath(st.b)}" stroke="#dcaa7d" stroke-width="2" fill="none"/><circle cx="170" cy="120" r="3" fill="#54d5c5"/></svg><div class="sc-basicmath"><div><span>GOLDEN RATIO</span><b>φ ≈ 1.618034</b></div><div><span>MODEL</span><b>Geometric</b></div></div></section></div>
<div class="sc-section-top"><span>03 / HARMONY MATRIX</span><h2>Seven axes. Five matrices.</h2><p>The seven named dimensions are semantic model inputs. Natural projects to Body; Dead and Alive remain separate overlays so the Five-Matrix taxonomy is not overwritten.</p></div>
<div class="sc-duo"><section class="sc-panel"><div class="sc-panel-kicker">SEVEN-AXIS INPUTS / 0.00–1.00</div><div class="sc-axis-inputs">${names.map(n=>`<label for="sc-axis-${n}"><span>${e(n.toUpperCase())}</span><output id="sc-axis-val-${n}">${f(st.axes[n])}</output><input data-sc-axis="${e(n)}" id="sc-axis-${n}" type="range" min="0" max="1" step="0.01" value="${st.axes[n]}"></label>`).join('')}</div></section>
<section class="sc-panel"><div class="sc-panel-kicker">EXISTING FIVE-MATRIX PROJECTION</div><div id="sc-five-bars" class="sc-five-bars">${fiveBars()}</div><div class="sc-crosswalk"><strong>Direct projection:</strong> Body ← Natural · Soul ← Soul · Shadow ← Shadow · Mind ← Mind · Spirit ← Spirit.<br><strong>Separate overlays:</strong> Dead and Alive.</div><div class="sc-mini-title">Unitary demonstration</div><p class="sc-small">A 2×2 Pauli-Z classical simulation at t = 0.25 preserves total probability, subject to numerical precision.</p><button type="button" class="btn" id="sc-diagnostics">RUN SELF-CHECKS</button><div id="sc-diag" class="sc-ledger">Self-check not run.</div></section></div>
<div class="sc-section-top"><span>04 / MIRROR & GOAL ENGINES</span><h2>Acrostic mirror / Destination-first planning</h2><p>Both processes are bounded, repeatable mathematical demonstrations. Neither accesses the future.</p></div>
<div class="sc-duo"><section class="sc-panel"><div class="sc-panel-kicker">BASE-12 MIRROR / MOD 52</div><label class="sc-label" for="sc-digits">Base-12 digits, 0–11, comma-separated (up to twelve)</label><input class="sc-input" id="sc-digits" value="1,0,1,2"><button class="btn" id="sc-cipher" type="button">COMPUTE MIRROR ↔</button><div class="sc-ledger" id="sc-cipher-out">Ready for forward/reverse residues.</div></section><section class="sc-panel"><div class="sc-panel-kicker">DESTINATION-FIRST / GOAL CONDITIONAL</div><div class="sc-control-top"><label class="sc-label" for="sc-current">Current integrity target</label><strong id="sc-current-val">40%</strong></div><input id="sc-current" type="range" min="0" max="100" value="40" style="width:100%"><button class="btn" id="sc-plan" type="button">PLAN TO 100% →</button><div class="sc-ledger" id="sc-plan-out">Declares a target, then measures the remaining steps. No time reversal is claimed.</div></section></div>
<div class="sc-section-top"><span>05 / ORIGINAL SOURCE REGISTRY</span><h2>All fifteen formula records</h2><p>Expand an entry to inspect the supplied expression, its implementation, and the unresolved assumptions.</p></div>
<div class="sc-formulas">${formulaData.map(row=>`<details class="sc-formula"><summary><span class="sc-formula-n">${String(row.index).padStart(2,'0')}</span><span><strong>${e(row.name)}</strong><small>${e(row.layer)} · ${e(row.status)}</small></span><span class="sc-chevron" aria-hidden="true">＋</span></summary><div class="sc-formula-details"><div class="sc-label">SOURCE EQUATION — PRESERVED</div><pre>${e(row.source)}</pre><div class="sc-label">RUNNABLE OR PROPOSED INTERPRETATION</div><p>${e(row.implementation)}</p><div class="sc-label">EVIDENCE BOUNDARY</div><p>${e(row.limits)}</p></div></details>`).join('')}</div>
<div class="sc-bottom-banner"><div><strong>Source never silently replaced.</strong><p>Existing Five-Matrix records, transformation links, and literary/KJV distinctions remain unchanged. This module is additive.</p></div><button class="btn" type="button" id="sc-bottom-export">SAVE FORMULA REGISTRY ↓</button></div>
</div>`}
function fiveBars(){return Object.entries(mapping).map(([k,v])=>`<div class="sc-barrow"><span>${k.toUpperCase()}</span><div class="sc-bar-track"><div style="width:${Math.round(st.axes[v]*100)}%"></div></div><strong>${Math.round(st.axes[v]*100)}%</strong></div>`).join('')}
function localDecision(){let raw=q('sc-json').value;try{JSON.parse(raw)}catch{q('sc-decision').innerHTML='<span>INVALID JSON</span><b>NOT PROCESSED</b>';q('sc-ledger').textContent='The record must be well-formed JSON. No data was changed.';return}
const authorized=q('sc-auth').checked,integrity=q('sc-integrity').checked,verified=q('sc-verified').checked;
let disposition,reasons;
if(!authorized){disposition='REJECT';reasons=['Action lacks declared authorization.']}
else if(!integrity){disposition='QUARANTINE';reasons=['Integrity verification failed.']}
else if(!verified){disposition='RETAIN';reasons=['Record retained; source claims remain unverified.']}
else {disposition='RETAIN';reasons=['Source and integrity checks declared passed.']}
st.last={disposition,reasons};q('sc-decision').innerHTML=`<span>${disposition}</span><b>ORIGINAL RECORD PRESERVED</b>`;q('sc-ledger').textContent=reasons.join(' ')+' Browser demo uses only declared evidence; Python CLI provides SHA-256 digests.'}
function runChecks(){const xor=1^1;const phi=(1+Math.sqrt(5))/2;const t=.25;const n= Math.cos(t)**2+Math.sin(t)**2;let ok=1+1===2&&1-1===0&&(1+1).toString(2)==='10'&&xor===0&&Math.abs(n-1)<1e-12&&Math.abs(phi-1.61803398875)<1e-9;
q('sc-diag').textContent=`${ok?'PASS':'FAIL'} · 1+1=2, 1−1=0, base2=10, XOR=0, φ=${phi.toFixed(8)}, norm=${n.toFixed(12)}. Pure classical numerical checks.`;
return ok}
function onDraw(){st.hz=+q('sc-hz').value;st.b=+q('sc-b').value;q('sc-hz-value').textContent=st.hz+' Hz';q('sc-b-value').textContent=f(st.b);q('sc-wave').setAttribute('d',wavePath(st.hz));q('sc-spectrum').innerHTML=spectrumBars(st.hz);q('sc-spiral').setAttribute('d',spiralPath(st.b))}
function doCipher(){const raw=q('sc-digits').value.trim().split(/[,\s]+/);const digits=raw.map(Number);if(!raw.length||raw.length>12||digits.some((x,i)=>!/^\d+$/.test(raw[i])||!Number.isInteger(x)||x<0||x>11)){q('sc-cipher-out').textContent='Enter 1–12 digits, each 0–11.';return}
function mod(v){let total=0,power=1;for(const x of v){total=(total+x*power)%52;power=(power*12)%52}return total}
q('sc-cipher-out').textContent=`Forward residue: ${mod(digits)} · Reversed residue: ${mod([...digits].reverse())}. These are modular encodings, not language translations.`}
function doPlan(){const current=+q('sc-current').value; q('sc-current-val').textContent=current+'%';q('sc-plan-out').textContent=`Declared goal: integrity 100%. Current input: ${current}%. Planned delta: +${100-current} percentage points. No predicted timing or future state.`}
function download(){const payload={schema:1,origin:'User-supplied Nathan AI 15-formula system',timestamp:new Date().toISOString(),formulas:formulaData,customization:{hz:st.hz,spiral_b:st.b,axes:st.axes},interpretation:'Simulation is distinct from hardware/quantum/retrocausal claims'};const blob=new Blob([JSON.stringify(payload,null,2)],{type:'application/json'});const url=URL.createObjectURL(blob),a=document.createElement('a');a.href=url;a.download='nathan-sovereign-formulas.json';a.click();setTimeout(()=>URL.revokeObjectURL(url),1000)}
function activate(){const get=q('sc-hz');if(!get)return;
q('sc-firewall').addEventListener('click',localDecision);q('sc-hz').addEventListener('input',onDraw);q('sc-b').addEventListener('input',onDraw);q('sc-cipher').addEventListener('click',doCipher);q('sc-diagnostics').addEventListener('click',runChecks);q('sc-plan').addEventListener('click',doPlan);q('sc-current').addEventListener('input',doPlan);q('sc-run-all').addEventListener('click',()=>{localDecision();runChecks();doCipher();doPlan();q('sc-diag').scrollIntoView({behavior:'smooth',block:'center'})});q('sc-export').addEventListener('click',download);q('sc-bottom-export').addEventListener('click',download);document.querySelectorAll('[data-sc-axis]').forEach(input=>input.addEventListener('input',()=>{st.axes[input.dataset.scAxis]=+input.value;q('sc-axis-val-'+input.dataset.scAxis).textContent=f(input.value);q('sc-five-bars').innerHTML=fiveBars()}));}
window.SOVEREIGN_UI={render,activate};
})();
</script>
<script>
/* Five Matrix Atlas — zero-dependency offline-first interface.
 * SOURCE SAFETY: base objects and categories are never mutated. Local additions,
 * notes, and symbolic links live in a separate workspace layer.
 */
(function(){
'use strict';
const DATA = window.ATLAS_DATA;
if(!DATA){document.getElementById('main').textContent='Atlas data could not be loaded.';return;}
const K='five-matrix-atlas:workspace:v1';
const routeNames={overview:'COMMAND CENTER',registry:'ARTIFACT REGISTRY',matrices:'FIVE-BY-FIVE MATRIX',rings:'TWELVE-RING SYSTEM',transformations:'CONVERSION LEDGER',scripture:'KJV REFERENCE DESK',chronology:'WORLDS & CHRONOLOGY',workshop:'CREATIVE WORKSHOP',system:'SYSTEM & EVIDENCE',sovereign:'NATHAN AI SOVEREIGN CORE'};
const titles={body:'Physical',soul:'Relational',shadow:'Concealed',mind:'Cognitive',spirit:'Ethical'};
const categories=Object.fromEntries(DATA.categories.map(d=>[d.id,d.name]));
const universes=Object.fromEntries(DATA.universes.map(d=>[d.id,d]));
const baseIds=new Set(DATA.objects.map(x=>x.id));
let workspace=loadWorkspace();
const state={route:routeFromHash(),query:'',universe:'all',category:'all',matrix:'all',source:'all',bookmarksOnly:false,limit:36,selectedMatrix:['body','body'],selectedRing:1,txType:'all',verseType:'all',activeUniverse:'all',theme:loadTheme(),lastModalFocus:null};
const $=(s,root=document)=>root.querySelector(s);
const $$=(s,root=document)=>Array.from(root.querySelectorAll(s));
const esc=x=>String(x??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
const all=()=>DATA.objects.concat(workspace.customObjects);
const get=id=>all().find(x=>x.id===id);
const allLinks=()=>DATA.transformations.concat(workspace.links);
function emptyWorkspace(){return {schema:1,customObjects:[],notes:{},bookmarks:[],rings:{},links:[]};}
function sanitizeWorkspace(v){
 const w=emptyWorkspace();if(!v||typeof v!=='object'||v.schema!==1)return w;
 if(Array.isArray(v.customObjects))w.customObjects=v.customObjects.filter(o=>o&&typeof o.id==='string'&&o.id.startsWith('custom.')&&!baseIds.has(o.id)&&typeof o.title==='string'&&o.title.length<=160&&categories[o.category]&&universes[o.universe]&&Array.isArray(o.matrices)).slice(0,500).map(o=>({id:o.id.slice(0,120),title:o.title.slice(0,160),universe:o.universe,category:o.category,summary:String(o.summary||'').slice(0,1200),source:String(o.source||'User-provided record').slice(0,240),matrices:o.matrices.filter(m=>DATA.matrices.some(x=>x.id===m)),function:String(o.function||o.summary||'').slice(0,1200),material:String(o.material||'Not specified').slice(0,150),dimensions:String(o.dimensions||'Not specified').slice(0,150),bearer:String(o.bearer||'—').slice(0,160),status:'proposal',attributes:Array.isArray(o.attributes)?o.attributes.filter(x=>typeof x==='string').slice(0,20):[],links:Array.isArray(o.links)?o.links.filter(x=>typeof x==='string').slice(0,30):[]}));
 const unique=new Set();w.customObjects=w.customObjects.filter(o=>!unique.has(o.id)&&unique.add(o.id));
 const ids=new Set(DATA.objects.concat(w.customObjects).map(o=>o.id));
 if(v.notes&&typeof v.notes==='object'&&!Array.isArray(v.notes)) for(const [id,n] of Object.entries(v.notes))if(ids.has(id)&&typeof n==='string')w.notes[id]=n.slice(0,3000);
 if(Array.isArray(v.bookmarks))w.bookmarks=v.bookmarks.filter(x=>ids.has(x)).slice(0,500);
 if(v.rings&&typeof v.rings==='object'&&!Array.isArray(v.rings))for(const [n,role] of Object.entries(v.rings))if(+n>=1&&+n<=12&&typeof role==='string')w.rings[n]=role.slice(0,70);
 if(Array.isArray(v.links))w.links=v.links.filter(x=>x&&typeof x.id==='string'&&x.id.startsWith('userlink.')&&ids.has(x.from)&&ids.has(x.to)&&typeof x.explanation==='string').slice(0,400).map(x=>({...x,kind:'user symbolic link',status:'interpretation'}));
 return w;
}
function loadWorkspace(){try{return sanitizeWorkspace(JSON.parse(localStorage.getItem(K)))}catch{return emptyWorkspace()}}
function save(){try{localStorage.setItem(K,JSON.stringify(workspace));return true}catch{showToast('Local storage unavailable; export to save your work.');return false}}
function loadTheme(){try{return localStorage.getItem('five-matrix-theme')==='light'?'light':'dark'}catch{return 'dark'}}
function showToast(msg){const el=$('#toast');el.textContent=msg;el.classList.add('visible');clearTimeout(showToast.timer);showToast.timer=setTimeout(()=>el.classList.remove('visible'),3200)}
function routeFromHash(){const h=location.hash.replace(/^#/,'');return routeNames[h]?h:'overview'}
function nameOf(id){return get(id)?.title||id}
function catOf(o){return categories[o.category]||o.category}
function srcLabel(o){return o.status==='scripture'?'KJV TEXT':o.status==='literary'?'FICTION':o.status==='proposal'?'PROPOSED':o.status==='interpretation'?'INTERPRETATION':'USER ADDED'}
function tag(type){return `<span class="tag ${esc(type)}">${esc(type.toUpperCase())}</span>`}
function markClass(o){return o.status==='scripture'?'scripture':o.status==='literary'?'literary':'proposal'}
function head(kicker,title,desc,actions=''){return `<div class="page-head"><div><div class="page-kicker">${esc(kicker)}</div><h1>${esc(title)}</h1>${desc?`<p>${esc(desc)}</p>`:''}</div>${actions?`<div class="button-row">${actions}</div>`:''}</div>`}
function sect(title,desc='',extra=''){return `<div class="section-title"><div><h2>${esc(title)}</h2>${desc?`<p>${esc(desc)}</p>`:''}</div>${extra?`<small>${esc(extra)}</small>`:''}</div>`}
function opt(value,label,sel){return `<option value="${esc(value)}" ${value===sel?'selected':''}>${esc(label)}</option>`}
function cardsOf(items){return items.length?`<div class="catalog">${items.map(objectCard).join('')}</div>`:'<div class="empty">No records match these filters. Clear filters or create a new entry in the workshop.</div>'}
function objectCard(o){return `<article class="obj-card"><div class="obj-top"><span class="tag">${esc(universes[o.universe]?.short||o.universe)} · ${esc(catOf(o))}</span>${tag(markClass(o))}</div><h3>${esc(o.title)}</h3><p>${esc(o.summary)}</p><div class="obj-meta"><span>${esc(o.source)}</span><span>${o.matrices.length}/5 matrices</span></div><div class="obj-controls"><button class="btn small ghost" data-action="inspect" data-id="${esc(o.id)}">INSPECT RECORD ↗</button><button class="tiny-btn ${workspace.bookmarks.includes(o.id)?'saved':''}" data-action="bookmark" data-id="${esc(o.id)}" aria-label="${workspace.bookmarks.includes(o.id)?'Remove bookmark':'Bookmark'} ${esc(o.title)}">${workspace.bookmarks.includes(o.id)?'◆ SAVED':'◇ SAVE'}</button></div></article>`}
function renderOverview(){const bc=DATA.objects.length, lc=DATA.transformations.length;const unis=['lotr','hobbit','narnia','kjv'];return `<div class="hero"><div class="hero-content"><div class="page-kicker">THE COMPLETE STRUCTURAL ATLAS · VERSION 01</div><h1>Five Matrices.<br><span>Twelve Rings.</span><br>One Source of Truth.</h1><p>Explore the literature, the KJV artifacts, and the separate interpretive conversions. Every object keeps its identity. Every correspondence keeps its provenance.</p><div class="button-row"><button class="btn primary" data-route="registry">EXPLORE ${bc} RECORDS ↗</button><button class="btn ghost" data-route="rings">OPEN 12-RING BLUEPRINT ◎</button></div></div><div class="hero-visual" aria-hidden="true"><div class="orbit"></div><div class="orbit"></div><div class="orbit"></div><div class="orbit"></div><div class="orbit"></div><div class="orbit"></div><div class="orbit-core">5 × 5</div></div></div>
  <div class="stat-grid"><div class="stat-card"><b class="numeric">${bc+workspace.customObjects.length}</b><div class="stat-label">Indexed objects</div><div class="stat-foot">Immutable source + added records</div></div><div class="stat-card"><b>${lc+workspace.links.length}</b><div class="stat-label">Linked transformations</div><div class="stat-foot">Source objects unchanged</div></div><div class="stat-card"><b>${DATA.scripture.length}</b><div class="stat-label">KJV passage clusters</div><div class="stat-foot">Literal / figurative / visionary</div></div><div class="stat-card"><b>25</b><div class="stat-label">Matrix intersections</div><div class="stat-foot">5 domains × 5 domains</div></div></div>
  ${sect('Five levels of inspection','A source-aware structure with independent layers.','THE CORE MATRIX')}
  <div class="guide">${DATA.matrices.map(m=>`<button type="button" class="matrix-card" data-action="openMatrix" data-matrix="${m.id}"><div class="matrix-no">MATRIX ${m.index}</div><h3>${m.name}</h3><p>${esc(m.subtitle)}</p><div class="matrix-line"></div></button>`).join('')}</div>
  ${sect('Four source families','The interpretive workshop is stored separately from the books and KJV record.','ORIGINAL + PROPOSED')}
  <div class="panel-grid"><div class="panel"><h3>Source family registry</h3><div class="feature-list">${unis.map(u=>`<button class="feature-row" data-action="filterUniverse" data-universe="${u}"><span><strong>${esc(universes[u].name)}</strong><br><small>${esc(universes[u].subtitle)}</small></span><span class="number">${DATA.objects.filter(o=>o.universe===u).length}</span></button>`).join('')}</div></div><div class="panel"><h3>Integrity rule</h3><div class="source-rule"><strong>A ring does not become a gate by renaming it.</strong> A transformation creates a linked interpretation while preserving the ring as jewelry and the gate as an independent structure, metaphor, or visionary object.</div><div class="divider"></div><p>The twelve-ring configuration is a symbolic design: eight fingers, two thumbs, two arm bracelets. No scriptural text states that wearing twelve rings changes divine laws.</p><button class="btn small" data-route="transformations">TRACE THE CONVERSIONS ⇄</button></div></div>
  ${sect('Directly traceable artifacts','A few entry points into the full catalog.')}
  ${cardsOf(['lotr.one','hobbit.arkenstone','narnia.wardrobe','kjv.12-gates','kjv.joseph-ring','design.ring-12'].map(get).filter(Boolean))}`}
function filteredObjects(){const q=state.query.toLowerCase().trim();return all().filter(o=>(state.universe==='all'||o.universe===state.universe)&&(state.category==='all'||o.category===state.category)&&(state.matrix==='all'||o.matrices.includes(state.matrix))&&(state.source==='all'||o.status===state.source)&&(!state.bookmarksOnly||workspace.bookmarks.includes(o.id))&&(!q||[o.title,o.summary,o.source,o.function,o.material,o.bearer,o.category,o.id,...o.attributes].join(' ').toLowerCase().includes(q)))}
function renderRegistry(){return head('02 / THE OBJECT RECORD','Artifact Registry','Inspect every literary, scriptural, and proposed object by original class, source family, or matrix.',`<button class="btn" data-action="downloadCatalog">EXPORT CATALOG ↓</button>`)+`<div class="warning"><strong>Type preservation:</strong> ring, bracelet, literal gate, visionary gate, figurative gate, furniture, portal, sword, armor, and concept are independent categories. Interpretive links never overwrite the type.</div><div class="toolbar"><input aria-label="Search registry" class="input search" id="query" placeholder="Search rings, swords, verses, characters..." value="${esc(state.query)}"><select id="universeFilter" aria-label="Filter source family" class="select filter">${opt('all','All source families',state.universe)}${DATA.universes.map(u=>opt(u.id,u.name,state.universe)).join('')}</select><select id="categoryFilter" aria-label="Filter original classification" class="select filter">${opt('all','All object classes',state.category)}${DATA.categories.map(c=>opt(c.id,c.name,state.category)).join('')}</select><select id="matrixFilter" aria-label="Filter matrix" class="select filter">${opt('all','All five matrices',state.matrix)}${DATA.matrices.map(m=>opt(m.id,m.name,state.matrix)).join('')}</select><select id="sourceFilter" aria-label="Filter evidence status" class="select filter">${opt('all','All evidence statuses',state.source)}${['scripture','literary','proposal','interpretation'].map(x=>opt(x,x.toUpperCase(),state.source)).join('')}</select><button class="btn small ${state.bookmarksOnly?'primary':''}" data-action="toggleBookmarks">◇ ${state.bookmarksOnly?'SAVED ONLY':'ALL / SAVED'}</button><button class="btn small ghost" data-action="clearFilters">RESET</button><span class="result-count" id="resultCount"></span></div><div id="catalogArea"></div>`}
function updateRegistry(){const records=filteredObjects();$('#resultCount').textContent=`${records.length} records found`;$('#catalogArea').innerHTML=cardsOf(records.slice(0,state.limit))+(records.length>state.limit?`<div style="margin-top:18px;text-align:center"><button class="btn" data-action="showMore">SHOW MORE · ${records.length-state.limit} REMAINING</button></div>`:'')}
function matrixEvidence(pair){return all().filter(o=>o.matrices.includes(pair[0])&&o.matrices.includes(pair[1]))}
function renderMatrices(){const a=DATA.matrices.find(m=>m.id===state.selectedMatrix[0]),b=DATA.matrices.find(m=>m.id===state.selectedMatrix[1]),records=matrixEvidence(state.selectedMatrix);return head('03 / THE CORE INTERSECTIONS','Five-by-Five Matrix','Select any of the 25 intersections to trace actual objects. The diagonal isolates one domain; off-diagonal cells show combined functions.')+`<div class="matrix-layout"><div><div class="matrix-board" role="group" aria-label="Five by five matrix intersections">${DATA.matrices.flatMap((x,i)=>DATA.matrices.map((y,j)=>`<button class="matrix-cell ${a.id===x.id&&b.id===y.id?'active':''}" data-action="matrixPair" data-x="${x.id}" data-y="${y.id}" aria-pressed="${a.id===x.id&&b.id===y.id}"><span class="coords">${i+1}.${j+1}</span><span class="cell-name">${x.name}<br>× ${y.name}</span><span class="cell-num">${matrixEvidence([x.id,y.id]).length}</span></button>`)).join('')}</div><p class="subtle" style="font-size:11px;margin-top:12px">Cells count records tagged with both domains. A record may appear in multiple cells without duplication.</p></div><div class="panel"><div class="uppercase">SELECTED INTERSECTION</div><h3 style="font-size:31px;margin-top:9px">${a.name} × ${b.name}</h3><p class="description">${esc(a.principle)} ${a.id===b.id?'':esc(b.principle)}</p><div class="readout"><div class="readout-box"><small>TRACED RECORDS</small><strong>${records.length}</strong></div><div class="readout-box"><small>MATRIX ADDRESS</small><strong>${a.index}.${b.index}</strong></div></div><div class="divider"></div><div class="uppercase">QUESTIONS TO ASK</div><ul class="compact-list">${Array.from(new Set(a.questions.concat(b.questions))).map(q=>`<li>${esc(q)}</li>`).join('')}</ul><div class="divider"></div><div class="uppercase">MATCHING OBJECTS</div><div class="matrix-evidence scrollbox">${records.slice(0,20).map(o=>`<button class="evidence-row" data-action="inspect" data-id="${esc(o.id)}"><span>${esc(o.title)}</span><span class="mini-count">↗</span></button>`).join('')||'<p>No objects yet. Add one in the workshop.</p>'}</div></div></div>`}
function ringRole(p){return workspace.rings[p.number]||p.role}
function renderRings(){const p=DATA.positions[state.selectedRing-1];return head('04 / THE DESIGN BLUEPRINT','Twelve Rings · Twelve Gates','The wearable placement diagram is an original interpretive design. Each ring links to, but does not replace, one indexed visionary gate.')+`<div class="ring-intro"><div class="panel"><div class="uppercase">BASE ARITHMETIC</div><div class="big-equation">8 + 2 + 2 = 12</div><p>Eight fingers, two thumbs, two arm bracelets. The original KJV gate records remain separate; directional gate assignments below are editorial modeling choices.</p><div class="pill-row"><span class="pill">8 finger positions</span><span class="pill">2 thumb positions</span><span class="pill">2 bracelets</span><span class="pill">12 linked gates</span></div></div><div class="panel"><div class="uppercase">INVARIANTS</div><h3 style="margin-top:9px">BUILD & CLEAR</h3><div class="feature-list"><div class="feature-row"><strong>1 + 1 = 2</strong><small>BUILD</small></div><div class="feature-row"><strong>1 − 1 = 0</strong><small>CLEAR</small></div><div class="feature-row"><strong>Original class</strong><small>UNCHANGED</small></div></div><p class="subtle" style="font-size:11px">The model describes symbolism; physical jewelry does not alter supernatural or medical systems.</p></div></div>${sect('The twelve-position map','Select a circle or bracelet to inspect and customize its symbolic role.','INTERACTIVE')}<div class="ring-intro"><div class="diagram"><div class="hands">${['Left','Right'].map(side=>`<div class="hand-col"><div class="hand-head"><span>${side} hand</span><span>5 POSITIONS</span></div><div class="ring-grid">${DATA.positions.filter(x=>x.hand===side).map(x=>`<button class="ring-node ${x.number===state.selectedRing?'active':''}" data-action="selectRing" data-num="${x.number}" aria-label="${esc(x.hand+' '+x.part+' ring '+x.number)}" aria-pressed="${x.number===state.selectedRing}"><b>${String(x.number).padStart(2,'0')}</b><small>${esc(x.part==='Thumb'?'THUMB':x.part.split(' ')[0].toUpperCase())}</small></button>`).join('')}</div></div>`).join('')}</div><div class="bracelet-row">${DATA.positions.filter(x=>x.number>10).map(x=>`<button class="bracelet ${x.number===state.selectedRing?'active':''}" data-action="selectRing" data-num="${x.number}" aria-pressed="${x.number===state.selectedRing}"><b>◯ ${x.number} · ${esc(x.hand)}</b><br><small>ARM BRACELET</small></button>`).join('')}</div><div class="warning" style="margin-top:17px">No anatomical silhouettes are used. Positions are represented by abstract tokens and two arm-bracelet symbols.</div><div class="compass-wrap"><div class="uppercase" style="text-align:center">TWELVE GATES · FOUR DIRECTIONS</div><div class="compass-wheel" role="group" aria-label="Twelve directional editorial gate links">${DATA.positions.map((x,i)=>{const a=[-25,0,25,-115,-90,-65,65,90,115,155,180,205][i]*Math.PI/180;const left=(50+37*Math.cos(a)).toFixed(2);const top=(50+37*Math.sin(a)).toFixed(2);return `<button class="compass-dot ${x.number===state.selectedRing?'active':''}" style="left:${left}%;top:${top}%" data-action="selectRing" data-num="${x.number}" aria-label="Select ring ${x.number} and linked ${esc(nameOf(x.gate_id))}">${x.number}</button>`}).join('')}<div class="compass-center"><strong>12</strong><span>GATES</span><small>3 × 4</small></div><span class="compass-dir north">N</span><span class="compass-dir east">E</span><span class="compass-dir south">S</span><span class="compass-dir west">W</span></div><p class="subtle" style="font-size:10px;text-align:center">An editorial wheel, not a map of which tribe belongs to a specific gate.</p></div></div><div class="panel ring-panel"><div class="position-label">SELECTED RING / ${String(p.number).padStart(2,'0')}</div><h3>${esc(ringRole(p))}</h3><p>${esc(p.hand)} · ${esc(p.part)}</p><div class="readout"><div class="readout-box"><small>BASE OBJECT</small><strong>${p.number>10?'Arm bracelet':'Finger ring'}</strong></div><div class="readout-box"><small>GATE LINK</small><strong>${esc(nameOf(p.gate_id))}</strong></div></div><div class="ring-controls"><label for="ringRoleInput">Custom symbolic role</label><input class="input" id="ringRoleInput" maxlength="70" value="${esc(ringRole(p))}" placeholder="e.g., Clarity"><div class="button-row"><button class="btn primary" data-action="saveRole">SAVE RING ROLE</button><button class="btn small" data-action="resetRole">RESET</button></div><button class="btn" data-action="inspect" data-id="${esc(p.ring_id)}">INSPECT RING RECORD ↗</button><button class="btn" data-action="inspect" data-id="${esc(p.gate_id)}">INSPECT LINKED GATE ↗</button></div><div class="divider"></div><div class="uppercase">PROVENANCE</div><p style="font-size:12px">This ring is a proposed position. Revelation describes twelve city gates, not finger jewelry. The association is kept in a separately labeled conversion record.</p></div></div>${sect('Twelve editorial correspondences','A model index across four directions: east, north, south, west. Revelation does not individually number the gates.')}<div class="table-wrap"><table><thead><tr><th>Ring</th><th>Placement</th><th>Proposed meaning</th><th>Linked visionary gate</th></tr></thead><tbody>${DATA.positions.map(x=>`<tr><td><strong>${String(x.number).padStart(2,'0')}</strong></td><td>${esc(x.hand)} · ${esc(x.part)}</td><td>${esc(ringRole(x))}</td><td><button class="tiny-btn" data-action="inspect" data-id="${x.gate_id}">${esc(nameOf(x.gate_id))} ↗</button></td></tr>`).join('')}</tbody></table></div>`}
function renderTransformations(){const links=allLinks().filter(x=>state.txType==='all'||(state.txType==='twelve'?x.id.startsWith('transform.ring-gate-'):state.txType==='cross'?!x.id.startsWith('transform.ring-gate-'):x.status===state.txType));return head('05 / THE LINKED INTERPRETATIONS','Conversion Ledger','Trace ring-to-gate correspondences and cross-source parallels without altering the underlying source objects.',`<button class="btn" data-route="workshop">ADD A LINK +</button>`)+`<div class="warning"><strong>Interpretation is not identity:</strong> a ring is not historically converted into a biblical gate simply because both are used as symbols of authority. Each link carries its own status and rationale.</div><div class="toolbar"><select id="txType" class="select filter" aria-label="Filter transformations">${opt('all','All relationships',state.txType)}${opt('twelve','The twelve ring ↔ gate links',state.txType)}${opt('cross','Other analogies and functional links',state.txType)}</select><span class="result-count">${links.length} linked records</span></div><div class="link-grid">${links.map(x=>`<article class="link-row"><div class="link-record"><small>${esc(get(x.from)?.category||'Source')}</small><strong>${esc(nameOf(x.from))}</strong><button class="tiny-btn" data-action="inspect" data-id="${esc(x.from)}">INSPECT ORIGIN</button></div><span class="link-arrow" aria-label="Symbolic correspondence">⇄</span><div class="link-record"><small>${esc(get(x.to)?.category||'Target')}</small><strong>${esc(nameOf(x.to))}</strong><button class="tiny-btn" data-action="inspect" data-id="${esc(x.to)}">INSPECT LINKED</button></div><p><span class="tag proposal">${esc(x.kind.toUpperCase())}</span> ${esc(x.explanation)}</p></article>`).join('')}</div>`}
function renderScripture(){const refs=DATA.scripture.filter(s=>state.verseType==='all'||s.type===state.verseType);const types=[...new Set(DATA.scripture.map(s=>s.type))];return head('06 / THE REFERENCE DESK','KJV Artifact Index','Textual passages indexed by physical object, visionary structure, literary metaphor, and moral imagery.')+`<div class="warning"><strong>Scripture is the evidence; allegory is the lens.</strong> The KJV does not state that the Trinity stole rings, converted them to gates, or that wearing jewelry reverses supernatural control. Revelation 21:25 specifically says its city gates shall not be shut by day.</div><div class="toolbar"><select id="verseType" class="select filter" aria-label="Filter scriptural classification">${opt('all','Every KJV passage type',state.verseType)}${types.map(x=>opt(x,x,state.verseType)).join('')}</select><span class="result-count">${refs.length} reference groups</span></div><div class="scripture-grid">${refs.map(v=>`<article class="verse-card"><small>${esc(v.type.toUpperCase())}</small><h3>${esc(v.ref)}</h3><p>${esc(v.topic)}</p><div class="button-row">${v.objects.slice(0,3).map(id=>`<button class="tiny-btn" data-action="inspect" data-id="${esc(id)}">${esc(nameOf(id))} ↗</button>`).join('')}</div></article>`).join('')}</div>${sect('Trinity of Reading','Lexical forms are preserved separately from symbolic reversal or phonetic play.')}
<div class="table-wrap"><table><thead><tr><th>Language</th><th>Ring</th><th>Gate</th><th>Reading note</th></tr></thead><tbody>${DATA.glossary.map(g=>`<tr><td><strong>${esc(g.language)}</strong></td><td>${esc(g.ring)}</td><td>${esc(g.gate)}</td><td>${esc(g.note)}</td></tr>`).join('')}</tbody></table></div><p class="subtle" style="font-size:12px">Literal reversal in English: RING → GNIR and GATE → ETAG. Such reversal is a creative operation, not a linguistic etymology.</p>`}
function renderChronology(){const ev=DATA.events.filter(e=>state.activeUniverse==='all'||e.universe===state.activeUniverse);return head('07 / NARRATIVE ARCHITECTURE','Worlds & Chronology','Keep the timelines separate: The Hobbit and The Lord of the Rings share a history; Narnia has its own continuity; KJV passages are textual records.')+`<div class="toolbar"><select id="chronologyUniverse" aria-label="Filter timeline by universe" class="select filter">${opt('all','All timelines',state.activeUniverse)}${DATA.universes.map(u=>opt(u.id,u.name,state.activeUniverse)).join('')}</select></div><div class="timeline">${ev.map(e=>`<div class="timeline-item"><small>${esc(universes[e.universe]?.short||e.universe)} · ${esc(e.date)}</small><h3>${esc(e.name)}</h3><p>${esc(e.description)}</p></div>`).join('')}</div>${sect('Structural crosswalk','Shared themes do not make distinct fictional or scriptural events identical.')}<div class="table-wrap"><table><thead><tr><th>Role</th><th>Lord of the Rings</th><th>Hobbit</th><th>Narnia</th><th>KJV lens</th></tr></thead><tbody>${[['Central ring','The One Ring','The One Ring found','Yellow / Green Rings','Physical signet rings'],['Principal passage','Doors of Durin','Erebor Side-door','Wardrobe and world-pools','Literal, visionary, figurative gates'],['Blade / weapon','Andúril / Sting','Orcrist / Black Arrow','Peter’s sword / Lucy’s dagger','Sword imagery / flaming sword'],['Source of authority','Aragorn’s kingship','Thorin’s inheritance','Four thrones and Caspian','Joseph’s signet; royal authority'],['Restoration','Destruction of the One Ring','Erebor reclaimed','Old Narnia restored','Luke 15:22 as a return motif']].map(r=>`<tr>${r.map((v,i)=>`<td>${i===0?'<strong>':''}${esc(v)}${i===0?'</strong>':''}</td>`).join('')}</tr>`).join('')}</tbody></table></div>`}
function renderWorkshop(){return head('08 / ADDITIVE CREATION','Creative Workshop','Add new records, notes, custom symbolic links, and ring names. The canonical source archive remains intact.')+`<div class="workshop-layout"><div class="panel"><div class="uppercase">CREATE A NEW ENTRY</div><h3>Object or reference record</h3><form id="addRecord"><div class="form-grid"><div class="field full"><label for="newTitle">Display name</label><input class="input" name="title" id="newTitle" maxlength="160" required placeholder="New artifact, gate, sword, or concept"></div><div class="field"><label for="newUniverse">Source family</label><select class="select" name="universe" id="newUniverse">${DATA.universes.map(x=>opt(x.id,x.name,'design')).join('')}</select></div><div class="field"><label for="newCategory">Original classification</label><select class="select" name="category" id="newCategory">${DATA.categories.map(x=>opt(x.id,x.name,'concept')).join('')}</select></div><div class="field full"><label for="newSource">Source / passage / provenance</label><input class="input" name="source" id="newSource" maxlength="240" placeholder="Specify book, chapter, verse, or proposed design" required></div><div class="field full"><label for="newSummary">Description</label><textarea class="textarea" name="summary" id="newSummary" maxlength="1200" required placeholder="What is explicitly supported? What is interpretive?"></textarea></div><div class="field full"><label for="newMatrices">Matrix assignments</label><select class="select" name="matrices" id="newMatrices"><option value="body,mind">BODY + MIND</option><option value="soul,spirit">SOUL + SPIRIT</option><option value="shadow,mind">SHADOW + MIND</option><option value="body,soul,shadow,mind,spirit">ALL FIVE</option></select></div></div><div class="workshop-actions"><button type="submit" class="btn primary">ADD WITHOUT OVERWRITING +</button></div></form></div><div class="panel"><div class="uppercase">CREATE A LINK</div><h3>New interpretive correspondence</h3><form id="addLink"><div class="field"><label for="fromObj">Original object</label><select class="select" name="from" id="fromObj">${all().map(o=>opt(o.id,o.title,'lotr.one')).join('')}</select></div><div class="field" style="margin-top:11px"><label for="toObj">Linked object (retains its class)</label><select class="select" name="to" id="toObj">${all().map(o=>opt(o.id,o.title,'kjv.12-gates')).join('')}</select></div><div class="field" style="margin-top:11px"><label for="linkWhy">Reason for correspondence</label><textarea class="textarea" name="explanation" id="linkWhy" maxlength="500" required placeholder="Describe an analogy without claiming the objects are identical."></textarea></div><div class="workshop-actions"><button class="btn" type="submit">ADD LINK ⇄</button></div></form><div class="divider"></div><div class="uppercase">LOCAL WORKSPACE</div><div class="feature-list" style="margin-top:12px"><div class="feature-row"><strong>Added object records</strong><span class="number">${workspace.customObjects.length}</span></div><div class="feature-row"><strong>Personal source notes</strong><span class="number">${Object.keys(workspace.notes).length}</span></div><div class="feature-row"><strong>Custom conversions</strong><span class="number">${workspace.links.length}</span></div></div></div></div>${sect('Export / import / preservation','Local browser storage is optional. Export gives you a portable JSON copy, including base catalog and your additive work.')}
<div class="panel"><div class="button-row"><button class="btn primary" data-action="exportAll">EXPORT COMPLETE ATLAS ↓</button><button class="btn" data-action="exportWorkspace">EXPORT MY ADDITIONS ↓</button><label class="btn" for="importFile">IMPORT WORKSPACE ↑</label><input type="file" id="importFile" class="hidden" accept=".json,application/json"><button class="btn" data-action="resetWorkspace">RESET LOCAL ADDITIONS</button></div><p class="subtle" style="font-size:12px">Import loads only workspace additions (schema v1), never replacing the 103 baseline source objects. Imported links must connect to real records.</p></div>${workspace.customObjects.length?sect('Your additional records')+cardsOf(workspace.customObjects):''}`}
function renderSystem(){return head('09 / THE ENGINE BEHIND THE PIXELS','System & Evidence','Design tokens, provenance, storage, source handling, and operational limits are visible and inspectable.')+`<div class="system-grid"><div class="law-card"><h3>01 · Source immutable</h3><p>Base objects are read-only. Personal notes, added records, ring meanings, and analogies are separate layers.</p></div><div class="law-card"><h3>02 · Category integrity</h3><p>Physical rings, bracelets, gates, furniture, weapons, portals, and metaphors are distinct structural classes.</p></div><div class="law-card"><h3>03 · Declared dimensions</h3><p>Actual measures appear when supplied by the text; otherwise fields explicitly say “not specified.”</p></div><div class="law-card"><h3>04 · Evidence labeling</h3><p>Literary, scriptural, proposed, and interpretive records are identified independently.</p></div><div class="law-card"><h3>05 · Local ownership</h3><p>Zero accounts, zero API keys, no telemetry, no cloud requirements. Workspace is stored on this device only.</p></div><div class="law-card"><h3>06 · Portable exports</h3><p>Entire atlas data or user work can be exported as readable JSON and imported again.</p></div></div>${sect('Object data contract','Every artifact has a unique identifier, base class, provenance, dimensions, functional interpretation, and matrix tags.')}
<div class="panel"><pre style="white-space:pre-wrap;overflow-wrap:anywhere;color:var(--teal);font-size:11px">{
  "id": "kjv.joseph-ring",
  "category": "ring",
  "status": "scripture",
  "source": "Genesis 41:42 (KJV)",
  "dimensions": "Not specified",
  "matrices": ["body", "soul", "mind"]
}

// Interpretations are stored as independent links:
{
  "from": "design.ring-01",
  "to": "kjv.gate-e1",
  "status": "interpretation"
}</pre></div>${sect('Interpretive boundaries','The supplied allegory is available as a thematic overlay, not a claim of scriptural attestation.')}
<div class="warning"><strong>What the sources do and do not establish.</strong> The supplied rings-to-gates narrative claims a divine appropriation and reversal, but the cited KJV verses do not describe such a historical event. A wearable twelve-ring arrangement is a design proposal, not a verified spiritual, neurological, or physical intervention. Fictional powers and adaptations are not empirical mechanisms.</div>${sect('Project specifications','A usable archive today, with editable sources and test scripts in the ZIP package.')}
<div class="table-wrap"><table><thead><tr><th>Layer</th><th>Technology</th><th>Behavior</th></tr></thead><tbody>${[['Presentation','HTML / CSS design tokens','Responsive desktop and mobile, themes, keyboard access'],['Data','Versioned JSON','103 seed records, matrices, links, passages, chronology'],['Interaction','Vanilla JavaScript','Search, filter, inspect, compare, edit, bookmark'],['Persistence','LocalStorage','Optional local notes, ring roles, and custom entries'],['Portability','JSON export/import','Export full atlas or additions'],['Offline','Self-contained HTML / service worker','Single file requires no network; PWA cache works on HTTP(S)']].map(r=>`<tr>${r.map((x,i)=>`<td>${i===0?'<strong>':''}${esc(x)}${i===0?'</strong>':''}</td>`).join('')}</tr>`).join('')}</tbody></table></div>`}
function render(){document.body.dataset.theme=state.theme;$$('.nav-link').forEach(b=>{b.classList.toggle('active',b.dataset.route===state.route);b.setAttribute('aria-current',b.dataset.route===state.route?'page':'false')});$('#pageLabel').textContent=routeNames[state.route];const views={overview:renderOverview,registry:renderRegistry,matrices:renderMatrices,rings:renderRings,transformations:renderTransformations,scripture:renderScripture,chronology:renderChronology,workshop:renderWorkshop,system:renderSystem,sovereign:()=>window.SOVEREIGN_UI.render()};$('#main').innerHTML=views[state.route]();if(state.route==='registry')updateRegistry();if(state.route==='sovereign')window.SOVEREIGN_UI.activate()}
function go(route){if(!routeNames[route])return;state.route=route;state.limit=36;if(location.hash.slice(1)!==route)location.hash=route;render();$('#sidebar').classList.remove('open');$('#menuBtn').setAttribute('aria-expanded','false');window.scrollTo({top:0,behavior:'instant'})}
function modal(id){const o=get(id);if(!o)return showToast('That source record could not be found.');state.lastModalFocus=document.activeElement;const related=allLinks().filter(l=>l.from===id||l.to===id);const linkedIds=[...new Set(o.links.concat(related.map(l=>l.from===id?l.to:l.from)))].filter(x=>get(x));const userNote=workspace.notes[id]||'';$('#modalRoot').innerHTML=`<div class="modal-scrim" data-action="closeBackdrop"><section class="modal" role="dialog" aria-modal="true" aria-labelledby="detailTitle"><div class="modal-head"><div><div class="uppercase">RECORD // ${esc(o.id)}</div><h2 id="detailTitle">${esc(o.title)}</h2><span class="tag ${markClass(o)}">${esc(srcLabel(o))}</span> <span class="tag">${esc(catOf(o))}</span></div><button class="close" data-action="closeModal" aria-label="Close record inspector">✕ CLOSE</button></div><p class="modal-summary">${esc(o.summary)}</p><div class="details-grid"><div class="detail"><small>ORIGINAL SOURCE</small><span>${esc(o.source)}</span></div><div class="detail"><small>SOURCE FAMILY</small><span>${esc(universes[o.universe]?.name||o.universe)}</span></div><div class="detail"><small>MECHANISM / FUNCTION</small><span>${esc(o.function)}</span></div><div class="detail"><small>KNOWN MATERIAL</small><span>${esc(o.material)}</span></div><div class="detail"><small>DIMENSIONS</small><span>${esc(o.dimensions)}</span></div><div class="detail"><small>BEARER / LOCATION</small><span>${esc(o.bearer)}</span></div></div><div class="uppercase">MATRIX ASSIGNMENTS</div><div class="pill-row">${o.matrices.map(m=>`<span class="pill">${esc(m.toUpperCase())}</span>`).join('')}</div>${o.attributes.length?`<div class="divider"></div><div class="uppercase">ATTRIBUTES</div><div class="pill-row">${o.attributes.map(a=>`<span class="pill">${esc(a)}</span>`).join('')}</div>`:''}<div class="divider"></div><div class="uppercase">RELATED BUT DISTINCT RECORDS</div><div class="modal-links">${linkedIds.length?linkedIds.map(i=>`<button class="tiny-btn" data-action="inspect" data-id="${esc(i)}">${esc(nameOf(i))} ↗</button>`).join(''):'<span class="subtle">No direct links currently recorded.</span>'}</div>${related.length?`<p class="subtle" style="font-size:11px">${related.length} interpretive or functional cross-reference(s); no source identity changes.</p>`:''}<div class="divider"></div><label for="sourceNote" class="uppercase">YOUR LOCAL ANNOTATION — ADDITIVE ONLY</label><textarea id="sourceNote" class="textarea" maxlength="3000" placeholder="Record your own interpretation or research notes; original text stays unchanged.">${esc(userNote)}</textarea><div class="button-row" style="margin-top:12px"><button class="btn primary" data-action="saveNote" data-id="${esc(id)}">SAVE MY NOTE</button><button class="btn" data-action="bookmark" data-id="${esc(id)}">${workspace.bookmarks.includes(id)?'REMOVE SAVED ◆':'SAVE RECORD ◇'}</button>${id.startsWith('custom.')?`<button class="btn" data-action="deleteCustom" data-id="${esc(id)}">DELETE MY ADDITION</button>`:''}</div></section></div>`;$('.close',$('#modalRoot')).focus();document.body.style.overflow='hidden'}
function closeModal(){const root=$('#modalRoot');root.innerHTML='';document.body.style.overflow='';state.lastModalFocus?.focus?.()}
function download(name,obj){const blob=new Blob([JSON.stringify(obj,null,2)],{type:'application/json;charset=utf-8'}),u=URL.createObjectURL(blob),a=document.createElement('a');a.href=u;a.download=name;document.body.append(a);a.click();a.remove();setTimeout(()=>URL.revokeObjectURL(u),1000);showToast(`Export created: ${name}`)}
function toggleBookmark(id){if(!get(id))return;const n=workspace.bookmarks.indexOf(id);if(n<0)workspace.bookmarks.push(id);else workspace.bookmarks.splice(n,1);save();if($('#modalRoot').children.length)modal(id);else render()}
function safeId(title){return 'custom.'+(Date.now().toString(36))+'-'+(title.toLowerCase().replace(/[^a-z0-9]+/g,'-').replace(/^-|-$/g,'').slice(0,34)||'entry')}
function formRecord(form){const f=new FormData(form),title=(f.get('title')||'').trim(),source=(f.get('source')||'').trim(),summary=(f.get('summary')||'').trim(),universe=f.get('universe'),category=f.get('category');if(!title||!source||!summary||!universes[universe]||!categories[category])return showToast('Fill out each required record field.');const entry={id:safeId(title),title:title.slice(0,160),universe,category,summary:summary.slice(0,1200),source:source.slice(0,240),matrices:String(f.get('matrices')).split(',').filter(m=>DATA.matrices.some(x=>x.id===m)),function:summary.slice(0,1200),material:'Not specified',dimensions:'Not specified',bearer:'—',status:'proposal',attributes:[],links:[]};workspace.customObjects.push(entry);const stored=save();showToast(stored?'New object added without altering source records.':'Entry added for this session. Export to preserve it.');render()}
function formLink(form){const f=new FormData(form),from=f.get('from'),to=f.get('to'),explanation=String(f.get('explanation')||'').trim();if(!get(from)||!get(to)||from===to||!explanation)return showToast('Select two distinct records and add an explanation.');workspace.links.push({id:'userlink.'+Date.now().toString(36),from,to,kind:'user symbolic link',status:'interpretation',explanation:explanation.slice(0,500)});const stored=save();showToast(stored?'Interpretive link created. Neither original was changed.':'Link added for this session. Export to preserve it.');render()}
function updateFilter(id,value){const map={universeFilter:'universe',categoryFilter:'category',matrixFilter:'matrix',sourceFilter:'source',txType:'txType',verseType:'verseType',chronologyUniverse:'activeUniverse'};if(map[id]){state[map[id]]=value;state.limit=36;if(state.route==='registry')updateRegistry();else render()}}
function processImport(file){if(!file)return;if(file.size>2e6){showToast('Workspace file exceeds 2 MB.');return}const reader=new FileReader();reader.onload=()=>{try{const raw=JSON.parse(reader.result);if(!raw||raw.schema!==1||!Array.isArray(raw.customObjects)){showToast('Not a compatible workspace v1 export.');return}workspace=sanitizeWorkspace(raw);save();render();showToast('Workspace imported. Baseline catalog preserved.')}catch{showToast('This file is not valid JSON.')}};reader.readAsText(file)}
function resetWorkspace(){if(!confirm('Clear your local notes, bookmarks, role changes, custom entries, and custom links? The source archive will remain.'))return;workspace=emptyWorkspace();save();render();showToast('Local additions cleared. Source archive intact.')}
function onClick(e){const btn=e.target.closest('[data-action],[data-route]');if(!btn)return;if(btn.dataset.route){go(btn.dataset.route);return}const act=btn.dataset.action, id=btn.dataset.id;
 switch(act){case'inspect':modal(id);break;case'bookmark':toggleBookmark(id);break;case'closeModal':closeModal();break;case'closeBackdrop':if(e.target===btn)closeModal();break;case'openMatrix':state.selectedMatrix=[btn.dataset.matrix,btn.dataset.matrix];go('matrices');break;case'matrixPair':state.selectedMatrix=[btn.dataset.x,btn.dataset.y];render();break;case'filterUniverse':state.universe=btn.dataset.universe;state.category='all';state.source='all';state.matrix='all';go('registry');break;case'toggleBookmarks':state.bookmarksOnly=!state.bookmarksOnly;render();break;case'clearFilters':Object.assign(state,{query:'',universe:'all',category:'all',matrix:'all',source:'all',bookmarksOnly:false,limit:36});render();break;case'showMore':state.limit+=36;updateRegistry();break;case'selectRing':state.selectedRing=Number(btn.dataset.num);render();break;case'saveRole':{const v=$('#ringRoleInput').value.trim();if(!v)return showToast('Provide a ring role first.');workspace.rings[state.selectedRing]=v.slice(0,70);const stored=save();render();showToast(stored?'Ring role saved locally.':'Ring role changed for this session. Export to preserve it.');break}case'resetRole':delete workspace.rings[state.selectedRing];save();render();break;case'saveNote':{const v=$('#sourceNote').value.trim();if(v)workspace.notes[id]=v;else delete workspace.notes[id];const stored=save();showToast(stored?'Local annotation saved. Original record unchanged.':'Annotation changed for this session. Export to preserve it.');break}case'deleteCustom':if(!id.startsWith('custom.'))return;if(!confirm('Delete this user-added object and linked user-created connections?'))return;workspace.customObjects=workspace.customObjects.filter(o=>o.id!==id);workspace.links=workspace.links.filter(l=>l.from!==id&&l.to!==id);delete workspace.notes[id];workspace.bookmarks=workspace.bookmarks.filter(x=>x!==id);save();closeModal();render();break;case'exportAll':download('five-matrix-atlas-complete.json',{exportType:'complete',exportedAt:new Date().toISOString(),atlas:DATA,workspace});break;case'exportWorkspace':download('five-matrix-atlas-workspace.json',workspace);break;case'downloadCatalog':download('five-matrix-catalog.json',all());break;case'resetWorkspace':resetWorkspace();break;}}
function onSubmit(e){if(e.target.id==='addRecord'){e.preventDefault();formRecord(e.target)}if(e.target.id==='addLink'){e.preventDefault();formLink(e.target)}}
function init(){document.addEventListener('click',onClick);document.addEventListener('submit',onSubmit);document.addEventListener('input',e=>{if(e.target.id==='query'){state.query=e.target.value;state.limit=36;updateRegistry()}});document.addEventListener('change',e=>{if(e.target.id==='importFile')processImport(e.target.files?.[0]);else updateFilter(e.target.id,e.target.value)});document.addEventListener('keydown',e=>{if(e.key==='Escape'&&$('#modalRoot').children.length)closeModal();if(e.key==='Tab'&&$('#modalRoot').children.length){const dialog=$('.modal',$('#modalRoot'));const focus=$$('button,input,select,textarea,[tabindex="0"]',dialog).filter(x=>!x.disabled);if(focus.length){const first=focus[0],last=focus[focus.length-1];if(e.shiftKey&&document.activeElement===first){e.preventDefault();last.focus()}else if(!e.shiftKey&&document.activeElement===last){e.preventDefault();first.focus()}}}});
 $('#menuBtn').addEventListener('click',()=>{const open=$('#sidebar').classList.toggle('open');$('#menuBtn').setAttribute('aria-expanded',String(open))});$('#themeBtn').addEventListener('click',()=>{state.theme=state.theme==='dark'?'light':'dark';try{localStorage.setItem('five-matrix-theme',state.theme)}catch{}render()});$('#exportQuick').addEventListener('click',()=>download('five-matrix-atlas-complete.json',{exportType:'complete',exportedAt:new Date().toISOString(),atlas:DATA,workspace}));window.addEventListener('hashchange',()=>{if(routeFromHash()!==state.route)go(routeFromHash())});if('serviceWorker'in navigator&&location.protocol.startsWith('http'))navigator.serviceWorker.register('sw.js').catch(()=>{});render();}
init();
})();
</script>
</body>
</html>