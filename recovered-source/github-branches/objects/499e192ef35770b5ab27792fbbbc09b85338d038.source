gs","matrices":["soul","mind","shadow","spirit"],"function":"Hidden identity, leadership, royal legitimacy.","material":"—","dimensions":"—","bearer":"Aragorn","status":"literary","attributes":[],"links":[]},{"id":"lotr.gandalf","title":"Gandalf","universe":"lotr","category":"person","summary":"Istari guide, wielder of Glamdring and keeper of Narya.","source":"The Hobbit; The Lord of the Rings","matrices":["soul","mind","spirit"],"function":"Guidance, wisdom, resistance.","material":"—","dimensions":"—","bearer":"Gandalf","status":"literary","attributes":[],"links":[]},{"id":"lotr.sauron","title":"Sauron","universe":"lotr","category":"person","summary":"Fallen Maia seeking dominion through the ruling Ring.","source":"The Lord of the Rings","matrices":["shadow","mind","spirit"],"function":"Domination and strategic control.","material":"—","dimensions":"—","bearer":"Sauron","status":"literary","attributes":[],"links":[]},{"id":"lotr.eye","title":"The Eye of Sauron","universe":"lotr","category":"concept","summary":"Emblem of Sauron’s surveillance and oppressive will; not proof of an exclusively disembodied eye.","source":"The Lord of the Rings","matrices":["shadow","mind","spirit"],"function":"Watchfulness, fear, control.","material":"Not specified","dimensions":"Not specified in source","bearer":"—","status":"literary","attributes":[],"links":[]},{"id":"hobbit.discovery","title":"Bilbo finds the One Ring","universe":"hobbit","category":"concept","summary":"The finding of the same One Ring in Gollum’s cavern; this is an event, not a second physical ring.","source":"The Hobbit, “Riddles in the Dark”","matrices":["soul","mind","shadow"],"function":"Transfers the Ring into Bilbo’s possession.","material":"Not specified","dimensions":"Not specified in source","bearer":"—","status":"literary","attributes":[],"links":["lotr.one"]},{"id":"hobbit.arkenstone","title":"The Arkenstone","universe":"hobbit","category":"treasure","summary":"The Heart of the Mountain, a luminous jewel with immense dynastic significance to Erebor.","source":"The Hobbit","matrices":["body","soul","shadow"],"function":"Claim of kingship and negotiating leverage.","material":"Gemstone","dimensions":"Not specified","bearer":"Thorin / Bilbo","status":"literary","attributes":[],"links":[]},{"id":"hobbit.blackarrow","title":"The Black Arrow","universe":"hobbit","category":"weapon","summary":"Bard’s inherited arrow used against Smaug; shot from his bow in the novel.","source":"The Hobbit, “Fire and Water”","matrices":["body","mind","soul"],"function":"Projectile striking Smaug’s unarmored patch.","material":"Black iron / metal shaft per descriptions","dimensions":"Not specified","bearer":"Bard","status":"literary","attributes":[],"links":[]},{"id":"hobbit.thror-map","title":"Thrór’s Map and Moon-letters","universe":"hobbit","category":"tool","summary":"Hidden writing on the map reveals the secret door’s timing and access.","source":"The Hobbit, “A Short Rest”","matrices":["body","mind","shadow"],"function":"Information encoded in moon-letters.","material":"Parchment","dimensions":"Not specified","bearer":"Thorin / Bilbo","status":"literary","attributes":[],"links":[]},{"id":"hobbit.key","title":"Key to the Side-door","universe":"hobbit","category":"tool","summary":"Small key opening Erebor’s concealed entrance.","source":"The Hobbit, “On the Doorstep”","matrices":["body","mind","shadow"],"function":"Grants physical access when door is revealed.","material":"Metal","dimensions":"Not specified","bearer":"Thorin","status":"literary","attributes":[],"links":[]},{"id":"hobbit.side-door","title":"Erebor Side-door","universe":"hobbit","category":"portal","summary":"Secret mountain passage located through clues and moon-letters.","source":"The Hobbit","matrices":["body","mind","shadow"],"function":"Concealed passage into the Lonely Mountain.","material":"Stone","dimensions":"Not specified","bearer":"Thorin’s Company","status":"literary","attributes":[],"links":[]},{"id":"hobbit.erebor","title":"Erebor / Lonely Mountain","universe":"hobbit","category":"place","summary":"Mountain kingdom and Smaug’s hoard.","source":"The Hobbit","matrices":["body","soul","shadow"],"function":"Ancestral home and contested treasure.","material":"Not specified","dimensions":"Not specified in source","bearer":"—","status":"literary","attributes":[],"links":[]},{"id":"hobbit.bilbo","title":"Bilbo Baggins","universe":"hobbit","category":"person","summary":"Unlikely burglar whose cleverness, mercy, and courage alter the expedition.","source":"The Hobbit","matrices":["soul","mind","shadow","spirit"],"function":"Stealth, choice, mercy.","material":"Not specified","dimensions":"Not specified in source","bearer":"—","status":"literary","attributes":[],"links":[]},{"id":"hobbit.thorin","title":"Thorin Oakenshield","universe":"hobbit","category":"person","summary":"Exiled heir pursuing his ancestors’ mountain kingdom.","source":"The Hobbit","matrices":["soul","shadow","spirit"],"function":"Kingship, inheritance, dragon-sickness.","material":"Not specified","dimensions":"Not specified in source","bearer":"—","status":"literary","attributes":[],"links":[]},{"id":"hobbit.smaug","title":"Smaug","universe":"hobbit","category":"person","summary":"Fire-drake occupying Erebor and hoarding its treasure.","source":"The Hobbit","matrices":["body","shadow","mind"],"function":"Threat, greed, physical vulnerability.","material":"Not specified","dimensions":"Not specified in source","bearer":"—","status":"literary","attributes":[],"links":[]},{"id":"hobbit.bard","title":"Bard the Bowman","universe":"hobbit","category":"person","summary":"Defender of Lake-town who shoots the Black Arrow.","source":"The Hobbit","matrices":["body","soul","mind","spirit"],"function":"Skill, responsibility, courage.","material":"Not specified","dimensions":"Not specified in source","bearer":"—","status":"literary","attributes":[],"links":[]},{"id":"hobbit.gollum","title":"Gollum","universe":"hobbit","category":"person","summary":"Riddle-opponent who previously possessed the One Ring.","source":"The Hobbit; The Lord of the Rings","matrices":["soul","mind","shadow"],"function":"Possession, deception, and loss.","material":"Not specified","dimensions":"Not specified in source","bearer":"—","status":"literary","attributes":[],"links":[]},{"id":"narnia.yellow","title":"Yellow Magic Ring","universe":"narnia","category":"ring","summary":"Uncle Andrew’s yellow ring draws a traveler out of a world toward the Wood between the Worlds.","source":"The Magician’s Nephew","matrices":["body","mind","shadow"],"function":"Inter-world departure.","material":"Enchanted ring","dimensions":"Not specified","bearer":"Digory / Polly","status":"literary","attributes":[],"links":[]},{"id":"narnia.green","title":"Green Magic Ring","universe":"narnia","category":"ring","summary":"Uncle Andrew’s green ring moves a traveler from the Wood into a selected world.","source":"The Magician’s Nephew","matrices":["body","mind","shadow"],"function":"Inter-world entry.","material":"Enchanted ring","dimensions":"Not specified","bearer":"Digory / Polly","status":"literary","attributes":[],"links":[]},{"id":"narnia.wardrobe","title":"The Wardrobe","universe":"narnia","category":"furniture","summary":"Wooden wardrobe built from a tree grown from a Narnian magical apple; sometimes becomes a doorway to Narnia.","source":"The Lion, the Witch and the Wardrobe; The Magician’s Nephew","matrices":["body","mind","shadow"],"function":"Furniture with a linked portal function.","material":"Wood","dimensions":"Not specified","bearer":"Pevensie children","status":"literary","attributes":[],"links":["narnia.wardrobe-gate"]},{"id":"narnia.wardrobe-gate","title":"Wardrobe gateway interpretation","universe":"narnia","category":"portal","summary":"Separate functional entry for the Wardrobe as a passage; the original furniture classification is preserved.","source":"Derived functional classification from Narnia narrative","matrices":["body","mind","shadow"],"function":"Connects Earth and Narnia under magical conditions.","material":"Linked to wooden wardrobe","dimensions":"Not specified","bearer":"Pevensies","status":"interpretation","attributes":[],"links":["narnia.wardrobe"]},{"id":"narnia.stone-table","title":"Stone Table","universe":"narnia","category":"monument","summary":"Ancient stone monument associated with Deep Magic, sacrifice, and a breaking of the table.","source":"The Lion, the Witch and the Wardrobe","matrices":["body","soul","spirit"],"function":"Place of Aslan’s sacrificial death.","material":"Stone","dimensions":"Not specified","bearer":"Aslan / Jadis","status":"literary","attributes":[],"links":[]},{"id":"narnia.peter-sword","title":"Peter’s sword (“Rhindon” in adaptations)","universe":"narnia","category":"weapon","summary":"Sword given to Peter by Father Christmas. The name Rhindon is prominent in adaptations rather than explicit original-book naming.","source":"The Lion, the Witch and the Wardrobe; adaptations","matrices":["body","soul","spirit"],"function":"Arms and symbolizes Peter’s kingship.","material":"Steel","dimensions":"Not specified","bearer":"Peter Pevensie","status":"literary","attributes":[],"links":[]},{"id":"narnia.peter-shield","title":"Peter’s shield","universe":"narnia","category":"armor","summary":"Shield given with Peter’s sword.","source":"The Lion, the Witch and the Wardrobe","matrices":["body","soul"],"function":"Protection and heraldry.","material":"Not specified","dimensions":"Not specified","bearer":"Peter","status":"literary","attributes":[],"links":[]},{"id":"narnia.susan-horn","title":"Susan’s Magic Horn","universe":"narnia","category":"tool","summary":"Horn that summons help when sounded, though form and timing of help vary.","source":"The Lion, the Witch and the Wardrobe; Prince Caspian","matrices":["body","mind","soul"],"function":"Signal requesting aid.","material":"Ivory","dimensions":"Not specified","bearer":"Susan → Caspian","status":