<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="theme-color" content="#0b171c">
<meta name="description" content="An offline-capable, source-aware Five Matrix Atlas of rings, gates, blades, furniture, literary worlds, KJV artifacts, and a 12-ring interpretive blueprint.">
<title>The Five Matrices — Twelve Rings / Twelve Gates Atlas</title>
<style>
:root{--bg:#091519;--panel:#102127;--panel2:#132a30;--panel3:#173139;--ink:#ecede7;--muted:#9aadb1;--dim:#6e8589;--edge:#2a4147;--copper:#e8b48a;--teal:#68ddd0;--gold:#edd69d;--shadow:0 12px 60px #010a0d60;--radius:15px;--serif:Georgia,"Times New Roman",serif;--sans:Inter,ui-sans-serif,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif}
body[data-theme="light"]{--bg:#f4f1e9;--panel:#fffcf4;--panel2:#f0eae0;--panel3:#e8e9df;--ink:#23373a;--muted:#586e6f;--dim:#708382;--edge:#cfd7d2;--copper:#9a5930;--teal:#137b76;--gold:#83631f;--shadow:0 12px 45px #1535391e}
*{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;background:var(--bg);color:var(--ink);font-family:var(--sans);font-size:14px;line-height:1.55}button,input,select,textarea{font:inherit}button{cursor:pointer}a{color:var(--teal)}a:hover{text-decoration-thickness:2px}button:focus-visible,a:focus-visible,input:focus-visible,select:focus-visible,textarea:focus-visible,[tabindex]:focus-visible{outline:2px solid var(--teal);outline-offset:3px}::selection{background:var(--teal);color:var(--bg)}.skip{position:absolute;top:-100px;left:20px;padding:10px 16px;z-index:300;background:var(--teal);color:var(--bg)}.skip:focus{top:12px}
.app-shell{min-height:100vh;display:grid;grid-template-columns:269px minmax(0,1fr)}.sidebar{position:sticky;top:0;height:100vh;min-height:680px;background:linear-gradient(155deg,#0c1e23 0%,#0b191e 100%);border-right:1px solid #264146;padding:27px 16px 23px;display:flex;flex-direction:column;z-index:20}.brand{display:flex;gap:11px;align-items:center;padding:1px 7px 34px}.brand-sigil{color:var(--copper)}.brand-overline{color:#a8c2c3;font-size:8px;font-weight:700;letter-spacing:.24em}.brand-title{font-family:var(--serif);font-size:19px;line-height:1.25;letter-spacing:.02em;color:#f2eae2}.brand-sub{font-size:9px;color:#72c6c1;letter-spacing:.21em;margin-top:3px;font-weight:700}.side-caption{font-size:9px;font-weight:700;letter-spacing:.2em;color:#789195;padding:0 15px 10px}.nav{display:grid;gap:4px}.nav-link{display:flex;align-items:center;gap:13px;padding:11px 13px;text-align:left;width:100%;border:1px solid transparent;border-radius:9px;background:none;color:#bacacc;font-size:12px;font-weight:600;transition:background .18s,border .18s,color .18s}.nav-link:hover{background:#1a343a;color:white}.nav-link.active{background:#1d3c40;border-color:#2c5358;color:#f8f3ea}.nav-link.active .nav-icon{color:#79e9d8}.nav-icon{font-family:var(--serif);width:18px;font-size:20px;text-align:center;color:#9aada8;font-weight:400}.nav-index{margin-left:auto;font-size:9px;letter-spacing:.07em;opacity:.55}.side-bottom{margin-top:auto;border-top:1px solid #2c4247;padding:22px 12px 0;color:#91a9a9}.meter-label{display:flex;justify-content:space-between;letter-spacing:.14em;font-size:9px;font-weight:750}.meter-label b{color:#73e3d3}.meter{height:4px;border-radius:5px;background:#243c40;margin-top:9px}.meter span{display:block;width:100%;height:100%;background:linear-gradient(90deg,#da9867,#61d0c1);border-radius:5px}.side-bottom p{font-size:11px;line-height:1.55}.build-clear{display:grid;gap:6px;border-top:1px solid #253e40;padding-top:13px;font-size:11px;color:#dce5e0}.build-clear span{display:flex;justify-content:space-between}.build-clear em{color:#69d7c8;font-size:9px;font-style:normal;letter-spacing:.15em;font-weight:700}
.workspace{min-width:0;display:flex;flex-direction:column}.topbar{height:70px;position:sticky;top:0;z-index:10;background:color-mix(in srgb,var(--bg) 93%,transparent);backdrop-filter:blur(16px);border-bottom:1px solid var(--edge);display:flex;align-items:center;justify-content:space-between;padding:0 40px;gap:15px}.top-left,.top-right{display:flex;align-items:center;gap:16px}.eyebrow,.top-page,.offline-indicator{font-size:10px;letter-spacing:.12em;font-weight:750}.eyebrow{color:var(--muted)}.top-page{color:var(--copper)}.top-slash{color:var(--dim)}.offline-indicator{color:var(--teal);white-space:nowrap}.pulse{display:inline-block;width:7px;height:7px;border-radius:50%;background:var(--teal);margin-right:5px;box-shadow:0 0 0 3px #68ddd024}.top-action,.icon-button{border:1px solid var(--edge);border-radius:8px;background:var(--panel);color:var(--ink);padding:8px 12px;font-size:10px;font-weight:800;letter-spacing:.08em}.top-action:hover,.icon-button:hover{border-color:var(--teal)}.mobile-menu{display:none}
#main{width:100%;max-width:1600px;margin:0 auto;padding:36px 43px 64px;flex:1}.footer{border-top:1px solid var(--edge);padding:17px 42px;display:flex;justify-content:space-between;gap:14px;color:var(--dim);font-size:9px;font-weight:700;letter-spacing:.13em}.page-kicker{color:var(--teal);letter-spacing:.22em;text-transform:uppercase;font-size:10px;font-weight:800;margin-bottom:9px}.page-head{display:flex;justify-content:space-between;gap:18px;align-items:end;margin-bottom:26px}.page-head h1,.hero h1{margin:0;font-family:var(--serif);font-weight:400;letter-spacing:-.035em;line-height:1.08}.page-head h1{font-size:clamp(32px,3.1vw,47px)}.page-head p{color:var(--muted);max-width:720px;margin:12px 0 0}.hero{position:relative;overflow:hidden;border-radius:21px;border:1px solid #3a5356;background:radial-gradient(circle at 81% 40%,#20504a9c 0%,transparent 37%),radial-gradient(circle at 40% 100%,#5b402f46 0%,transparent 35%),linear-gradient(115deg,#1b2c2e,#0b1f25);padding:44px 45px;min-height:320px;display:flex;align-items:center;justify-content:space-between;gap:28px}.hero h1{font-size:clamp(41px,4.6vw,68px);color:#f7efe3;max-width:650px}.hero h1 span{color:#77ddcb}.hero p{color:#bad0ca;max-width:490px;line-height:1.7;margin:17px 0 26px}.hero .page-kicker{color:#e2b389}.hero-visual{flex:0 0 min(32%,300px);width:300px;aspect-ratio:1;position:relative;display:grid;place-items:center;opacity:.95}.orbit{position:absolute;border:1px solid #d4b18874;border-radius:50%;width:95%;height:95%;box-shadow:0 0 40px #6bdac816 inset}.orbit:nth-child(2){width:74%;height:74%;border-color:#58d8cba9;border-width:2px;transform:rotate(25deg)}.orbit:nth-child(3){width:53%;height:53%;border-color:#dfae85b3;transform:rotate(-17deg)}.orbit:nth-child(4){width:30%;height:30%;border-color:#67d8cc;width:30%;transform:rotate(45deg)}.orbit:nth-child(5){width:100%;height:2px;border:0;border-radius:0;background:#bba78851;transform:rotate(-28deg);box-shadow:none}.orbit:nth-child(6){width:2px;height:100%;border:0;border-radius:0;background:#bba78851;transform:rotate(-28deg);box-shadow:none}.orbit-core{z-index:1;font-family:var(--serif);font-size:36px;color:#ffeacb}.button-row{display:flex;align-items:center;gap:10px;flex-wrap:wrap}.btn{display:inline-flex;align-items:center;justify-content:center;gap:8px;padding:10px 14px;border-radius:9px;border:1px solid var(--edge);background:var(--panel2);color:var(--ink);font-size:12px;font-weight:750;line-height:1.25;text-decoration:none}.btn:hover{border-color:var(--teal);background:var(--panel3)}.btn.primary{background:var(--teal);border-color:var(--teal);color:#0a2225}.btn.primary:hover{background:#89eee0}.btn.copper{background:var(--copper);border-color:var(--copper);color:#1b1c1a}.btn.small{padding:7px 10px;font-size:10px}.btn.ghost{background:transparent}.hero .btn.ghost{color:#dbeae5;border-color:#667d7c}
.section-title{display:flex;align-items:end;justify-content:space-between;gap:15px;margin:32px 0 16px}.section-title h2{font-family:var(--serif);font-weight:400;font-size:24px;margin:0}.section-title p{margin:4px 0 0;color:var(--muted);font-size:12px}.section-title small{color:var(--teal);font-size:10px;letter-spacing:.13em;font-weight:800}.stat-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:12px;margin:17px 0}.stat-card,.panel,.obj-card,.matrix-card,.ring-card,.verse-card,.timeline-item,.law-card{border:1px solid var(--edge);background:var(--panel);border-radius:var(--radius)}.stat-card{padding:20px}.stat-card b{font-family:var(--serif);font-size:32px;font-weight:400;display:block;color:var(--ink);line-height:1.15}.stat-card .stat-label{color:var(--muted);font-size:10px;letter-spacing:.1em;text-transform:uppercase;margin-top:11px;font-weight:750}.stat-card .stat-foot{color:var(--teal);font-size:10px;margin-top:3px}.panel{padding:22px}.panel h3{margin:0 0 12px;font-family:var(--serif);font-size:21px;font-weight:400}.panel p{color:var(--muted)}.panel-grid{display:grid;grid-template-columns:1.2fr 1fr;gap:14px}.inset{border:1px dashed var(--edge);border-radius:11px;padding:15px;background:var(--panel2)}.source-rule{border-left:3px solid var(--copper);padding:12px 14px;background:var(--panel2);border-radius:0 9px 9px 0;color:var(--muted);font-size:12px;line-height:1.7}.source-rule strong{color:var(--ink)}.feature-list{display:grid;gap:9px}.feature-row{display:flex;justify-content:space-between;gap:12px;align-items:center;padding:11px 12px;border:1px solid var(--edge);border-radius:9px;background:var(--panel2)}.feature-row strong{font-size:12px}.feature-row small{color:var(--muted);font-size:11px}.feature-row .number{color:var(--teal);font-family:var(--serif);font-size:23px}.guide{display:grid;grid-template-columns:repeat(5,1fr);gap:11px}.matrix-card{padding:17px;transition:transform .15s,border-color .15s}.matrix-card:hover{border-color:var(--teal);transform:translateY(-2px)}.matrix-no{color:var(--copper);font-size:11px;letter-spacing:.1em}.matrix-card h3{font-family:var(--serif);font-size:23px;font-weight:400;margin:10px 0 4px}.matrix-card p{font-size:11px;color:var(--muted);min-height:44px;margin:0}.matrix-line{margin-top:16px;width:30px;height:2px;background:var(--teal)}
.toolbar{display:flex;align-items:center;flex-wrap:wrap;gap:10px;margin:20px 0 16px}.input,.select,.textarea{width:100%;border:1px solid var(--edge);background:var(--panel2);color:var(--ink);border-radius:9px;padding:11px 12px;font-size:12px;outline:none}.input::placeholder,.textarea::placeholder{color:var(--dim)}.input:focus,.select:focus,.textarea:focus{border-color:var(--teal)}.search{min-width:230px;max-width:390px;flex:2}.filter{min-width:130px;max-width:210px;flex:1}.result-count{font-size:11px;color:var(--muted);margin-left:auto}.catalog{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12px}.obj-card{padding:18px;display:flex;flex-direction:column;gap:10px;min-width:0;transition:transform .15s,border-color .15s}.obj-card:hover{transform:translateY(-2px);border-color:var(--teal)}.obj-top{display:flex;justify-content:space-between;align-items:center;gap:10px}.tag{font-size:9px;color:var(--muted);letter-spacing:.11em;font-weight:800;border:1px solid var(--edge);padding:4px 7px;border-radius:5px;white-space:nowrap}.tag.proposal{color:var(--copper)}.tag.scripture{color:var(--teal)}.obj-card h3{font-family:var(--serif);font-size:20px;line-height:1.2;font-weight:400;margin:0}.obj-card p{color:var(--muted);font-size:12px;line-height:1.6;margin:0;flex:1}.obj-meta{font-size:10px;color:var(--dim);border-top:1px solid var(--edge);padding-top:10px;display:flex;justify-content:space-between;gap:8px}.obj-controls{display:flex;justify-content:space-between;align-items:center;gap:9px}.tiny-btn{padding:6px 8px;border-radius:6px;border:1px solid var(--edge);background:transparent;color:var(--muted);font-size:10px;font-weight:700}.tiny-btn:hover,.tiny-btn.saved{color:var(--teal);border-color:var(--teal)}.empty{padding:45px;text-align:center;border:1px dashed var(--edge);border-radius:15px;color:var(--muted)}
.matrix-layout{display:grid;grid-template-columns:minmax(0,1.2fr) minmax(270px,.8fr);gap:16px}.matrix-board{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:7px}.matrix-cell{min-height:105px;padding:11px 7px;display:flex;flex-direction:column;align-items:start;justify-content:space-between;border:1px solid var(--edge);border-radius:9px;text-align:left;background:var(--panel);color:var(--ink);transition:background .15s,border-color .15s}.matrix-cell:hover,.matrix-cell.active{background:var(--panel3);border-color:var(--teal)}.matrix-cell .coords{font-size:9px;color:var(--dim);letter-spacing:.1em}.matrix-cell .cell-name{font-family:var(--serif);font-size:15px;line-height:1.2}.matrix-cell .cell-num{font-size:20px;color:var(--copper);font-family:var(--serif)}.panel .description{line-height:1.7;color:var(--muted)}.intersection{margin-top:16px}.intersection .pill-row{margin-top:13px}.pill-row{display:flex;gap:6px;flex-wrap:wrap}.pill{padding:5px 8px;border-radius:100px;border:1px solid var(--edge);font-size:10px;color:var(--muted)}.matrix-evidence{display:grid;gap:8px;margin-top:13px}.evidence-row{display:flex;gap:9px;align-items:center;text-align:left;border:1px solid var(--edge);border-radius:8px;background:var(--panel2);padding:10px 12px;color:var(--ink)}.evidence-row:hover{border-color:var(--copper)}.evidence-row .mini-count{margin-left:auto;color:var(--teal)}
.ring-intro{display:grid;grid-template-columns:1.3fr .7fr;gap:14px}.big-equation{font-family:var(--serif);font-size:clamp(40px,5vw,66px);font-weight:400;line-height:1.1;color:var(--teal);margin:4px 0 12px}.diagram{border:1px solid var(--edge);border-radius:18px;background:radial-gradient(circle at center,#213e3c30,transparent 60%),linear-gradient(45deg,transparent 49.8%,#497d7c16 50%,transparent 50.2%),var(--panel);padding:26px 22px}.hands{display:grid;grid-template-columns:1fr 1fr;gap:15px}.hand-col{padding:12px;border:1px solid var(--edge);border-radius:13px;background:var(--panel2)}.hand-head{font-size:11px;color:var(--muted);letter-spacing:.12em;text-transform:uppercase;font-weight:700;display:flex;justify-content:space-between;gap:4px}.ring-grid{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:8px;margin-top:25px}.ring-node{aspect-ratio:1;min-height:48px;max-height:82px;padding:5px;border:2px solid #9f806a;border-radius:50%;background:radial-gradient(circle at 37% 33%,#63524950,transparent 55%),var(--panel);color:var(--ink);display:flex;flex-direction:column;align-items:center;justify-content:center;gap:1px;position:relative;box-shadow:inset 0 0 0 4px var(--panel), inset 0 0 0 5px #d9a57755}.ring-node:hover,.ring-node.active{border-color:var(--teal);box-shadow:0 0 0 3px #69ddd025,inset 0 0 0 4px var(--panel),inset 0 0 0 5px #69ddd0ad}.ring-node b{font-family:var(--serif);font-size:19px;font-weight:400}.ring-node small{font-size:8px;color:var(--muted);letter-spacing:.01em}.bracelet-row{display:grid;grid-template-columns:1fr 1fr;gap:15px;margin-top:16px}.bracelet{width:100%;padding:12px;background:var(--panel2);border:2px double #ad8b76;border-radius:90px;color:var(--ink);text-align:center}.bracelet.active,.bracelet:hover{border-color:var(--teal)}.bracelet b{font-family:var(--serif);font-weight:400;font-size:17px}.bracelet small{color:var(--muted)}.ring-panel h3{font-family:var(--serif);font-weight:400;font-size:28px;margin:0}.ring-panel .position-label{color:var(--teal);font-size:11px;font-weight:800;letter-spacing:.12em}.readout{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-top:14px}.readout-box{background:var(--panel2);border:1px solid var(--edge);border-radius:8px;padding:12px}.readout-box small{font-size:9px;color:var(--muted);display:block;letter-spacing:.1em;margin-bottom:6px}.readout-box strong{font-family:var(--serif);font-weight:400;font-size:16px}.ring-controls{display:grid;gap:9px;margin-top:14px}.ring-controls label,.field label{display:block;font-size:10px;letter-spacing:.09em;text-transform:uppercase;color:var(--muted);margin:0 0 5px;font-weight:800}
.link-grid{display:grid;gap:10px}.link-row{display:grid;grid-template-columns:1fr auto 1fr;gap:10px;align-items:center;padding:13px;border:1px solid var(--edge);background:var(--panel);border-radius:11px}.link-record{min-width:0}.link-record small{color:var(--muted);font-size:9px;letter-spacing:.11em;display:block;text-transform:uppercase;margin-bottom:4px}.link-record strong{font-family:var(--serif);font-size:16px;font-weight:400;display:block}.link-arrow{font-size:22px;color:var(--teal)}.link-row p{grid-column:1/-1;font-size:11px;color:var(--muted);margin:2px 0 0;line-height:1.6}.warning{padding:15px 17px;border-left:3px solid var(--copper);background:var(--panel2);color:var(--muted);line-height:1.7;border-radius:0 9px 9px 0;font-size:12px}.warning strong{color:var(--ink)}.table-wrap{width:100%;overflow:auto;border:1px solid var(--edge);border-radius:12px}table{width:100%;border-collapse:collapse;text-align:left;font-size:12px}th{color:var(--teal);font-size:10px;letter-spacing:.11em;text-transform:uppercase;background:var(--panel2)}th,td{padding:13px 14px;border-bottom:1px solid var(--edge);vertical-align:top}tr:last-child td{border-bottom:0}td{color:var(--muted)}td strong{color:var(--ink);font-weight:650}tr:hover td{background:var(--panel2)}.scripture-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:11px}.verse-card{padding:18px}.verse-card small{color:var(--teal);font-size:10px;letter-spacing:.1em}.verse-card h3{font-family:var(--serif);font-weight:400;font-size:21px;margin:7px 0}.verse-card p{color:var(--muted);font-size:12px;line-height:1.6;margin:0 0 13px}.timeline{display:grid;gap:11px;border-left:1px solid var(--edge);margin-left:13px;padding-left:22px}.timeline-item{padding:17px 19px;position:relative}.timeline-item:before{content:"";position:absolute;left:-29px;top:25px;width:11px;height:11px;background:var(--copper);border:3px solid var(--bg);border-radius:50%}.timeline-item small{color:var(--teal);letter-spacing:.09em}.timeline-item h3{font-family:var(--serif);font-weight:400;font-size:20px;margin:4px 0}.timeline-item p{color:var(--muted);font-size:12px;margin:0}.form-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:13px}.field.full{grid-column:1/-1}.textarea{min-height:100px;resize:vertical}.workshop-layout{display:grid;grid-template-columns:1.05fr .95fr;gap:15px}.workshop-actions{display:flex;flex-wrap:wrap;gap:9px;margin-top:16px}.note-list{display:grid;gap:8px}.note-item{padding:10px 12px;border-radius:8px;background:var(--panel2);border:1px solid var(--edge)}.note-item b{font-size:12px}.note-item p{margin:4px 0 0;font-size:11px}.law-card{padding:18px}.law-card h3{font-family:var(--serif);font-weight:400;font-size:19px;margin:0 0 8px}.law-card p{font-size:12px;color:var(--muted);margin:0}.system-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:12px}.system-grid .law-card{min-height:145px}
.modal-scrim{position:fixed;inset:0;z-index:40;background:#001116bd;display:grid;place-items:center;padding:22px}.modal{width:min(780px,100%);max-height:90vh;overflow:auto;background:var(--panel);border:1px solid var(--edge);border-radius:17px;box-shadow:var(--shadow);padding:25px}.modal-head{display:flex;justify-content:space-between;gap:16px;align-items:start}.modal h2{font-family:var(--serif);font-weight:400;font-size:31px;line-height:1.15;margin:9px 0 12px}.close{border:1px solid var(--edge);background:var(--panel2);color:var(--ink);border-radius:8px;padding:7px 12px}.modal-summary{color:var(--muted);font-size:13px;line-height:1.7}.details-grid{display:grid;grid-template-columns:1fr 1fr;gap:9px;margin:17px 0}.detail{padding:11px 12px;background:var(--panel2);border-radius:9px}.detail small{display:block;color:var(--dim);font-size:9px;letter-spacing:.1em;margin-bottom:5px}.detail span{font-size:12px;overflow-wrap:anywhere}.modal-links{display:flex;flex-wrap:wrap;gap:6px}.modal-links button{color:var(--teal)}#toast{position:fixed;right:22px;bottom:22px;z-index:100;background:var(--teal);color:#082021;border-radius:9px;padding:13px 17px;box-shadow:var(--shadow);font-weight:750;max-width:min(360px,calc(100vw - 44px));display:none}#toast.visible{display:block}.stack{display:grid;gap:15px}.divider{height:1px;background:var(--edge);margin:18px 0}.subtle{color:var(--muted)}.uppercase{font-size:10px;letter-spacing:.15em;text-transform:uppercase;color:var(--copper);font-weight:800}.hidden{display:none!important}.scrollbox{max-height:300px;overflow:auto}.compact-list{margin:0;padding-left:19px;color:var(--muted)}.compact-list li{margin:7px 0}.numeric{font-variant-numeric:tabular-nums}
@media(max-width:1350px){.catalog{grid-template-columns:repeat(2,minmax(0,1fr))}.guide{grid-template-columns:repeat(3,1fr)}.topbar{padding:0 27px}#main{padding:31px 28px 55px}.stat-grid{gap:8px}}
@media(max-width:1050px){.app-shell{grid-template-columns:1fr}.sidebar{position:fixed;left:0;top:0;bottom:0;transform:translateX(-100%);transition:transform .2s;height:100vh;min-height:0;width:275px;box-shadow:var(--shadow)}.sidebar.open{transform:translateX(0)}.mobile-menu{display:inline-block}.eyebrow{display:none}.top-slash{display:none}.topbar{height:63px}.ring-intro,.panel-grid,.workshop-layout{grid-template-columns:1fr}.hero-visual{flex-basis:27%}.matrix-layout{grid-template-columns:1fr}.matrix-board{max-width:750px}.side-bottom{display:none}}
@media(max-width:680px){.topbar{padding:0 16px}.top-action span,.offline-indicator{display:none}.top-right,.top-left{gap:8px}#main{padding:20px 15px 38px}.footer{padding:17px;font-size:8px;display:grid;gap:4px}.hero{padding:30px 23px;min-height:300px}.hero h1{font-size:42px}.hero-visual{position:absolute;right:-62px;bottom:-88px;width:220px;opacity:.22}.hero-content{z-index:1}.page-head{display:block}.page-head h1{font-size:38px}.stat-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.stat-card{padding:15px}.stat-card b{font-size:28px}.catalog,.guide,.scripture-grid,.system-grid{grid-template-columns:1fr}.matrix-board{gap:4px}.matrix-cell{min-height:78px;padding:7px 5px}.matrix-cell .cell-name{font-size:11px}.matrix-cell .cell-num{font-size:16px}.hands{gap:7px}.hand-col{padding:9px 5px}.ring-grid{gap:3px;margin-top:18px}.ring-node{min-height:37px;border-width:1.5px}.ring-node b{font-size:15px}.ring-node small{font-size:6px}.diagram{padding:16px 10px}.ring-panel .readout{grid-template-columns:1fr 1fr}.link-row{grid-template-columns:1fr 20px 1fr;gap:5px}.link-record strong{font-size:13px}.form-grid,.details-grid{grid-template-columns:1fr}.modal{padding:16px}.modal h2{font-size:26px}.search,.filter{min-width:100%;max-width:none}.result-count{margin:0}.hero p{font-size:12px}}
@media(prefers-reduced-motion:reduce){*,*:before,*:after{scroll-behavior:auto!important;transition:none!important;animation:none!important}}
@media print{.sidebar,.topbar,.footer,.toolbar,.button-row,.obj-controls,#toast{display:none!important}.app-shell{display:block}#main{padding:0}body{color:black;background:white}.panel,.obj-card,.stat-card{break-inside:avoid;border-color:#aaa;color:black}.hero{background:#eee;color:black;min-height:0}.hero h1{color:black}.hero p{color:#333}}
/* Explicit control ink; browsers otherwise use dark native ButtonText. */
.matrix-card,.feature-row{color:var(--ink);text-align:left}
.feature-row{width:100%}
/* Twelve-gate compass: ornamental diagram with clickable, independently
   indexed gate-to-ring correspondences; not a geographic map. */
.compass-wrap{margin-top:23px;border-top:1px solid var(--edge);padding:20px 0 2px}
.compass-wheel{position:relative;width:min(100%,278px);aspect-ratio:1;margin:13px auto;background:radial-gradient(circle,#59b8aa0c 0%,transparent 50%);border:1px solid #52736a55;border-radius:50%;box-shadow:inset 0 0 0 28px #59b8aa05,inset 0 0 0 56px #59b8aa06}
.compass-wheel:before,.compass-wheel:after{content:"";position:absolute;left:50%;top:50%;transform:translate(-50%,-50%);background:var(--edge);z-index:0}.compass-wheel:before{height:1px;width:100%}.compass-wheel:after{width:1px;height:100%}
.compass-dot{position:absolute;transform:translate(-50%,-50%);z-index:2;background:var(--panel2);border:1.5px solid var(--copper);border-radius:50%;width:29px;height:29px;color:var(--ink);font-family:var(--serif);font-size:13px;display:grid;place-items:center}
.compass-dot:hover,.compass-dot.active{border-color:var(--teal);background:var(--teal);color:#10242a}
.compass-center{position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);width:92px;height:92px;border-radius:50%;background:var(--panel2);border:1px solid var(--edge);display:flex;flex-direction:column;align-items:center;justify-content:center;z-index:1}
.compass-center strong{font-family:var(--serif);font-size:32px;line-height:1;color:var(--teal);font-weight:400}.compass-center span{font-size:10px;font-weight:800;letter-spacing:.13em}.compass-center small{font-size:9px;color:var(--muted)}
.compass-dir{position:absolute;color:var(--copper);font-weight:800;font-size:10px;letter-spacing:.1em;z-index:1}.compass-dir.north{top:3%;left:48%}.compass-dir.south{bottom:3%;left:48%}.compass-dir.east{right:3%;top:48%}.compass-dir.west{left:3%;top:48%}
/* --- Additive Nathan AI Sovereign Core design system --- */
.sc-root{max-width:1320px;margin:auto}.sc-hero{position:relative;isolation:isolate;overflow:hidden;display:grid;grid-template-columns:minmax(0,1fr) 250px;align-items:center;gap:20px;min-height:287px;padding:38px;background:linear-gradient(128deg,#13272b,#133432 52%,#213237);border:1px solid #39615c;border-radius:17px;color:#f7f4ed}.sc-eyebrow,.sc-panel-kicker,.sc-section-top>span{font-size:10px;text-transform:uppercase;letter-spacing:.17em;font-weight:800;color:#8be7d6}.sc-hero h1{font-family:var(--serif);font-weight:400;font-size:clamp(36px,4vw,64px);line-height:1.04;letter-spacing:-.03em;margin:13px 0 16px}.sc-hero h1 span{color:#e5b17e}.sc-hero p{font-size:13px;color:#becdca;line-height:1.8;max-width:660px;margin:0 0 20px}.sc-head-actions{display:flex;flex-wrap:wrap;gap:8px}.sc-hero-sigil{height:220px;position:relative;display:grid;place-items:center}.sc-orbit{position:absolute;border:1px solid #6fa99e;border-radius:50%;opacity:.6}.sc-orbit.one{width:210px;height:210px}.sc-orbit.two{width:155px;height:155px;border-color:#d6a978;transform:rotate(15deg) scaleX(.72)}.sc-orbit.three{width:110px;height:110px;border-color:#d6a978;transform:rotate(-35deg) scaleY(.68)}.sc-sigil-center{font-family:var(--serif);font-size:28px;color:#e5b17e}.sc-metrics{display:grid;grid-template-columns:repeat(4,1fr);gap:10px;margin:14px 0}.sc-metrics>div{border:1px solid var(--edge);border-radius:11px;background:var(--panel);padding:16px}.sc-metrics b{display:block;font-family:var(--serif);font-weight:400;font-size:29px;color:var(--ink);margin-bottom:4px}.sc-metrics small{font-size:9px;letter-spacing:.12em;font-weight:800;color:var(--muted)}.sc-guardrail{background:var(--panel2);border-left:3px solid var(--copper);padding:16px 20px;border-radius:0 8px 8px 0;font-size:12px;line-height:1.75;color:var(--muted)}.sc-guardrail strong{color:var(--ink)}.sc-section-top{padding-top:36px;margin:14px 0 17px}.sc-section-top span{color:var(--teal)}.sc-section-top h2{font-family:var(--serif);font-size:clamp(29px,3.4vw,43px);font-weight:400;line-height:1.1;margin:7px 0 8px;color:var(--ink)}.sc-section-top p{font-size:12px;color:var(--muted);line-height:1.7;margin:0;max-width:830px}.sc-duo{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:13px}.sc-panel{border:1px solid var(--edge);border-radius:13px;background:var(--panel);padding:20px;min-width:0}.sc-panel-kicker{color:var(--copper);margin-bottom:15px}.sc-label{display:block;font-size:10px;letter-spacing:.07em;text-transform:uppercase;color:var(--muted);font-weight:800;margin:0 0 8px}.sc-json,.sc-input{display:block;box-sizing:border-box;width:100%;border:1px solid var(--edge);border-radius:9px;background:var(--panel2);color:var(--ink);padding:12px;font-size:13px}.sc-json{font-family:monospace;resize:vertical;min-height:102px;line-height:1.65}.sc-checks{display:grid;gap:9px;margin:15px 0}.sc-checks label{display:flex;align-items:center;gap:8px;font-size:12px;color:var(--ink)}.sc-checks input,.sc-axis-inputs input{accent-color:#48bdb0}.sc-decision{background:var(--panel2);border:1px solid var(--edge);border-radius:10px;padding:21px}.sc-decision span{display:block;font-family:var(--serif);font-size:27px;color:var(--teal);line-height:1.1}.sc-decision b{font-size:10px;letter-spacing:.1em;color:var(--muted)}.sc-ledger{font-size:12px;line-height:1.7;background:var(--panel2);padding:13px 14px;border-radius:9px;margin:13px 0 14px;color:var(--muted);overflow-wrap:anywhere}.sc-basicmath{display:grid;grid-template-columns:repeat(2,1fr);gap:8px;margin-top:15px}.sc-basicmath>div{padding:12px;background:var(--panel2);border:1px solid var(--edge);border-radius:8px}.sc-basicmath span{display:block;color:var(--muted);letter-spacing:.13em;font-size:9px}.sc-basicmath b{display:block;font-family:var(--serif);color:var(--ink);font-weight:400;font-size:20px;margin-top:4px}.sc-chart{display:block;width:100%;height:auto;border:1px solid var(--edge);border-radius:8px;margin:12px 0;background:var(--panel2)}.sc-control-top{display:flex;gap:12px;align-items:center;justify-content:space-between}.sc-control-top strong{font-size:12px;color:var(--teal);font-variant-numeric:tabular-nums}.sc-legend{display:flex;justify-content:space-between;gap:8px;font-size:10px;color:var(--muted)}.sc-spiral-svg{max-height:345px}.sc-axis-inputs{display:grid;gap:15px}.sc-axis-inputs label{display:grid;grid-template-columns:85px 1fr 50px;align-items:center;gap:12px}.sc-axis-inputs label span{font-size:10px;font-weight:800;letter-spacing:.06em;color:var(--ink)}.sc-axis-inputs label input{width:100%;grid-column:2;grid-row:1}.sc-axis-inputs label output{grid-column:3;grid-row:1;font-size:11px;color:var(--teal);text-align:right}.sc-five-bars{display:grid;gap:15px}.sc-barrow{display:grid;grid-template-columns:76px 1fr 42px;gap:10px;align-items:center}.sc-barrow span,.sc-barrow strong{font-size:10px;color:var(--ink)}.sc-barrow strong{text-align:right}.sc-bar-track{height:9px;border-radius:100px;background:var(--edge);overflow:hidden}.sc-bar-track>div{height:100%;background:linear-gradient(90deg,#b0785c,#49c5b5);border-radius:100px}.sc-crosswalk,.sc-small{font-size:11px;color:var(--muted);line-height:1.75;margin:20px 0 10px}.sc-mini-title{font-size:11px;color:var(--copper);font-weight:800;margin-top:19px}.sc-input{margin:7px 0 14px}.sc-formulas{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:9px}.sc-formula{min-width:0;border:1px solid var(--edge);border-radius:10px;background:var(--panel);overflow:hidden}.sc-formula summary{cursor:pointer;display:flex;align-items:center;gap:12px;min-height:66px;padding:13px 15px;list-style:none}.sc-formula summary::-webkit-details-marker{display:none}.sc-formula-n{display:grid;place-items:center;border:1px solid var(--edge);border-radius:8px;background:var(--panel2);height:40px;min-width:40px;color:var(--teal);font-family:var(--serif);font-size:19px}.sc-formula summary strong{display:block;color:var(--ink);font-size:12px}.sc-formula summary small{display:block;color:var(--muted);font-size:10px;line-height:1.5;margin-top:4px}.sc-chevron{color:var(--teal);margin-left:auto;font-size:21px}.sc-formula[open] .sc-chevron{transform:rotate(45deg)}.sc-formula-details{border-top:1px solid var(--edge);padding:15px;color:var(--muted);font-size:12px}.sc-formula-details pre{font-size:11px;white-space:pre-wrap;overflow-wrap:anywhere;background:var(--panel2);padding:12px;border-radius:7px;color:var(--ink);line-height:1.5}.sc-formula-details p{margin:0 0 14px;line-height:1.65}.sc-bottom-banner{margin-top:20px;padding:20px 24px;border:1px solid var(--edge);border-radius:12px;display:flex;justify-content:space-between;align-items:center;gap:15px;background:var(--panel2)}.sc-bottom-banner strong{color:var(--ink)}.sc-bottom-banner p{color:var(--muted);font-size:11px;max-width:700px}
@media(max-width:950px){.sc-hero{grid-template-columns:1fr}.sc-hero-sigil{position:absolute;opacity:.16;right:-45px;top:6px;z-index:-1}.sc-duo{grid-template-columns:1fr}.sc-formulas{grid-template-columns:1fr}}
@media(max-width:600px){.sc-hero{padding:25px}.sc-hero h1{font-size:37px}.sc-metrics{grid-template-columns:repeat(2,minmax(0,1fr))}.sc-metrics b{font-size:25px}.sc-panel{padding:15px}.sc-axis-inputs label{grid-template-columns:70px 1fr 36px;gap:5px}.sc-bottom-banner{display:block}.sc-basicmath b{font-size:16px}}

</style>
</head>
