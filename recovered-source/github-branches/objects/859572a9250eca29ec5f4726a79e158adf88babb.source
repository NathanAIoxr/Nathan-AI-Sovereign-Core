:root{color-scheme:dark;font-family:system-ui,sans-serif;color:#edf1f9;background:#101725}*{box-sizing:border-box}body{margin:0}main{max-width:1440px;margin:auto;padding:40px 28px}header{max-width:850px;margin-bottom:32px}.eyebrow{letter-spacing:.18em;color:#ddc18b;font-size:.8rem}h1{font-size:clamp(2rem,5vw,3.6rem);line-height:1.1;margin:14px 0}h2{font-size:1.35rem}p{line-height:1.6}.note,footer{color:#b8c3d8;font-size:.9rem}.overview{display:flex;gap:18px;flex-wrap:wrap}.metric{padding:18px;background:#1b2639;border:1px solid #40516e;border-radius:10px;min-width:190px}.metric strong{display:block;font-size:1.8rem;color:#ddc18b}.import,section{margin-bottom:34px}.import{padding:22px;border:1px solid #52637f;border-radius:10px}.button,button{display:inline-block;border:1px solid #a3b6d5;background:#253952;border-radius:6px;padding:10px 14px;color:white;cursor:pointer;font:inherit}.button input{display:block;margin-top:8px;max-width:100%}button:disabled{opacity:.4;cursor:default}#message{display:block;margin-top:12px}.shelves{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:10px}.shelf{display:block;text-align:left;border-color:#40516e;background:#1b2639}.shelf strong{color:#ddc18b;margin-right:10px}.shelf small{display:block;margin-top:8px;color:#c1cce0}.filters{display:flex;gap:12px;flex-wrap:wrap;align-items:end}label{font-size:.9rem}input,select,textarea{display:block;background:#172339;border:1px solid #7086a5;color:#fff;padding:10px;border-radius:5px;font:inherit;margin-top:6px}input[type=search]{min-width:260px}textarea{width:100%;min-width:170px;min-height:75px;resize:vertical}select{max-width:300px}.table-wrap{overflow:auto}table{border-collapse:collapse;width:100%;min-width:850px}th,td{text-align:left;padding:14px;border-bottom:1px solid #40516e;vertical-align:top}th{background:#1b2639}td{font-size:.9rem;max-width:500px;overflow-wrap:anywhere}td small{display:block;color:#c1cce0;margin:8px 0}nav{display:flex;align-items:center;gap:18px;margin:18px 0}a{color:#99dacf}footer{border-top:1px solid #40516e;padding-top:22px}details{padding:14px;border-bottom:1px solid #40516e}summary{cursor:pointer;font-weight:600}:focus-visible{outline:3px solid #f3ce7d;outline-offset:3px}@media(max-width:600px){main{padding:22px 16px}.filters label,.filters input,.filters select{width:100%;max-width:none}.metric{min-width:140px}.shelves{grid-template-columns:1fr}}
