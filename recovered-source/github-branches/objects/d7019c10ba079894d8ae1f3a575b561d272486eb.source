'use strict';
const test=require('node:test');
const assert=require('node:assert/strict');
const fs=require('node:fs');
const path=require('node:path');
const planner=require('./planner.js');
const manifest=JSON.parse(fs.readFileSync(path.join(__dirname,'dependencies.json'),'utf8'));
const nodes=manifest.nodes;
test('manifest has valid unique IDs and acyclic dependencies',()=>{const x=planner.validateManifest(manifest);assert.equal(x.nodes,nodes.length);assert.ok(x.acyclic)});
test('every dependency comes before its dependent',()=>{const order=planner.ordered(nodes).map(x=>x.id);for(const n of nodes)for(const dep of n.dependsOn)assert.ok(order.indexOf(dep)<order.indexOf(n.id),dep+' before '+n.id)});
test('reuses existing public demo rather than planning a remake',()=>{assert.equal(planner.noRebuild(nodes,'vault-browser').decision,'reuse-public');assert.equal(planner.noRebuild(nodes,'gps').decision,'reuse-public')});
test('private package must be imported and verified, not claimed production-ready',()=>{assert.equal(planner.noRebuild(nodes,'knowledge-engine').decision,'import-and-verify');assert.equal(planner.noRebuild(nodes,'state-engine').decision,'import-and-verify')});
test('blocker on cloud access cannot be bypassed',()=>{const report=planner.noRebuild(nodes,'private-storage');assert.ok(report.prerequisites.some(x=>x.id==='authentication'));assert.ok(report.prerequisites.some(x=>x.id==='backup-local'))});
test('game build uses one shared state engine',()=>{const p=planner.prerequisites(nodes,'game101');assert.ok(p.some(x=>x.id==='game-runtime'));assert.ok(p.some(x=>x.id==='state-engine'))});
test('preserves app and game independence',()=>{const box=JSON.parse(fs.readFileSync(path.join(__dirname,'../sovereign-boxes/registry.json'),'utf8'));const ids=new Set(box.records.map(x=>x.id));assert.ok(ids.has('TW-001'));assert.ok(ids.has('TW-101'));assert.ok(ids.has('APP:one'));assert.ok(ids.has('APP:sovereign-boxes'));assert.ok(!ids.has('TW001'));assert.equal(box.counts.totalIndexedBoxes,box.records.length)});
test('private slots not advertised as applications',()=>{const b=JSON.parse(fs.readFileSync(path.join(__dirname,'../sovereign-boxes/registry.json'),'utf8'));assert.equal(b.records.filter(x=>x.kind==='proposed-idea-slot').length,496);assert.ok(b.records.filter(x=>x.kind==='proposed-idea-slot').every(x=>x.title===null))});
test('rejects a broken missing dependency',()=>{const n=[{id:'first',status:'not-built',phase:0,dependsOn:['absent']}];assert.throws(()=>planner.ordered(n),/Missing or self dependency/)});
test('rejects cycles and duplicate IDs',()=>{const a={id:'first',status:'not-built',phase:0,dependsOn:['second']};const b={id:'second',status:'not-built',phase:0,dependsOn:['first']};assert.throws(()=>planner.ordered([a,b]),/Circular/);assert.throws(()=>planner.ordered([a,a]),/duplicate/)});
test('does not mutate source manifest when planning',()=>{const snapshot=JSON.stringify(nodes);planner.plan(nodes);assert.equal(JSON.stringify(nodes),snapshot)});
test('counts mutually exclusive statuses honestly',()=>{const m=planner.metrics(nodes);assert.equal(Object.entries(m).filter(([k])=>k!=='total').reduce((s,[,v])=>s+v,0),m.total);assert.ok(m.needsImplementation>0&&m.approvalGates>0)});
test('unknown feature fails closed',()=>{assert.throws(()=>planner.noRebuild(nodes,'not-a-product'),/Unknown feature/)});

test('Octopus Root family is first-class in the build graph with existing evidence paths',()=>{const roots={'octopus-root':'app-factory/octopus-root/README.md','sovereign-fields':'app-factory/octopus-root/sovereign-fields/README.md','uct':'app-factory/octopus-root/uct/README.md','sovereign-continuum':'app-factory/octopus-root/sovereign-continuum/README.md','sovereign-bubble':'app-factory/octopus-root/sovereign-bubble/README.md','root-codex':'app-factory/octopus-root/uct/triple-code/README.md','octopus-arsenal':'app-factory/octopus-root/octopus-arsenal/README.md','sovereign-nexus':'app-factory/octopus-root/sovereign-nexus/README.md'};const byId=new Map(nodes.map(n=>[n.id,n]));for(const [id,evidence] of Object.entries(roots)){assert.ok(byId.has(id),'missing root layer: '+id);assert.equal(byId.get(id).evidence,evidence);assert.ok(fs.existsSync(path.resolve(__dirname,'../..',evidence)),'missing root evidence: '+evidence)}});
test('Nexus requires every independent root pack and shared contract before integration',()=>{const nexus=nodes.find(n=>n.id==='sovereign-nexus');assert.ok(nexus);assert.equal(nexus.status,'public-prototype');for(const id of ['octopus-root','sovereign-fields','uct','sovereign-continuum','sovereign-bubble','root-codex','octopus-arsenal','contracts'])assert.ok(nexus.dependsOn.includes(id),'Nexus must list prerequisite '+id);const prerequisites=planner.prerequisites(nodes,'sovereign-nexus').map(n=>n.id);for(const id of nexus.dependsOn)assert.ok(prerequisites.includes(id),id+' must resolve before Nexus')});
test('local root prototypes are not marked as hosted production services',()=>{for(const id of ['octopus-root','sovereign-fields','uct','sovereign-continuum','sovereign-bubble','root-codex','octopus-arsenal','sovereign-nexus'])assert.equal(nodes.find(n=>n.id===id).status,'public-prototype',id+' keeps its verified prototype status')});
