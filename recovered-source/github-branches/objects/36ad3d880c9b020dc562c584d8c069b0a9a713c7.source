{
  "meta": {
    "name": "THE FIVE MATRICES",
    "subtitle": "The Twelve Rings / Twelve Gates Atlas",
    "version": "1.0.0",
    "copyright": "Independent interpretive study tool. No affiliation with Tolkien or C. S. Lewis estates.",
    "policy": "Canonical works, scriptural references, and interpretive transformations are kept distinct. Source objects are never converted in place.",
    "arithmetic": [
      "1 + 1 = 2 — BUILD",
      "1 − 1 = 0 — CLEAR",
      "8 fingers + 2 thumbs + 2 arm bracelets = 12 symbolic positions"
    ]
  },
  "matrices": [
    {
      "id": "body",
      "name": "BODY",
      "index": "I",
      "subtitle": "Form • materials • space",
      "principle": "What physically exists, where it is placed, and what it can do.",
      "questions": [
        "What is it made of?",
        "How large is it?",
        "Is it jewelry, a weapon, furniture, a gate, or something else?"
      ],
      "keywords": [
        "matter",
        "structure",
        "material",
        "size"
      ]
    },
    {
      "id": "soul",
      "name": "SOUL",
      "index": "II",
      "subtitle": "Identity • loyalty • belonging",
      "principle": "Who bears an object and what relationships, memories, and loyalties attach to it.",
      "questions": [
        "Who bears or owns it?",
        "What identity does it symbolize?",
        "Whose loyalty is tested?"
      ],
      "keywords": [
        "identity",
        "loyalty",
        "memory",
        "belonging"
      ]
    },
    {
      "id": "shadow",
      "name": "SHADOW",
      "index": "III",
      "subtitle": "Concealment • power • deception",
      "principle": "What is concealed, coerced, corrupted, or strategically kept out of view.",
      "questions": [
        "What does it hide?",
        "Who gains power from its secrecy?",
        "Is its use coercive or protective?"
      ],
      "keywords": [
        "deception",
        "hidden",
        "risk",
        "power"
      ]
    },
    {
      "id": "mind",
      "name": "MIND",
      "index": "IV",
      "subtitle": "Language • rules • strategy",
      "principle": "How inscriptions, signals, logic, laws, reading, and decisions shape use.",
      "questions": [
        "What rules govern it?",
        "How do we know what it does?",
        "How is the mechanism communicated?"
      ],
      "keywords": [
        "language",
        "knowledge",
        "logic",
        "strategy"
      ]
    },
    {
      "id": "spirit",
      "name": "SPIRIT",
      "index": "V",
      "subtitle": "Sacrifice • conscience • purpose",
      "principle": "What the narrative presents as its moral purpose, sacrifice, hope, or ultimate consequence.",
      "questions": [
        "What moral tension does it represent?",
        "Does it preserve or violate freedom?",
        "What restoration is imagined?"
      ],
      "keywords": [
        "ethics",
        "freedom",
        "sacrifice",
        "hope"
      ]
    }
  ],
