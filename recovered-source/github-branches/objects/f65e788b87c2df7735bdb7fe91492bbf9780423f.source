<style>
:root{font:16px system-ui,sans-serif;color-scheme:dark;--bg:#0d151d;--surface:#1a2a36;--edge:#3f586c;--muted:#c1d0dc;--gold:#edd4a0;--text:#fff}*{box-sizing:border-box}
body{background:var(--bg);color:var(--text);margin:0}main{max-width:1200px;margin:auto;padding:22px 16px 75px}h1{font-size:clamp(2.1rem,5vw,4rem);line-height:1.12;margin:.2em 0 .3em}h2{font-size:1.25rem;margin:.3em 0}h3{font-size:1.13rem;margin:0}p{color:var(--muted);line-height:1.55}a{color:var(--gold)}a:focus-visible,button:focus-visible,input:focus-visible,select:focus-visible{outline:3px solid var(--gold);outline-offset:2px}.eyebrow{font-size:.78rem;font-weight:700;letter-spacing:.08em;text-transform:uppercase;color:var(--gold)}.bar{display:flex;gap:12px;align-items:center;flex-wrap:wrap}.bar a{padding:6px 0}.intro{max-width:780px}.statrow{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:10px;margin:24px 0}.stat{background:var(--surface);border:1px solid var(--edge);border-radius:12px;padding:16px}.stat strong{display:block;font-size:1.8rem;color:var(--gold)}.stat span{display:block;color:var(--muted);font-size:.87rem}.filters{padding:16px;border:1px solid var(--edge);border-radius:12px;background:var(--surface);margin:20px 0;display:flex;gap:12px;flex-wrap:wrap;align-items:center}.filters input,.filters select,.filters button{background:#243746;color:white;border:1px solid #87a0b2;border-radius:8px;padding:11px;font:inherit}.filters input{min-width:210px;flex:1}.filters button{cursor:pointer}.cards{display:grid;grid-template-columns:repeat(auto-fit,minmax(270px,1fr));gap:12px}.card{background:var(--surface);border:1px solid var(--edge);border-radius:15px;padding:18px}.card .num{color:var(--gold);font-size:.8rem;font-weight:700}.card .epithet{color:var(--gold);font-style:italic;margin:7px 0 12px}.card h3{line-height:1.3}.card dt{font-size:.75rem;font-weight:700;text-transform:uppercase;color:var(--gold);letter-spacing:.04em;margin-top:13px}.card dd{margin:5px 0 0;color:var(--muted);line-height:1.5}.panel{margin-top:25px;padding:16px;border:1px solid var(--edge);border-radius:13px}.small{font-size:.87rem}.hide{display:none}footer{font-size:.83rem;color:var(--muted);margin-top:36px}code{color:var(--gold)}@media(max-width:600px){.statrow{grid-template-columns:1fr 1fr 1fr}.stat span{font-size:.75rem}.filters{display:grid}.filters input{min-width:0;width:100%}}
