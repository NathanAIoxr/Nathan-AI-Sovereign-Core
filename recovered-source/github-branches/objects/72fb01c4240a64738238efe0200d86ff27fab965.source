/* Material Worlds 1.0 — scoped presentation only; no economy or gameplay overrides. */
html[data-presentation]{--mw-bg:#11191d;--mw-surface:#26343a;--mw-deep:#162126;--mw-metal:#bca475;--mw-edge:#746749;--mw-text:#f4eee0;--mw-muted:#b9b9ac;--mw-accent:#bca475;color-scheme:dark}
html[data-world=christmas]{--mw-bg:#0c1c1a;--mw-surface:#233e34;--mw-deep:#172c26;--mw-metal:#d4b474;--mw-edge:#85734e;--mw-accent:#c79d67}
html[data-world=alchemy]{--mw-bg:#1c1516;--mw-surface:#37292a;--mw-deep:#241b20;--mw-metal:#c7a477;--mw-edge:#886b4c;--mw-accent:#c48d69}
html[data-world=mystery]{--mw-bg:#191b18;--mw-surface:#34352b;--mw-deep:#24271f;--mw-metal:#b9a97a;--mw-edge:#82734e;--mw-accent:#ac986b}
html[data-world=theatre]{--mw-bg:#21151d;--mw-surface:#3d2a34;--mw-deep:#2b1c26;--mw-metal:#c3a38b;--mw-edge:#816653;--mw-accent:#c39c91}
html[data-world=logic]{--mw-bg:#181b28;--mw-surface:#2e3348;--mw-deep:#202638;--mw-metal:#b5bbc9;--mw-edge:#6c7488;--mw-accent:#b8acd1}
html[data-world=jade]{--mw-bg:#121d1b;--mw-surface:#293d34;--mw-deep:#1c2e29;--mw-metal:#c5b98b;--mw-edge:#7b7a59;--mw-accent:#a2bba4}
html[data-world=storybook]{--mw-bg:#191e14;--mw-surface:#35412b;--mw-deep:#252f20;--mw-metal:#c5b075;--mw-edge:#827b4d;--mw-accent:#c2aa81}
html[data-world=observatory]{--mw-bg:#0e1b21;--mw-surface:#23373e;--mw-deep:#16282e;--mw-metal:#a6babd;--mw-edge:#617a80;--mw-accent:#abc6c5}
html[data-world=archive]{--mw-bg:#1c1b17;--mw-surface:#37352c;--mw-deep:#29271f;--mw-metal:#c9b284;--mw-edge:#817653;--mw-accent:#c0ac86}
html[data-world=redstone]{--mw-bg:#131d29;--mw-surface:#28384a;--mw-deep:#1c2b3c;--mw-metal:#c6a675;--mw-edge:#816c4f;--mw-accent:#b8a27e}
html[data-presentation] body{background-color:var(--mw-bg);background-image:radial-gradient(ellipse at 20% 0%,color-mix(in srgb,var(--mw-metal) 12%,transparent),transparent 60%);color:var(--mw-text)}
html[data-presentation] :is(.panel,.tilebox,.mission,.game-card,.kk-panel,.kk-box,.cx-panel,.aly-panel,.eg-panel,.px-panel,.t33-panel,.sheet,.module,.shelf,.connector){background-color:var(--mw-deep);background-image:linear-gradient(135deg,#ffffff08,transparent 48%,#00000020),repeating-linear-gradient(3deg,#ffffff02 0 1px,transparent 1px 6px);border-color:var(--mw-edge);box-shadow:inset 0 1px #ffffff12,inset 0 -2px #0005,0 8px 24px #0003}
html[data-presentation] :is(button,.button,.btn){background-image:linear-gradient(180deg,#ffffff10,transparent 45%,#0003);box-shadow:inset 0 1px #ffffff1f,inset 0 -2px #0005,0 2px 3px #0003;border-color:var(--mw-edge);transition:filter .12s,box-shadow .12s}
html[data-presentation] :is(button,.button,.btn):not(:disabled):active{box-shadow:inset 0 2px 4px #0008;filter:brightness(1.12)}
html[data-presentation] :is(.primary,.gold-btn,.kk-primary,.aly-primary,.cx-primary,.px-primary,.eg-primary,.t33-primary){background-color:var(--mw-metal);color:#171b1b;border-color:var(--mw-metal);text-shadow:0 1px #ffffff30}
html[data-presentation] :is(h2,h3,.eyebrow,.smallcaps,.section-label){text-shadow:0 2px 4px #0003}
html[data-presentation] :is(.board .tile,[data-mw-gem]){position:relative;isolation:isolate;clip-path:polygon(20% 2%,80% 2%,98% 20%,94% 72%,50% 99%,6% 72%,2% 20%);border-radius:0!important;background-image:linear-gradient(145deg,#ffffff60 0%,transparent 32%,#0006 67%,#ffffff25 70%,#0005 100%),conic-gradient(from 25deg,#fff2,transparent,#0004,transparent,#fff3);box-shadow:inset 0 2px 4px #fff5,inset 0 -6px 10px #0008,0 3px 8px #0006}
html[data-presentation] .board .tile.c0{background-color:#cd3948}html[data-presentation] .board .tile.c1{background-color:#3b97d2}html[data-presentation] .board .tile.c2{background-color:#3ba46a}html[data-presentation] .board .tile.c3{background-color:#ddbd44}html[data-presentation] .board .tile.c4{background-color:#9653ca}html[data-presentation] .board .tile.c5{background-color:#a7bdc0}
html[data-presentation] .board .tile:is(.selected,.hint,.special-prism,.special-line){filter:brightness(1.3) drop-shadow(0 0 5px #ffdf8a);outline-offset:-5px}
html[data-presentation] :is(button,a,input,select):focus-visible{outline:3px solid #f4de9b;outline-offset:3px}
.mw-fx-layer{position:fixed;inset:0;pointer-events:none;z-index:2147483000;overflow:hidden;contain:strict}.mw-spark{position:absolute;width:5px;height:5px;transform:rotate(45deg);background:var(--mw-metal);box-shadow:0 0 6px currentColor}.mw-troop{position:absolute;width:13px;height:19px;clip-path:polygon(30% 0,70% 0,76% 25%,100% 40%,76% 65%,70% 100%,30% 100%,24% 65%,0 40%,24% 25%);background:currentColor;filter:drop-shadow(0 0 4px currentColor)}
.mw-display-button{position:fixed;bottom:max(12px,env(safe-area-inset-bottom));right:12px;z-index:2147482999;padding:8px 12px!important;font:12px system-ui!important;background:var(--mw-deep)!important;color:var(--mw-text)!important;border:1px solid var(--mw-edge)!important;border-radius:6px!important;box-shadow:0 3px 12px #0007!important}
.mw-preferences{background:var(--mw-deep);color:var(--mw-text);max-width:420px;width:calc(100% - 30px);border:1px solid var(--mw-metal);border-radius:8px;padding:24px;box-shadow:0 20px 80px #000b}.mw-preferences::backdrop{background:#04080cc9}.mw-preferences h2{font:28px Georgia;margin:0 0 18px}.mw-preferences label{display:flex;gap:12px;align-items:center;margin:14px 0;font:14px/1.6 system-ui}.mw-preferences input{width:20px;height:20px;accent-color:var(--mw-metal)}.mw-preferences p{color:var(--mw-muted);font:13px/1.7 system-ui}.mw-preferences button{color:var(--mw-text);background:var(--mw-surface);padding:10px 15px;border:1px solid var(--mw-edge)}
html[data-mw-motion=off] *,html[data-mw-motion=off] *::before,html[data-mw-motion=off] *::after{animation:none!important;transition:none!important;scroll-behavior:auto!important}
@media(prefers-reduced-motion:reduce){html[data-presentation] *,html[data-presentation] *::before,html[data-presentation] *::after{animation:none!important;transition:none!important;scroll-behavior:auto!important}}
@media print{.mw-display-button,.mw-fx-layer,.mw-preferences{display:none!important}}
.mw-preferences details{border-top:1px solid var(--mw-edge);padding-top:14px;margin-top:18px}.mw-preferences summary{cursor:pointer;line-height:1.6}.mw-preferences small{display:block;color:var(--mw-muted);font-size:11px;line-height:1.6}.mw-preferences label:has(input:disabled){opacity:.55}.mw-playground{max-width:840px;width:calc(100% - 24px);max-height:92vh;overflow:auto;background:var(--mw-bg);color:var(--mw-text);border:2px solid var(--mw-metal);border-radius:10px;padding:22px}.mw-playground::backdrop{background:#02060be8}.mw-playground h2{font:30px Georgia;margin:4px 0 10px}.mw-playground p{color:var(--mw-muted);font:13px/1.7 system-ui}.mw-playground button{padding:10px;border:1px solid var(--mw-edge);background:var(--mw-surface);color:var(--mw-text);border-radius:5px}.mw-play-layout{display:grid;grid-template-columns:minmax(230px,1fr) minmax(180px,.8fr);gap:20px}.mw-grid{display:grid;grid-template-columns:repeat(5,1fr);gap:4px;padding:8px;border:1px solid var(--mw-edge);background:#05090c;max-width:360px}.mw-grid button{aspect-ratio:1;padding:0;font:20px Georgia;min-width:0;position:relative;clip-path:polygon(20% 0,80% 0,100% 25%,90% 75%,50% 100%,10% 75%,0 25%);border-radius:0;background-image:linear-gradient(145deg,#ffffff66,transparent 40%,#0008);text-shadow:0 1px 3px #000}.mw-grid button[aria-pressed=true],.mw-grid button.mw-hint{outline:3px solid white;outline-offset:-7px;filter:brightness(1.4)}.mw-grid button[data-cracked=true]::after{content:'╱';position:absolute;inset:0;color:#090f17;font-size:30px}.mw-foes{display:grid;grid-template-columns:repeat(5,1fr);gap:4px;max-width:360px;margin-bottom:10px;text-align:center;font:10px system-ui}.mw-foes b{display:block;color:var(--mw-metal);font-size:13px;margin:6px 0}.mw-actions{display:flex;gap:6px;flex-wrap:wrap;margin:15px 0}.mw-status{min-height:46px;padding:12px;border-left:2px solid var(--mw-metal);font:13px/1.7 system-ui;background:var(--mw-deep)}.mw-village{display:grid;grid-template-columns:repeat(3,52px);gap:4px;transform:skewY(-8deg);margin:16px 0 24px}.mw-village button{height:46px;font-size:20px}.mw-replay-row{border-bottom:1px solid var(--mw-edge);padding:10px 0;font:12px/1.6 system-ui}.mw-playground input,.mw-playground select{color:var(--mw-text);background:var(--mw-deep);padding:8px;border:1px solid var(--mw-edge);max-width:100%}@media(max-width:600px){.mw-play-layout{grid-template-columns:1fr}.mw-grid,.mw-foes{max-width:none}.mw-playground{padding:14px}.mw-preferences{max-height:85vh;overflow:auto}}
