(function(root,factory){const api=factory();if(typeof module==='object'&&module.exports)module.exports=api;else root.TeamEngine=api})(typeof globalThis!=='undefined'?globalThis:this,function(){'use strict';
const ROLES=['Chair','Vice-chair','Secretary','Treasurer','Rules steward','Welcomer','Navigator','Builder','Defender','Healer','Researcher','Chronicler'];
const CLUBS=[{id:'council',name:'Council',purpose:'Motions, quorum, debate, recorded votes.'},{id:'adventure',name:'Adventure party',purpose:'Complementary roles, guided quests, shared construction.'},{id:'service',name:'Service circle',purpose:'Mutual support, hospitality, restoration, and voluntary giving.'},{id:'league',name:'Competitive league',purpose:'Scheduled human teams, agreed scoring, explicit tie rules.'}];
class Match{
 constructor({id='local-match',teamA='Lanterns',teamB='Evergreens',start,end,rosterA=['Player A'],rosterB=['Player B'],tieRule='draw'}={}){if(teamA===teamB||![start,end].every(Number.isFinite)||end<=start||end-start>7*86400000||!['draw','cascades'].includes(tieRule))throw Error('Invalid match settings');if(!rosterA.length||!rosterB.length||rosterA.length>12||rosterB.length>12||new Set([...rosterA,...rosterB]).size!==rosterA.length+rosterB.length)throw Error('Distinct players, 1–12 per team, required');Object.assign(this,{id,teamA,teamB,start,end,rosterA:[...rosterA],rosterB:[...rosterB],tieRule});this.entries=[];this.ids=new Set();this.ledger={[teamA]:{points:0,cascades:0},[teamB]:{points:0,cascades:0}};this.closed=false}
 status(now=Date.now()){return now<this.start?'SCHEDULED':now>=this.end||this.closed?'FINISHED':'LIVE'}
 submit({id,team,player,score,cascades},now=Date.now()){if(this.status(now)!=='LIVE')return{status:this.status(now)};if(!Object.hasOwn(this.ledger,team)||!(team===this.teamA?this.rosterA:this.rosterB).includes(player))return{status:'NOT_A_MEMBER'};if(typeof id!=='string'||id.length<1||id.length>160||!Number.isSafeInteger(score)||score<0||score>10000000||!Number.isSafeInteger(cascades)||cascades<0||cascades>10000)return{status:'INVALID_SUBMISSION'};if(this.ids.has(id))return{status:'DUPLICATE'};const points=score+cascades*13;if(!Number.isSafeInteger(this.ledger[team].points+points))return{status:'SCORE_LIMIT'};this.ids.add(id);this.ledger[team].points+=points;this.ledger[team].cascades+=cascades;this.entries.push({id,team,player,score,cascades,points,at:now});return{status:'RECORDED',points,total:this.ledger[team].points}}
 result(now=Date.now()){if(this.status(now)!=='FINISHED')return{status:this.status(now)};const a=this.ledger[this.teamA],b=this.ledger[this.teamB];if(a.points!==b.points)return{status:'FINAL',winner:a.points>b.points?this.teamA:this.teamB,margin:Math.abs(a.points-b.points)};if(this.tieRule==='cascades'&&a.cascades!==b.cascades)return{status:'FINAL',winner:a.cascades>b.cascades?this.teamA:this.teamB,reason:'CASCADE_TIEBREAK'};return{status:'FINAL',winner:null,reason:'DRAW'}}
 toJSON(){return{id:this.id,teamA:this.teamA,teamB:this.teamB,start:this.start,end:this.end,rosterA:this.rosterA,rosterB:this.rosterB,tieRule:this.tieRule,entries:this.entries,closed:this.closed}}
 static load(v){let m=new Match(v);for(const e of v.entries||[])m.submit(e,e.at);m.closed=!!v.closed;return m}
}
class Assembly{
 constructor({requirements={iron:120,light:60},cap=.35}={}){if(!(cap>0&&cap<1)||!Object.keys(requirements).length||Object.values(requirements).some(v=>!Number.isSafeInteger(v)||v<1))throw Error('Invalid project');this.requirements={...requirements};this.cap=cap;this.total={};this.contributions={};this.ids=new Set()}
 contribute(id,player,resource,amount){if(this.ids.has(id))return{status:'DUPLICATE'};if(!player||!Object.hasOwn(this.requirements,resource)||!Number.isSafeInteger(amount)||amount<1)return{status:'INVALID'};let prior=this.contributions[player]?.[resource]||0,max=Math.floor(this.requirements[resource]*this.cap),left=this.requirements[resource]-(this.total[resource]||0);if(prior+amount>max)return{status:'MEMBER_CAP',remaining:Math.max(0,max-prior)};if(amount>left)return{status:'OVER_TARGET',remaining:left};this.ids.add(id);this.contributions[player]??={};this.contributions[player][resource]=prior+amount;this.total[resource]=(this.total[resource]||0)+amount;return{status:'ACCEPTED',complete:this.complete()}}
 complete(){return Object.entries(this.requirements).every(([k,v])=>(this.total[k]||0)>=v)}
}
function vote({members,present,yes,no,abstain=0,threshold='majority',quorum}){if(![members,present,yes,no,abstain,quorum].every(Number.isInteger)||members<1||present<0||present>members||quorum<1||quorum>members||Math.min(yes,no,abstain)<0||yes+no+abstain>present||!['majority','two-thirds'].includes(threshold))return{status:'INVALID'};if(present<quorum)return{status:'NO_QUORUM',passed:false};let cast=yes+no;if(!cast)return{status:'NO_VOTES',passed:false};return{status:'RECORDED',passed:threshold==='two-thirds'?yes*3>=cast*2:yes*2>cast,cast,abstain}}
function bracket(teams){if(!Array.isArray(teams)||teams.length<2||teams.length>64||new Set(teams).size!==teams.length)throw Error('Choose 2–64 distinct teams');let size=2;while(size<teams.length)size*=2;let padded=teams.slice();while(padded.length<size)padded.push(null);return Array.from({length:size/2},(_,i)=>({a:padded[i],b:padded[size-1-i],bye:padded[size-1-i]===null,winner:padded[size-1-i]===null?padded[i]:null}))}
class WarRoom{
 constructor({start,end,lanes=1,attackers=['Attacker'],defenders=['Defender']}={}){if(!Number.isFinite(start)||!Number.isFinite(end)||end<=start||!Number.isInteger(lanes)||lanes<1||lanes>5||attackers.length!==lanes||defenders.length!==lanes||new Set([...attackers,...defenders]).size!==lanes*2)throw Error('Distinct human seats and valid window required');Object.assign(this,{start,end,attackers:[...attackers],defenders:[...defenders]});this.seats=Array.from({length:lanes},()=>({hp:1000,shield:false,reactions:2}));this.phase='ASSEMBLING';this.events=[];this.used=new Set();this.pending=null;this.scores={attack:0,defense:0};}
 callToOrder(present,now=Date.now()){if(this.phase!=='ASSEMBLING'||now<this.start||now>=this.end||!Array.isArray(present)||![...this.attackers,...this.defenders].every(p=>present.includes(p)))return{status:'NOT_READY'};this.phase='ACTIVE';return{status:'ACTIVE'}}
 queue({id,player,lane,damage},now=Date.now()){if(this.phase!=='ACTIVE'||now<this.start||now>=this.end)return{status:'CLOSED'};if(this.pending)return{status:'REACTION_PENDING'};if(this.used.has(id))return{status:'DUPLICATE'};if(!Number.isInteger(lane)||lane<0||lane>=this.seats.length||this.attackers[lane]!==player||!Number.isSafeInteger(damage)||damage<1||damage>1000||typeof id!=='string'||!id.length)return{status:'INVALID'};this.pending={id,player,lane,damage};return{status:'AWAITING_DEFENDER',defender:this.defenders[lane]}}
 react({player,spell='pass'},now=Date.now()){if(this.phase!=='ACTIVE'||now>=this.end||!this.pending)return{status:'NO_PENDING_ACTION'};let p=this.pending,l=this.seats[p.lane];if(player!==this.defenders[p.lane]||!['pass','wall','heal'].includes(spell))return{status:'INVALID'};if(spell!=='pass'&&l.reactions<1)return{status:'NO_REACTION'};if(spell!=='pass')l.reactions--;if(spell==='heal'){let healed=Math.min(200,1000-l.hp);l.hp+=healed;this.scores.defense+=healed;}let dmg=Math.min(l.hp,spell==='wall'?Math.ceil(p.damage*.5):p.damage),blocked=p.damage-dmg;l.hp-=dmg;this.scores.attack+=dmg;if(spell==='wall')this.scores.defense+=Math.min(p.damage,blocked);this.used.add(p.id);let event={...p,spell,actualDamage:dmg,remaining:l.hp,at:now};this.events.push(event);this.pending=null;if(this.events.length%2===0)l.reactions=2;return{status:'RESOLVED',event}}
 close(now=Date.now()){if(now<this.end)return{status:'WINDOW_OPEN'};this.pending=null;this.phase='CLOSED';let a=this.scores.attack,b=this.scores.defense;return{status:'FINAL',winner:a===b?null:a>b?'attack':'defense',scores:{...this.scores}}}
}
const CATEGORIES={'000':'Information and computing','100':'Philosophy and psychology','200':'Religion','300':'Social sciences','400':'Language','500':'Science','600':'Technology','700':'Arts and recreation','800':'Literature','900':'History and geography'};
function toBase12(n){if(!Number.isSafeInteger(n)||n<0)throw Error('Nonnegative safe integer required');return n.toString(12).toUpperCase()}
class Catalog{constructor(){this.assets=new Map()}add({id,classification,title,data={}}){if(typeof classification!=='string'||!/^\d{3}(\.\d+)?$/.test(classification)||typeof id!=='string'||!id||typeof title!=='string')throw Error('Use string classification and stable asset ID');if(this.assets.has(id))throw Error('Duplicate asset ID');this.assets.set(id,{id,classification,title,data:JSON.parse(JSON.stringify(data))})}find(prefix=''){return[...this.assets.values()].filter(x=>x.classification.startsWith(prefix)).sort((a,b)=>a.classification.localeCompare(b.classification)||a.id.localeCompare(b.id))}}
function toBase60(n){if(!Number.isSafeInteger(n)||n<0)throw Error('Nonnegative safe integer required');let digits=[];do{digits.unshift(n%60);n=Math.floor(n/60)}while(n);return digits.map((d,i)=>i?String(d).padStart(2,'0'):String(d)).join(':')}
return{Match,Assembly,WarRoom,ROLES,CLUBS,vote,bracket,Catalog,CATEGORIES,toBase12,toBase60};});
