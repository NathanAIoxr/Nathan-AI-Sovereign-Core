name: Factory quality checks

# Only run tests for changes they actually exercise. Manual runs remain available.
on:
  push:
    branches: [main]
    paths:
      - 'app-factory/**'
      - '.github/workflows/factory-ci.yml'
  pull_request:
    branches: [main]
    paths:
      - 'app-factory/**'
      - '.github/workflows/factory-ci.yml'
  workflow_dispatch:

# Avoid flooding inboxes with obsolete results during batches of commits.
concurrency:
  group: factory-quality-${{ github.workflow }}-${{ github.ref }}
  cancel-in-progress: true

permissions:
  contents: read

jobs:
  public-foundation:
    name: Public Factory syntax, integrity and game tests
    runs-on: ubuntu-latest
    timeout-minutes: 10
    steps:
      - name: Check out public code
        uses: actions/checkout@v5
      - name: Install Node.js 22 LTS
        uses: actions/setup-node@v5
        with:
          node-version: '22'
      - name: Verify public assets and architecture boundaries
        run: node --test app-factory/quality.test.cjs
      - name: Verify NATHAN AI 138-reference Registry and boundaries
        run: node --test app-factory/game-reference-lab/registry.test.cjs
      - name: Verify October 13 morning 376-reference integration
        run: node --test app-factory/game-reference-lab/morning-376.test.cjs
      - name: Verify TABOR Golden Radix Ladder bases and inverse conversion
        run: node --test app-factory/radix-ladder/engine.test.cjs
      - name: Verify Python radix parity
        run: python3 -m unittest discover -s app-factory/radix-ladder -p 'test_*.py'
      - name: Verify shared TABOR ROOT contracts and authorization gates
        run: node --test app-factory/core/root-contracts.test.cjs
      - name: Verify DUMMIE canon and rotating M semantics
        run: node --test app-factory/creative/dummie/canon.test.cjs
      - name: Verify Sovereign Boxes, 101 original games, private slots and holiday project
        run: node --test app-factory/sovereign-boxes/engine.test.cjs
      - name: Verify private owner catalog import and original ID protection
        run: node --test app-factory/sovereign-boxes/importer.test.cjs
      - name: Verify shared dependency build controller
        run: node --test app-factory/build-order/planner.test.cjs
      - name: Verify original-byte Vault backup and recovery
        run: node --test app-factory/vault-backup.test.cjs
      - name: Verify Middle C reversible word and ancient number puzzle game
        run: node --test app-factory/middle-c/game.test.cjs
      - name: Verify rotating X reference and four-scale Universal Node engine
        run: node --test app-factory/universal-node/engine.test.cjs
      - name: Verify rotating Earth X and Babel mirrored game
        run: |
          node --test app-factory/universal-node/engine.test.cjs
          node --test app-factory/universal-node/babel-game.test.cjs
      - name: Verify Universal Node mathematical body/cosmos model
        run: node --test app-factory/universal-node/engine.test.cjs
      - name: Verify universal website/blog and archive adapters
        run: node --test app-factory/universal-node/source-adapters.test.cjs
      - name: Verify DUMMIE packaging and provider handoff integrity
        run: node --test app-factory/dummie-publisher/publisher.test.cjs
      - name: Verify Greek mythology archive taxonomy and provenance
        run: node --test app-factory/mythology/greek/atlas.test.cjs
      - name: Verify ONE local engine
        run: node --test app-factory/one/one.test.cjs
      - name: Verify ONE 33 Trial Matrix five Epoch I levels
        run: node --test app-factory/one/trial-matrix/epoch1.test.cjs
      - name: Verify ONE Health private vault source boundaries
        run: node --test app-factory/one/health/health.test.cjs
      - name: Verify ONE 101–901 Master Library privacy and import boundaries
        run: node --test app-factory/one/library/library.test.cjs
      - name: Verify ONE Trials playable geometry and private source boundary
        run: node --test app-factory/one/trials/trials.test.cjs
      - name: Verify 1420 Crowning Jewel gameplay
        run: node --test app-factory/games/crowning-jewel.test.cjs

      - name: Verify 118 Line toy game roster and three-gate gameplay
        run: node --test app-factory/games/paradox-118/engine.test.cjs

      - name: Verify original Stewie Finn PAWS SWAP Mirror Bridge and physics
        run: node --test app-factory/stewie-mr-finn/polar-middle-c/mirror-bridge/engine.test.cjs

      - name: Verify Stewart Finn Polar Middle C game branch
        run: node --test app-factory/stewie-mr-finn/polar-middle-c/engine.test.cjs

      - name: Verify sports cutoff, generated filler provenance and rights-review gating
        run: node --test app-factory/historical-sports/engine.test.cjs

      - name: Verify Octopus Root receptors, growth and Crumbkeeper review
        run: node --test app-factory/octopus-root/engine.test.cjs

      - name: Verify Universal Continuum Tensor integration, formulas and simulated anomaly inversion
        run: node --test app-factory/octopus-root/uct/engine.test.cjs

      - name: Verify Sovereign Nexus no-loss, permission boundaries and multi-pack integration
        run: node --test app-factory/octopus-root/sovereign-nexus/engine.test.cjs

      - name: Verify Octopus Arsenal gameplay and combat rules
        run: node --test app-factory/octopus-root/octopus-arsenal/game.test.cjs

      - name: Verify Octopus app, PWA scope, source integrity and Root links
        run: node --test app-factory/octopus-root/octopus-arsenal/app.test.cjs

      - name: Verify Sovereign Continuum 25 gates, inversion and Root graft
        run: node --test app-factory/octopus-root/sovereign-continuum/engine.test.cjs

      - name: Verify Sovereign Root Codex indexes, mirror operations and non-destructive migration
        run: node --test app-factory/octopus-root/codex.test.cjs

      - name: Verify six additional Python deep-root numerical experiments
        run: python3 -m unittest discover -s app-factory/octopus-root/sovereign-continuum -p test_advanced.py -v

      - name: Verify all three Root field packs graft idempotently
        run: node --test app-factory/octopus-root/sovereign-fields/merge-packs.test.cjs

      - name: Verify full UCT number, geometry and Egyptian numeral atlas
        run: node --test app-factory/octopus-root/uct/triple-code/*.test.cjs

      - name: Verify sovereign bubble isolation, consensual strings and Good Samaritan responses
        run: node --test app-factory/octopus-root/sovereign-bubble/engine.test.cjs

      - name: Verify 100 Math Roots gates and numerical solvers
        run: node --test app-factory/stewie-mr-finn/polar-middle-c/math-roots/engine.test.cjs

      - name: Verify dynamic audience- and app-aware pricing decisions
        run: node --test app-factory/pricing-router/engine.test.cjs

      - name: Verify manifest-driven multi-game pricing configuration
        run: node --test app-factory/pricing-router/build-manifests.test.cjs


      - name: Verify Ancient Divine Roots source preservation and indexing
        run: node --test app-factory/mythology/ancient-roots/atlas.test.cjs

      - name: Verify KNAVE archive source, cultural qualifiers and fictional counterparts
        run: node --test app-factory/mythology/knave/atlas.test.cjs
