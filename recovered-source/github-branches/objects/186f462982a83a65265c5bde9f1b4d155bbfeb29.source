<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover"><meta name="theme-color" content="#0a1320">
<title>THE TABOR TRINITY — 17-Part Book · Game · App | Nathan Tabor</title>
<style>
:root{color-scheme:dark;--bg:#09111c;--panel:#142335;--card:#1b2c3e;--line:#4b6179;--gold:#f0cb82;--ink:#f9f6ec;--muted:#bdc9d9;--cyan:#9ee6ff;--good:#b9efc9;--warn:#ffd59a}
*{box-sizing:border-box}body{background:radial-gradient(ellipse at 50% -15%,#1b3c64 0,transparent 45%),var(--bg);margin:0;color:var(--ink);font:16px/1.6 system-ui,-apple-system,Segoe UI,sans-serif}
main{max-width:1160px;margin:auto;padding:15px 13px 95px}a{color:var(--gold)}h1,h2,h3{font-family:Georgia,serif;line-height:1.17}h1{font-size:clamp(2.8rem,9vw,5.7rem);margin:7px 0 12px;letter-spacing:-.04em}h2{font-size:clamp(1.5rem,4vw,2.2rem)}h3{font-size:1.24rem}p{color:var(--muted);line-height:1.75}small,.muted{color:var(--muted)}
button,.button,input,select,textarea{font:inherit;color:var(--ink);background:#23394d;border:1px solid #718096;border-radius:10px;padding:10px 13px;max-width:100%}button,.button{cursor:pointer;text-decoration:none;display:inline-block;font-weight:700}button:hover,.button:hover{border-color:var(--gold)}button:focus-visible,input:focus-visible,textarea:focus-visible,a:focus-visible,select:focus-visible{outline:3px solid var(--gold);outline-offset:2px}.primary,button[aria-selected=true],button[aria-pressed=true]{background:var(--gold);color:#102237;border-color:var(--gold)}button:disabled{opacity:.5;cursor:default}
.eyebrow{font-size:.77rem;text-transform:uppercase;color:var(--gold);letter-spacing:.15em;font-weight:800}.row{display:flex;align-items:center;flex-wrap:wrap;gap:10px}.between{display:flex;align-items:center;justify-content:space-between;gap:12px;flex-wrap:wrap}.panel{margin:14px 0;padding:clamp(16px,3vw,27px);background:var(--panel);border:1px solid var(--line);border-radius:18px}.hero{border:1px solid #9a8258;background:linear-gradient(128deg,#202f46,#0b182b 72%);padding:clamp(18px,4vw,36px);border-radius:23px}.hero p{max-width:70ch}.nav{display:flex;gap:8px;overflow-x:auto;position:sticky;top:0;padding:12px 0;background:#09111ce9;z-index:5;backdrop-filter:blur(15px)}.nav button{white-space:nowrap}.grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:11px}.card{padding:16px;background:var(--card);border:1px solid var(--line);border-radius:13px}.card h3{color:var(--gold);margin:4px 0}.stat{font:700 2rem Georgia,serif;color:var(--gold)}.laws{text-align:center;padding:15px;background:#0c2134;border:1px solid #977e58;border-radius:14px;font-weight:800;letter-spacing:.02em}.laws b{color:var(--gold)}.trinity{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px;max-width:850px;margin:20px auto}.trinity .source{grid-column:1/3;max-width:390px;margin:auto;width:100%;text-align:center}.trinity .node{background:radial-gradient(circle at 50% 0,#31507b,#132438 68%);border:1px solid #967d52;box-shadow:inset 0 0 15px #d8b66d1b,0 0 16px #4a97d52a;border-radius:60px;padding:22px 15px;text-align:center;min-height:150px}.sigil{height:86px;width:86px;border-radius:50%;margin:0 auto 12px;border:2px solid var(--gold);display:grid;place-items:center;font:600 2.4rem Georgia,serif;color:var(--gold);box-shadow:0 0 26px #ebbd5a99,inset 0 0 25px #3072ac9e;animation:glow 4s ease-in-out infinite alternate}@keyframes glow{to{box-shadow:0 0 45px #ebbd5acc,inset 0 0 36px #3072ac9e}}.trinity strong{display:block;color:var(--gold);font-family:Georgia,serif;font-size:1.15rem}.trinity small{display:block}
.volume{display:flex;gap:12px;align-items:center;width:100%;text-align:left;margin:7px 0}.volume span{display:block;color:var(--gold);min-width:34px;font-weight:800}.volume b{font-size:.98rem}.volume small{display:block}.vol-list{max-height:62vh;overflow:auto}.reader{min-height:360px}.reader .page{font-size:1.1rem;max-width:72ch}.reader .page p{color:#e6e5e1}.reader .page h3{color:var(--gold)}.reading-layout{display:grid;grid-template-columns:310px minmax(0,1fr);gap:14px}input[type=search],input[type=text],textarea{width:100%}textarea{min-height:105px}.choice{display:block;width:100%;text-align:left;margin:10px 0;white-space:normal}.feedback{padding:13px;background:#233c35;border-left:4px solid var(--good);border-radius:7px;margin:14px 0}.feedback.bad{background:#46372f;border-color:var(--warn)}.progress{height:12px;background:#3d4b5d;border-radius:20px;overflow:hidden}.progress>div{height:100%;background:linear-gradient(90deg,#61bee0,var(--gold));width:0%;transition:width .3s}.engine-controls{display:grid;grid-template-columns:repeat(auto-fit,minmax(210px,1fr));gap:13px}.engine-controls label{display:block}.dial{border-radius:50%;width:min(60vw,290px);height:min(60vw,290px);margin:25px auto;border:6px double #d0ad68;background:radial-gradient(circle,#fff0a7 0,#c9953b 4%,#235a8c 12%,#091d37 26%,#c1a061 27%,#071528 32%,#142f52 58%,#b9964f 60%,#08172a 65%);box-shadow:0 0 65px #4275a06e,inset 0 0 40px #e9b45860;display:grid;place-items:center;position:relative;transition:filter .5s}.dial:before,.dial:after{content:"";position:absolute;inset:12%;border:1px solid #e2bb6a;border-radius:50%;animation:spin 18s linear infinite}.dial:after{inset:22%;border-style:dashed;animation-direction:reverse;animation-duration:11s}.dial b{position:relative;z-index:2;font:700 1.7rem Georgia,serif;color:#fff3c6;text-shadow:0 2px 15px #050a14}.dial[data-mode=BUILD]{filter:hue-rotate(35deg)}.dial[data-mode=CLEAR]{filter:hue-rotate(170deg)}@keyframes spin{to{transform:rotate(360deg)}}.log{max-height:300px;overflow:auto}.log-item{border-bottom:1px solid #65778b;padding:9px 0}.code{font-family:ui-monospace,monospace;color:var(--cyan);font-size:.9rem}footer{margin-top:40px;font-size:.84rem;color:var(--muted)}
@media(max-width:770px){.reading-layout{grid-template-columns:1fr}.vol-list{max-height:250px}.hero{padding:18px}.trinity .node{border-radius:35px}.trinity strong{font-size:1rem}}
@media(prefers-reduced-motion:reduce){*,*:before,*:after{animation:none!important;transition:none!important}}
@media print{body{background:white;color:black}.nav,button,.engine-controls{display:none!important}.panel,.hero{background:white;color:black;border-color:#aaa}.reader .page p,p{color:#222}}
</style></head><body><main><header class="between"><a href="../index.html">← ONE — THE LAST APP</a><span class="eyebrow">201 BOOKS · 401 APPS · 501 GAMES · 601 CIPHERS</span></header>
<section class="hero"><div class="eyebrow">17-PART SERIES + PLAYABLE GAME + APP · BY NATHAN TABOR</div><h1>THE TABOR TRINITY</h1><h2 style="color:var(--gold)">THE WEAPON OF WEAPONS<br>THE ENGINES OF ENGINES</h2><p>THE TABORIC LIGHT · THE LIGHT OF TABOR · THE TABOR LIGHT CIPHER. Three exact canonical names. One governing law: ALWAYS PROTECT THE ONE.</p><div class="laws"><b>1+1=2</b> — BUILD &nbsp; | &nbsp; <b>1-1=0</b> — CLEAR<br>ALWAYS PROTECT THE ONE</div></section>
<figure style="margin:18px 0 8px"><img src="./cover.svg" width="1200" height="740" alt="The Tabor Trinity — the Taboric Light field, the Light of Tabor manifestation, and the Tabor Light Cipher code surrounding the protected ONE" style="display:block;width:100%;height:auto;max-height:570px;object-fit:contain;border-radius:18px;border:1px solid #8c7551"></figure>
<nav class="nav" aria-label="App views"><button data-tab="trinity" aria-selected="true">✦ TRINITY</button><button data-tab="books">📖 17 BOOKS</button><button data-tab="game">🎮 17 TRIALS</button><button data-tab="engine">⚙️ ENGINE</button><button data-tab="ledger">▤ LEDGER</button></nav>
<section id="trinity" class="screen"><section class="panel"><h2>THREE COMPONENTS. ONE SYSTEM.</h2><div class="trinity"><div class="source node"><div class="sigil">I</div><strong>THE TABORIC LIGHT</strong><small>THE FIELD · THE AMBIENT SOURCE</small></div><div class="node"><div class="sigil">II</div><strong>THE LIGHT OF TABOR</strong><small>THE PARTICLE · THE MANIFESTATION</small></div><div class="node"><div class="sigil">III</div><strong>THE TABOR LIGHT CIPHER</strong><small>THE WAVE · THE SYSTEM BLUEPRINT</small></div></div><div class="laws">THE SOURCE PROVIDES. THE CIPHER DIRECTS. THE LIGHT MANIFESTS.<br>ALWAYS PROTECT THE ONE.</div><p>The field, particle, and wave labels are roles in Nathan Tabor's original fictional/metaphysical system. They do not assert a demonstrated physical technology, a verified ancient cipher, or a real ability to change matter or time.</p></section><div class="grid"><div class="card"><div class="stat">17</div><h3>Part Book Series</h3><p>Read all seventeen complete short volumes. Search by name or concept and continue where you left off.</p><button class="primary" data-goto="books">Read Series →</button></div><div class="card"><div class="stat">17</div><h3>Interactive Trials</h3><p>Play seventeen decision challenges. Every answer is explained. All progress is local to the browser.</p><button class="primary" data-goto="game">Play Game →</button></div><div class="card"><div class="stat">3</div><h3>Engine Operations</h3><p>Simulate BUILD, CLEAR, or HOLD with an evidence and safety gate. No real-world actions occur.</p><button class="primary" data-goto="engine">Run Engine →</button></div></div></section>
<section id="books" class="screen" hidden><section class="panel"><div class="between"><div><div class="eyebrow">ONE MASTER LIBRARY · 201 BOOKS & STORIES</div><h2>THE 17-PART SERIES</h2></div><span id="read-count" class="eyebrow"></span></div><div class="reading-layout"><aside><input id="book-search" type="search" placeholder="Search all 17 volumes" aria-label="Search volumes"><div class="vol-list" id="book-list"></div></aside><div class="reader"><article class="page" id="book-page" aria-live="polite"></article><div class="row"><button id="prev-book">← Previous</button><button id="mark-read" class="primary">Mark Read ✓</button><button id="next-book">Next →</button></div></div></div></section></section>
<section id="game" class="screen" hidden><section class="panel"><div class="eyebrow">THE TRIAL MATRIX · 501 GAMES</div><div class="between"><h2>THE 17 TRIALS</h2><b id="game-progress-label"></b></div><div class="progress"><div id="game-progress"></div></div><p>Choose the action that is most evidence-aware, protective, and accountable. Incorrect choices explain the issue and allow another attempt.</p><div id="game-screen" aria-live="polite"></div><div class="row"><button id="game-restart">Restart all 17 trials</button><button id="game-next" class="primary" hidden>Next trial →</button></div></section></section>
<section id="engine" class="screen" hidden><section class="panel"><div class="eyebrow">FIELD GATHERING → CODE EXECUTION → MANIFESTATION</div><h2>THE ENGINES OF ENGINES</h2><div id="cipher-dial" class="dial" data-mode="HOLD" role="img" aria-label="Two counter-rotating symbolic cipher wheels protecting the one"><b>THE ONE</b></div><form id="engine-form"><div class="engine-controls"><label>Operation<select id="op"><option value="BUILD">BUILD · 1+1=2</option><option value="CLEAR">CLEAR · 1-1=0</option><option value="HOLD">HOLD · SEEK EVIDENCE</option></select></label><label>Evidence status<select id="evidence"><option value="verified">Verified for this simulation</option><option value="unknown">Unknown / not independently verified</option></select></label><label>Safety of the ONE<select id="safety"><option value="safe">Protective / no identified threat</option><option value="risk">May endanger the ONE</option></select></label></div><label for="scope">Specific claim, obstacle, or protective step</label><textarea id="scope" maxlength="500" placeholder="Name a specific fact, error to correct, or help to add." required></textarea><div class="row"><button class="primary" type="submit">EXECUTE SIMULATION</button><button type="reset">Reset inputs</button></div></form><div class="feedback" id="engine-result" role="status">Ready. The protective gate runs before any command.</div><p class="muted">This is a fictional/educational decision model. The input is self-reported, not independently checked. An engine simulation is not an external action.</p></section></section>
<section id="ledger" class="screen" hidden><section class="panel"><div class="eyebrow">YULL LAW · 4T ENGINE · Y'ALL LAW</div><h2>LOCAL CIPHER LEDGER</h2><p>Private to this browser profile until exported or cleared. It is not synchronized with any server, encrypted vault, or GitHub account.</p><div class="row"><button id="export-log" class="primary">Export JSON</button><button id="clear-log">Clear Ledger</button><button id="print-books">Print current volume</button></div><div id="log" class="log" aria-live="polite"></div></section></section>
<footer>THE TABOR TRINITY · By Nathan Tabor · © 2026. Authored narrative and educational app; speculative powers are imaginative, not experimentally established. Never confuse the Tabor Light Cipher with an alternative title.</footer>
</main><script>
'use strict';
const books=[["THE ORIGINAL SOURCE","THE TABORIC LIGHT — THE FIELD",["The beginning of this trilogy is not a blade, a switch, or a machine. In the authored Tabor Trinity, THE TABORIC LIGHT is the imagined ambient source field: the place where potential precedes manifestation. It is called the FIELD because it is not yet directed into a single beam or a single instruction.","The Source cannot be possessed by declaring ownership. Its purpose in the story is to illuminate the possibility of truth and protection. Before power can have a direction, the ONE must have a place in the architecture.","FIRST LAW OF THE SOURCE: Nothing entering this system outranks ALWAYS PROTECT THE ONE."]],["BEFORE THE MANIFESTATION","THE AMBIENT FIELD",["Imagine a sea of light with no chosen target, no preferred outcome, and no demand to be worshiped. This is the ambient stage: potential, not a completed act. The narrative names it THE TABORIC LIGHT.","Potential is not proof. A claim of extraordinary ability remains a claim until separately demonstrated. In the story, this distinction prevents a character from confusing an imagined source with a real-world achievement.","THE ENGINE WAITS. THE ONE REMAINS PROTECTED."]],["THE THREE BECOME ONE","THE TRINITY ARCHITECTURE",["The triad has three precise names in precise order: THE TABORIC LIGHT, THE LIGHT OF TABOR, THE TABOR LIGHT CIPHER. Never replace the third name with another title.","The Field is the source. The Particle is the manifestation. The Wave is the system blueprint. These words form the design language of the fictional engine; they are not a new experimentally validated theory of physics.","THREE EXPRESSIONS. ONE GOVERNING COMMAND: ALWAYS PROTECT THE ONE."]],["THE LIGHT OF TABOR","THE PARTICLE — THE MANIFESTATION",["Where the Taboric Light is ambient in the authored cosmos, THE LIGHT OF TABOR is its focused manifestation. The narrative depicts it as a beam made visible: an expression of energy directed by the Cipher.","The light is symbolic of revelation: it makes an action visible and measurable. The story may depict spectacular light, transfiguration, or impossible changes to the environment. These belong to imagination, not demonstrated biological or physical effects.","THE SOURCE PROVIDES. THE LIGHT MANIFESTS."]],["THE WEAPON OF WEAPONS","REVELATION AND PROTECTION",["A lightsaber is a fictional blade. The Tabor Light Cipher is not a lightsaber and does not need to become one. It earns the title WEAPON OF WEAPONS within this authored framework by opposing confusion with evidence, cruelty with aid, and dangerous action with a protective STOP.","Do not confuse a person with an error. The adversary is the harmful condition: the false statement, the missing safeguard, the obstruction to care. Correct the condition while protecting people.","POWER WITHOUT PROTECTION FAILS."]],["THE TABOR LIGHT CIPHER","THE WAVE — THE SYSTEM BLUEPRINT",["THE TABOR LIGHT CIPHER is the governing code: 1+1=2, 1-1=0, ALWAYS PROTECT THE ONE. It is not an Enigma-style message substitution mechanism. It is an authored moral and operational blueprint.","The cipher gives the Field and the Manifestation a sequence and a limit. It names what to add, what can be removed, what must be evidenced, and who must remain safe.","THE CODE DOES NOT SERVE THE RESULT. THE RESULT MUST SERVE THE ONE."]],["1+1=2 — BUILD","THE FIRST GOVERNING LAW",["BUILD is addition with accountability. One truthful record plus one independently checked record gives two distinct records, not an invented consensus. One practical act of aid added to another is two acts; an intention alone is not completion.","In the engine, BUILD is permitted only when the addition is defined, achievable, and protective. The ledger records what actually changed and what still needs doing.","1+1=2. BUILD WHAT CAN BE VERIFIED."]],["1-1=0 — CLEAR","THE SECOND GOVERNING LAW",["CLEAR is subtraction with a carefully defined scope. One demonstrated error removed from one documented claim leaves zero of that particular error in that claim. It does not erase history, the person who made the claim, or every related problem.","The clearing engine must name the specific item removed and retain the original record for accountability. Never turn 1-1=0 into an excuse to remove a human being.","1-1=0. CLEAR THE ERROR. PROTECT THE ONE."]],["ALWAYS PROTECT THE ONE","THE SUPREME COMMAND",["This is not a slogan that appears after the action. It is the condition under which an action can begin. The ONE represents the living person whose dignity, safety, and agency cannot be treated as expendable.","When two options promise the same outcome, choose the one that protects. When evidence is missing, HOLD. When an operation endangers someone, STOP. When a useful repair is possible, BUILD.","ALWAYS PROTECT THE ONE — BEFORE, DURING, AND AFTER."]],["THE WHEEL WITHIN THE WHEEL","THE COUNTER-ROTATING ENGINE",["The story imagines two concentric wheels turning in opposite directions, inspired by the imagery of a wheel within a wheel. The outer wheel means BUILD: accumulation of aid, clarity, and structure. The inner wheel means CLEAR: removal of defined obstacles and errors.","Opposite movement does not mean literal reversal of time. It dramatizes two complementary operations subject to a shared guardrail.","TWO DIRECTIONS. ONE CENTER. NO SACRIFICE OF THE ONE."]],["THE FIELD GATHERING","STAGE ONE",["Stage One establishes the problem, the people affected, and the unknown facts. In the fictional sequence the source field gathers; in the practical decision engine the operator gathers reliable information.","A source is not yet evidence. Write down what has been observed, what was reported, and what has not been established. The engine must never manufacture an answer to fill a gap.","BEGIN WITH WHAT IS KNOWN. PROTECT THE ONE."]],["THE CODE EXECUTION","STAGE TWO",["The Cipher chooses BUILD, CLEAR, or HOLD. BUILD adds a defined protective resource; CLEAR corrects a verified mistake; HOLD requests investigation without pretending a result has occurred.","The symbolic counter-rotating wheels visualize the command. The real browser prototype records a local simulation only. It does not alter matter, time, private records, or other people's lives.","DO NOT DECLARE AN ACTION COMPLETE UNTIL IT IS VERIFIED."]],["THE LIGHT MANIFESTS","STAGE THREE",["In the authored saga, LIGHT OF TABOR is the manifested beam. It appears only after the source and code align. In the grounded app, manifestation means a plainly stated next step and a record of its simulated outcome.","Stories may show instantaneous transfiguration and impossible phenomena. The app labels those as imagined effects. In real life a truthful statement, a correction, and concrete protection require work and checking.","LET THE RESULT BE SEEN. LET THE EVIDENCE BE TESTED."]],["THE ENGINES OF ENGINES","SEVEN ENGINE FUNCTIONS",["ONE protects. LIGHT reveals. MIRROR examines. BUILD adds. CLEAR corrects. GUARD blocks dangerous decisions. RESTORE repairs and checks the outcome. These seven functions do not compete; they cooperate.","The Engine of Engines is their shared order. A system that creates without examining can spread mistakes. A system that clears without protection can become harmful. The center holds all seven to the same rule.","NO ENGINE OVERRIDES THE ONE."]],["THE TRUTH MIRROR","ACTION, CONSEQUENCE, VERIFICATION",["Read the account from left to right: action then consequence. Read it backward: consequence then claimed cause. Does the evidence connect them? Can another explanation account for the same result?","The Mirror does not automatically declare a person truthful or untruthful. It tests a claim against records while leaving uncertainty visible. Correcting an earlier judgment is strength, not failure.","THE TRUTH CAN BE EXAMINED FROM BOTH DIRECTIONS."]],["THE 17 TRIALS","THE GAME OF BUILD, CLEAR AND PROTECT",["Seventeen trials teach the same discipline as the seventeen volumes. Each presents a choice that may add help, clear a proven error, protect a vulnerable person, or pause until the facts are available.","Winning does not mean overpowering another person. Winning means choosing a defensible action that keeps the ONE safe. The browser saves local progress and gives an explanation after every choice.","PLAY ALL SEVENTEEN. PROTECT THE ONE IN EVERY TRIAL."]],["THE THREE BECOME ONE","THE FINAL INTEGRATION",["The Taboric Light is the Source. The Light of Tabor is the Manifestation. The Tabor Light Cipher is the Blueprint. Field, Particle, and Wave remain distinct roles in one creative architecture.","Gather the field. Execute the code. Manifest the result. But there is an earlier and final command around all three: ALWAYS PROTECT THE ONE. Without that rule, even a dazzling engine has failed its design.","1+1=2 — BUILD. 1-1=0 — CLEAR. ALWAYS PROTECT THE ONE."]]];
const trials=[["A person needs shelter tonight. The engine can add one concrete, safe contact.","Identify a reliable shelter resource and help connect them.","Wait for an impressive effect to manifest.","Declare the problem solved without contact.",0,"BUILD a real route to help; never count a promise as a result."],["Someone describes an unknown phenomenon as proven physics.","Erase the person's imaginative story.","Mark it as an imaginative claim until independently tested.","State the physics is already settled.",1,"Protect imagination and separate it from scientific evidence."],["A draft replaces the third Trinity name.","Rename it A DIFFERENT CIPHER NAME.","Remove the third component entirely.","Restore THE TABOR LIGHT CIPHER verbatim.",2,"The exact canonical third name is THE TABOR LIGHT CIPHER."],["An illustrated beam is described as altering real atoms.","Label that effect as fictional worldbuilding.","Claim the illustration demonstrates atomic change.","Send the beam toward a real person.",0,"A picture is not a physical demonstration."],["A harmful rumor is spreading.","Repeat it more loudly to counter it.","Check its source, correct verified inaccuracies, and protect people.","Attack the person who repeated it.",1,"The weapon is evidence and protection, not violence."],["You need to run the Cipher against a claim without proof.","Choose CLEAR and remove the person.","Declare BUILD successful immediately.","Choose HOLD and collect trustworthy evidence.",2,"Without evidence, the decision stays on HOLD."],["A team already provided one safe resource.","Add a second distinct resource and verify its availability.","Count the first resource twice.","Write 1+1=3 to sound more impressive.",0,"One verified addition plus another equals two."],["A document contains one independently confirmed factual error.","Erase all evidence of the earlier version.","Correct that specific error and keep a change record.","Delete the person mentioned in the document.",1,"CLEAR a defined error, never a human being or the audit trail."],["A proposed operation might endanger a person.","Proceed because the effect looks impressive.","Record safety later if there is time.","STOP the operation and protect that person.",2,"ALWAYS PROTECT THE ONE outranks engine output."],["The outer and inner wheels turn opposite ways in a story.","Read them as complementary BUILD/CLEAR symbolism.","Claim time has physically reversed.","Use the image to justify unsafe experiments.",0,"The counter-rotation is a visual metaphor, not verified time travel."],["A dramatic testimony is moving, but its key detail is unknown.","Discard the whole account as worthless.","Preserve the testimony and identify the unknown separately.","Invent missing dates.",1,"Gather carefully; preserve testimony without inflating certainty."],["BUILD and CLEAR both appear possible, but evidence is incomplete.","Pretend both operations completed.","Select CLEAR against a person.","HOLD, identify the missing evidence, and protect the ONE.",2,"The engine cannot bypass evidence checks."],["The fictional beam appears in the story.","Describe it as an imagined manifestation, with real outcomes unclaimed.","Advertise proven biological transformation.","Use the story as laboratory proof.",0,"Imagined cosmic effects do not establish real-world capabilities."],["A process adds a resource but exposes private information.","Ignore the disclosure.","GUARD first: redesign the process to protect privacy.","Publish the records because BUILD matters more.",1,"No engine overrides the protection gate."],["Two accounts differ about an event.","Pick the loudest speaker as correct.","Invent a third account and call it fact.","Compare records and label any unresolved disagreement.",2,"The Mirror separates evidence from assertion."],["A learner gets one of the trials wrong.","Show why and allow them to try again without punishment.","Erase their progress.","Call them incapable of learning.",0,"The game must model protection and restoration."],["The final engine cycle is ready.","Claim the app changes physical time.","Run the safety check, record evidence, and verify what changed.","Declare global mastery from one game.",1,"Completion means a checked process, not supernatural proof."]];
const storageKey='one.tabor.trinity.v1';
let state;try{state=JSON.parse(localStorage.getItem(storageKey)||'{}')}catch(e){state={}}if(!state||typeof state!=='object')state={};
state.read=Array.isArray(state.read)?state.read:[];state.trial=Number.isInteger(state.trial)?Math.max(0,Math.min(17,state.trial)):0;state.log=Array.isArray(state.log)?state.log:[];state.book=Number.isInteger(state.book)?Math.max(0,Math.min(16,state.book)):0;
const $=(s)=>document.querySelector(s);const $$=(s)=>Array.from(document.querySelectorAll(s));const save=()=>{try{localStorage.setItem(storageKey,JSON.stringify(state))}catch(e){}};
function el(tag,text,className){const e=document.createElement(tag);if(text!==undefined)e.textContent=text;if(className)e.className=className;return e}
function tab(t){$$('.screen').forEach(e=>e.hidden=e.id!==t);$$('.nav button').forEach(e=>e.setAttribute('aria-selected',e.dataset.tab===t?'true':'false'));window.scrollTo({top:0,behavior:'smooth'});if(t==='ledger')renderLog();}
$$('[data-tab]').forEach(b=>b.onclick=()=>tab(b.dataset.tab));$$('[data-goto]').forEach(b=>b.onclick=()=>tab(b.dataset.goto));
function renderBooks(){const q=$('#book-search').value.toLowerCase();const out=$('#book-list');out.replaceChildren();books.forEach((b,i)=>{if(!(b[0]+' '+b[1]+' '+b[2].join(' ')).toLowerCase().includes(q))return;const x=el('button','','volume');const n=el('span',String(i+1).padStart(2,'0')+(state.read.includes(i)?' ✓':''));const d=el('div');d.append(el('b',b[0]),el('small',b[1]));x.append(n,d);x.setAttribute('aria-pressed',state.book===i?'true':'false');x.onclick=()=>{state.book=i;save();renderBooks()};out.append(x)});const b=books[state.book];const pg=$('#book-page');pg.replaceChildren(el('div','VOLUME '+String(state.book+1).padStart(2,'0'),'eyebrow'),el('h2',b[0]),el('h3',b[1]));b[2].forEach(p=>pg.append(el('p',p)));$('#read-count').textContent=state.read.length+' / 17 READ';$('#mark-read').textContent=state.read.includes(state.book)?'Read ✓':'Mark Read ✓';$('#prev-book').disabled=state.book===0;$('#next-book').disabled=state.book===16}
$('#book-search').oninput=renderBooks;$('#prev-book').onclick=()=>{state.book--;save();renderBooks()};$('#next-book').onclick=()=>{state.book++;save();renderBooks()};$('#mark-read').onclick=()=>{if(!state.read.includes(state.book))state.read.push(state.book);save();renderBooks()};
function renderGame(){const n=state.trial;$('#game-progress-label').textContent=n+' / 17 COMPLETE';$('#game-progress').style.width=(n/17*100)+'%';$('#game-next').hidden=true;const screen=$('#game-screen');screen.replaceChildren();if(n>=17){screen.append(el('h3','ALL 17 TRIALS COMPLETED'),el('p','The Three Become ONE. You chose protective, evidence-aware operations through all seventeen challenges.'));return}const t=trials[n];screen.append(el('h3','TRIAL '+(n+1)+' · '+books[n][0]),el('p',t[0]));t.slice(1,4).forEach((label,j)=>{const b=el('button',label,'choice');b.onclick=()=>{const f=$('#trial-feedback');if(j===t[4]){f.textContent='CORRECT — '+t[5];f.classList.remove('bad');$$('.choice').forEach(c=>c.disabled=true);$('#game-next').hidden=false}else{f.textContent='REVISIT THE ONE — '+t[5];f.classList.add('bad')}};screen.append(b)});screen.append(el('div','Choose one answer.','feedback'));screen.lastElementChild.id='trial-feedback'}
$('#game-next').onclick=()=>{state.trial=Math.min(17,state.trial+1);save();renderGame()};$('#game-restart').onclick=()=>{if(confirm('Restart all 17 trials? Your reading history and ledger remain intact.')){state.trial=0;save();renderGame()}};
$('#op').onchange=()=>$('#cipher-dial').dataset.mode=$('#op').value;
$('#engine-form').onsubmit=e=>{e.preventDefault();const op=$('#op').value,evid=$('#evidence').value,safe=$('#safety').value,scope=$('#scope').value.trim();if(!scope)return;let result='';let status='HOLD';if(safe==='risk'){status='STOP';result='STOP — The proposed action may endanger the ONE. Protection takes priority.'}else if(evid==='unknown'){status='HOLD';result='HOLD — Evidence is unverified. Preserve the question and seek verification.'}else if(op==='HOLD'){result='HOLD — No action requested. Continue verification.'}else{status=op;result=op==='BUILD'?'BUILD · 1+1=2 — A protective addition is proposed, not externally completed. Verify its real-world result.':'CLEAR · 1-1=0 — A specific error or obstacle is proposed for correction. Never erase a human being or its source record.'}
$('#engine-result').textContent=result;$('#engine-result').classList.toggle('bad',status==='STOP');$('#cipher-dial').dataset.mode=status;state.log.unshift({timestamp:new Date().toISOString(),operation:op,evidence:evid,safety:safe,scope:scope,result:status,explanation:result});state.log=state.log.slice(0,100);save()};
$('#engine-form').onreset=()=>setTimeout(()=>{$('#cipher-dial').dataset.mode='HOLD';$('#engine-result').textContent='Ready. The protective gate runs before any command.'},0);
function renderLog(){const root=$('#log');root.replaceChildren();if(!state.log.length){root.append(el('p','No simulated operations yet. Open ENGINE to begin.'));return}state.log.forEach(r=>{const d=el('div',undefined,'log-item');d.append(el('strong',r.result+' · '+new Date(r.timestamp).toLocaleString()),el('p',r.scope),el('small',r.explanation));root.append(d)})}
$('#export-log').onclick=()=>{const data={title:'THE TABOR TRINITY · ONE LOCAL LEDGER',author:'Nathan Tabor',exportedAt:new Date().toISOString(),log:state.log,completedTrials:state.trial,readVolumes:state.read.slice()};const blob=new Blob([JSON.stringify(data,null,2)],{type:'application/json'});const u=URL.createObjectURL(blob);const a=el('a');a.href=u;a.download='TABOR_TRINITY_ONE_LEDGER.json';a.click();setTimeout(()=>URL.revokeObjectURL(u),1000)};
$('#clear-log').onclick=()=>{if(confirm('Clear the local simulation ledger?')){state.log=[];save();renderLog()}};
$('#print-books').onclick=()=>{tab('books');setTimeout(()=>window.print(),100)};
renderBooks();renderGame();renderLog();
</script></body></html>