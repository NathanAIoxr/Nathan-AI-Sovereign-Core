<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="theme-color" content="#101116"><title>TABOR Root Constellation · 101–901</title><style>:root{font-family:system-ui,-apple-system,sans-serif;color-scheme:dark}body{margin:0;background:#101116;color:#f5f5f7}main{margin:auto;max-width:1080px;padding:18px 14px 60px}h1{font-size:clamp(1.6rem,5vw,2.7rem);margin:12px 0}p{color:#c2c1cd;line-height:1.55}.panel{background:#1c1f2a;border:1px solid #424353;padding:16px;border-radius:15px;margin:12px 0}.grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:9px}.item{background:#242837;padding:12px;border:1px solid #4a4b60;border-radius:11px}button,.btn,input,select{font:inherit;border-radius:9px;padding:11px;border:1px solid #53576b;color:white;background:#2b3242}.btn{display:inline-block;text-decoration:none}input,select{box-sizing:border-box;width:100%;margin:5px 0 12px}button{cursor:pointer}small{color:#aaa}label{display:block;color:#c9c5cd}strong{color:#fff}.stats{font-size:1.7rem;font-weight:800}header{display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:8px}.warn{border-left:4px solid #d8b369;padding:12px;background:#333026}a{color:#ddd1ad}</style></head><body><main><header><a class="btn" href="./index.html">← Factory</a><span>9 independent divisions · shared root</span></header><div class="panel"><h1>TABOR 101–901 · ROOT CONSTELLATION</h1><p>Separate every creation. Connect only the services, source references and approved assets it needs. No relationship merges two products, users or intellectual property.</p><p class="warn">This public page contains no private ideas. Select files from the private catalog ZIP on your iPhone to browse them locally; nothing is uploaded by this page. This is a single-device catalog viewer, not cloud account sync.</p><label for="file">Select one or more JSON catalog files from your private ZIP</label><input type="file" id="file" multiple accept=".json,application/json"><p id="notice" role="status">Awaiting files. Required: NEW_101_TO_901_IDEAS.json, ORIGINAL_101_GAMES_PRESERVED.json, PRIOR_150_CATALOG_PRESERVED.json; optional MASTER_ROOT_ARCHITECTURE.json and GAP_REGISTER.json.</p></div><div class="grid" id="stats"></div><div class="panel"><h2>Independent records</h2><div class="grid"><div><label for="source">Catalog</label><select id="source"><option value="ideas">New ideas</option><option value="games">Original TW games</option><option value="prior">Prior projects</option><option value="gaps">Gap report</option></select></div><div><label for="division">Division</label><select id="division"><option value="">All eras</option><option value="101">101 Origins</option><option value="201">201 Ancient</option><option value="301">301 Crossroads</option><option value="401">401 Medieval</option><option value="501">501 Early Modern</option><option value="601">601 Industry</option><option value="701">701 Modern</option><option value="801">801 Future</option><option value="901">901 Creator Tools</option></select></div><div><label for="query">Search titles</label><input id="query" placeholder="Search"></div></div><p id="count" role="status"></p><div id="results" class="grid"></div><p><button id="more">Show more</button></p></div></main><script>
'use strict';const $=id=>document.getElementById(id),store={ideas:[],games:[],prior:[],gaps:[],root:null};let limit=40;
const schemas={ideas:'tabor123.root-ideas.v1',games:'tabor123.root-originals.v1',prior:'tabor123.root-prior.v1'};
function el(tag,text){let x=document.createElement(tag);x.textContent=String(text||'');return x}
function refresh(){const counts=[['New ideas',store.ideas.length],['Original TW games',store.games.length],['Prior projects',store.prior.length],['Gap findings',store.gaps.length]];const box=$('stats');box.replaceChildren();for(const [name,n] of counts){const tile=el('div');tile.className='item';const count=el('div',n);count.className='stats';tile.append(count,el('small',name));box.append(tile)}const type=$('source').value,division=$('division').value,q=$('query').value.toLowerCase(),data=store[type]||[];let found=data.filter(x=>(!division||type==='prior'||type==='gaps'||String(x.category_code)===division)&&(!q||Object.values(x).map(v=>String(v)).join(' ').toLowerCase().includes(q)));$('count').textContent=found.length+' matching '+type+' records.';const out=$('results');out.replaceChildren();for(const x of found.slice(0,limit)){const tile=el('article');tile.className='item';tile.append(el('strong',x.title||x.gap));tile.append(el('p',(x.idea_id||x.stable_id||x.catalog_id||x.priority||'')+' · '+(x.category_name||x.kind||x.dimension||'')));tile.append(el('small',x.core_hook||x.setting||x.description||x.current_evidence_or_risk||''));out.append(tile)}$('more').hidden=found.length<=limit}
$('file').onchange=async()=>{let files=[...$('file').files],recognized=0;for(const f of files){if(f.size>8000000){$('notice').textContent='Skipped '+f.name+': max 8 MB per JSON file.';continue}try{const value=JSON.parse(await f.text());if(Array.isArray(value)&&value[0]?.idea_id){store.ideas=value;recognized++}else if(Array.isArray(value)&&value[0]?.stable_id){store.games=value;recognized++}else if(Array.isArray(value)&&value[0]?.catalog_id){store.prior=value;recognized++}else if(value?.schema==='tabor123.gaps.v1'&&Array.isArray(value.gaps)){store.gaps=value.gaps;recognized++}else if(value?.schema==='tabor123.root-constellation.v1'){store.root=value;recognized++}}catch(e){$('notice').textContent='Could not read '+f.name+': '+e.message}}$('notice').textContent='Loaded '+recognized+' compatible files locally. Private catalog not transmitted.';refresh()};
for(const id of ['source','division','query'])$(id).addEventListener(id==='query'?'input':'change',()=>{limit=40;refresh()});$('more').onclick=()=>{limit+=40;refresh()};refresh();
</script></body></html>