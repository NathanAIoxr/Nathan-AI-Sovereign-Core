<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover"><title>🐙 Octopus Root | Middle C</title><style>
:root{font-family:system-ui,-apple-system,sans-serif;color-scheme:dark}*{box-sizing:border-box}body{margin:0;background:#071124;color:#e8efff}main{max-width:1000px;margin:auto;padding:20px 14px 72px}a{color:#8de4d0}h1{font-size:clamp(24px,6vw,40px);margin:.3em 0}p{line-height:1.5;color:#adc9da}.eyebrow{font-size:12px;letter-spacing:.18em;color:#95e6ca}.panel{background:#122038;border:1px solid #2b4e67;padding:17px;margin:14px 0;border-radius:18px}.grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:12px}label{display:block;font-size:13px;margin:12px 0 5px;color:#c5deed}button,input,select,textarea{font:inherit}select,input,textarea{width:100%;padding:10px;border:1px solid #527189;color:white;background:#09182c;border-radius:10px}textarea{min-height:68px}button{border:1px solid #78c9b3;background:#245e67;color:#f2ffff;border-radius:11px;padding:11px 14px;margin:8px 4px 0 0;cursor:pointer}button:focus-visible,select:focus-visible,input:focus-visible{outline:3px solid #9cf6d2}.row{display:flex;flex-wrap:wrap;gap:16px}strong{color:#9befcf}.muted{font-size:13px;color:#96adbd}svg{width:100%;height:auto;border-radius:15px;background:radial-gradient(circle,#244063,#0c1932 75%)}#cookieList{max-height:180px;overflow:auto;padding-left:22px}li{margin-bottom:6px;overflow-wrap:anywhere}#message{min-height:26px;color:#a8ffcf}h2{font-size:20px}footer{color:#9ab0c5;font-size:12px;padding-top:15px}</style></head><body><main>
<a href="../index.html">← TABOR 1-2-3 FACTORY</a><div class="eyebrow">NATHAN AI × THE MIDDLE C</div><h1>🐙 THE INFINITE ROOT OCTOPUS</h1><p>The central brain anchors each project. Tentacles carry ideas into every branch. Sucker cups test connections before they stick. 🍪 Cookie Monster keeps rejected proposals safe for correction and review.</p>
<div class="panel"><div class="row"><span>🧠 Receptors: <strong id="countNodes">0</strong></span><span>🦑 Tentacles: <strong id="countLinks">0</strong></span><span>🍪 Cookies: <strong id="countCookies">0</strong></span></div><svg id="roots" viewBox="0 0 720 480" role="img" aria-label="Tentacle root map with sucker cup receptors"></svg><p class="muted">Finite visible slice of an extensible root graph. Each small ring represents a sucker cup. The graph expands on demand rather than running an uncontrolled infinite loop.</p></div>
<div class="grid"><section class="panel"><h2>🌱 Grow new roots</h2><label for="start">Start node</label><select id="start"></select><label for="amount">New tentacles per click</label><select id="amount"><option>1</option><option selected>3</option><option>4</option></select><button id="grow">Sprout tentacles</button><p class="muted">Available operations: reverse letters, rotate left, rotate right, reverse word order. No records are destroyed.</p></section>
<section class="panel"><h2>🫧 Attach a sucker cup</h2><label for="from">From</label><select id="from"></select><label for="to">To</label><select id="to"></select><label for="type">Check type</label><select id="type"><option>exact</option><option>reversal</option><option>word-order</option><option>cipher</option><option selected>symbolic</option><option>documented</option></select><label for="note">Transformation / explanation</label><textarea id="note" placeholder="Explain why these nodes connect"></textarea><label for="source">Document URL, when applicable</label><input id="source" placeholder="https://"><button id="test">Test & attach</button></section></div>
<div class="grid"><section class="panel"><h2>🍪 Cookie Monster Octopus</h2><p>Rejected connections are captured here, not deleted.</p><ol id="cookieList"></ol><button id="retry">Retry newest with form details</button></section><section class="panel"><h2>📦 Make it stick</h2><p>Changes are saved in this browser. Export JSON to preserve a separate copy.</p><button id="export">Export roots</button><label for="import">Import root JSON</label><input id="import" type="file" accept=".json,application/json"><button id="reset">Reset demo (confirm)</button><p id="message" aria-live="polite"></p></section></div>
<footer>Local-first concept engine · No automatic network access, fact certification, cross-project sharing or public release · <a href="./README.md">Rules and scope</a></footer></main>
<script src="./engine.js"></script><script>
(()=>{'use strict';
const A=window.OctopusRoot,K='tabor-octopus-root-v1',$=s=>document.getElementById(s);
let s;try{s=A.load(localStorage.getItem(K)||A.save(A.create()))}catch(e){s=A.create()}
const ns='http://www.w3.org/2000/svg';
function el(t,attrs){const x=document.createElementNS(ns,t);for(const k in attrs)x.setAttribute(k,attrs[k]);return x}
function label(m){$('message').textContent=m}
function optionize(name,items){const sel=$(name),old=sel.value;sel.replaceChildren();for(const item of items){const opt=document.createElement('option');opt.value=item.id;opt.textContent=item.label.slice(0,52);sel.append(opt)}if(items.some(n=>n.id===old))sel.value=old}
function draw(){
 const svg=$('roots');svg.replaceChildren();const nodes=s.nodes.slice(0,65),pos={};let spoke=0;
 for(const n of nodes){if(n.id==='core:middle'){pos[n.id]={x:360,y:240};continue}if(n.id==='filter:cookie'){pos[n.id]={x:360,y:451};continue}const angle=spoke++*Math.PI*2/Math.max(1,nodes.length-2),r=175+(spoke%3)*16;pos[n.id]={x:360+Math.cos(angle)*r,y:235+Math.sin(angle)*r}}
 for(const [i,link] of s.edges.entries()){const a=pos[link.from],b=pos[link.to];if(!a||!b)continue;const path=el('path',{d:'M'+a.x+','+a.y+' Q'+((a.x+b.x)/2)+','+((a.y+b.y)/2-12-(i%5)*5)+' '+b.x+','+b.y,fill:'none',stroke:'#428f9d','stroke-width':'1.5',opacity:'.7'});svg.append(path);
 for(let j=1;j<=3;j++){const f=j/4;svg.append(el('circle',{cx:a.x+(b.x-a.x)*f,cy:a.y+(b.y-a.y)*f-6,r:'3',fill:'#93ecd1',opacity:'.8'}))}}
 for(const n of nodes){const p=pos[n.id];if(!p)continue;const center=n.kind==='root',cookie=n.kind==='filter',r=center?38:cookie?25:12;
 const dot=el('circle',{cx:p.x,cy:p.y,r,fill:center?'#1f786b':'#243b63',stroke:cookie?'#eab65d':center?'#7ff6d6':'#9cabff','stroke-width':center?4:2});const info=el('title',{});info.textContent=n.label+' · '+n.origin;dot.append(info);svg.append(dot);
 if(center||cookie){const t=el('text',{x:p.x,y:p.y+5,'text-anchor':'middle','font-size':center?14:18,fill:'#fff'});t.textContent=center?'MIDDLE C':'🍪';svg.append(t)}
 else{for(let k=0;k<4;k++){const q=k*Math.PI/2;svg.append(el('circle',{cx:p.x+Math.cos(q)*10,cy:p.y+Math.sin(q)*10,r:2,fill:'#b8fce2'}))}}
 }
}
function refresh(){
 $('countNodes').textContent=s.nodes.length;$('countLinks').textContent=s.edges.length;$('countCookies').textContent=s.cookie.length;
 optionize('start',s.nodes.filter(n=>['word','pattern'].includes(n.kind)));
 optionize('from',s.nodes.filter(n=>n.kind!=='filter'));optionize('to',s.nodes.filter(n=>n.kind!=='filter'));
 $('cookieList').replaceChildren();for(const c of s.cookie.slice(-10).reverse()){const li=document.createElement('li');li.textContent=c.why+' — '+c.proposal.from+' → '+c.proposal.to;$('cookieList').append(li)}
 draw();try{localStorage.setItem(K,A.save(s))}catch(e){label('Storage not available; export JSON manually')}
}
function form(){return {from:$('from').value,to:$('to').value,type:$('type').value,note:$('note').value,source:$('source').value}}
$('grow').onclick=()=>{const r=A.grow(s,$('start').value,Number($('amount').value));s=r.state;refresh();label(r.why+' ('+r.added+')')};
$('test').onclick=()=>{const r=A.attach(s,form());s=r.state;refresh();label((r.ok?'🫧 STUCK: ':'🍪 COOKIE: ')+r.why)};
$('retry').onclick=()=>{const c=s.cookie.at(-1);if(!c){label('No cookies to review');return}const r=A.retry(s,c.id,form());s=r.state;refresh();label(r.why)};
$('export').onclick=()=>{const blob=new Blob([A.save(s)],{type:'application/json'}),url=URL.createObjectURL(blob),a=document.createElement('a');a.href=url;a.download='tabor-octopus-root.json';a.click();setTimeout(()=>URL.revokeObjectURL(url),1500);label('Download prepared: keep a safe backup')};
$('import').onchange=async e=>{const f=e.target.files[0];if(!f)return;try{s=A.load(await f.text());refresh();label('Imported: historical claims remain unverified')}catch(err){label('Import blocked: '+err.message)}e.target.value=''};
$('reset').onclick=()=>{if(!confirm('Reset local data? Export a backup first.'))return;s=A.create();refresh();label('Fresh root started')};
refresh();$('from').value='formula:arithmetic';$('to').value='word:aaron';$('type').value='cipher';$('note').value='The AAND → AARON substitution must be explicitly described';})();
</script></body></html>