efit_guarantee": false}, {"amount_usd": 300, "tier_name": "Family Reset", "display_group": "Seasonal", "heifer_catalog_analogy": "Gift of Clean Water ($300)", "toys_illustrative_use": "Support an age-diverse toy collection", "clothing_illustrative_use": "Support a family coat-and-clothing collection", "food_illustrative_use": "Support a fuller family pantry replenishment", "category_choices": ["toys", "clothing", "food", "combined", "where_needed_most"], "frequency_choices": ["one_time", "monthly", "annually"], "status": "proposed", "impact_status": "illustrative; validate with supplier quotes and partner fulfillment costs", "benefit_guarantee": false}, {"amount_usd": 350, "tier_name": "Bright Futures", "display_group": "Seasonal", "heifer_catalog_analogy": "Chicks + Solar Hatchery ($350)", "toys_illustrative_use": "Support learning, play and special-needs adaptations", "clothing_illustrative_use": "Support a coordinated multi-child wardrobe", "food_illustrative_use": "Support family groceries and healthy snacks", "category_choices": ["toys", "clothing", "food", "combined", "where_needed_most"], "frequency_choices": ["one_time", "monthly", "annually"], "status": "proposed", "impact_status": "illustrative; validate with supplier quotes and partner fulfillment costs", "benefit_guarantee": false}, {"amount_usd": 500, "tier_name": "Family Anchor", "display_group": "Signature", "heifer_catalog_analogy": "Heifer ($500)", "toys_illustrative_use": "Support substantial toy and book needs across a family", "clothing_illustrative_use": "Support clothing, coats, and footwear for a family", "food_illustrative_use": "Support substantial food assistance for a family", "category_choices": ["toys", "clothing", "food", "combined", "where_needed_most"], "frequency_choices": ["one_time", "monthly", "annually"], "status": "proposed", "impact_status": "illustrative; validate with supplier quotes and partner fulfillment costs", "benefit_guarantee": false}, {"amount_usd": 750, "tier_name": "Neighborhood Care", "display_group": "Signature", "heifer_catalog_analogy": "Gift of Water for Life ($750)", "toys_illustrative_use": "Help supply a small community toy drive", "clothing_illustrative_use": "Help supply a neighborhood clothing closet", "food_illustrative_use": "Help supply a partner pantry shelf", "category_choices": ["toys", "clothing", "food", "combined", "where_needed_most"], "frequency_choices": ["one_time", "monthly", "annually"], "status": "proposed", "impact_status": "illustrative; validate with supplier quotes and partner fulfillment costs", "benefit_guarantee": false}, {"amount_usd": 1000, "tier_name": "Community Shelf", "display_group": "Community", "heifer_catalog_analogy": "", "toys_illustrative_use": "Underwrite a local toy shelf or distribution event", "clothing_illustrative_use": "Underwrite a local clothing rack or supply day", "food_illustrative_use": "Underwrite pantry purchases at a community partner", "category_choices": ["toys", "clothing", "food", "combined", "where_needed_most"], "frequency_choices": ["one_time", "monthly", "annually"], "status": "proposed", "impact_status": "illustrative; validate with supplier quotes and partner fulfillment costs", "benefit_guarantee": false}, {"amount_usd": 2500, "tier_name": "Community Partner", "display_group": "Community", "heifer_catalog_analogy": "", "toys_illustrative_use": "Support multiple toy distribution points", "clothing_illustrative_use": "Support multiple seasonal clothing efforts", "food_illustrative_use": "Support multiple food distribution efforts", "category_choices": ["toys", "clothing", "food", "combined", "where_needed_most"], "frequency_choices": ["one_time", "annually"], "status": "proposed", "impact_status": "illustrative; validate with supplier quotes and partner fulfillment costs", "benefit_guarantee": false}, {"amount_usd": 5000, "tier_name": "Community Caravan", "display_group": "Community", "heifer_catalog_analogy": "Gift Ark ($5,000)", "toys_illustrative_use": "Support a major toy-drive buying and delivery cycle", "clothing_illustrative_use": "Support a major coat and essentials buying cycle", "food_illustrative_use": "Support a major pantry procurement and delivery cycle", "category_choices": ["toys", "clothing", "food", "combined", "where_needed_most"], "frequency_choices": ["one_time", "annually"], "status": "proposed", "impact_status": "illustrative; validate with supplier quotes and partner fulfillment costs", "benefit_guarantee": false}, {"amount_usd": 10000, "tier_name": "Community Circle", "display_group": "Leadership", "heifer_catalog_analogy": "Feed a Village ($10,000)", "toys_illustrative_use": "Support community-wide toys and books coverage", "clothing_illustrative_use": "Support community-wide clothing assistance", "food_illustrative_use": "Support community-wide food assistance", "category_choices": ["toys", "clothing", "food", "combined", "where_needed_most"], "frequency_choices": ["one_time", "annually"], "status": "proposed", "impact_status": "illustrative; validate with supplier quotes and partner fulfillment costs", "benefit_guarantee": false}, {"amount_usd": 25000, "tier_name": "Regional Builder", "display_group": "Leadership", "heifer_catalog_analogy": "", "toys_illustrative_use": "Support a regional toy-drive initiative", "clothing_illustrative_use": "Support a regional clothing and winter-gear initiative", "food_illustrative_use": "Support a regional food-access initiative", "category_choices": ["toys", "clothing", "food", "combined", "where_needed_most"], "frequency_choices": ["one_time", "annually"], "status": "proposed", "impact_status": "illustrative; validate with supplier quotes and partner fulfillment costs", "benefit_guarantee": false}, {"amount_usd": 50000, "tier_name": "Sustaining Partner", "display_group": "Leadership", "heifer_catalog_analogy": "", "toys_illustrative_use": "Support multi-site toy collections and distributions", "clothing_illustrative_use": "Support multi-site clothing assistance", "food_illustrative_use": "Support multi-site food assistance", "category_choices": ["toys", "clothing", "food", "combined", "where_needed_most"], "frequency_choices": ["one_time", "annually"], "status": "proposed", "impact_status": "illustrative; validate with supplier quotes and partner fulfillment costs", "benefit_guarantee": false}, {"amount_usd": 100000, "tier_name": "Founding Partner", "display_group": "Leadership", "heifer_catalog_analogy": "", "toys_illustrative_use": "Support annual program capacity for toys", "clothing_illustrative_use": "Support annual program capacity for clothing", "food_illustrative_use": "Support annual program capacity for food", "category_choices": ["toys", "clothing", "food", "combined", "where_needed_most"], "frequency_choices": ["one_time", "annually"], "status": "proposed", "impact_status": "illustrative; validate with supplier quotes and partner fulfillment costs", "benefit_guarantee": false}];window.fetch=async function(path){if(path==="/api/catalog")return {ok:true,json:async()=>({tiers:window.__CTD_TIERS})};throw new Error("Standalone preview has no backend")}</script><script>(()=>{'use strict';
const $=id=>document.getElementById(id),cash=n=>new Intl.NumberFormat('en-US',{style:'currency',currency:'USD',maximumFractionDigits:n%1===0?0:2}).format(n),esc=s=>String(s).replace(/[&<>"']/g,ch=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[ch]));
const departments=[{id:'toys',label:'Toys',icon:'✦',desc:'Play, learning, birthday surprises and Christmas gifts.',use:'toys_illustrative_use'},{id:'clothing',label:'Clothing',icon:'◈',desc:'Coats, school clothes, shoes and everyday essentials.',use:'clothing_illustrative_use'},{id:'food',label:'Food',icon:'❋',desc:'Pantry staples, groceries and holiday meals.',use:'food_illustrative_use'},{id:'combined',label:'All three',icon:'✳',desc:'Joy, warmth and nourishment—together.'},{id:'where_needed_most',label:'Where needed',icon:'♥',desc:'Flexible planning for the most urgent needs.'}];
const programs=[['Christmas Giving','✳','A holiday-centered initiative for toys, family gifts and community gatherings.'],['Birthday Joy','✦','Celebrate children whose special day deserves its own moment of joy.'],['Learning & Creativity','◈','Books, puzzles, creative supplies and play for all ages.'],['Emergency Family Support','♥','Coordinated food, clothing and essential supply responses.'],['365 Joy Circle','∞','Consistent year-round donor support rather than a December-only drive.'],['Toy Factory & Logistics','▣','Safe purchasing, sorting, stock control and transparent deliveries.']];
let tiers=[],designation='combined',cadence='one_time',amount=50,staffKey='',dialogType='';
const previewTiers=[20,50,120,300],defaultAmounts=[20,30,50,120,300,500];
function route(){const name=decodeURIComponent(location.hash.slice(1)).split('?')[0]||'home';const current=document.querySelector(`.page[data-page="${CSS.escape(name)}"]`)?name:'home';document.querySelectorAll('.page').forEach(el=>el.classList.toggle('active',el.dataset.page===current));document.querySelectorAll('nav a').forEach(el=>{el.classList.toggle('active',el.hash==='#'+current);if(el.hash==='#'+current)el.setAttribute('aria-current','page');else el.removeAttribute('aria-current')});$('navigation').classList.remove('open');$('menu').setAttribute('aria-expanded','false');window.scrollTo({top:0,behavior:'instant'});document.title='Christmas Toy Drive · '+current[0].toUpperCase()+current.slice(1)+' · 24 / 7 / 365'}
window.addEventListener('hashchange',route);$('menu').addEventListener('click',()=>{const open=$('navigation').classList.toggle('open');$('menu').setAttribute('aria-expanded',String(open))});
function renderDepartments(){const parent=$('departments');parent.replaceChildren();departments.forEach(d=>{const btn=document.createElement('button');btn.className='option'+(d.id===designation?' chosen':'');btn.type='button';btn.setAttribute('aria-pressed',String(d.id===designation));btn.innerHTML=`<span aria-hidden="true">${d.icon}<\/span><strong>${esc(d.label)}<\/strong>`;btn.addEventListener('click',()=>{designation=d.id;renderDepartments();updateSummary()});parent.append(btn)})}
function updateSummary(){const tier=tiers.find(t=>t.amount_usd===amount);$('total').textContent=cash(amount);$('chosen-tier').textContent=tier?.tier_name||'Custom level';$('chosen-department').textContent=departments.find(d=>d.id===designation)?.label||designation;$('period').textContent=({one_time:'One-time',monthly:'Monthly',annually:'Annual'})[cadence]+' planned gift';document.querySelectorAll('#amounts button').forEach(el=>{el.classList.toggle('selected',Number(el.dataset.amount)===amount);el.setAttribute('aria-pressed',String(Number(el.dataset.amount)===amount))});$('amount').value=String(amount)}
function selectAmount(value){if(!Number.isFinite(value)||value<5||value>100000)return;amount=value;updateSummary()}
function renderCatalog(){const term=$('search').value.toLowerCase().trim(),group=$('group').value;const found=tiers.filter(t=>(group==='all'||group===t.display_group)&&(!term||(t.tier_name+' '+t.amount_usd).toLowerCase().includes(term)));$('results').textContent=found.length+' levels';$('tier-cards').replaceChildren();found.forEach(t=>{const div=document.createElement('article');div.className='tier-card';div.innerHTML=`<span class="category-dot">✳<\/span><small>${esc(t.display_group)}<\/small><div class="price">${cash(t.amount_usd)}<\/div><h3>${esc(t.tier_name)}<\/h3><p>${esc(t.toys_illustrative_use)}<\/p><button data-amount="${t.amount_usd}" type="button">Build a gift plan ↗<\/button>`;div.querySelector('button').onclick=()=>{selectAmount(t.amount_usd);location.hash='give'};$('tier-cards').append(div)})}
function renderDynamic(){const programsMain=$('program-cards');programsMain.replaceChildren();departments.slice(0,3).forEach((d,i)=>{const p=document.createElement('article');p.className='program-card';p.innerHTML=`<div class="program-visual ${d.id}"><span class="program-symbol">${d.icon}<\/span><\/div><div class="program-card-content"><small>DEPARTMENT 0${i+1}<\/small><h3>${d.label}<\/h3><p>${d.desc}<\/p><a href="#give">Choose ${d.label.toLowerCase()} ↗<\/a><\/div>`;p.querySelector('a').addEventListener('click',()=>{designation=d.id;renderDepartments();updateSummary()});programsMain.append(p)});
$('featured-tiers').innerHTML=previewTiers.map(value=>{const t=tiers.find(x=>x.amount_usd===value);return `<article class="tier-preview"><small>GIVING LEVEL<\/small><div class="price">${cash(value)}<\/div><h3>${esc(t?.tier_name||'Gift')}<\/h3><p>${esc(t?.food_illustrative_use||'Help provide the essentials')}<\/p><a href="#give" data-pick="${value}">Plan this gift ↗<\/a><\/article>`}).join('');document.querySelectorAll('[data-pick]').forEach(a=>a.addEventListener('click',()=>selectAmount(Number(a.dataset.pick))));
const groups=[...new Set(tiers.map(t=>t.display_group))];groups.forEach(g=>{const option=document.createElement('option');option.value=g;option.textContent=g+' gifts';$('group').append(option)});
$('program-details').innerHTML=programs.map((p,i)=>`<article class="detail-card"><div class="symbol">${p[1]}<\/div><small class="overline">PROGRAM ${String(i+1).padStart(2,'0')}<\/small><h2>${p[0]}<\/h2><p>${p[2]}<\/p><a href="#give" class="text-link">Explore giving ↗<\/a><\/article>`).join('');
const involved=[['goods','Give new goods','▣','Plan an age-appropriate toy, seasonal clothing or safe shelf-stable grocery collection.'],['volunteer','Lend a hand','✳','Help with gift sorting, purchasing coordination, packing, design or delivery through approved partners.'],['host','Host a drive','◈','Bring a school, business, church or neighborhood group together to collect essentials.'],['help','Explore assistance','♥','Learn how verified partner referrals will work. Private family details are not collected here.']];$('involved-cards').innerHTML=involved.map(d=>`<article class="involved-card"><div class="symbol">${d[2]}<\/div><h2>${d[1]}<\/h2><p>${d[3]}<\/p><button class="btn dark" data-dialog="${d[0]}">Open planner ↗<\/button><\/article>`).join('');document.querySelectorAll('[data-dialog]').forEach(b=>b.addEventListener('click',()=>openDialog(b.dataset.dialog)));
$('amounts').replaceChildren();defaultAmounts.forEach(a=>{const b=document.createElement('button');b.dataset.amount=String(a);b.textContent=cash(a);b.onclick=()=>selectAmount(a);$('amounts').append(b)});renderDepartments();updateSummary();renderCatalog()}
async function loadCatalog(){try{const r=await fetch('/api/catalog',{cache:'no-store'});if(!r.ok)throw new Error('Catalog temporarily unavailable');tiers=(await r.json()).tiers;if(!Array.isArray(tiers)||!tiers.length)throw new Error('Empty catalog');renderDynamic()}catch(e){$('program-cards').textContent='The catalog service is unavailable. Start the development server to load the gift levels.';console.error(e)}}
$('amount').addEventListener('input',e=>{const n=Number(e.target.value);if(n>=5&&n<=100000&&Math.abs(n*100-Math.round(n*100))<.00001){amount=n;updateSummary()}});
$('frequencies').addEventListener('click',e=>{const b=e.target.closest('[data-frequency]');if(!b)return;cadence=b.dataset.frequency;document.querySelectorAll('#frequencies button').forEach(x=>x.classList.toggle('selected',x===b));updateSummary()});$('search').addEventListener('input',renderCatalog);$('group').addEventListener('change',renderCatalog);
$('prepare').addEventListener('click',async()=>{let n=Number($('amount').value);const target=$('plan-status');if(!Number.isFinite(n)||n<5||n>100000||Math.abs(n*100-Math.round(n*100))>0.0001){target.textContent='Enter an amount between $5 and $100,000, in whole cents.';return}selectAmount(n);$('prepare').disabled=true;try{const response=await fetch('/api/plans',{method:'POST',headers:{'Content-Type':'application/json','Idempotency-Key':(globalThis.crypto?.randomUUID?.()||('plan-'+Date.now().toString(36)+'-'+Math.random().toString(36).slice(2)))},body:JSON.stringify({amount_usd:n,designation,cadence})});const data=await response.json();if(!response.ok)throw new Error(typeof data.detail==='string'?data.detail:'Could not create planning record');target.textContent='Giving plan '+data.id.slice(0,8)+' prepared. Nothing has been charged. This is not a donation receipt.';if($('tribute-check').checked)location.hash='honor'}catch(e){target.textContent='Your plan: '+cash(n)+' for '+departments.find(x=>x.id===designation).label+' ('+cadence.replace('_',' ')+'). No payment has been made. Server record unavailable.'}finally{$('prepare').disabled=false}});
function tributeUpdate(){$('card-for').textContent='For '+($('honoree').value.trim()||'someone special');$('card-message').textContent=$('message').value.trim()||'Wishing you joy, kindness and a little extra sparkle.';$('card-from').textContent=$('signature').value.trim()||'With love'}['honoree','message','signature'].forEach(id=>$(id).addEventListener('input',tributeUpdate));$('print-card').onclick=()=>window.print();$('copy-card').onclick=async()=>{const text=[$('card-for').textContent,$('card-message').textContent,$('card-from').textContent,'Christmas Toy Drive · Not proof of donation'].join('\n');try{await navigator.clipboard.writeText(text);$('card-status').textContent='Greeting copied. Nothing was sent to a server.'}catch(e){$('card-status').textContent='Copy is unavailable in this browser. Select the greeting text to copy.'}};
const dialogs={goods:{name:'Plan a goods collection',intro:'Start with safe, useful goods and confirm a verified partner before delivering anything.',list:['New, age-appropriate toys and books','Clean, size-labeled clothing and coats','Shelf-stable, sealed food within its safe dates','Keep a list of quantities and sources','Confirm handoff location before announcing it']},volunteer:{name:'Explore volunteer roles',intro:'Volunteering requires a confirmed site, coordinator and child-safety protocols.',list:['Toy sorting and safety screening','Clothing size matching and labeling','Food packing with safe handling','Creative website or outreach support','Inventory reconciliation and distribution support']},host:{name:'Build a collection-drive checklist',intro:'Use this plan for a workplace, school, neighborhood or faith community.',list:['Name a responsible adult organizer','Choose toys, clothing, food, or all three','Agree on eligible item specifications','Verify a distribution or drop-off partner','Record incoming goods and confirm final handoff']},help:{name:'Assistance pathways',intro:'The private intake system is not operating. Do not submit names, addresses, contact details or medical information here.',list:['Holiday toy support through approved local partners','Warm clothing and school essentials','Family pantry and emergency food needs','Referral verification before sharing private records','No public photos or stories required for assistance']}};
function openDialog(kind){dialogType=kind;const d=dialogs[kind];if(!d)return;$('dialog-title').textContent=d.name;$('dialog-copy').textContent=d.intro;$('dialog-list').innerHTML='<ol>'+d.list.map(i=>'<li>'+esc(i)+'<\/li>').join('')+'<\/ol>';$('dialog-status').textContent='This checklist stays in your browser.';$('modal').hidden=false;$('close-dialog').focus();document.body.style.overflow='hidden'}function closeDialog(){$('modal').hidden=true;document.body.style.overflow=''}$('close-dialog').onclick=closeDialog;$('done-dialog').onclick=closeDialog;$('modal').addEventListener('click',e=>{if(e.target===$('modal'))closeDialog()});document.addEventListener('keydown',e=>{if(e.key==='Escape'&&!$('modal').hidden)closeDialog()});$('copy-list').onclick=async()=>{const d=dialogs[dialogType],text=d.name+'\n'+d.intro+'\n'+d.list.map((x,i)=>`${i+1}. ${x}`).join('\n');try{await navigator.clipboard.writeText(text);$('dialog-status').textContent='Checklist copied.'}catch(e){$('dialog-status').textContent='Clipboard permission unavailable; copy the items from the dialog.'}};
async function staffFetch(path,options={}){const r=await fetch(path,{...options,headers:{'X-Admin-Key':staffKey,'Content-Type':'application/json',...(options.headers||{})}});const data=await r.json();if(!r.ok)throw Error(typeof data.detail==='string'?data.detail:'Request failed');return data}
function fillText(el,value){$(el).textContent=String(value)}
async function staffRefresh(){const [overview,inventory,audit]=await Promise.all([staffFetch('/api/admin/overview'),staffFetch('/api/admin/inventory'),staffFetch('/api/admin/audit')]);const measures=[['Plans (not paid)',overview.planned_gifts],['Planned value',cash(overview.planned_amount_cents/100)],['Inventory SKUs',overview.inventory_skus],['Stock units',overview.inventory_units]];$('staff-metrics').innerHTML=measures.map(x=>`<div><small>${esc(x[0])}<\/small><strong>${esc(x[1])}<\/strong><span>Development records<\/span><\/div>`).join('');$('stock-rows').replaceChildren();inventory.forEach(i=>{const row=document.createElement('tr');[i.sku,i.category,i.quantity,i.safety].forEach(v=>{const td=document.createElement('td');td.textContent=String(v);row.append(td)});$('stock-rows').append(row)});if(!inventory.length)$('stock-rows').innerHTML='<tr><td colspan="4">No inventory has been registered.<\/td><\/tr>';['movement-item','safety-item'].forEach(id=>{const select=$(id);const selected=select.value;select.replaceChildren();const blank=document.createElement('option');blank.value='';blank.textContent='Choose SKU';select.append(blank);inventory.forEach(item=>{const option=document.createElement('option');option.value=item.id;option.textContent=item.sku+' · '+item.title;select.append(option)});select.value=inventory.some(i=>i.id===selected)?selected:''});$('audit-events').replaceChildren();audit.forEach(a=>{const p=document.createElement('p');p.textContent=a.created_at+' · '+a.action+' · '+a.subject.slice(0,8);$('audit-events').append(p)});if(!audit.length)$('audit-events').textContent='No events recorded.'}
$('connect').onclick=async()=>{staffKey=$('staff-key').value;$('staff-key').value='';try{await staffRefresh();$('staff-workspace').hidden=false;fillText('staff-message','Connected for this browser session. Your key is not saved.')}catch(e){staffKey='';$('staff-workspace').hidden=true;fillText('staff-message',e.message)}};$('refresh').onclick=()=>staffRefresh().catch(e=>fillText('staff-message',e.message));
$('add-item').onclick=async()=>{try{const data={sku:$('sku').value.trim(),title:$('item-title').value.trim(),category:$('item-category').value};const result=await staffFetch('/api/admin/inventory',{method:'POST',body:JSON.stringify(data)});fillText('inventory-message','SKU '+result.sku+' added, pending inspection.');await staffRefresh()}catch(e){fillText('inventory-message',e.message)}};
$('add-campaign').onclick=async()=>{try{const data={name:$('campaign-name').value.trim(),category:$('campaign-category').value,goal_cents:Math.round(Number($('campaign-goal').value)*100)};const result=await staffFetch('/api/admin/campaigns',{method:'POST',body:JSON.stringify(data)});fillText('campaign-message','Campaign '+result.id.slice(0,8)+' created as a draft.');await staffRefresh()}catch(e){fillText('campaign-message',e.message)}};
$('move-stock').onclick=async()=>{try{const item=$('movement-item').value;if(!item)throw Error('Select a SKU first');const data={item_id:item,delta:Number($('movement-units').value),reason:$('movement-reason').value,reference:$('movement-ref').value.trim()};const result=await staffFetch('/api/admin/movements',{method:'POST',body:JSON.stringify(data)});fillText('movement-message','Movement recorded; current count '+result.quantity+'.');await staffRefresh()}catch(e){fillText('movement-message',e.message)}};
$('save-safety').onclick=async()=>{try{const item=$('safety-item').value;if(!item)throw Error('Select a SKU first');const result=await staffFetch('/api/admin/inventory/'+encodeURIComponent(item)+'/safety',{method:'POST',body:JSON.stringify({safety:$('safety-state').value})});fillText('safety-message','Status saved: '+result.safety+'.');await staffRefresh()}catch(e){fillText('safety-message',e.message)}};
$('add-batch').onclick=async()=>{try{const data={reference:$('batch-reference').value.trim(),category:$('batch-department').value,items:Number($('batch-count').value),partner_batch:$('batch-partner').value.trim(),verified:false};const result=await staffFetch('/api/admin/batches',{method:'POST',body:JSON.stringify(data)});fillText('batch-message','Planned batch '+result.id.slice(0,8)+' recorded. Not verified as delivered.');await staffRefresh()}catch(e){fillText('batch-message',e.message)}};
route();loadCatalog();
})();
</script></body></html>