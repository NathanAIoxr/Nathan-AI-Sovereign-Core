ight:1.05;letter-spacing:-.065em;margin:0}.page-hero p:not(.overline){max-width:690px;color:#d0e5d5;font-size:17px;line-height:1.75}.card{background:white;border:1px solid var(--line);border-radius:var(--radius);padding:30px}.card h2{font-size:25px;letter-spacing:-.04em;margin:0 0 23px}.giving-grid{display:grid;grid-template-columns:minmax(0,1fr) 345px;gap:30px;align-items:start}.form-stack{display:grid;gap:20px}.number{display:inline-flex;width:31px;height:31px;background:#e4f0dc;color:#2c7459;border-radius:9px;align-items:center;justify-content:center;font-size:12px;margin-right:10px;vertical-align:middle}.options{display:grid;grid-template-columns:repeat(3,1fr);gap:10px}.option{border:1px solid #d6e5dc;border-radius:11px;background:#fafdf9;text-align:left;padding:19px 14px;min-height:100px;color:#234b3a}.option span{display:block;font-size:24px}.option strong{font-size:13px}.option.chosen,.option:hover{border:2px solid #2b7457;background:#e9f2e5}.tabs{display:flex;border-radius:10px;background:#f0f4ea;padding:5px;gap:5px}.tabs button{flex:1;border:0;background:transparent;padding:11px;font-weight:850;font-size:12px;border-radius:8px}.tabs button.selected{background:var(--forest);color:white}.amount-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:10px;margin:22px 0}.amount-grid button{padding:15px;border:1px solid #ccdbd0;border-radius:10px;background:white;font-weight:900;color:var(--forest)}.amount-grid button.selected{background:var(--lime);border-color:#95ae6d}.field-label{display:block;font-size:12px;font-weight:900;margin:16px 0 8px}input:not([type=checkbox]),textarea,select{width:100%;border:1px solid #d0dad1;border-radius:10px;background:#fffefa;padding:14px 16px;color:var(--forest);font-size:14px}input:focus,textarea:focus,select:focus{border-color:#417a62}.money-input{position:relative}.money-input span{position:absolute;left:16px;top:12px;font-weight:850;font-size:18px}.money-input input{padding-left:37px}.fine{font-size:12px;color:#718178;line-height:1.65}.check{display:flex;gap:10px;align-items:center;margin:20px 0}.check input{width:17px;height:17px}.notice{font-size:12px;color:#2b6650;margin-top:18px}.summary{padding:28px;border-radius:18px;background:var(--forest);color:white;position:sticky;top:119px}.summary>strong{font-size:64px;letter-spacing:-.065em;line-height:1.25;display:block}.summary>small{color:#cce1d3}.summary>div{display:flex;justify-content:space-between;gap:8px;margin:19px 0;font-size:13px}.summary>div span{color:#c0d9c9}.summary hr{border:0;border-top:1px solid #517a65;margin:22px 0}.summary p{color:#b9d4c6;font-size:12px;line-height:1.7}.side-note{margin-top:15px;padding:23px;background:#f1ebd5;border-radius:15px;font-size:13px}.side-note p{color:#667264}.filters{display:flex;gap:10px;align-items:center;margin-bottom:26px}.filters input{max-width:420px}.filters select{max-width:220px}.filters span{font-size:12px;color:#667b71;white-space:nowrap}.tier-cards{display:grid;grid-template-columns:repeat(4,1fr);gap:15px}.tier-card h3{min-height:55px}.tier-card .category-dot{position:absolute;top:20px;right:20px;color:#b8cca0}.program-details,.involved-cards{display:grid;grid-template-columns:repeat(2,1fr);gap:20px}.detail-card,.involved-card{background:#fff;border-radius:18px;border:1px solid #e1e7dd;padding:30px}.detail-card .symbol,.involved-card .symbol{width:58px;height:58px;display:grid;place-items:center;border-radius:14px;background:#e6f0e4;font-size:30px}.detail-card h2,.involved-card h2{font-size:27px;letter-spacing:-.04em}.detail-card p,.involved-card p{color:var(--muted)}.principles{background:var(--forest);color:white;padding:50px;margin-top:25px;border-radius:18px}.principles h2{font-size:39px}.principles p{color:#cfe2d7;max-width:850px}.tribute-grid{display:grid;grid-template-columns:.85fr 1.15fr;gap:28px}.tribute-fields textarea{resize:vertical}.tribute-preview{background:#e5efcd;min-height:530px;border:15px solid white;outline:1px solid #c5d5ba;box-shadow:0 15px 36px #173b2