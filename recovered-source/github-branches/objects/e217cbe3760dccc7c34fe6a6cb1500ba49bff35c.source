ooter p{font-size:13px;color:#aec9b6}.footer small{font-size:9px;letter-spacing:.15em;color:#88ae9d}.footer-grid>div:not(:first-child){display:flex;flex-direction:column;gap:11px;font-size:13px}.footer-grid b{color:white;margin-bottom:8px}.footer-grid a{color:#b8d5c2}.footer-bottom{border-top:1px solid #36614e;margin-top:58px;padding-top:25px;display:flex;justify-content:space-between;gap:20px;color:#97b8a4;font-size:10px;letter-spacing:.08em}.modal-backdrop{position:fixed;inset:0;background:#06231bd4;z-index:70;display:grid;place-items:center;padding:20px}.modal-backdrop[hidden]{display:none}.dialog{background:#fffcf4;border-radius:20px;padding:35px;width:min(570px,100%);max-height:90vh;overflow:auto;position:relative}.dialog h2{font-size:33px;margin:0 0 5px}.dialog>p:not(.overline){color:#66796d}.dialog li{margin:10px 0}.modal-close{position:absolute;top:14px;right:14px;border:0;background:#e9eee5;border-radius:50%;width:40px;height:40px;font-size:27px}
@media(max-width:1100px){.shell{width:min(100% - 36px,1150px)}nav{gap:12px}.brand{font-size:13px}.nav{gap:12px}.hero-layout{min-height:580px}.hero-graphic{transform:scale(.85);transform-origin:center}.tier-cards{grid-template-columns:repeat(3,1fr)}}@media(max-width:900px){nav{display:none;position:absolute;left:0;right:0;top:100%;background:white;padding:22px;box-shadow:0 15px 20px #193f3520}nav.open{display:flex;flex-direction:column;align-items:stretch;gap:20px}.menu{display:block}.staff-link{display:none}.hero-layout{grid-template-columns:1fr;padding:65px 0 45px}.hero-graphic{min-height:460px;transform:scale(.85);margin:-40px 0}.feature-grid,.giving-grid,.tribute-grid,.join-grid{grid-template-columns:1fr}.feature-grid{gap:35px}.feature-graphic{max-width:600px}.summary{position:static}.featured-tiers{grid-template-columns:repeat(2,1fr)}.program-cards{grid-template-columns:1fr 1fr}.program-card:last-child{grid-column:1/-1}.footer-grid{grid-template-columns:1fr 1fr}.impact-grid{grid-template-columns:1fr}}@media(max-width:620px){.announcement{font-size:8px;letter-spacing:.08em}.nav{min-height:73px}.brand{font-size:12px}.brand small{font-size:7px}.mark{width:37px;height:37px;font-size:26px}.nav-actions .btn{padding:10px 12px;font-size:11px}.hero-layout{padding:45px 0}.hero h1{font-size:clamp(49px,12vw,70px)}.hero-lead{font-size:15px}.hero-caption{margin-top:38px;font-size:8px}.hero-graphic{min-height:310px;transform:scale(.58);margin:-100px 0}.hero-strip{font-size:8px;letter-spacing:.07em}.hero-strip .shell{gap:5px}.section{padding:60px 0}.section-heading{display:block}.section-heading>p{max-width:100%}.program-cards,.featured-tiers,.program-details,.involved-cards,.metrics,.work-grid,.login{grid-template-columns:1fr}.program-card:last-child{grid-column:auto}.feature-grid{padding:55px 0}.feature-graphic{height:370px}.sticker{width:100px;height:100px;font-size:12px}.join{padding:55px 0}.page-hero{padding:55px 0}.options{grid-template-columns:repeat(2,1fr)}.amount-grid{grid-template-columns:repeat(3,1fr)}.tier-cards{grid-template-columns:repeat(2,1fr)}.tier-card,.tier-preview{padding:17px}.tier-card h3,.tier-preview h3{font-size:18px}.tier-card .price,.tier-preview .price{font-size:30px}.filters{flex-wrap:wrap}.filters input{max-width:none}.filters select{max-width:none}.tribute-preview{min-height:480px}.footer-grid{gap:40px 20px}.footer-bottom{flex-direction:column}.principles{padding:30px}.principles h2{font-size:30px}}
@media print{header,.announcement,.footer,.page-hero,.tribute-fields,.modal-backdrop{display:none!important}.page{display:none!important}.page[data-page=honor]{display:block!important}.tribute-grid{display:block;padding:0}.tribute-preview{width:100%;border:4px solid #194832;min-height:90vh;box-shadow:none}body{background:white}}@media(prefers-reduced-motion:reduce){html{scroll-behavior:auto}*{transition:none!important}}

/* Keep the mobile top action on one line without displacing navigation. */
@media(max-width:620px){.nav-actions .btn{white-space:nowrap;font-size:10px;padding:10px 9px}.brand{font-size:11px}.nav-actions{gap:7px}}
