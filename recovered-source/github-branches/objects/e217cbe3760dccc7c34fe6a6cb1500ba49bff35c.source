<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="theme-color" content="#0b372d"><meta name="description" content="Christmas Toy Drive: three departments, 24 gift tiers, year-round generosity. A development preview by Nathan Tabor."><title>Christmas Toy Drive — 24 / 7 / 365</title><style>:root{--forest:#0b392f;--deep:#092a24;--cream:#fbfaf4;--paper:#fffefa;--ink:#193f35;--muted:#687970;--lime:#d9ed82;--gold:#f4ca83;--line:#dfE6dd;--blue:#cfebf3;--rose:#f5d9c9;--mint:#e5f0e3;--radius:18px}*{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;background:var(--cream);font:16px/1.55 Inter,"Avenir Next",system-ui,-apple-system,sans-serif;color:var(--ink)}a{color:inherit;text-decoration:none}button,input,select,textarea{font:inherit}button{cursor:pointer}a:focus-visible,button:focus-visible,input:focus-visible,select:focus-visible,textarea:focus-visible,summary:focus-visible{outline:3px solid #b95b4c;outline-offset:3px}.shell{width:min(1220px,calc(100% - 64px));margin:0 auto}.sr-only{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0,0,0,0)}.skip{position:absolute;left:12px;top:-90px;z-index:1000;background:white;padding:10px}.skip:focus{top:12px}.announcement{background:#e2ebce;color:#2b5441;text-align:center;padding:9px 16px;font-size:10px;font-weight:900;letter-spacing:.19em}.nav{display:flex;align-items:center;justify-content:space-between;gap:22px;min-height:92px}.brand{display:flex;align-items:center;gap:12px;letter-spacing:.02em;font-size:15px;font-weight:900;white-space:nowrap;line-height:1.1}.brand b{color:#60866b}.brand small{display:block;font-size:9px;color:#75887b;letter-spacing:.19em;margin-top:8px}.mark,.footer-mark{display:grid;place-items:center;font-weight:900;font-size:35px;color:var(--deep);width:47px;height:47px;border-radius:13px;background:var(--lime)}header{position:sticky;top:0;background:#fffcf7ed;backdrop-filter:blur(18px);z-index:20;border-bottom:1px solid #e6e9df}nav{display:flex;gap:24px;align-items:center}nav a,.staff-link{font-weight:740;font-size:12px;color:#3c584c;white-space:nowrap}nav a:hover,nav a.active{color:#096d4e}.nav-actions{display:flex;align-items:center;gap:18px}.btn{display:inline-flex;justify-content:center;align-items:center;gap:10px;padding:13px 21px;border-radius:11px;border:1px solid transparent;font-size:13px;font-weight:850;text-align:center;transition:transform .2s,background .2s}.btn:hover{transform:translateY(-2px)}.btn.lime{background:var(--lime);color:var(--deep)}.btn.dark{background:var(--forest);color:white}.btn.border{background:white;color:var(--forest);border-color:#bdcfc4}.btn.outline-light{border:1px solid #98bbae;color:white}.btn.big{padding:17px 24px}.btn.full{width:100%}.menu{display:none;background:transparent;border:0;font-size:25px;color:var(--forest)}.page{display:none;min-height:65vh}.page.active{display:block}.hero{background:radial-gradient(circle at 72% 30%,#235d48 0,transparent 36%),linear-gradient(145deg,#104334,#092e27 75%);color:white;overflow:hidden}.hero-layout{display:grid;grid-template-columns:1.06fr .94fr;min-height:650px;align-items:center;gap:35px}.overline{font-size:10px;letter-spacing:.19em;font-weight:900;color:#388061;text-transform:uppercase;margin:0 0 22px}.overline.light{color:#cbebba}.hero h1{font-size:clamp(55px,6.5vw,99px);line-height:1.03;font-weight:800;letter-spacing:-.07em;margin:0 0 27px}.hero h1 em,.page-hero h1 em,.join h2 em,.tribute-preview h2 em{font-style:normal;color:var(--lime)}.hero-lead{max-width:585px;color:#d3e5dc;font-size:17px;line-height:1.85}.actions{display:flex;flex-wrap:wrap;gap:16px;align-items:center;margin-top:28px}.simple-link{font-size:13px;font-weight:800;color:#e2f0e8}.hero-caption{margin-top:75px;color:#a8cfbb;letter-spacing:.14em;font-weight:800;font-size:10px}.hero-graphic{min-height:560px;position:relative;display:grid;place-items:center}.orb{width:490px;height:490px;border:1px solid #a8d