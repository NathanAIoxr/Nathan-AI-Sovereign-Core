<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Greek Mythology — TABOR Sovereign Atlas</title><meta name="theme-color" content="#111a2b"><style>:root{color-scheme:dark;font-family:system-ui,-apple-system,sans-serif;color:#f6f3e8;background:#0a1422}*{box-sizing:border-box}body{margin:0;background:radial-gradient(ellipse at top,#37435b,#101b2d 45%,#081421 92%)}main{max-width:1140px;margin:auto;padding:20px}.header{border:1px solid #ad8c5c;border-radius:21px;padding:clamp(19px,5vw,38px);background:linear-gradient(135deg,#26334c,#122234)}h1{font-family:Georgia,serif;font-size:clamp(2.3rem,6vw,4.6rem);line-height:1.05;margin:10px 0;color:#f9dea7}.eyebrow{color:#f6ce88;font-size:.78rem;letter-spacing:.14em;font-weight:800;text-transform:uppercase}p{color:#c5d2dd;line-height:1.55}a{color:#f9d9a0}.links{display:flex;flex-wrap:wrap;gap:9px}.links a,button{background:#254158;border:1px solid #8298ad;padding:10px 13px;color:#f9e1aa;border-radius:9px;text-decoration:none;font:inherit;cursor:pointer}.panel{background:#1a2e43;border:1px solid #566f86;border-radius:15px;padding:18px;margin:16px 0}.features{display:grid;grid-template-columns:repeat(auto-fit,minmax(190px,1fr));gap:12px}.stat{border:1px solid #627990;background:#24384f;padding:14px;border-radius:12px}.stat strong{display:block;font-size:2rem;color:#f4d398}.inputs{display:grid;grid-template-columns:repeat(auto-fit,minmax(180px,1fr));gap:10px}input,select{font:inherit;background:#101f32;color:white;border:1px solid #879fb1;border-radius:9px;padding:12px;width:100%}input:focus-visible,select:focus-visible,button:focus-visible{outline:3px solid #f6d594}.grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(260px,1fr));gap:12px}.card{background:#23374b;border:1px solid #5b748d;border-radius:14px;padding:16px}.card h3{font-family:Georgia,serif;font-size:1.35rem;color:#ffe3af;margin:7px 0}.card p{font-size:.93rem;margin:7px 0}.id{font:700 .77rem ui-monospace,monospace;color:#b7c9d8}.pill{font-size:.75rem;border:1px solid #a38c68;border-radius:20px;padding:4px 7px;display:inline-block;color:#f4d79f}.details{margin-top:11px;padding-top:12px;border-top:1px solid #4e6780;font-size:.84rem;color:#cad5de}.views{display:flex;gap:9px;flex-wrap:wrap}#selected{white-space:pre-wrap;word-wrap:break-word;font-size:.85rem}.disc{border-left:4px solid #eac98e;padding:9px 15px;background:#343445;border-radius:6px}.hidden{display:none}@media(max-width:520px){.panel{padding:12px}}</style></head><body><main>
<nav class="links"><a href="../../index.html">← TABOR Factory</a><a href="../../universal-node/index.html">Universal Node</a><a href="../../sovereign-boxes/index.html">Sovereign Boxes</a></nav>
<header class="header"><div class="eyebrow">TABOR WORLD × INFINITUM · Source-aware atlas</div><h1>THE GREEK<br>MYTHOLOGY ARCHIVE</h1><p>Gods · Titans · Primordials · Underworld · Spirits · Heroes · Monsters · Instruments · Divine Machines</p><p>An inspectable library built from source-supplied material. Ancient mythologies are represented as traditions and narratives, not as verified supernatural physics.</p><div class="features"><div class="stat"><strong id="total">—</strong>Individual reference entries</div><div class="stat"><strong id="categories">—</strong>Independent categories</div><div class="stat"><strong id="ensembles">—</strong>Divine ensembles</div></div></header>
<section class="panel"><h2>Search the archive</h2><p>Search names, powers, instruments, creatures, and roles. Click a record to inspect its ID, category and evidence status.</p><div class="inputs"><input id="search" type="search" aria-label="Search ancient mythological records" placeholder="Athena, light, lyre, monsters…"><select id="category" aria-label="Mythology category"><option value="">Every category</option></select><select id="kind" aria-label="Record type"><option value="">Every record type</option></select></div><p id="count" role="status" aria-live="polite">Loading references…</p><div id="cards" class="grid"></div><p><button id="more" type="button" hidden>Show 40 more records</button></p></section>
<section class="panel"><h2>Divine ensembles — no forced mergers</h2><p>The same name may represent different roles or versions. This is preserved as context, not silently collapsed into one identity.</p><div id="ensembleCards" class="grid"></div></section>
<section class="panel"><h2>Selected record</h2><div id="selected" role="status">Select any card to inspect source-derived attributes.</div><p class="disc">Research status: reference transcription, not primary-source verification. Similarities are not proof of shared origins. Game abilities are future adaptations, not factual powers.</p></section></main>
<script>
'use strict';const $=id=>document.getElementById(id);let atlas=null,list=[],limit=40;
function node(tag,text,cls){const e=document.createElement(tag);if(text!==undefined)e.textContent=text;if(cls)e.className=cls;return e}
function inspect(r){$('selected').textContent=JSON.stringify({id:r.id,name:r.originalName,category:r.group,attributes:r.description,associatedSymbols:r.associations,kind:r.recordType,provenance:r.sourceStatus,evidence:r.evidenceLevel,interpretation:r.interpretation},null,2);$('selected').scrollIntoView({behavior:'smooth',block:'nearest'})}
function render(){if(!atlas)return;const q=$('search').value.trim().toLowerCase(),c=$('category').value,k=$('kind').value;list=atlas.records.filter(x=>(!c||x.group===c)&&(!k||x.recordType===k)&&(!q||[x.originalName,x.description,x.associations.join(' ')].join(' ').toLowerCase().includes(q)));limit=40;page()}
function page(){const box=$('cards');box.replaceChildren();for(const r of list.slice(0,limit)){const c=node('article',undefined,'card');c.append(node('span',r.id,'id'),node('h3',r.originalName),node('span',r.group.replaceAll('-',' '),'pill'),node('p',r.description));if(r.associations.length)c.append(node('p','Symbols / associations: '+r.associations.join(', ')));const b=node('button','Inspect sovereign record');b.type='button';b.addEventListener('click',()=>inspect(r));c.append(b);box.append(c)}$('count').textContent=list.length+' matching records · '+Math.min(limit,list.length)+' displayed';$('more').hidden=list.length<=limit}
fetch('./atlas.json',{cache:'no-store'}).then(r=>{if(!r.ok)throw Error('Dataset missing');return r.json()}).then(x=>{if(x.schema!=='tabor.mythology.archive.v1')throw Error('Unknown schema');atlas=x;$('total').textContent=x.records.length;$('categories').textContent=x.categories.length;$('ensembles').textContent=x.ensembleRules.length;for(const c of x.categories){const o=node('option',c.title);o.value=c.id;$('category').append(o)}for(const k of [...new Set(x.records.map(r=>r.recordType))].sort()){const o=node('option',k.replaceAll('-',' '));o.value=k;$('kind').append(o)}for(const a of x.ensembleRules){const c=node('article',undefined,'card');c.append(node('h3',a.label),node('p','Members: '+a.members.join(' · ')));if(a.alternatives)c.append(node('p','Alternate members: '+a.alternatives.join(' / ')));if(a.excluded)c.append(node('p','Normally excluded: '+a.excluded.join(', ')));if(a.note)c.append(node('div',a.note,'details'));$('ensembleCards').append(c)}for(const id of ['search','category','kind'])$(id).addEventListener(id==='search'?'input':'change',render);render()}).catch(e=>{$('count').textContent='Could not open Greek archive: '+e.message});
$('more').addEventListener('click',()=>{limit+=40;page()});
</script>
