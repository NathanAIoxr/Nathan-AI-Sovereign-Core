'use strict';const test=require('node:test'),assert=require('node:assert/strict'),s=require('./status.js');test('boot is honest when nothing connected',()=>{const x=s.status();assert.equal(x.syncedToPhone,false);assert.equal(x.fullyBackedUp,false);assert.equal(x.items,null);assert.equal(x.photos,null);assert.equal(x.mirrors.deployedProxies,null);assert.equal(x.mirrors.logicalAddresses,5000000);assert.equal(x.axioms.build,true);assert.equal(x.axioms.protect,true)});test('only verified gates permit synced/backup claim',()=>{assert.equal(s.status({cloudAuthenticated:true}).syncedToPhone,false);assert.equal(s.status({cloudAuthenticated:true,cloudUploadAcknowledged:true}).syncedToPhone,true);assert.equal(s.status({cloudAuthenticated:true,cloudUploadAcknowledged:true}).fullyBackedUp,false);assert.equal(s.status({cloudAuthenticated:true,cloudUploadAcknowledged:true,backupRestoreVerified:true}).fullyBackedUp,true)});test('never report fake counts',()=>{assert.equal(s.status({itemCount:'24831',photoCount:-1}).items,null);assert.equal(s.status({itemCount:0,photoCount:4}).photos,4)});