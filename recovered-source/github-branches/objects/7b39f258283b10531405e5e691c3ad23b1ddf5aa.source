(function(){
'use strict';
const E=window.NathanChatbox,P=window.NathanHopIn,A=window.NathanAssistant,W=window.NathanWorkspace;
const $=id=>document.getElementById(id);
const SESSION_KEY=E.SCHEMA,DRAFT_KEY=SESSION_KEY+'.draft',DRAFT_OPT=SESSION_KEY+'.rememberDraft';
const st={mode:'core',figureIds:E.FIGURES.map(x=>x.id),mind:'',turns:[],featureRows:[],rootRows:[],activeLetter:'',featureQuery:'',shown:12,publicRows:[],sourcesLoading:false,selected:[],previewQuestion:null,previewFingerprint:'',reviewed:false,adapter:false,controller:null,baseline:null,storageHealthy:true,rememberDraft:false};
function n(tag,txt,cls){const el=document.createElement(tag);if(txt!==undefined)el.textContent=String(txt);if(cls)el.className=cls;return el}
function status(text){$('chat-status').textContent=text}
function remove(el){el.replaceChildren()}
function appendAssistant(response){const row={role:'assistant',text:response.answer||'',kind:response.kind||'guide',links:response.links||[]};addTurn(row);return row}
function keepBottom(el){return el.scrollHeight-el.scrollTop-el.clientHeight<140}
function renderTurn(turn){const holder=n('article',undefined,'turn '+turn.role);const avatar=n('div',turn.role==='assistant'?'N':'YOU','avatar');avatar.setAttribute('aria-hidden','true');const bubble=n('div',undefined,'bubble');const t=n('p',turn.role==='assistant'?'NATHAN AI · '+(turn.kind==='model'?'LOCAL MODEL DRAFT':turn.kind==='source-retrieval'?'SOURCE RETRIEVAL':'LOCAL GUIDE'):'YOU','turn-label');const answer=n('p',turn.text,'answer');bubble.append(t,answer);if(turn.links?.length){const related=n('div',undefined,'related');for(const l of turn.links){if(!l||!l.url||!l.label)continue;const a=n('a',l.label);a.href=l.url;if(l.url.startsWith('https://')){a.target='_blank';a.rel='noopener noreferrer'}related.append(a)}bubble.append(related)}holder.append(avatar,bubble);return holder}
function addTurn(turn){E.noCredentials(turn.text);if(st.turns.length>=E.MAX_TURNS)throw Error('Conversation limit reached. Export or clear the conversation before continuing.');st.turns.push(turn);const log=$('chat-history'),stick=keepBottom(log);if($('welcome'))$('welcome').hidden=true;log.append(renderTurn(turn));if(stick)log.scrollTop=log.scrollHeight;$('session-indicator').textContent='In memory · not saved automatically';window.dispatchEvent(new Event('nathan:turns'))}
function renderLog(){remove($('chat-history'));if(!st.turns.length){const h=n('div',undefined,'welcome');h.id='welcome';h.append(n('p','START WITH A QUESTION','eyebrow'),n('h2','HOP IN.'),n('p','Ask a question, use /help, or open a tool. Choose UNBOXED to explore the original source library.'));const prompts=n('div',undefined,'suggestions');for(const [title,q] of [['Find the original archives','How do I explore the UNBOXED original source index?'],['Paradoxes and enigmas','/paradoxes'],['Group Assembly','/group What is the evidence for protecting innocence?'],['Go to 1611','Explore the 1611 historical timeline']]){const b=n('button',title);b.type='button';b.addEventListener('click',()=>sendPrewritten(q));prompts.append(b)}h.append(prompts);$('chat-history').append(h);return}for(const turn of st.turns)$('chat-history').append(renderTurn(turn));$('chat-history').scrollTop=$('chat-history').scrollHeight;}
function useMode(mode){if(!E.MODE_LABELS[mode])return;st.mode=mode;for(const b of document.querySelectorAll('[data-mode]'))b.setAttribute('aria-pressed',String(b.dataset.mode===mode));$('mode-indicator').textContent=E.MODE_LABELS[mode];$('mode-description').textContent=E.TIPS[mode];status('Mode selected. Source text is not rewritten or erased.');window.dispatchEvent(new Event('nathan:mode'));}
function useTool(tool){for(const b of document.querySelectorAll('[data-tool]')){const yes=b.dataset.tool===tool;b.setAttribute('aria-pressed',String(yes));document.querySelector('[data-panel="'+b.dataset.tool+'"]').hidden=!yes}}
function setMessage(text){$('message').value=text;rememberDraft();if($('message-count'))$('message-count').textContent=String($('message').value.length);$('message').focus()}
function rememberDraft(){if(!st.rememberDraft)return;try{localStorage.setItem(DRAFT_KEY,$('message').value.slice(0,4000))}catch(_){status('Could not save draft; browser storage unavailable.')}}
function resetPreview(){st.selected=[];st.previewQuestion=null;st.reviewed=false;st.previewFingerprint='';$('review-panel').hidden=true;remove($('source-results'))}
function addUser(question){addTurn({role:'user',text:question,kind:'user',links:[]})}
function publicMatches(question){if(!st.publicRows.length)return[];return A.retrieve(question,st.publicRows,5)}
function sourceText(items){return items.map((v,i)=>(i+1)+'. '+v.title+' ['+v.id+'] · '+v.stage+'\n'+v.excerpt).join('\n\n')}
function sendLocal(question){const q=String(question||'').trim();if(!q)return;if(st.controller){status('A model request is active. Cancel it before sending another message.');return}try{if(st.turns.length>E.MAX_TURNS-2)throw Error('Conversation is full. Export it and start a new chat.');
 E.noCredentials(q);const response=E.reply(q,{mode:st.mode,mind:st.mind,figureIds:st.figureIds});addUser(q);
 const matches=publicMatches(q);if(matches.length&&response.kind!=='reset-request'){
   appendAssistant({kind:'source-retrieval',answer:response.answer+'\n\nMATCHING PUBLIC SOURCE PASSAGES (source retrieval, not a synthesized factual conclusion):\n\n'+sourceText(matches),links:[...(response.links||[]),E.LINKS.assistant]});
 }else appendAssistant(response);
 $('message').value='';if($('message-count'))$('message-count').textContent='0';rememberDraft();resetPreview();status(st.publicRows.length?'Source-aware local response shown. No model request made.':'Local navigation response shown. No model request made.');
 }catch(e){status(e.message)}}
function sendPrewritten(question){setMessage(question);sendLocal(question)}
function card(parent,item){const el=n('article',undefined,'catalog-card');el.append(n('b',item.title));const stage=n('span',' · '+(item.stage||'concept'),'muted');el.append(stage);el.append(n('p',item.sourceDescription));const b=n('button','Ask about this');b.type='button';b.addEventListener('click',()=>{setMessage('Tell me about “'+item.title+'” and which Nathan AI tools can help with it. Keep its stage and limitations explicit.');$('message').scrollIntoView({block:'nearest'});});el.append(b);parent.append(el)}
function refreshCatalog(){const type=$('catalog-kind').value;const rows=type==='settings'?st.rootRows:st.featureRows;const q=$('feature-search').value;let matches=type==='settings'?rows.filter(x=>{const t=E.words((x.title||'')+' '+(x.sourceDescription||'')),qt=E.words(q);return qt.every(w=>t.includes(w))}):E.catalogSearch(rows,q,st.activeLetter,104);remove($('catalog-results'));for(const x of matches.slice(0,st.shown))card($('catalog-results'),x);$('catalog-count').textContent=matches.length+' match'+(matches.length===1?'':'es')+' · '+Math.min(st.shown,matches.length)+' shown';$('catalog-more').hidden=matches.length<=st.shown;$('letters').hidden=type==='settings';}
function initLetters(){const all=n('button','All');all.type='button';all.setAttribute('aria-pressed','true');all.addEventListener('click',()=>chooseLetter(''));$('letters').append(all);for(const letter of 'ABCDEFGHIJKLMNOPQRSTUVWXYZ'){const b=n('button',letter);b.type='button';b.dataset.letter=letter;b.setAttribute('aria-pressed','false');b.addEventListener('click',()=>chooseLetter(letter));$('letters').append(b)}}
function chooseLetter(letter){st.activeLetter=letter;st.shown=12;for(const b of $('letters').querySelectorAll('button'))b.setAttribute('aria-pressed',String((b.dataset.letter||'')===letter));refreshCatalog()}
async function initCatalogs(){try{const r=await Promise.all([fetch('features.json',{cache:'no-store'}),fetch('settings.json',{cache:'no-store'})]);if(r.some(x=>!x.ok))throw Error('Catalog resources unavailable');const a=await r[0].json(),b=await r[1].json();st.featureRows=E.validateCatalog(a,'consumer-feature-catalog.v1');st.rootRows=E.validateCatalog(b,'root-settings-excerpt.v1');$('catalog-info').textContent=st.featureRows.length+' supplied A–Z consumer concepts; '+st.rootRows.length+' named root settings. All are specifications or concept descriptions until individually verified as implemented. Catalog title counts in the source differ.';refreshCatalog();}catch(e){$('catalog-info').textContent='Unable to load the packaged directories. Use a local web server (not file://): '+e.message;}}
function initHistory(){for(let i=0;i<P.HISTORY.length;i++){const h=P.HISTORY[i],op=n('option',h.label);op.value=i;$('history-anchor').append(op)}$('history-anchor').value='2';const update=()=>{$('year-text').textContent=P.chronology(Number($('year-slider').value));$('zoom-text').textContent=P.perspectiveLabel($('zoom-slider').value)};$('year-slider').addEventListener('input',update);$('zoom-slider').addEventListener('input',update);$('history-anchor').addEventListener('change',()=>{$('year-slider').value=P.HISTORY[Number($('history-anchor').value)].year;update()});update();}
function initAssembly(){for(const figure of E.FIGURES){const label=n('label');const check=document.createElement('input');check.type='checkbox';check.value=figure.id;check.checked=true;check.addEventListener('change',()=>{st.figureIds=[...$('people-select').querySelectorAll('input:checked')].map(x=>x.value)});label.append(check,n('span',figure.name));$('people-select').append(label)}}
function updateSourceStatus(){const x=st.publicRows.length;$('source-indicator').textContent=x?x.toLocaleString()+' catalog records loaded':'No sources loaded';$('coverage').textContent=x?x.toLocaleString()+' public entries loaded in this tab. Original documents and citations must still be checked.':'Not loaded. Loading is explicit.'}
async function loadPublicSources(){if(st.sourcesLoading)return;st.sourcesLoading=true;$('load-sources').disabled=true;$('coverage').textContent='Loading available public catalogs on this site…';try{if(!W?.load||!A?.source)throw Error('Existing source engine is unavailable.');const root=new URL('../../',location.href);const loaded=await W.load(url=>fetch(new URL(url,root)));st.publicRows=loaded.rows.map(A.source);const failed=loaded.coverage.filter(x=>x.error).length;updateSourceStatus();$('coverage').textContent+=` ${failed} of ${loaded.coverage.length} catalogs unavailable.`;resetPreview();}catch(e){$('coverage').textContent='Catalog loading failed: '+e.message}finally{st.sourcesLoading=false;$('load-sources').disabled=false}}
function preview(){const q=$('message').value.trim();if(!q){status('Write a question in the chatbox before finding sources.');return[]};try{E.noCredentials(q);const selections=publicMatches(q);st.selected=selections;st.previewQuestion=q;st.previewFingerprint=JSON.stringify(selections.map(s=>s.id));st.reviewed=false;$('review-panel').hidden=false;remove($('source-results'));if(!selections.length){$('source-results').append(n('p','No matching public source passages. Try a specific title or phrase or click Load public catalogs.'));status('No source passages selected.')}else{for(const s of selections){const d=n('details',undefined,'source-hit');d.append(n('summary',s.title+' · '+s.stage));d.append(n('p',s.excerpt));d.append(n('small','Source ID: '+s.id));$('source-results').append(d)}status('Review all '+selections.length+' excerpts. Model draft requires a separate click to confirm the selected context.')}return selections;}catch(e){status(e.message);return[]}}
async function adapterStatus(){try{const resp=await fetch('/api/nathan/status',{cache:'no-store'});if(!resp.ok)throw Error('Not running');const body=await resp.json();st.adapter=body.modelConfigured===true;$('adapter-status').textContent=st.adapter?'Local adapter configured. Provider access is only confirmed by a successful draft. Only reviewed question + source excerpts will be sent.':'Local adapter running but provider is not configured.'}catch(_){st.adapter=false;$('adapter-status').textContent='No local model adapter running. Offline guide and source retrieval work without one.'}$('model-draft').disabled=!st.adapter;$('capability-tag').textContent=st.adapter?'Local model configured':'Offline guide';}
async function modelDraft(){if(st.controller){st.controller.abort();return}if(!st.adapter){status('No configured local adapter. Open the existing Assistant for setup instructions.');return}const q=$('message').value.trim();if(!q){status('Enter a question before requesting a model draft.');return}
 try{E.noCredentials(q);if(st.previewQuestion!==q||!st.selected.length){preview();return}if(!st.reviewed){st.reviewed=true;status('Review the exact passages above. Click Model draft again to send only this question and up to five excerpts.');return}if(JSON.stringify(st.selected.map(s=>s.id))!==st.previewFingerprint){resetPreview();throw Error('Source selection changed. Review again.');}
 const chosen=A.packet(q,st.selected);const history=$('share-history').checked?st.turns.slice(-8).map(x=>({role:x.role,text:x.text.slice(0,1000)})):[];const packet={operation:'source-chat',question:chosen.question,sources:chosen.sources,history,lens:st.mode};st.controller=new AbortController();$('send').disabled=true;$('model-draft').textContent='Cancel draft';status('Requesting a source-grounded chat reply. '+history.length+' earlier turns explicitly included.');const resp=await fetch('/api/nathan/chat',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(packet),signal:st.controller.signal});const result=await resp.json();if(!resp.ok)throw Error(result.error||'Model draft failed');if(result.mode!=='model'||typeof result.answer!=='string'||!Array.isArray(result.citations)||result.citations.some(x=>!st.selected.some(s=>s.id===x)))throw Error('Invalid or unsupported response citations');E.noCredentials(result.answer);
 if(st.turns.length>E.MAX_TURNS-2)throw Error('Conversation is full. Export it and start a new chat.');addUser(q);const used=st.selected.filter(s=>result.citations.includes(s.id));appendAssistant({kind:'model',answer:result.answer+'\n\nCITED EXCERPTS:\n'+(used.length?used.map(s=>s.title+' ['+s.id+']').join('\n'):'No citations were supplied; check all claims independently.'),links:[E.LINKS.assistant]});$('message').value='';if($('message-count'))$('message-count').textContent='0';rememberDraft();status('Model draft received; citations are displayed. This does not establish factual correctness.');resetPreview();
 }catch(e){status(e.name==='AbortError'?'Cancelled waiting locally. Provider may have received a submitted request.':e.message)}finally{st.controller=null;$('send').disabled=false;$('model-draft').textContent='Model draft';}}
function cleanState(){if(!confirm('Clear this chat and any saved copy on this browser? Export first if you need it.'))return;try{if(!st.storageHealthy||localStorage.getItem(SESSION_KEY)!==st.baseline)throw Error('Saved conversation changed in another tab; export a backup before clearing.');localStorage.removeItem(SESSION_KEY);st.baseline=null;st.turns=[];$('message').value='';localStorage.removeItem(DRAFT_KEY);resetPreview();renderLog();$('save-status').textContent='Conversation and saved draft cleared. Current profile fields remain in the tab until refreshed.';window.dispatchEvent(new Event('nathan:clear'));status('Zero-state clear: in-browser chat cleared. This does not delete server logs or anything shared with a provider.')}catch(e){$('save-status').textContent=e.message}}
function saveSession(){try{if(!st.storageHealthy||localStorage.getItem(SESSION_KEY)!==st.baseline)throw Error('Saved data changed or could not be read. Export this chat before replacing browser storage.');const obj=E.validateSession({schema:E.SCHEMA,turns:st.turns});const json=JSON.stringify(obj);if(json.length>900000)throw Error('Chat too large to save; export and clear first.');localStorage.setItem(SESSION_KEY,json);st.baseline=json;window.dispatchEvent(new Event('nathan:save-all'));$('session-indicator').textContent='Saved on this device';$('save-status').textContent='Saved to this browser profile. Not encrypted, not synchronized.';}catch(e){$('save-status').textContent='Not saved: '+e.message}}
function exportChat(){try{const obj=E.validateSession({schema:E.SCHEMA,turns:st.turns});const a=n('a');const u=URL.createObjectURL(new Blob([JSON.stringify(obj,null,2)],{type:'application/json'}));a.href=u;a.download='nathan-ai-hop-in-chat.json';document.body.append(a);a.click();a.remove();setTimeout(()=>URL.revokeObjectURL(u),1600);$('save-status').textContent='Export created with text turns only; no credentials or personal mind fields.';}catch(e){$('save-status').textContent=e.message}}
async function importChat(event){const file=event.target.files?.[0];event.target.value='';if(!file)return;try{if(file.size>1000000)throw Error('Import exceeds the 1MB limit.');const obj=E.validateSession(JSON.parse(await file.text()));if(confirm('Restore '+obj.turns.length+' turns to this tab? Saved storage will not be overwritten until you choose Save.')){st.turns=obj.turns;renderLog();window.dispatchEvent(new Event('nathan:turns'));$('save-status').textContent='Restored in memory only. Choose Save to persist.'}}catch(e){$('save-status').textContent='Import rejected: '+e.message}}
function initStorage(){try{st.baseline=localStorage.getItem(SESSION_KEY);if(st.baseline){const data=E.validateSession(JSON.parse(st.baseline));st.turns=data.turns;renderLog();$('session-indicator').textContent='Saved browser conversation loaded'}st.rememberDraft=localStorage.getItem(DRAFT_OPT)==='yes';$('remember-draft').checked=st.rememberDraft;if(st.rememberDraft)$('message').value=localStorage.getItem(DRAFT_KEY)||'';}catch(e){st.storageHealthy=false;st.baseline=null;$('save-status').textContent='Saved data could not be validated; not overwritten. '+e.message;}}
function initEvents(){document.querySelectorAll('[data-mode]').forEach(b=>b.addEventListener('click',()=>useMode(b.dataset.mode)));document.querySelectorAll('[data-tool]').forEach(b=>b.addEventListener('click',()=>useTool(b.dataset.tool)));document.querySelectorAll('[data-prompt]').forEach(b=>b.addEventListener('click',()=>sendPrewritten(b.dataset.prompt)));
 $('chat-form').addEventListener('submit',e=>{e.preventDefault();sendLocal($('message').value)});$('message').addEventListener('input',()=>{resetPreview();rememberDraft()});$('message').addEventListener('keydown',e=>{if(e.key==='Enter'&&!e.shiftKey&&!e.isComposing){e.preventDefault();sendLocal($('message').value)}});
 $('new-chat').addEventListener('click',()=>{if(window.NathanStudioActive){window.dispatchEvent(new Event('nathan:new-request'));return;}if(!confirm('Start a new in-memory chat? Export or save your current chat first.'))return;st.turns=[];renderLog();status('New chat started. Existing saved browser data was not altered.');window.dispatchEvent(new Event('nathan:new'));});$('feature-search').addEventListener('input',()=>{st.shown=12;refreshCatalog()});$('catalog-kind').addEventListener('change',()=>{st.shown=12;refreshCatalog()});$('catalog-more').addEventListener('click',()=>{st.shown+=16;refreshCatalog()});
 $('time-explore').addEventListener('click',()=>{const h=P.HISTORY[Number($('history-anchor').value)];const q='Explore '+h.label+' in '+h.place+' around '+P.chronology($('year-slider').value)+' at the scale '+P.perspectiveLabel($('zoom-slider').value);const x=h.note+'\n\nImaginative reconstruction only. Ask what sources actually establish, and mark missing details. No live observation or historical sensory retrieval.';addUser(q);appendAssistant({kind:'research',answer:x,links:[E.LINKS.maps,E.LINKS.wikis,E.LINKS.assistant]});status('Historical source prompt generated.');});
 $('explore-me').addEventListener('click',()=>{const name=$('your-name').value.trim(),date=$('your-date').value,goal=$('your-goal').value.trim();if(!name&&!date&&!goal){status('All personal prompts are optional. Enter something or choose another tool.');return}const lines=[];if(name)lines.push('NAME TRANSFORMATIONS · not etymology or ancestry\n'+P.nameVariants(name).map(x=>x.label+': '+x.text).join('\n'));if(date){const cal=P.calendarViews(date);lines.push('BROWSER-SUPPORTED CALENDARS\n'+cal.filter(x=>x.available).map(x=>x.label+': '+x.display).join('\n'));lines.push('TABOR ALMANAC DRAFT CYCLES\n'+P.experimentalCycles(date).map(x=>x.name+': illustrative cycle month '+x.cycleMonth).join('\n')+'\nThese are not verified Almanac conversion rules.')}if(goal)lines.push('YOUR PURPOSE\n'+goal);appendAssistant({kind:'personal-workspace',answer:lines.join('\n\n')+'\n\nYour details were used locally in this tab; they were not sent to a model.',links:[E.LINKS.calendar,E.LINKS.family]});status('Local transformations complete. No upload made.');});
 $('apply-mind').addEventListener('click',()=>{const name=$('mind-persona').value.trim(),values=$('mind-values').value.trim();try{E.noCredentials(name+values);st.mind=(name?name+': ':'')+(values||'Innocence, truth, care for the vulnerable.');useMode('custom');status('Your creative mind lens is active for this tab only. It does not override safeguards or establish spiritual facts.')}catch(e){status(e.message)}});
 $('group-ask').addEventListener('click',()=>{const q=$('group-topic').value.trim()||'protecting innocence';addUser('Group Assembly: '+q);appendAssistant(E.assembly(q,st.figureIds));useMode('assembly')});
 $('load-sources').addEventListener('click',loadPublicSources);$('preview-sources').addEventListener('click',preview);$('model-status-check').addEventListener('click',adapterStatus);$('model-draft').addEventListener('click',modelDraft);$('share-history').addEventListener('change',()=>{resetPreview();status('History-sharing choice changed. Review source excerpts again before sending any model request.');});
 $('save-chat').addEventListener('click',saveSession);$('export-chat').addEventListener('click',exportChat);$('import-chat').addEventListener('change',importChat);$('clear-chat').addEventListener('click',cleanState);
 $('remember-draft').addEventListener('change',e=>{st.rememberDraft=e.target.checked;try{localStorage.setItem(DRAFT_OPT,st.rememberDraft?'yes':'no');if(st.rememberDraft)rememberDraft();else localStorage.removeItem(DRAFT_KEY);$('save-status').textContent=st.rememberDraft?'Drafts will be saved to unencrypted browser storage.':'Draft retention disabled; the saved draft has been cleared.'}catch(_){$('save-status').textContent='Browser storage unavailable.'}});
 $('read-aloud').addEventListener('click',()=>{const last=st.turns.filter(x=>x.role==='assistant').at(-1);if(!last){status('No response to read aloud.');return}if(!('speechSynthesis' in window)){status('Speech output is not available in this browser.');return}speechSynthesis.cancel();const utter=new SpeechSynthesisUtterance(last.text.slice(0,4000));utter.rate=1;utter.lang=document.documentElement.lang||'en';speechSynthesis.speak(utter);status('Reading with a browser-generated voice; not a recording or clone of Nathan Tabor.');});$('stop-speaking').addEventListener('click',()=>window.speechSynthesis?.cancel());
 $('mic').addEventListener('click',()=>{const SR=window.SpeechRecognition||window.webkitSpeechRecognition;if(!SR){status('Speech recognition is not supported by this browser. Text entry still works.');return}if(!confirm('The browser may send microphone audio to its speech-recognition provider. Continue?'))return;const sr=new SR();sr.lang=navigator.language||'en-US';sr.continuous=false;sr.interimResults=false;sr.onresult=e=>{const text=e.results[0][0].transcript;$('message').value=($('message').value+' '+text).trim().slice(0,4000);rememberDraft();status('Speech added to draft; press Send to submit it. Nothing submitted automatically.')};sr.onerror=()=>status('Speech input failed or was denied. Text input is still available.');try{sr.start();status('Listening with browser speech recognition after your permission.')}catch(e){status('Unable to begin speech recognition: '+e.message)}});
}
initLetters();initHistory();initAssembly();initStorage();initEvents();initCatalogs();adapterStatus();window.NathanStudioBridge={getTurns:()=>st.turns.slice(),setTurns:(turns)=>{if(st.controller){st.controller.abort();st.controller=null;$('model-draft').textContent='Model draft';status('Previous model request cancelled locally; a provider might already have received it.')}st.turns=E.validateSession({schema:E.SCHEMA,turns}).turns;renderLog();resetPreview();},getMode:()=>st.mode,setMode:(mode)=>useMode(mode),getDraft:()=>$('message').value,setDraft:(txt)=>setMessage(String(txt).slice(0,4000)),getLegacyBaseline:()=>st.baseline,getLegacyStatus:()=>st.storageHealthy,resetPreview:()=>resetPreview(),setStatus:status};$('message').focus();
})();