:root{color-scheme:dark;font:16px/1.65 system-ui,sans-serif;background:#101720;color:#f4f1e8}*{box-sizing:border-box}body{margin:0}main{max-width:1220px;margin:auto;padding:24px}a{color:inherit;text-decoration:none}a:focus-visible,input:focus-visible{outline:3px solid #edcf92;outline-offset:5px}header,nav,.actions{display:flex;align-items:center;gap:24px;flex-wrap:wrap}header{justify-content:space-between;padding:10px 0 30px;border-bottom:1px solid #3d505d}.brand{font-weight:850;letter-spacing:.1em}.brand span{display:block;font-size:11px;color:#e2c18a}nav a{color:#c3cdd4}.hero{padding:75px 0 60px;background:radial-gradient(ellipse at 90% 40%,#29404b70,transparent 60%)}.eyebrow{color:#edcf92;letter-spacing:.17em;font-size:.75rem;font-weight:700}h1{font-size:clamp(2.8rem,7vw,5.8rem);line-height:1.06;letter-spacing:-.055em;margin:20px 0}h2{font-size:clamp(1.9rem,4vw,2.7rem);letter-spacing:-.035em;margin:10px 0}h3{font-size:1.25rem;line-height:1.3;margin:12px 0}p{color:#bac8d2}.intro{font-size:1.25rem}.actions{gap:12px;margin:30px 0}.primary,.button{padding:13px 20px;border-radius:8px;border:1px solid #586b77;font-weight:650}.primary{background:#e6cea0;color:#15232e;border-color:#e6cea0}.motto{font-size:.7rem;letter-spacing:.12em}section{scroll-margin-top:20px}#library,#apps{border-top:1px solid #3d505d;padding:36px 0}.grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:16px;margin:24px 0}.card{display:block;padding:25px;background:#1b2934;border:1px solid #3e5361;border-radius:12px;overflow-wrap:anywhere;transition:border-color .15s}.card:hover{border-color:#edcf92}.card span{font-size:.7rem;letter-spacing:.13em;color:#edcf92}.card p{font-size:.95rem;margin-bottom:0}.source-links{padding:24px;border-left:3px solid #e6cea0;background:#192630}.source-links a{display:inline-block;text-decoration:underline;color:#edcf92;margin:4px 20px 4px 0}.source-links p,footer{font-size:.85rem}label{display:block;margin-top:25px}input{font:inherit;color:inherit;background:#1b2934;border:1px solid #617786;border-radius:8px;padding:13px;width:100%;margin-top:8px}footer{border-top:1px solid #3d505d;padding:30px 0}footer a{color:#edcf92;text-decoration:underline}@media(max-width:600px){main{padding:18px}.hero{padding:40px 0}nav{gap:15px}.actions>a{width:100%}.grid{grid-template-columns:1fr}}
