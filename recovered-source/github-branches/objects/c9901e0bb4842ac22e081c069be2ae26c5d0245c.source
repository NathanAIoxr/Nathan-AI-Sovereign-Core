:root{color-scheme:dark;font:16px system-ui;background:#101822;color:#f1f5f9}body{max-width:1120px;margin:auto;padding:24px}a{color:#93c5fd}nav{display:flex;gap:12px;flex-wrap:wrap}header{border-bottom:1px solid #506174;padding-bottom:20px}.muted{color:#bccbd8}.card{padding:20px;border:1px solid #475569;border-radius:12px;margin:16px 0;background:#192638}input,select{background:#0b1220;color:white;padding:12px;border:1px solid #8794a6;border-radius:7px;max-width:100%}input{width:340px}button{padding:9px;background:#344861;color:white;border:1px solid #94a3b8;border-radius:6px}small{display:block;color:#ccd5df;margin-top:6px}.tag{display:inline-block;padding:4px 9px;border:1px solid #94a3b8;border-radius:15px;font-size:.8em}.map{display:flex;gap:10px;flex-wrap:wrap;align-items:center}.node{padding:13px;border:1px solid #64748b;border-radius:9px}.divider{font-size:22px}article h3{margin:4px 0}#results{min-height:70px}footer{border-top:1px solid #475569;margin-top:35px;padding-top:18px}
