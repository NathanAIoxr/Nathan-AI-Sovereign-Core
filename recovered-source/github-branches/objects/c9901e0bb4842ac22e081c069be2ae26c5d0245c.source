{title:"Recovered: Tabor Secret Society Doctrine / Inversion Codex",type:"Author research",date:"2026-10-25",summary:"Owner-authored institutional inversion labels, including Vatican and Knights of Malta. No primary-document linkage established in current archive.",url:""},
{title:"Recovered: Nathan AI Truth Forge and Sovereign Scroll",type:"Author research",date:"2025-08 to 2025-10",summary:"Owner's prior investigative modules include Spiral Grid, Sovereign Scroll, Truth Forge and Trump Breach Log. Existence of private original code/files not verified here.",url:""},
{title:"AP review of FBI investigative findings",type:"Reporting",date:"2026",summary:"AP reviewed federal records and reported extensive evidence of Epstein's abuse of minors, but limited corroboration for claims of a trafficking ring supplying powerful men.",url:"https://apnews.com/article/049c96080a2ca2c12c84ac506437e50b"}
];
const results=document.getElementById("results"),q=document.getElementById("q"),type=document.getElementById("type");function render(){const term=q.value.toLowerCase(),kind=type.value;const xs=records.filter(x=>(!kind||x.type===kind)&&[x.title,x.summary,x.date].join(" ").toLowerCase().includes(term));results.replaceChildren();for(const r of xs){const a=document.createElement("article");a.className="card";const h=document.createElement("h3");h.textContent=r.title;a.append(h);const badge=document.createElement("span");badge.className="tag";badge.textContent=r.type;a.append(badge);const d=document.createElement("small");d.textContent=r.date;a.append(d);const p=document.createElement("p");p.textContent=r.summary;a.append(p);if(r.url){const link=document.createElement("a");link.href=r.url;link.target="_blank";link.rel="noopener noreferrer";link.textContent="Open source";a.append(link)}results.append(a)}if(!xs.length)results.textContent="No matching records."}q.addEventListener("input",render);type.addEventListener("change",render);render();
</script></html>