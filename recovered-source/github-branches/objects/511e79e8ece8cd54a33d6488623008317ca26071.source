<style>:root{color-scheme:dark;font:16px system-ui,sans-serif;--bg:#0e1720;--panel:#1d2d39;--line:#466274;--accent:#ead7ae;--muted:#c4d3dd}*{box-sizing:border-box}body{margin:0;background:radial-gradient(circle at top left,#24404c,var(--bg) 48%);color:#f5f8fb}main{max-width:1180px;margin:0 auto;padding:20px 14px 65px}h1{font-size:clamp(2rem,5vw,3.6rem);margin:12px 0}h2{font-size:1.3rem}h3{font-size:1rem;margin:.4em 0}p,li{line-height:1.55;color:var(--muted)}a{color:var(--accent)}nav{display:flex;flex-wrap:wrap;gap:15px;margin:4px 0 22px}section{background:var(--panel);border:1px solid var(--line);border-radius:14px;padding:17px;margin:13px 0}.eyebrow{text-transform:uppercase;letter-spacing:.1em;color:var(--accent);font-size:.77rem;font-weight:700}.stats{display:grid;grid-template-columns:repeat(auto-fit,minmax(128px,1fr));gap:8px}.stat{padding:11px;background:#293e4b;border-radius:10px}.stat strong{display:block;font-size:1.6rem;color:var(--accent)}.grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(270px,1fr));gap:10px}.card{background:#253946;border:1px solid #587084;border-radius:11px;padding:13px;overflow-wrap:anywhere}.card small{color:#d6c39a}.status{border-left:3px solid #dec18b;padding:7px 10px;color:#f3e0b9;background:#383b35;font-size:.78rem;word-break:break-word}.controls{display:grid;grid-template-columns:minmax(140px,220px) 1fr auto;align-items:end;gap:10px}label{display:block;color:var(--muted);margin:4px 0;font-size:.86rem}button,select,input{font:inherit;padding:10px;background:#304654;color:white;border:1px solid #7594a9;border-radius:8px;max-width:100%}button{cursor:pointer}button:focus-visible,input:focus-visible,select:focus-visible,a:focus-visible{outline:3px solid #f1dba7;outline-offset:2px}pre{background:#0d202a;padding:12px;max-height:310px;overflow:auto;white-space:pre-wrap;overflow-wrap:anywhere}details{margin:12px 0}summary{cursor:pointer;font-weight:700}footer{color:var(--muted);font-size:.84rem;margin-top:22px}@media(max-width:620px){.controls{grid-template-columns:1fr}.grid{grid-template-columns:1fr}}</style>
