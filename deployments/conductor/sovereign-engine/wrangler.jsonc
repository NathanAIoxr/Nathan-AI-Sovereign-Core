{
  "name": "nathan-ai-sovereign-engine",
  "main": "worker.mjs",
  "compatibility_date": "2026-11-20",
  "workers_dev": true,
  "preview_urls": false,
  "observability": { "enabled": true, "traces": { "enabled": true } },
  "vars": { "DAILY_RECEIPTS_PER_SHARD": "1000" },
  "d1_databases": [
    { "binding": "DB_PRIMARY", "database_name": "nathan-ai-sovereign-engine", "database_id": "d0d366dc-7773-4384-b3f6-d671cb649d36" },
    { "binding": "DB_SHARD_2", "database_name": "nathan-ai-sovereign-engine-shard-2", "database_id": "5870d835-eb05-42dc-b1b1-1edf7ce75562" }
  ],
  "r2_buckets": [
    { "binding": "OVERFLOW_R2", "bucket_name": "nathan-ai-sovereign-engine-overflow" }
  ]
}
