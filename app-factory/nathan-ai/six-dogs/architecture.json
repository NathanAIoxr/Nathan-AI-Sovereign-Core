  "stages": [
    {
      "id": 1,
      "name": "KNICK",
      "microservice": "input-recognition",
      "software": "Explicit capture of a concrete issue",
      "computerScience": "Event acquisition and provenance",
      "interface": "What happened?",
      "hardware": {
        "ledPin": "D3",
        "button": "next"
      },
      "emotionalAnalogy": "Denial or shock → awareness"
    },
    {
      "id": 2,
      "name": "KNACK",
      "microservice": "option-planning",
      "software": "Generate choices and review assumptions",
      "computerScience": "Decision support, branching, constraint review",
      "interface": "What are the available choices?",
      "hardware": {
        "ledPin": "D4",
        "button": "next"
      },
      "emotionalAnalogy": "Pain or guilt → adaptation"
    },
    {
      "id": 3,
      "name": "PADDY",
      "microservice": "paced-workflow",
      "software": "Choose deliberate pace without forced emotional claims",
      "computerScience": "Scheduler / feedback loop",
      "interface": "What pace feels manageable?",
      "hardware": {
        "ledPin": "D5",
        "button": "next"
      },
      "emotionalAnalogy": "Anger or frustration → regulation"
    },
    {
      "id": 4,
      "name": "WHACK",
      "microservice": "decision-confirmation",
      "software": "Select a nonviolent action after user confirmation",
      "computerScience": "Intent review and user-approved commit",
      "interface": "What safe decision will you make?",
      "hardware": {
        "ledPin": "D6",
        "button": "next"
      },
      "emotionalAnalogy": "Bargaining or rumination → decision"
    },
    {
      "id": 5,
      "name": "DOG",
      "microservice": "follow-through",
      "software": "Track next manageable action and available support",
      "computerScience": "Progress tracking and explicit opt-in reminders",
      "interface": "What happens next?",
      "hardware": {
        "ledPin": "D7",
        "button": "next"
      },
      "emotionalAnalogy": "Sadness or isolation → supported action"
    },
    {
      "id": 6,
      "name": "BONE",
      "microservice": "reflection-and-checkpoint",
      "software": "Assess outcome and retain portable user-owned record",
      "computerScience": "Checkpoint and reversible review",
      "interface": "What improved? What remains?",
      "hardware": {
        "ledPin": "D8",
        "button": "wrap-to-knick"
      },
      "emotionalAnalogy": "Possible relief, acceptance or connection; not stress elimination"
    }
