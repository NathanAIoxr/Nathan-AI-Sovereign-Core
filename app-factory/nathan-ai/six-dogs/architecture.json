  "dataFlow": [
    "user input",
    "consent/local storage choice",
    "deterministic Six Dogs state machine",
    "local reflection records",
    "optional explicit USB serial command",
    "device LED indicator"
  ],
  "deterministicInvariants": [
    "six unique named stages",
    "same user-specified order in every output",
    "mind begins at Dalet (Door/Mind Gate)",
    "body follows KNICK→KNACK→PADDY→WHACK→DOG→BONE",
    "shadow follows Bet→Nun→Waw→Kaph→Pe→Dalet",
    "soul/spirit require user-authored optional labels",
    "no automatic clinical or emotional inference",
    "no automatic external physical action"
  ],
  "hardware": {
    "board": "Arduino Uno-compatible",
    "button": "D2 INPUT_PULLUP to GND",
    "ledPins": [
      "D3",
      "D4",
      "D5",
      "D6",
      "D7",
      "D8"
    ],
    "resistors": "one 220–330 ohm resistor per LED",
    "power": "USB low voltage only",
    "serial": {
      "baud": 115200,
      "commands": [
        "SD1 STEP 1..6",
        "SD1 RESET",
        "SD1 QUERY"
      ],
      "lineTermination": "LF"
    },
    "physicalValidation": "not performed"
  },
  "privacy": {
    "defaultStorage": "in-memory",
