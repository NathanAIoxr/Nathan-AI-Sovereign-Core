<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="theme-color" content="#112624">
  <title>Nathan AI Memory Bank</title>
  <link rel="stylesheet" href="./styles.css">
  <script type="module" src="./app.js"></script>
</head>
<body>
  <main>
    <header>
      <p class="brand">NATHAN AI</p>
      <h1>Memory Bank</h1>
      <p>Recall your notes and past AI work.</p>
      <nav aria-label="Memory Bank">
        <a href="./zones/">Memory zones</a> ·
        <a href="./?category=chatgpt-history">Past ChatGPT work</a>
      </nav>
    </header>

    <details id="connection">
      <summary>Memory bank access</summary>
      <label for="key">Access key</label>
      <input id="key" type="password" autocomplete="off" autocapitalize="none" spellcheck="false">
      <div class="actions">
        <button type="button" id="connect">Unlock for this session</button>
        <button type="button" id="lock" class="quiet">Lock</button>
      </div>
    </details>

    <section aria-labelledby="recall-heading">
      <h2 id="recall-heading">Recall</h2>
      <form id="recall" novalidate>
        <label for="question">What are you looking for?</label>
        <div class="search">
          <input id="question" name="q" type="search" maxlength="300" placeholder="Pull up my finger-physics games">
          <button>Search</button>
        </div>
        <label for="recall-category">Memory zone</label>
        <input id="recall-category" name="category" maxlength="80" placeholder="Any zone">
      </form>
      <p id="recall-status" role="status"></p>
      <div class="actions">
        <button type="button" id="copy" class="quiet" hidden>Copy selected records</button>
        <button type="button" id="use-all" class="quiet" hidden>Select all displayed</button>
        <button type="button" id="more" class="quiet" hidden>Load more</button>
      </div>
      <div id="results"></div>
    </section>

    <section aria-labelledby="intelligence-heading">
      <h2 id="intelligence-heading">AI Personal Intelligence</h2>
      <p>Open a past ChatGPT conversation or start a chat with your account’s memory. To bring records from this bank, select them in Recall, copy, then paste them into your AI.</p>
      <label for="ai-question">Question for your AI</label>
      <textarea id="ai-question" rows="2" maxlength="2000" placeholder="What did we decide about this project?"></textarea>
      <button type="button" id="copy-question">Copy question and selected records</button>
      <p id="ai-status" role="status"></p>
      <div class="actions">
        <a href="https://chatgpt.com/" target="_blank" rel="noopener noreferrer">Open ChatGPT</a>
        <a href="https://gemini.google.com/app" target="_blank" rel="noopener noreferrer">Open Gemini</a>
        <a href="https://claude.ai/new" target="_blank" rel="noopener noreferrer">Open Claude</a>
        <a href="https://grok.com/" target="_blank" rel="noopener noreferrer">Open Grok</a>
      </div>
      <details class="labels">
        <summary>Import past ChatGPT work</summary>
        <p>Extract the conversation JSON from your ChatGPT export. Preview titles here, choose the conversations you want, then import them with your write key.</p>
        <label for="archive-file">Conversation JSON</label>
        <input id="archive-file" type="file" accept=".json,application/json">
        <label for="archive-filter" hidden>Filter conversation titles</label>
        <input id="archive-filter" type="search" placeholder="Find a conversation" maxlength="120" hidden>
        <p id="archive-status" role="status"></p>
        <div id="archive-list"></div>
        <button type="button" id="archive-save" hidden>Import selected conversations</button>
        <p><a href="https://help.openai.com/en/articles/7260999-exporting-your-chatgpt-history-and-data" target="_blank" rel="noopener noreferrer">Export ChatGPT history</a></p>
      </details>
    </section>

    <section aria-labelledby="remember-heading">
      <h2 id="remember-heading">Remember</h2>
      <form id="remember">
        <label for="note">Note or idea</label>
        <textarea id="note" name="content" placeholder="Dictate or paste an idea…" rows="5" maxlength="12000" required></textarea>
        <details class="labels">
          <summary>Title, category, tags, and source</summary>
          <label for="title">Title</label>
          <input id="title" name="title" maxlength="240">
          <label for="category">Category</label>
          <input id="category" name="category" maxlength="80">
          <label for="tags">Tags</label>
          <input id="tags" name="tags" maxlength="500">
          <label for="source">Source AI</label>
          <input id="source" name="source_ai" maxlength="80" placeholder="e.g. Gemini, Claude">
        </details>
        <button>Save memory</button>
      </form>
      <p id="remember-status" role="status"></p>
    </section>
  </main>
</body>
</html>
