{
  "schema": "nathan.one.editorial.reflexpoint-drafts.v1",
  "project": "THE RIVER AND THE SPARK",
  "status": "NEW DRAFTS ONLY. None of these are asserted to be among the 40 earlier completed original Reflex Points.",
  "author_attribution": "Nathan Tabor project; content of these 40 new draft sentences is assistant-generated editorial suggestion",
  "source_excerpt_original_examples_count": 6,
  "count": 40,
  "components": {
