{
  "openapi": "3.1.0",
  "info": {
    "title": "Nathan AI Global Bounties & Grand Challenges",
    "version": "1.0.0",
    "description": "Dated, source-checked mathematics and science catalog by Nathan Tabor."
  },
  "servers": [
    {
      "url": "https://tabor-bridge.nathantaboract.workers.dev/global-bounties"
    }
  ],
  "paths": {
    "/bounties": {
      "get": {
        "operationId": "searchBounties",
        "summary": "Search the public catalog.",
        "responses": {
          "200": {
            "description": "Matching rows in catalog order.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "count",
                    "bounties"
                  ],
                  "properties": {
                    "count": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "bounties": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Bounty"
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid input",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Catalog unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "category",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "mathematics",
                "science",
                "math"
              ]
            }
          },
          {
            "name": "status",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "OPEN",
                "UNDER_REVIEW",
                "ACTIVE_CLOSED_TO_NEW_ENTRIES",
                "CLOSED",
                "PAUSED"
              ]
            }
          },
          {
            "name": "q",
            "in": "query",
            "schema": {
              "type": "string",
              "maxLength": 120
            }
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 50
            }
          }
        ]
      },
      "post": {
        "operationId": "upsertBounty",
        "summary": "Add or correct a verified record with an owner key.",
        "responses": {
          "200": {
            "description": "Record accepted.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "const": "upserted"
                    },
                    "id": {
                      "type": "string",
                      "pattern": "^[a-z0-9][a-z0-9-]{0,79}$"
                    },
                    "checked_on": {
                      "type": "string",
                      "format": "date"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid input",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid key",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "Newer source check exists",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "413": {
            "description": "Body too large",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "415": {
            "description": "Unsupported content type",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Catalog unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "security": [
          {
            "ownerToken": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/BountyInput"
              }
            }
          }
        }
      }
    },
    "/stats": {
      "get": {
        "operationId": "getPrizeStats",
        "summary": "Count open entries and report individual prize and pool totals independently.",
        "responses": {
          "200": {
            "description": "Sponsor-reported amounts for records with status OPEN.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "const": "OPEN"
                    },
                    "totals": {
                      "type": "object",
                      "properties": {
                        "count": {
                          "type": "integer",
                          "minimum": 0
                        },
                        "prize_usd": {
                          "type": "integer",
                          "minimum": 0
                        },
                        "pool_usd": {
                          "type": "integer",
                          "minimum": 0
                        }
                      }
                    },
                    "breakdown": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "category": {
                            "type": "string",
                            "enum": [
                              "mathematics",
                              "science"
                            ]
                          },
                          "payout_kind": {
                            "type": "string",
                            "enum": [
                              "prize",
                              "pool"
                            ]
                          },
                          "count": {
                            "type": "integer",
                            "minimum": 0
                          },
                          "reported_usd": {
                            "type": "integer",
                            "minimum": 0
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "503": {
            "description": "Catalog unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/join": {
      "get": {
        "operationId": "getJoinInformation",
        "summary": "Get opt-in participation information for system and non-system integrations.",
        "responses": {
          "200": {
            "description": "Public collaboration and contribution links.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "ownerToken": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "schemas": {
      "BountyInput": {
        "type": "object",
        "required": [
          "id",
          "title",
          "organization",
          "category",
          "payout_usd",
          "payout_kind",
          "status",
          "source_url",
          "description"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{0,79}$"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "organization": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "category": {
            "type": "string",
            "enum": [
              "mathematics",
              "science"
            ]
          },
          "payout_usd": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1000000000000
          },
          "payout_kind": {
            "type": "string",
            "enum": [
              "prize",
              "pool"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "OPEN",
              "UNDER_REVIEW",
              "ACTIVE_CLOSED_TO_NEW_ENTRIES",
              "CLOSED",
              "PAUSED"
            ]
          },
          "deadline": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 200
          },
          "source_url": {
            "type": "string",
            "format": "uri",
            "pattern": "^https://",
            "maxLength": 500
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          }
        }
      },
      "Bounty": {
        "allOf": [
          {
            "$ref": "#/components/schemas/BountyInput"
          },
          {
            "type": "object",
            "required": [
              "checked_on"
            ],
            "properties": {
              "checked_on": {
                "type": "string",
                "format": "date"
              }
            }
          }
        ]
      },
      "Error": {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "string"
          }
        }
      }
    }
  }
}
