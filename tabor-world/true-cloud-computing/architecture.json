{
  "project": "TRUE CLOUD COMPUTING BY NATHAN TABOR",
  "version": "0.3.0",
  "state": "edge_runtime",
  "layers": [
    {
      "id": "source",
      "provider": "GitHub",
      "functions": [
        "version_control",
        "CI",
        "releases"
      ],
      "state": "source_and_ci"
    },
    {
      "id": "edge",
      "provider": "Cloudflare Workers",
      "functions": [
        "api_gateway",
        "authentication",
        "routing"
      ],
      "state": "service_bindings"
    },
    {
      "id": "metadata",
      "provider": "Cloudflare D1",
      "functions": [
        "capabilities",
        "job_leases",
        "receipts"
      ],
      "state": "d1_job_leases_and_receipts"
    },
    {
      "id": "artifacts",
      "provider": "Cloudflare R2",
      "state": "requires_provisioning",
      "functions": [
        "build_artifacts",
        "backups"
      ]
    },
    {
      "id": "dispatch",
      "provider": "Workers Cron and Cloudflare D1",
      "state": "scheduled",
      "functions": [
        "fixed_job_dispatch",
        "lease_recovery"
      ]
    },
    {
      "id": "compute",
      "provider": "authorized CPU/GPU nodes",
      "state": "external_fleet_registry",
      "functions": [
        "builds",
        "bounded_tasks",
        "benchmarking"
      ]
    }
  ],
  "integrations": [
    "tabor-world-hub",
    "nathan-ai-sovereign-2x",
    "tabor-compute-fleet"
  ],
  "principles": [
    "preserve_originals",
    "no_unverified_hardware_claims",
    "least_privilege",
    "bounded_cost",
    "execution_receipts"
  ],
  "act_addressing": {
    "version": 1,
    "constants": {
      "pi": 3.141592653589793,
      "phi": 1.618033988749895
    },
    "pie_sectors": 12,
    "storage": "stateless"
  }
}
