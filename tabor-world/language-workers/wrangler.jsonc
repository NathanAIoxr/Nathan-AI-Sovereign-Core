{
  "name": "tabor-polyglot-knowledge-gateway",
  "main": "src/index.mjs",
  "compatibility_date": "2026-11-18",
  "workers_dev": true,
  "preview_urls": false,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1,
    "traces": { "enabled": true, "head_sampling_rate": 0.1 }
  },
  "services": [{ "binding": "LIBRARY", "service": "tabor-universal-library-engine" }],
  "ai": { "binding": "AI" }
}
