# Install as root-owned /etc/tabor/node-agent.env, chmod 0600.
# Never commit real values or embed them in Terraform cloud-init.
TABOR_NODE_ID=replace-with-unique-node-id
TABOR_FLEET_URL=https://replace-with-verified-fleet-worker-domain
TABOR_FLEET_TOKEN=replace-with-secure-random-token
TABOR_HEARTBEAT_INTERVAL=60
